#import "io"
#import "time"

/// <summary>An error of starting or talking to a process: `code` is one of ProcessCodes (the program was not found, no permission, the platform has no processes, ...).</summary>
class ProcessException : Exception {
    int code
    construct(string message, int code = 6) {
        this.message = message
        this.code = code
    }
}

/// <summary>The codes of ProcessException.code (the same numbers as in the bridge).</summary>
class ProcessCodes {
    static int InvalidArgument() { return 1 }
    static int InvalidHandle() { return 2 }
    static int FileNotFound() { return 3 }
    static int Permission() { return 4 }
    static int NotSupported() { return 5 }
    static int Other() { return 6 }
    static int NotExited() { return 7 }
    static int DirectoryNotFound() { return 8 }

    // throws the error of the last native call of this thread
    static undefined Throw() { throw new ProcessException(__ProcLastErrorMessage(), __ProcLastError()) }
}

/// <summary>How a process starts: `Process.Start("git", ["status"], new ProcessOptions() { ... })`. Without redirection the process writes into the console of this
/// program and reads from it.</summary>
class ProcessOptions {
    /// The folder the process starts in (undefined: the current one of this program).
    string WorkingDirectory = undefined
    /// The environment variables of the process (undefined: those of this program, Environment.Variables - with what it set).
    Dictionary<string, string> Environment = undefined
    /// The standard input becomes Process.StandardInput (a stream that this program writes).
    bool RedirectInput = false
    /// The standard output becomes Process.StandardOutput (a stream that this program reads) - or the lines go to Process.OnOutput.
    bool RedirectOutput = false
    /// The standard error becomes Process.StandardError - or the lines go to Process.OnError.
    bool RedirectError = false
    /// The standard error goes into the standard output (one stream, in the order the process wrote them).
    bool MergeError = false

    construct() { }
}

/// <summary>What Process.Run gives: the exit code and everything the process wrote.</summary>
class ProcessResult {
    int ExitCode
    string Output
    string Error
    construct(int exitCode, string output, string error) {
        this.ExitCode = exitCode
        this.Output = output
        this.Error = error
    }
}

/// <summary>A pipe to or from a process (Process.StandardInput, StandardOutput, StandardError) as an IO stream: `new IO.TextReader(p.StandardOutput)` reads its lines.
/// Reading waits until something is there or the process has closed the pipe (0: the end); writing waits until the pipe has taken everything.</summary>
class ProcessStream : IO.Stream {
    any owner      // the Process
    int which      // 0 input, 1 output, 2 error
    bool closed = false

    construct(any owner, int which) {
        this.owner = owner
        this.which = which
    }

    override bool CanRead { get { return !this.closed && this.which != 0 } }
    override bool CanWrite { get { return !this.closed && this.which == 0 } }

    override int Read(byte buffer[], int offset, int count) {
        if (this.closed) { throw new IO.StreamClosedException("The stream is closed.", 9) }
        if (this.which == 0) { throw new IO.IOException("The input of a process cannot be read.", 8) }
        var tries = 0
        while (true) {
            var n = __ProcRead(this.owner.handle, this.which, buffer, offset, count)
            if (n >= 0) { return n }
            if (n == -1) { ProcessCodes.Throw() }
            Process.Pause(tries)
            tries = tries + 1
        }
    }

    // Reads what is there now without waiting: the bytes read, 0 at the end, -1 when nothing is there yet.
    int ReadAvailable(byte buffer[], int offset, int count) {
        if (this.closed) { throw new IO.StreamClosedException("The stream is closed.", 9) }
        var n = __ProcRead(this.owner.handle, this.which, buffer, offset, count)
        if (n == -1) { ProcessCodes.Throw() }
        if (n == -3) { return -1 }
        return n
    }

    override int Write(byte buffer[], int offset, int count) {
        if (this.closed) { throw new IO.StreamClosedException("The stream is closed.", 9) }
        if (this.which != 0) { throw new IO.IOException("The output of a process cannot be written.", 8) }
        var done = 0
        var tries = 0
        while (done < count) {
            var n = __ProcWrite(this.owner.handle, buffer, offset + done, count - done)
            if (n < 0) { ProcessCodes.Throw() }
            if (n == 0) {
                Process.Pause(tries)
                tries = tries + 1
            } else {
                done = done + n
                tries = 0
            }
        }
        return count
    }

    /// Closes the pipe; for the input: the process reads the end of it.
    override undefined Close() {
        if (this.closed) { return }
        this.closed = true
        if (this.which == 0 && this.owner.handle >= 0) { __ProcCloseInput(this.owner.handle) }
    }
}

/// <summary>A program that runs as a process of its own (docs/PROCESS.md).
///
///     var r = Process.Run("git", ["status", "--short"])
///     print(r.ExitCode + ": " + r.Output)
///
///     var options = new ProcessOptions()
///     options.MergeError = true
///     var p = Process.Start("make", ["all"], options)
///     p.OnOutput = (string line) => print("make: " + line)
///     p.WaitForExit()
/// </summary>
class Process {
    int handle = -1
    private ProcessStream input
    private ProcessStream output
    private ProcessStream error
    private bool lines = false      // the output goes to OnOutput/OnError (Pump)
    private IO.MemoryStream pendingOut
    private IO.MemoryStream pendingErr
    private bool outEnded = false
    private bool errEnded = false
    private bool endedRead = false
    private bool exitReported = false

    /// Called for every line of the standard output (without the line break), by Pump() and while WaitForExit() waits - the output must be redirected
    /// (ProcessOptions.RedirectOutput or MergeError); then do not read StandardOutput yourself.
    lambda<string> OnOutput
    /// Called for every line of the standard error (ProcessOptions.RedirectError).
    lambda<string> OnError
    /// Called once when the process has ended (by Pump/WaitForExit/HasExited), with the exit code.
    lambda<int> OnExit

    private construct() { }

    destruct() { try { this.Close() } catch (ProcessException e) { } }

    /// Whether this platform can start processes (false on FreeRTOS, ESP32, in the browser).
    static bool IsSupported { get { return __ProcSupported() } }

    /// Starts `file` (a path, or a name that is looked up in PATH) with the arguments - each one reaches the program as it is (no shell, no quoting needed).
    static Process Start(string file, string args[] = undefined, ProcessOptions options = undefined) {
        if (args == undefined) { args = new string[0] }
        if (options == undefined) { options = new ProcessOptions() }
        var flags = 0
        if (options.RedirectInput) { flags = flags | 1 }
        if (options.RedirectOutput) { flags = flags | 2 }
        if (options.RedirectError) { flags = flags | 4 }
        if (options.MergeError) { flags = flags | 2 | 8 }
        var vars = options.Environment
        if (vars == undefined) { vars = Environment.Variables }
        var env = new string[vars.Count * 2]
        var i = 0
        foreach (pair in vars) {
            env[i] = pair.Key
            env[i + 1] = pair.Value
            i = i + 2
        }
        var h = __ProcStart(file, args, options.WorkingDirectory, env, flags)
        if (h < 0) { ProcessCodes.Throw() }
        var p = new Process()
        p.handle = h
        if (options.RedirectInput) { p.input = new ProcessStream(p, 0) }
        if (options.RedirectOutput || options.MergeError) { p.output = new ProcessStream(p, 1) }
        if (options.RedirectError && !options.MergeError) { p.error = new ProcessStream(p, 2) }
        return p
    }

    /// Runs `file` to its end and gives its exit code and everything it wrote (standard input: nothing). `timeout` (milliseconds or a TimeSpan): it is ended after that
    /// time (Kill) and a ProcessException is thrown.
    static ProcessResult Run(string file, string args[] = undefined, ProcessOptions options = undefined, any timeout = undefined) {
        if (options == undefined) { options = new ProcessOptions() }
        options.RedirectInput = true
        options.RedirectOutput = true
        options.RedirectError = !options.MergeError
        var p = Process.Start(file, args, options)
        p.StandardInput.Close()
        var out = new IO.MemoryStream()
        var err = new IO.MemoryStream()
        var chunk = new byte[4096]
        var deadline = Process.DeadlineOf(timeout)
        var outDone = false
        var errDone = options.MergeError
        var tries = 0
        while (!outDone || !errDone) {
            var got = false
            if (!outDone) {
                var n = p.output.ReadAvailable(chunk, 0, 4096)
                if (n == 0) { outDone = true }
                if (n > 0) { out.Write(chunk, 0, n); got = true }
            }
            if (!errDone) {
                var m = p.error.ReadAvailable(chunk, 0, 4096)
                if (m == 0) { errDone = true }
                if (m > 0) { err.Write(chunk, 0, m); got = true }
            }
            if (got) { tries = 0 } else {
                if (deadline >= 0 && DateTime.UtcNow.Ticks >= deadline) {
                    p.Kill()
                    p.Close()
                    throw new ProcessException("'" + file + "' did not end within the time and was ended.", 6)
                }
                Process.Pause(tries)
                tries = tries + 1
            }
        }
        if (!p.WaitForExit(Process.LeftOf(deadline))) {
            p.Kill()
            p.Close()
            throw new ProcessException("'" + file + "' did not end within the time and was ended.", 6)
        }
        var result = new ProcessResult(p.ExitCode, IO.Utf8.GetString(out.ToBuffer()), IO.Utf8.GetString(err.ToBuffer()))
        p.Close()
        return result
    }

    /// The process id of the operating system.
    int Id {
        get {
            this.Check()
            return __ProcId(this.handle)
        }
    }

    /// The stream to the standard input of the process (undefined unless ProcessOptions.RedirectInput).
    ProcessStream StandardInput { get { return this.input } }
    /// The stream of its standard output (undefined unless RedirectOutput or MergeError).
    ProcessStream StandardOutput { get { return this.output } }
    /// The stream of its standard error (undefined unless RedirectError).
    ProcessStream StandardError { get { return this.error } }

    /// Whether it has ended (asks without waiting; delivers the lines that are there, see Pump).
    bool HasExited {
        get {
            this.Check()
            this.Pump()
            return this.endedRead
        }
    }

    /// The exit code (a ProcessException if it has not ended yet); a process that a signal ended: 128 + the number of the signal.
    int ExitCode {
        get {
            this.Check()
            var code = __ProcExitCode(this.handle)
            if (code == undefined) { ProcessCodes.Throw() }
            return code
        }
    }

    /// Waits until the process has ended - at most `timeout` (milliseconds or a TimeSpan; undefined: as long as it takes). While it waits the lines go to OnOutput/OnError.
    /// true when it has ended.
    bool WaitForExit(any timeout = undefined) {
        this.Check()
        var deadline = Process.DeadlineOf(timeout)
        var tries = 0
        while (true) {
            if (this.Pump()) { tries = 0 }
            if (this.endedRead && (!this.lines || (this.outEnded && this.errEnded))) { return true }
            if (deadline >= 0 && DateTime.UtcNow.Ticks >= deadline) { return false }
            Process.Pause(tries)
            tries = tries + 1
        }
    }

    /// Delivers what the process wrote so far to OnOutput/OnError, line by line, and calls OnExit once it has ended - without waiting. A loop of a user interface calls it
    /// regularly (WaitForExit and HasExited call it too). true when there was something to deliver.
    bool Pump() {
        if (this.handle < 0) { return false }
        var delivered = false
        if (this.OnOutput != undefined || this.OnError != undefined) { this.lines = true }
        if (this.lines) {
            if (this.output != undefined && !this.outEnded) {
                if (this.pendingOut == undefined) { this.pendingOut = new IO.MemoryStream() }
                var r = this.Drain(this.output, this.pendingOut, this.OnOutput)
                if (r > 0) { delivered = true }
                if (r == 2) { this.outEnded = true }
            } else { this.outEnded = true }
            if (this.error != undefined && !this.errEnded) {
                if (this.pendingErr == undefined) { this.pendingErr = new IO.MemoryStream() }
                var e = this.Drain(this.error, this.pendingErr, this.OnError)
                if (e > 0) { delivered = true }
                if (e == 2) { this.errEnded = true }
            } else { this.errEnded = true }
        }
        if (!this.endedRead) {
            var state = __ProcPoll(this.handle)
            if (state < 0) { ProcessCodes.Throw() }
            if (state == 1) {
                this.endedRead = true
                delivered = true
            }
        }
        // OnExit once: after the end of the process and of the lines it wrote
        if (this.endedRead && !this.exitReported && (!this.lines || (this.outEnded && this.errEnded))) {
            this.exitReported = true
            if (this.OnExit != undefined) { this.OnExit(this.ExitCode) }
        }
        return delivered
    }

    // reads what is there of one pipe and hands the complete lines over: 0 nothing, 1 something, 2 the end (the rest goes over as the last line)
    private int Drain(ProcessStream stream, IO.MemoryStream pending, lambda<string> handler) {
        var chunk = new byte[4096]
        var result = 0
        while (true) {
            var n = stream.ReadAvailable(chunk, 0, 4096)
            if (n < 0) { return result }
            if (n == 0) {
                var rest = pending.ToBuffer()
                if (rest.length > 0 && handler != undefined) { handler(Process.LineOf(rest, 0, rest.length)) }
                pending.Length = 0
                pending.Position = 0
                return 2
            }
            result = 1
            var start = 0
            for (var i = 0; i < n; i++) {
                if (chunk[i] == 10) {
                    pending.Write(chunk, start, i - start)
                    var line = pending.ToBuffer()
                    pending.Length = 0
                    pending.Position = 0
                    if (handler != undefined) { handler(Process.LineOf(line, 0, line.length)) }
                    start = i + 1
                }
            }
            if (start < n) { pending.Write(chunk, start, n - start) }
        }
    }

    // a line without its line break ("\n", "\r\n")
    static string LineOf(byte bytes[], int offset, int count) {
        if (count > 0 && bytes[offset + count - 1] == 13) { count = count - 1 }
        if (count == 0) { return "" }
        return IO.Utf8.GetString(bytes, offset, count)
    }

    /// Ends the process at once.
    undefined Kill() {
        this.Check()
        if (!__ProcKill(this.handle)) { ProcessCodes.Throw() }
    }

    /// Releases the pipes and the handle; the process itself goes on if it still runs (Kill ends it).
    undefined Close() {
        if (this.handle < 0) { return }
        if (this.input != undefined) { this.input.Close() }
        __ProcClose(this.handle)
        this.handle = -1
    }

    private undefined Check() {
        if (this.handle < 0) { throw new ProcessException("The process has been closed.", 2) }
    }

    // ---- waiting: the natives are only asked, never made to wait ----
    static int DeadlineOf(any timeout) {
        if (timeout == undefined) { return -1 }
        var ms = 0
        if (timeout is of int) { ms = timeout } else { ms = TimeSpan.Of(timeout).Ticks / 10000 }
        if (ms < 0) { ms = 0 }
        return DateTime.UtcNow.Ticks + ms * 10000
    }

    static any LeftOf(int deadline) {
        if (deadline < 0) { return undefined }
        var left = (deadline - DateTime.UtcNow.Ticks) / 10000
        if (left < 0) { return 0 }
        return left
    }

    // a moment between two attempts: 1 ms at first, up to 10 ms when it takes long
    static undefined Pause(int tries) {
        var ms = 1
        if (tries >= 3) { ms = 2 }
        if (tries >= 8) { ms = 5 }
        if (tries >= 20) { ms = 10 }
        Sleep(ms)
    }
}
