{
  "format": 1,
  "name": "fire-process",
  "type": "library",
  "import": "process",
  "standard": true,
  "settings": {
    "version": "1.0.0",
    "author": "fire",
    "license": "fire",
    "description": "The standard library 'process' of fire: starting programs, pipes, exit codes (prelude and C++ sources)."
  },
  "native": {
    "sources": [
      "native/fire_bridge_process.hpp"
    ],
    "discover": false,
    "functions": [
      {
        "name": "__ProcLastError",
        "arguments": 0,
        "cpp": "process::LastError"
      },
      {
        "name": "__ProcLastErrorMessage",
        "arguments": 0,
        "cpp": "process::LastErrorMessage",
        "needsList": true,
        "returnsReference": true
      },
      {
        "name": "__ProcOpenCount",
        "arguments": 0,
        "cpp": "process::OpenCount"
      },
      {
        "name": "__ProcSupported",
        "arguments": 0,
        "cpp": "process::Supported"
      },
      {
        "name": "__ProcStart",
        "arguments": 5,
        "cpp": "process::Start"
      },
      {
        "name": "__ProcId",
        "arguments": 1,
        "cpp": "process::Id"
      },
      {
        "name": "__ProcPoll",
        "arguments": 1,
        "cpp": "process::Poll"
      },
      {
        "name": "__ProcExitCode",
        "arguments": 1,
        "cpp": "process::ExitCode"
      },
      {
        "name": "__ProcRead",
        "arguments": 5,
        "cpp": "process::Read"
      },
      {
        "name": "__ProcWrite",
        "arguments": 4,
        "cpp": "process::Write"
      },
      {
        "name": "__ProcCloseInput",
        "arguments": 1,
        "cpp": "process::CloseInput"
      },
      {
        "name": "__ProcKill",
        "arguments": 1,
        "cpp": "process::Kill"
      },
      {
        "name": "__ProcClose",
        "arguments": 1,
        "cpp": "process::Close"
      }
    ],
    "reset": "process::reset"
  }
}
