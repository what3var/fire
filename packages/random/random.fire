#import "time"

class RandomException : Exception {
    string message
    construct(string message) { this.message = message }
}

class PseudoRandom {
    defined int s0
    defined int s1
    defined int s2
    defined int s3

    // From the clock.
    construct() { this.Seed(DateTime.UtcNow.Ticks) }

    // From a number: the same number gives the same sequence.
    construct(defined int seed) { this.Seed(seed) }

    // 32-bit multiplication modulo 2^32 without leaving the 64-bit `int` (a and b are below 2^32).
    static defined int Mul32(defined int a, defined int b) {
        return (((a & 65535) * b) + ((((a >> 16) * b) & 65535) << 16)) & 4294967295
    }

    // The finalizer of MurmurHash3: spreads every bit of x over the whole word.
    static defined int Mix(defined int x) {
        x = (x # (x >> 16)) & 4294967295
        x = PseudoRandom.Mul32(x, 2246822507)
        x = (x # (x >> 13)) & 4294967295
        x = PseudoRandom.Mul32(x, 3266489909)
        return (x # (x >> 16)) & 4294967295
    }

    // Starts the sequence again from `seed`.
    undefined Seed(defined int seed) {
        var lo = seed & 4294967295
        var hi = (seed >> 32) & 4294967295
        this.s0 = PseudoRandom.Mix((lo + 2654435769) & 4294967295)
        this.s1 = PseudoRandom.Mix((hi + this.s0 + 2654435769) & 4294967295)
        this.s2 = PseudoRandom.Mix(((lo # hi # this.s1) + 1013904242) & 4294967295)
        this.s3 = PseudoRandom.Mix((this.s2 + this.s1 + 1640531527) & 4294967295)
        if (this.s0 == 0 && this.s1 == 0 && this.s2 == 0 && this.s3 == 0) { this.s0 = 1 }
    }

    // The next 32 random bits as a number 0 .. 4294967295.
    defined int NextUInt32() {
        var m = (this.s1 * 5) & 4294967295
        m = ((m << 7) | (m >> 25)) & 4294967295
        var result = (m * 9) & 4294967295
        var t = (this.s1 << 9) & 4294967295
        this.s2 = this.s2 # this.s0
        this.s3 = this.s3 # this.s1
        this.s1 = this.s1 # this.s2
        this.s0 = this.s0 # this.s3
        this.s2 = this.s2 # t
        this.s3 = ((this.s3 << 11) | (this.s3 >> 21)) & 4294967295
        return result
    }

    // 0 .. 2147483646 (like Random.Next() of .NET).
    defined int Next() {
        var v = this.NextUInt32() >> 1
        if (v == 2147483647) { return 0 }
        return v
    }

    // 0 .. max - 1 (max must be above 0; a bigger max than 2^31 uses 62 random bits).
    defined int Next(defined int max) {
        if (max <= 0) { throw new RandomException("max must be above 0") }
        if (max <= 4294967296) { return this.Bounded(max, 4294967296, false) }
        return this.Bounded(max, 4611686018427387904, true)
    }

    // min .. max - 1.
    defined int Next(defined int min, defined int max) {
        if (max <= min) { throw new RandomException("max must be above min") }
        return min + this.Next(max - min)
    }

    // An unbiased value below `max`: the few values at the top of the range that would make some results likelier are drawn again.
    defined int Bounded(defined int max, defined int range, bool wide) {
        var limit = range - (range % max)
        while (true) {
            var v = this.NextUInt32()
            if (wide) { v = (v << 30) | (this.NextUInt32() >> 2) }
            if (v < limit) { return v % max }
        }
    }

    // A number in the whole range of `int` (63 bits and the sign).
    defined int NextInt() {
        var hi = this.NextUInt32()
        var lo = this.NextUInt32()
        var v = ((hi & 2147483647) << 32) | lo
        if ((hi >> 31) == 1) { return ~v }
        return v
    }

    // 0.0 .. below 1.0 with 53 random bits.
    defined float NextFloat() {
        var a = this.NextUInt32() >> 5
        var b = this.NextUInt32() >> 6
        return (a * 67108864 + b) / 9007199254740992.0
    }

    // true or false, each half of the time.
    bool NextBool() { return (this.NextUInt32() & 1) == 1 }

    // The number of elements of a List or an array.
    defined int CountOf(any list) {
        if (list is of List) { return list.Count }
        return list.length
    }

    // A random element of the list or array (undefined if it is empty).
    any Pick(any list) {
        var n = this.CountOf(list)
        if (n == 0) { return undefined }
        return list[this.Next(n)]
    }

    // Mixes the elements of the list or array in place (Fisher-Yates) and returns it.
    any Shuffle(any list) {
        var i = this.CountOf(list) - 1
        while (i > 0) {
            var j = this.Next(i + 1)
            any tmp = list[i]
            list[i] = list[j]
            list[j] = tmp
            i = i - 1
        }
        return list
    }
}
// A 128-bit identifier (RFC 9562, the GUID of .NET): NewGuid (version 4), Parse, ToString in the forms of .NET.
class Guid {
    private byte data[]
    // the generator of NewGuid(): made at the first call, seeded from the clock and the state of the process
    private static PseudoRandom shared = undefined

    construct() { this.data = new byte[16] }

    // The Guid of all zeros.
    static Guid Empty { get { return new Guid() } }

    // A new random Guid (version 4, variant RFC 9562). Its bits come from a PseudoRandom seeded once per program from the clock and the memory of the
    // process: unique in practice, but not unguessable - for a token use Guid.FromBytes(Net.SecureRandom.Bytes(16)).
    static Guid NewGuid() {
        if (Guid.shared == undefined) {
            defined int seed = DateTime.UtcNow.Ticks
            seed = seed # (Environment.ProcessMemory << 20) # Environment.FreeMemory
            Guid.shared = new PseudoRandom(seed)
        }
        return Guid.NewGuid(Guid.shared)
    }

    // A new version 4 Guid with the bits of this generator (the same seed gives the same Guids).
    static Guid NewGuid(PseudoRandom random) {
        var g = new Guid()
        for (int i = 0; i < 16; i += 4) {
            defined int v = random.NextUInt32()
            g.data[i] = (v >> 24) & 255
            g.data[i + 1] = (v >> 16) & 255
            g.data[i + 2] = (v >> 8) & 255
            g.data[i + 3] = v & 255
        }
        g.data[6] = (g.data[6] & 15) | 64
        g.data[8] = (g.data[8] & 63) | 128
        return g
    }

    // A Guid of 16 bytes in the order of its text (RFC 9562, big-endian) - not the order of .NET's ToByteArray, whose first three fields are little-endian.
    // The bytes are taken as they are (version and variant included).
    static Guid FromBytes(byte bytes[]) {
        if (bytes == undefined || bytes.length != 16) { throw new ArgumentException("A Guid is made of 16 bytes.") }
        var g = new Guid()
        for (int i = 0; i < 16; i++) { g.data[i] = bytes[i] }
        return g
    }

    // The 16 bytes in the order of the text (see FromBytes).
    byte[] ToBytes() {
        var b = new byte[16]
        for (int i = 0; i < 16; i++) { b[i] = this.data[i] }
        return b
    }

    // Reads the forms of .NET: "D" (8-4-4-4-12 hex digits), "N" (32 digits), "B" ({D}), "P" ((D)); either case, spaces around it. An ArgumentException
    // for anything else.
    static Guid Parse(string text) {
        var g = Guid.TryParse(text)
        if (g == undefined) { throw new ArgumentException("'" + text + "' is not a Guid (32 hex digits, as 8-4-4-4-12 with hyphens, optionally in {} or ()).") }
        return g
    }

    // Like Parse, undefined when the text is not a Guid.
    static Guid TryParse(string text) {
        if (text == undefined) { return undefined }
        string t = text.Trim()
        if (t.Length == 38 && ((t[0] == '{' && t[37] == '}') || (t[0] == '(' && t[37] == ')'))) { t = t.Substring(1, 36) }
        if (t.Length == 36) {
            if (t[8] != '-' || t[13] != '-' || t[18] != '-' || t[23] != '-') { return undefined }
            t = t.Substring(0, 8) + t.Substring(9, 4) + t.Substring(14, 4) + t.Substring(19, 4) + t.Substring(24)
        }
        if (t.Length != 32) { return undefined }
        var g = new Guid()
        for (int i = 0; i < 16; i++) {
            int hi = Guid.Hex(t[i * 2])
            int lo = Guid.Hex(t[i * 2 + 1])
            if (hi < 0 || lo < 0) { return undefined }
            g.data[i] = hi * 16 + lo
        }
        return g
    }

    private static defined int Hex(char h) {
        if (h >= '0' && h <= '9') { return h.ToInt() - 48 }
        if (h >= 'a' && h <= 'f') { return h.ToInt() - 87 }
        if (h >= 'A' && h <= 'F') { return h.ToInt() - 55 }
        return -1
    }

    // The text in the form "D": 8-4-4-4-12 lower-case hex digits, as .NET writes it.
    string ToString() { return this.ToString("D") }

    // "D" (with hyphens), "N" (32 digits), "B" ({...}), "P" ((...)); an upper-case letter does the same (the digits stay lower-case, as in .NET).
    string ToString(string format) {
        string f = format.ToUpper()
        string digits = "0123456789abcdef"
        var sb = new StringBuilder()
        if (f == "B") { sb.Append('{') }
        if (f == "P") { sb.Append('(') }
        if (f != "D" && f != "N" && f != "B" && f != "P") { throw new ArgumentException("The format of a Guid is \"D\", \"N\", \"B\" or \"P\", not \"" + format + "\".") }
        for (int i = 0; i < 16; i++) {
            if (f != "N" && (i == 4 || i == 6 || i == 8 || i == 10)) { sb.Append('-') }
            int b = this.data[i]
            sb.Append(digits[b >> 4])
            sb.Append(digits[b & 15])
        }
        if (f == "B") { sb.Append('}') }
        if (f == "P") { sb.Append(')') }
        return sb.ToString()
    }

    // The version (4 for NewGuid, the high four bits of byte 6).
    defined int Version { get { return this.data[6] >> 4 } }

    bool IsEmpty {
        get {
            for (int i = 0; i < 16; i++) { if (this.data[i] != 0) { return false } }
            return true
        }
    }

    // Two Guids are equal when their bits are.
    bool operator==(any other) {
        if (!(other is of Guid)) { return false }
        return this.CompareTo(other) == 0
    }

    bool operator!=(any other) { return !(this == other) }

    bool Equals(any other) { return this == other }

    defined int GetHashCode() {
        defined int h = 0
        for (int i = 0; i < 16; i++) { h = (h * 31 + this.data[i]) & 2147483647 }
        return h
    }

    // -1, 0 or 1: the order of the bytes (of the text).
    defined int CompareTo(any other) {
        byte o[] = other.ToBytes()
        for (int i = 0; i < 16; i++) {
            if (this.data[i] != o[i]) { return this.data[i] < o[i] ? -1 : 1 }
        }
        return 0
    }
}
