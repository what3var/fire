namespace UI {
    // The topmost element: draws into `framebuffer` and receives the events from `window` (queue, see Tick).
    class Root {
        Framebuffer framebuffer
        Window window
        Renderer renderer
        Theme theme
        Panel content
        // Resources and implicit styles for the whole interface (see ResourceDictionary)
        ResourceDictionary resources
        int width
        int height
        // Cell size of the font in pixels (width and height of a character)
        int cw
        int ch
        // The fonts that elements have asked for by name (see FontFor)
        List fontNames
        List fontObjects
        bool closed = false
        int mouseX = 0
        int mouseY = 0
        Element hoverElement
        Element pressedElement
        Element focusElement
        // Clipping rectangles (Rect), nested: the topmost applies (see PushClip)
        List clips
        // Floating elements above the interface (menus, suggestion lists): the last one is on top (see ShowPopup)
        List popups
        // Further roots (windows) that this one processes along with it (see Attach)
        List attached
        // A lambda without parameters that every cycle of this root calls at the end (the markup classes use it for OnTick)
        lambda onTick
        // A lambda (width, height) that is called after the interface has been brought to a new window size (see autoResize)
        lambda<int, int> onResize
        // Sees every key first (key, modifier): when it returns true, the key is used up and no element gets it (a dialog takes Escape this way)
        lambda<int, int> onKeyPreview
        // Drag & drop between the elements (docs/UI.md): the press a drag may start from, what is dragged, its source, the element under the pointer that
        // takes it and what it would do
        Element dragFrom
        int dragX0 = 0
        int dragY0 = 0
        bool dragging = false
        UI.DragData dragData
        Element dragSource
        Element dragTarget
        UI.DropEffect dragEffect = UI.DropEffect.None
        // A lambda (data, x, y) for what another program drops onto the window (files, text) where no element takes it
        lambda<UI.DragData, int, int> onDrop
        // Something of another program dragged over the window (DragHover): the element under it that takes drops, and what it is told (Pending: not known yet)
        Element hoverTarget
        UI.DragData hoverData
        // The label at the pointer while a drag goes on (see MoveDragImage): where it is drawn (dragImageW = 0: nowhere)
        int dragImageX = 0
        int dragImageY = 0
        int dragImageW = 0
        int dragImageH = 0
        // ... or a picture instead of the label (DragData.Image, or the snapshot of the source element that the root made and owns), its top left corner at
        // (dragPicX, dragPicY) from the pointer, dragPicW x dragPicH logical pixels big
        Framebuffer dragPicture
        Framebuffer dragSnapshot
        int dragPicX = 0
        int dragPicY = 0
        int dragPicW = 0
        int dragPicH = 0
        // The modifier keys held now (as KeyDown/KeyUp report them; UI.Keys.Shift/Shortcut read it): a text field copies instead of moving a drop with Ctrl
        int modifiers = 0
        // Counts the cycles of this root (Tick, Cycle): elements measure short intervals with it (a double click)
        int cycles = 0
        // Clicks in a row, for Element.MouseDown: 1 a single click, 2 a double click, 3 a triple click, ... A press counts on when it is the same button as the one
        // before, within `doubleClickTime` milliseconds and `doubleClickDistance` pixels of it. The time comes from `clock` (a lambda that gives milliseconds, for
        // example `func () => { return DateTime.Now.Ticks / 10000 }` with #import "time"); without it the cycles of the root count (one is about 1/60 s with VSync).
        int clickCount = 0
        int doubleClickTime = 400
        int doubleClickDistance = 4
        int lambda clock
        int lastClickButton = -1
        int lastClickX = 0
        int lastClickY = 0
        int lastClickTime = 0
        // Invalidate: if something has changed, Update arranges anew and repaints - only the area that has changed, as long as no element has moved elsewhere.
        bool dirty = true
        bool fullRedraw = true
        bool hasDirtyRect = false
        int dirtyX0 = 0
        int dirtyY0 = 0
        int dirtyX1 = 0
        int dirtyY1 = 0
        // while arranging the position or size of an element has changed
        bool layoutMoved = false
        // while arranging and drawing: write accesses to the fields of the elements are then no changes
        bool painting = false
        lambda<any, any, any, any> watcher

        // Touchscreen: the finger that guides the pointer (-1: none; a second finger next to it is ignored), where it touched down, where it was last, whether it is currently swiping (and which element is then moved)
        int touchFinger = -1
        int touchX0 = 0
        int touchY0 = 0
        int touchX = 0
        int touchY = 0
        bool touchPanning = false
        Element touchPanner
        // from this many pixels of movement a tap becomes a swipe
        int touchSlop = 10

        // Joystick: D-pad (hat) and left stick become the arrow keys, buttons become Enter/Escape/Tab. The button numbers are those of the device (for an Xbox pad: 0 = A, 1 = B, 4 = LB, 5 = RB); -1 switches a button off.
        int joyAxisX = 0
        int joyAxisY = 1
        int joyButtonActivate = 0
        int joyButtonCancel = 1
        int joyButtonPrevious = 4
        int joyButtonNext = 5
        // Holding repeats the key: after `joyRepeatDelay` cycles, then every `joyRepeatInterval` (one cycle is a tick - with VSync about 1/60 s)
        int joyRepeatDelay = 24
        int joyRepeatInterval = 6
        int joyStickX = 0
        int joyStickY = 0
        int joyHatX = 0
        int joyHatY = 0
        int joyKey = 0
        int joyHold = 0

        // The look from the system (SystemTheme.Current()): set them to override it - see Scaling, Dark, Accent
        float scaling = 1.0
        bool dark = false
        int accent = 0x0078D7
        // a board without a desktop: whole-number scaling, the fast built-in font
        bool embedded = false

        // The scale of the interface: logical pixels -> pixels of the screen (1.5 = 150 %). Starts with the scaling of the system, like every other program on it;
        // setting it overrides that (`root.Scaling = 1.0`). The elements keep their sizes in logical pixels, the window and the framebuffer grow with it, text is
        // drawn sharp at the larger size.
        float Scaling {
            get { return this.scaling }
            set { this.ApplyScaling(value) }
        }

        // Dark mode. Starts with the setting of the system; setting it overrides that.
        bool Dark {
            get { return this.dark }
            set {
                this.dark = value
                this.theme.SetColors(this.dark, this.accent)
                this.Invalidate()
            }
        }

        // The accent colour as 0xRRGGBB (focus, selection, hovered buttons). Starts with the accent colour of the system; setting it overrides that.
        int Accent {
            get { return this.accent }
            set {
                this.accent = value
                this.theme.SetColors(this.dark, this.accent)
                this.Invalidate()
            }
        }

        construct(Framebuffer framebuffer, Window window) {
            this.framebuffer = framebuffer
            this.window = window
            this.renderer = new Renderer(framebuffer)
            this.theme = new Theme()
            this.resources = new ResourceDictionary()
            this.clips = new List()
            this.popups = new List()
            this.attached = new List()
            this.fontNames = new List()
            this.fontObjects = new List()
            this.cw = this.renderer.CellWidth()
            this.ch = this.renderer.CellHeight()
            this.width = framebuffer.Width()
            this.height = framebuffer.Height()

            // the look of the system: dark or light, its accent colour, its font, its scaling (a board: dark violet, the built-in font, whole-number scaling)
            var system = SystemTheme.Current()
            this.embedded = system.embedded
            this.dark = system.dark
            this.accent = system.accent
            if (system.font != "" && !this.embedded) {
                this.theme.font = system.font
                if (system.fontSize > 0) { this.theme.fontSize = system.fontSize }
            }
            if (this.dark || this.accent != 0x0078D7) { this.theme.SetColors(this.dark, this.accent) }
            float systemScale = system.scale
            if (this.embedded) { systemScale = Math.Max(1.0, Math.Round(systemScale)) }
            this.content = new Panel(0, 0, this.width, this.height)
            this.content.Filled = false

            // Events are polled, not delivered by callback: this way they run in the main program, and an
            // onClick lambda sees the real global variables (a callback, by contrast, works on a copy, SPEC 8.1.4)
            window.EnableEvents()
            // the cycle of the window's manager (Window.Show/Run, WindowManager): the events of the window are distributed and the interface is drawn
            window.onCycle = func () on this => { this.Cycle() }
            // If the user drags the window to another size, the framebuffer gets it (as long as it is valid) and the interface arranges itself anew - instead of its image being stretched.
            // `window.AutoResize = false` leaves it at stretching.
            window.AutoResize = true
            // The finger guides the interface itself (tapping, dragging, swiping, see TouchDown): SDL should not additionally make mouse events out of it.
            window.TouchMouse = false

            // Every change of a field of an element (and of the theme) is reported by a probe (see SPEC 8.14): the elements call Touched as soon as they are arranged for the first time (Watch)
            this.watcher = func (o, n, a, b) on this => { this.Touched(o) }
            Reflect.ProbeAll(this.theme, "changed", this.watcher)
            if (systemScale != 1.0) { this.ApplyScaling(systemScale) }
        }

        // A new scale: the renderer draws at it, the framebuffer and the window get the logical size times the scale.
        undefined ApplyScaling(float scale) {
            var s = scale
            if (s < 0.25) { s = 0.25 }
            if (this.embedded) { s = Math.Max(1.0, Math.Round(s)) }
            this.scaling = s
            this.renderer.scale = s
            this.cw = this.renderer.Logical(this.renderer.CellWidth())
            this.ch = this.renderer.Logical(this.renderer.CellHeight())
            var pw = Math.Round(this.width * s)!int
            var ph = Math.Round(this.height * s)!int
            if (pw != this.framebuffer.Width() || ph != this.framebuffer.Height()) {
                this.framebuffer.Resize(pw, ph)
                this.window.SetSize(pw, ph)
            }
            this.Invalidate()
        }

        // A position of the window (pixels of the screen) in logical pixels.
        int ToLogical(int v) {
            if (this.scaling == 1.0) { return v }
            return Math.Floor(v / this.scaling)!int
        }

        // The font with this name (Fonts.Get; the console font if there is none), looked up once and then kept.
        Font FontFor(string name) {
            if (name == "") { return undefined }
            for (var i = 0; i < this.fontNames.Count; i = i + 1) {
                if (this.fontNames[i] == name) { return this.fontObjects[i] }
            }
            var found = Fonts.Get(name)
            found.TakeTo(this)
            this.fontNames.Add(name)
            this.fontObjects.Add(found)
            return found
        }

        // An element or the theme has changed.
        undefined Touched(any o) {
            if (this.painting) { return }
            this.dirty = true
            if (o is of Element) { o.Invalidate() } else { this.fullRedraw = true }
        }

        // Observes the fields of the element (once).
        undefined Watch(Element element) {
            if (element.watched) { return }
            element.watched = true
            Reflect.ProbeAll(element, "changed", this.watcher)
        }

        // The area (x, y, w, h) must be repainted.
        undefined InvalidateRect(int x, int y, int w, int h) {
            this.dirty = true
            var x1 = x + w + 1
            var y1 = y + h + 1
            var x0 = x - 1
            var y0 = y - 1
            if (!this.hasDirtyRect) {
                this.dirtyX0 = x0
                this.dirtyY0 = y0
                this.dirtyX1 = x1
                this.dirtyY1 = y1
                this.hasDirtyRect = true
                return
            }
            this.dirtyX0 = UI.M.Min(this.dirtyX0, x0)
            this.dirtyY0 = UI.M.Min(this.dirtyY0, y0)
            this.dirtyX1 = UI.M.Max(this.dirtyX1, x1)
            this.dirtyY1 = UI.M.Max(this.dirtyY1, y1)
        }

        // Everything must be repainted (for example after changing a brush that elements use).
        undefined Invalidate() {
            this.dirty = true
            this.fullRedraw = true
        }

        // Does the rectangle lie in the area that is currently being repainted? (Elements outside do not paint.)
        bool Needs(int x, int y, int w, int h) {
            if (this.fullRedraw) { return true }
            if (!this.hasDirtyRect) { return false }
            return x < this.dirtyX1 && x + w > this.dirtyX0 && y < this.dirtyY1 && y + h > this.dirtyY0
        }

        // Adds an element (or panel) to the top level; it belongs to this root from now on.
        undefined Add(Element element) { this.content.Add(element) }

        // Arranges the entire interface and draws it anew completely.
        undefined Draw() {
            this.fullRedraw = true
            this.dirty = true
            this.Update()
        }

        // Polls the elements (bindings, triggers, styles, lists); everything that changes in the process reports itself via Touched.
        undefined Poll() {
            this.content.Poll(this)
            for (var i = 0; i < this.popups.Count; i = i + 1) { this.popups[i].Poll(this) }
        }

        // Brings the interface up to date: polls, arranges anew and paints - but only if something has changed, and only the changed area, as long as no element
        // has changed its position or size. Returns true if painting took place.
        bool Update() {
            this.CheckSize()
            this.Poll()
            if (!this.dirty && !this.fullRedraw) { return false }
            this.painting = true
            this.layoutMoved = false
            this.content.Measure(this, this.width, this.height)
            this.content.Arrange(this, 0, 0, this.width, this.height)
            this.LayoutPopups()
            if (this.layoutMoved) { this.fullRedraw = true }
            this.Paint()
            this.painting = false
            this.dirty = false
            this.fullRedraw = false
            this.hasDirtyRect = false
            return true
        }

        // Does the framebuffer have a different size than the interface (the window was dragged, see Window.AutoResize)? Then the top level gets the new size, everything is
        // arranged and painted anew, and onResize(width, height) is called. Returns true if the size has changed.
        bool CheckSize() {
            var w = this.ToLogical(this.framebuffer.Width())
            var h = this.ToLogical(this.framebuffer.Height())
            if (w == this.width && h == this.height) { return false }
            this.width = w
            this.height = h
            this.content.Width = w
            this.content.Height = h
            this.Invalidate()
            var callback = this.onResize
            if (callback != undefined) { callback(w, h) }
            return true
        }

        // Arranges the floating elements (a new or moved one is repainted).
        undefined LayoutPopups() {
            for (var i = 0; i < this.popups.Count; i = i + 1) {
                var popup = this.popups[i]
                popup.Measure(this, -1, -1)
                // not beyond the edge
                if (popup.Left + popup.dw > this.width) { popup.Left = UI.M.Max(0, this.width - popup.dw) }
                if (popup.Top + popup.dh > this.height) { popup.Top = UI.M.Max(0, this.height - popup.dh) }
                var moved = this.layoutMoved
                this.layoutMoved = false
                popup.Arrange(this, popup.Left, popup.Top, popup.dw, popup.dh)
                if (this.layoutMoved && !this.fullRedraw) { this.InvalidateRect(popup.rx, popup.ry, popup.actualWidth, popup.actualHeight) }
                this.layoutMoved = moved
            }
        }

        undefined Paint() {
            this.renderer.ResetClip()
            if (this.fullRedraw) {
                this.renderer.FillRect(0, 0, this.width, this.height, this.theme.back)
            } else if (this.hasDirtyRect) {
                var x0 = UI.M.Max(0, this.dirtyX0)
                var y0 = UI.M.Max(0, this.dirtyY0)
                var x1 = UI.M.Min(this.width, this.dirtyX1)
                var y1 = UI.M.Min(this.height, this.dirtyY1)
                if (x1 <= x0 || y1 <= y0) { return }
                this.dirtyX0 = x0
                this.dirtyY0 = y0
                this.dirtyX1 = x1
                this.dirtyY1 = y1
                this.PushClip(x0, y0, x1 - x0, y1 - y0)
                this.renderer.FillRect(x0, y0, x1 - x0, y1 - y0, this.theme.back)
            } else { return }
            this.content.Draw(this, 0, 0)
            for (var i = 0; i < this.popups.Count; i = i + 1) {
                var popup = this.popups[i]
                popup.Draw(this, popup.rx, popup.ry)
            }
            this.DrawDragImage()
            if (!this.fullRedraw) { this.PopClip() }
        }

        // Restricts drawing to the rectangle (intersected with the current one); PopClip restores the previous one. The elements call both
        // in pairs (for example a ScrollViewer around its children).
        undefined PushClip(int x, int y, int w, int h) {
            var r = new Rect(x, y, w, h)
            if (this.clips.Count > 0) { r.IntersectWith(this.clips[this.clips.Count - 1]) }
            r.TakeTo(this)
            this.clips.Add(r)
            this.renderer.SetClip(r.x, r.y, r.w, r.h)
        }

        undefined PopClip() {
            var last = this.clips.Count - 1
            if (last < 0) { return }
            delete this.clips[last]
            this.clips.RemoveAt(last)
            if (last == 0) { this.renderer.ResetClip() }
            else {
                var r = this.clips[last - 1]
                this.renderer.SetClip(r.x, r.y, r.w, r.h)
            }
        }

        // Shows an element floating at the screen position (x, y) above everything; it belongs to the root from now on. `transient`: destroy
        // on closing (menus). `owner`: the element that opened it (a click on it only closes, does not reopen right away).
        undefined ShowPopup(Element popup, int x, int y, bool transient = true, Element owner = undefined) {
            popup.TakeTo(this)
            popup.Left = x
            popup.Top = y
            popup.transient = transient
            popup.owner = owner
            popup.parent = undefined
            this.popups.Add(popup)
            this.dirty = true
        }

        bool IsPopup(Element popup) {
            for (var i = 0; i < this.popups.Count; i = i + 1) {
                if (this.popups[i] == popup) { return true }
            }
            return false
        }

        undefined ClosePopup(Element popup) {
            for (var i = 0; i < this.popups.Count; i = i + 1) {
                if (this.popups[i] == popup) {
                    this.popups.RemoveAt(i)
                    this.InvalidateRect(popup.ax, popup.ay, popup.actualWidth, popup.actualHeight)
                    if (this.hoverElement == popup) { this.hoverElement = undefined }
                    if (this.pressedElement == popup) { this.pressedElement = undefined }
                    if (this.focusElement == popup) { this.focusElement = undefined }
                    if (popup.transient) { delete popup }
                    return
                }
            }
        }

        // Closes all floating elements (a click next to them, Escape, a chosen menu row).
        undefined CloseAllPopups() {
            while (this.popups.Count > 0) { this.ClosePopup(this.popups[this.popups.Count - 1]) }
        }

        // Shows a menu (list of MenuItem) with its top left corner at (x, y); a chosen row or a click next to it closes it.
        UI.MenuPopup ShowMenu(List items, int x, int y, Element owner = undefined) {
            var menu = new MenuPopup(items)
            this.ShowPopup(menu, x, y, true, owner)
            return menu
        }

        // The element under the mouse pointer: first the floating elements (the topmost first), then the interface.
        UI.Element Hit(int px, int py) {
            var i = this.popups.Count - 1
            while (i >= 0) {
                var hit = this.popups[i].HitTest(px, py)
                if (hit != undefined) { return hit }
                i = i - 1
            }
            return this.content.HitTest(px, py)
        }

        // One cycle: bring the interface up to date (only what has changed is painted), then let the window run one cycle (show, fetch events)
        // and distribute the events. The attached roots (see Attach) do the same cycle. Returns false as soon as the window of this root has been closed.
        bool Tick() {
            var open = this.TickOne()
            var i = 0
            while (i < this.attached.Count) {
                var other = this.attached[i]
                if (!other.TickOne()) {
                    this.attached.RemoveAt(i)
                    continue
                }
                i = i + 1
            }
            return open
        }

        // The interface's part of a cycle of the window's manager (Window.onCycle): distribute the events that came in, bring the interface up to date
        // (only what has changed is painted) and call onTick. The manager then shows the frame.
        undefined Cycle() {
            this.cycles = this.cycles + 1
            this.DispatchEvents()
            if (this.window.IsClosed) { this.closed = true }
            this.JoyRepeat()
            this.Update()
            var callback = this.onTick
            if (callback != undefined) { callback() }
        }

        // Shows the window (Window.Show): on its manager, which gets a thread of its own if nobody runs it yet; the events are handled at the program's safe
        // points. `modal`: returns when the window is closed, the other windows of the manager take no input meanwhile.
        undefined Show(bool modal = false) { this.window.Show(modal) }

        // The cycle of this root only (without the attached ones).
        bool TickOne() {
            this.cycles = this.cycles + 1
            this.JoyRepeat()
            this.Update()
            var open = this.window.Tick()
            this.DispatchEvents()
            if (!open) { this.closed = true }
            var callback = this.onTick
            if (callback != undefined) { callback() }
            return open
        }

        // Attaches a further root (a further window): Tick and Run process it along with it until its window is closed. The window that runs here determines the end
        // of Run; closing an attached window only removes it. The other root (and what owns it) must live as long as its window.
        undefined Attach(Root other) {
            for (var i = 0; i < this.attached.Count; i = i + 1) {
                if (this.attached[i] == other) { return }
            }
            // only one window waits for the screen refresh, otherwise every cycle takes as many frame periods as there are windows
            other.window.VSync = false
            this.attached.Add(other)
            // the window's manager cycles it too (Run, Show)
            if (this.window.Manager == undefined) { WindowManager.Default.Attach(this.window) }
            this.window.Manager.Attach(other.window)
        }

        // Takes the attached root out again (its window stays open, but nobody processes it any more).
        undefined Detach(Root other) {
            for (var i = 0; i < this.attached.Count; i = i + 1) {
                if (this.attached[i] == other) {
                    this.attached.RemoveAt(i)
                    var manager = other.window.Manager
                    if (manager != undefined) { manager.Detach(other.window) }
                    return
                }
            }
        }

        // Distributes the events that came in. Moves of the mouse in a row count as one (the last position): a pointer that is moved fast delivers many
        // of them per cycle, and each one asks the elements below it (hover, cursor) - that would take the time of the program.
        undefined DispatchEvents() {
            bool moved = false
            int mx = 0
            int my = 0
            while (true) {
                var e = this.window.NextEvent()   // (declared in the loop: the event array belongs to this iteration)
                if (e == undefined) { break }
                if (e[0] == 9) {
                    moved = true
                    mx = e[1]
                    my = e[2]
                    continue
                }
                if (moved) {
                    moved = false
                    this.MouseMove(this.ToLogical(mx), this.ToLogical(my))
                }
                this.Dispatch(e)
            }
            if (moved) { this.MouseMove(this.ToLogical(mx), this.ToLogical(my)) }
        }

        // Distributes an event of the window (structure see Window.NextEvent) to the element below it or the one with focus.
        undefined Dispatch(any e) {
            var type = e[0]
            if (type == 8) { this.MouseDown(e[1], this.ToLogical(e[2]), this.ToLogical(e[3])) }
            else if (type == 11) { this.MouseUp(e[1], this.ToLogical(e[2]), this.ToLogical(e[3])) }
            else if (type == 9) { this.MouseMove(this.ToLogical(e[1]), this.ToLogical(e[2])) }
            else if (type == 12) { this.WheelEvent(e[1], e[2], this.ToLogical(e[3]), this.ToLogical(e[4])) }
            else if (type == 24) {
                this.KeyDown(e[1], e[3])
                // a key can change what the pointer means (Escape ends a tool): the pointer follows at once, not with the next move
                this.UpdateCursor(this.mouseX, this.mouseY)
            }
            else if (type == 25) { this.KeyUp(e[1], e[3]) }
            else if (type == 3) { this.TextInput(e[1]) }
            else if (type == 16) { this.TouchDown(e[1], this.ToLogical(e[2]), this.ToLogical(e[3])) }
            else if (type == 17) { this.TouchMove(e[1], this.ToLogical(e[2]), this.ToLogical(e[3])) }
            else if (type == 18) { this.TouchUp(e[1], this.ToLogical(e[2]), this.ToLogical(e[3])) }
            else if (type == 32) { this.JoyAxis(e[2], e[3]) }
            else if (type == 33) { this.JoyButton(e[2]) }
            else if (type == 35) { this.JoyHat(e[3]) }
            else if (type == 37) { this.JoyReset() }
            else if (type == 40 || type == 41) { this.ExternalDrop(e) }
            else if (type == 42) { this.ExternalHover(this.ToLogical(e[1]), this.ToLogical(e[2])) }
            else if (type == 43) { this.ExternalLeave() }
            else if (type == 1) { this.closed = true }
        }

        // Runs until the windows are closed: the window's manager (WindowManager.Default if it has none) runs on this thread (Window.Run). With `other`
        // (a root) it is attached beforehand: `ui.Run(second)` processes both windows.
        undefined Run(Root other = undefined) {
            if (other != undefined) { this.Attach(other) }
            this.window.Run()
        }

        undefined SetFocus(Element element) {
            var old = this.focusElement
            if (old != undefined) { old.Focused = false }
            this.focusElement = element
            if (element != undefined) {
                element.Focused = true
                this.Reveal(element)
            }
        }

        // Makes sure that the element can be seen in every ScrollViewer it lies in (the focus moves by Tab, arrow keys or joystick).
        undefined Reveal(Element element) {
            // (x, y) is the position of the element in the coordinate system of `e`, which changes from the inside out (without the screen position: that is only current after the next drawing)
            var x = 0
            var y = 0
            var e = element
            while (e != undefined) {
                var p = e.parent
                if (p == undefined) { return }
                if (p is of ScrollViewer) {
                    p.ScrollIntoView(x, y, element.actualWidth, element.actualHeight)
                    x = x - p.hbar.offset
                    y = y - p.vbar.offset
                } else {
                    x = x + e.rx
                    y = y + e.ry
                }
                e = p
            }
        }

        // Is this one of the four arrow keys?
        bool IsArrow(int key) {
            return key == UI.Keys.Left() || key == UI.Keys.Right() || key == UI.Keys.Up() || key == UI.Keys.Down()
        }

        // Arrow key: the focus moves to the next focusable element in this direction. If there is none, the ScrollViewer around the element (or under the pointer) is scrolled instead.
        undefined FocusMove(int key) {
            var list = new List()
            this.content.Collect(list)
            var current = this.focusElement
            var found = false
            for (var i = 0; i < list.Count; i = i + 1) {
                if (list[i] == current) { found = true }
            }
            if (list.Count == 0) {
                this.ScrollFrom(current, key)
                return
            }
            if (!found) {
                // nothing focused yet: the first element (downwards/right) or the last (upwards/left)
                if (key == UI.Keys.Up() || key == UI.Keys.Left()) { this.SetFocus(list[list.Count - 1]) } else { this.SetFocus(list[0]) }
                return
            }
            var cx = current.ax + current.actualWidth / 2
            var cy = current.ay + current.actualHeight / 2
            var best = undefined
            var bestScore = -1
            for (var k = 0; k < list.Count; k = k + 1) {
                var c = list[k]
                if (c == current) { continue }
                var dx = c.ax + c.actualWidth / 2 - cx
                var dy = c.ay + c.actualHeight / 2 - cy
                var gap = 0
                var side = 0
                if (key == UI.Keys.Right()) {
                    if (dx <= 0) { continue }
                    gap = UI.M.Max(0, c.ax - (current.ax + current.actualWidth))
                    side = this.Gap(current.ay, current.ay + current.actualHeight, c.ay, c.ay + c.actualHeight)
                } else if (key == UI.Keys.Left()) {
                    if (dx >= 0) { continue }
                    gap = UI.M.Max(0, current.ax - (c.ax + c.actualWidth))
                    side = this.Gap(current.ay, current.ay + current.actualHeight, c.ay, c.ay + c.actualHeight)
                } else if (key == UI.Keys.Down()) {
                    if (dy <= 0) { continue }
                    gap = UI.M.Max(0, c.ay - (current.ay + current.actualHeight))
                    side = this.Gap(current.ax, current.ax + current.actualWidth, c.ax, c.ax + c.actualWidth)
                } else {
                    if (dy >= 0) { continue }
                    gap = UI.M.Max(0, current.ay - (c.ay + c.actualHeight))
                    side = this.Gap(current.ax, current.ax + current.actualWidth, c.ax, c.ax + c.actualWidth)
                }
                // preferably close in the direction and at the same height/width (overlapping), when tied the nearer centre
                var score = (gap + 3 * side) * 1000 + UI.M.Abs(dx) + UI.M.Abs(dy)
                if (bestScore < 0 || score < bestScore) {
                    best = c
                    bestScore = score
                }
            }
            if (best != undefined) { this.SetFocus(best) } else { this.ScrollFrom(current, key) }
        }

        // The distance of two segments [a0, a1) and [b0, b1) (0 if they overlap).
        int Gap(int a0, int a1, int b0, int b1) {
            if (b0 >= a1) { return b0 - a1 }
            if (a0 >= b1) { return a0 - b1 }
            return 0
        }

        // Scrolls (like the mouse wheel) the next ScrollViewer or the list above/around `element` in the direction of the arrow key.
        undefined ScrollFrom(Element element, int key) {
            var dx = 0
            var dy = 0
            if (key == UI.Keys.Up()) { dy = 1 }
            else if (key == UI.Keys.Down()) { dy = -1 }
            else if (key == UI.Keys.Left()) { dx = 1 }
            else if (key == UI.Keys.Right()) { dx = -1 }
            var e = element
            if (e == undefined) { e = this.Hit(this.mouseX, this.mouseY) }
            while (e != undefined) {
                if (e.Enabled && e.MouseWheel(this, dx, dy)) { return }
                e = e.parent
            }
        }

        // ---- Touchscreen ----

        // A finger touches down: like a pressed left mouse button at this place. If it moves no further than `touchSlop`, lifting is a click; if it drags over a list or a ScrollViewer, it becomes a swipe.
        undefined TouchDown(int finger, int px, int py) {
            if (this.touchFinger >= 0) { return }
            this.touchFinger = finger
            this.touchX0 = px
            this.touchY0 = py
            this.touchX = px
            this.touchY = py
            this.touchPanning = false
            this.touchPanner = undefined
            this.MouseMove(px, py)
            this.MouseDown(1, px, py)
        }

        undefined TouchMove(int finger, int px, int py) {
            if (finger != this.touchFinger) { return }
            if (!this.touchPanning) {
                var dx = px - this.touchX0
                var dy = py - this.touchY0
                var moved = UI.M.Abs(dx) > this.touchSlop || UI.M.Abs(dy) > this.touchSlop
                if (moved) {
                    var panner = this.FindPanner()
                    if (panner != undefined) {
                        // the tap becomes a swipe: the pressed button (etc.) is released without clicking
                        var pressed = this.pressedElement
                        this.pressedElement = undefined
                        if (pressed != undefined) { pressed.MouseUp(this, 1, -100000, -100000) }
                        this.touchPanner = panner
                        this.touchPanning = true
                        this.touchX = this.touchX0
                        this.touchY = this.touchY0
                    }
                }
            }
            if (this.touchPanning) {
                this.touchPanner.PanBy(this, px - this.touchX, py - this.touchY)
                this.touchX = px
                this.touchY = py
            } else {
                this.MouseMove(px, py)
            }
        }

        // The element that takes over a swipe: from the pressed element upwards the first that can be moved - unless a handle is currently being dragged (scroll bar).
        UI.Element FindPanner() {
            var e = this.pressedElement
            if (e == undefined) { e = this.Hit(this.touchX0, this.touchY0) }
            while (e != undefined) {
                if (e.Dragging()) { return undefined }
                if (e.Enabled && e.CanPan()) { return e }
                e = e.parent
            }
            return undefined
        }

        undefined TouchUp(int finger, int px, int py) {
            if (finger != this.touchFinger) { return }
            this.touchFinger = -1
            if (this.touchPanning) {
                this.touchPanning = false
                this.touchPanner = undefined
            } else {
                this.MouseUp(1, px, py)
            }
            // a finger leaves no hover highlight
            var old = this.hoverElement
            if (old != undefined) {
                old.Hover = false
                this.hoverElement = undefined
            }
        }

        // ---- Joystick ----

        // An axis moves (-1 to 1): the left stick becomes a direction, with a dead zone in the middle.
        undefined JoyAxis(int axis, any v) {
            if (axis == this.joyAxisX) { this.joyStickX = this.StickDirection(v, this.joyStickX) }
            else if (axis == this.joyAxisY) { this.joyStickY = this.StickDirection(v, this.joyStickY) }
            else { return }
            this.JoyDirectionChanged()
        }

        // -1, 0 or 1: deflected from 0.6 on, back to the middle only below 0.3 (in between it stays as it was).
        int StickDirection(any v, int old) {
            if (v > 0.6) { return 1 }
            if (v < -0.6) { return -1 }
            if (v > -0.3 && v < 0.3) { return 0 }
            return old
        }

        // The D-pad (hat) has a bit mask: 1 up, 2 right, 4 down, 8 left.
        undefined JoyHat(int mask) {
            this.joyHatY = 0
            this.joyHatX = 0
            if (mask % 2 == 1) { this.joyHatY = -1 }
            if ((mask / 4) % 2 == 1) { this.joyHatY = 1 }
            if ((mask / 2) % 2 == 1) { this.joyHatX = 1 }
            if ((mask / 8) % 2 == 1) { this.joyHatX = -1 }
            this.JoyDirectionChanged()
        }

        // From D-pad and stick the arrow key that is currently held (the D-pad first, vertical before horizontal): on a change it is pressed.
        undefined JoyDirectionChanged() {
            var x = this.joyHatX
            if (x == 0) { x = this.joyStickX }
            var y = this.joyHatY
            if (y == 0) { y = this.joyStickY }
            var key = 0
            if (y < 0) { key = UI.Keys.Up() }
            else if (y > 0) { key = UI.Keys.Down() }
            else if (x < 0) { key = UI.Keys.Left() }
            else if (x > 0) { key = UI.Keys.Right() }
            if (key == this.joyKey) { return }
            this.joyKey = key
            this.joyHold = 0
            if (key != 0) { this.KeyDown(key, 0) }
        }

        // Every cycle: a held direction repeats.
        undefined JoyRepeat() {
            if (this.joyKey == 0) { return }
            this.joyHold = this.joyHold + 1
            if (this.joyHold >= this.joyRepeatDelay && (this.joyHold - this.joyRepeatDelay) % this.joyRepeatInterval == 0) { this.KeyDown(this.joyKey, 0) }
        }

        // A joystick button was pressed.
        undefined JoyButton(int button) {
            if (button == this.joyButtonActivate) { this.KeyDown(UI.Keys.Enter(), 0) }
            else if (button == this.joyButtonCancel) { this.KeyDown(UI.Keys.Escape(), 0) }
            else if (button == this.joyButtonPrevious) { this.FocusStep(true) }
            else if (button == this.joyButtonNext) { this.FocusStep(false) }
        }

        // A joystick was unplugged: release held directions.
        undefined JoyReset() {
            this.joyStickX = 0
            this.joyStickY = 0
            this.joyHatX = 0
            this.joyHatY = 0
            this.joyKey = 0
            this.joyHold = 0
        }

        // Tab: the focus moves to the next (with Shift: to the previous) focusable element.
        undefined FocusStep(bool backwards) {
            var list = new List()
            this.content.Collect(list)
            if (list.Count == 0) { return }
            var index = -1
            for (var i = 0; i < list.Count; i = i + 1) {
                if (list[i] == this.focusElement) { index = i }
            }
            if (backwards) {
                index = index - 1
                if (index < 0) { index = list.Count - 1 }
            } else {
                index = index + 1
                if (index >= list.Count) { index = 0 }
            }
            this.SetFocus(list[index])
        }

        // what the wheel moved that is not a whole notch yet (a touchpad gives fractions: they add up)
        float wheelRestX = 0.0
        float wheelRestY = 0.0

        // A wheel event of the window: the distances may be fractions (touchpads, high resolution wheels); whole notches go to MouseWheel.
        undefined WheelEvent(any rawX, any rawY, int px, int py) {
            float x = rawX
            float y = rawY
            this.wheelRestX = this.wheelRestX + x
            this.wheelRestY = this.wheelRestY + y
            var dx = UI.Root.Whole(this.wheelRestX)
            var dy = UI.Root.Whole(this.wheelRestY)
            this.wheelRestX = this.wheelRestX - dx
            this.wheelRestY = this.wheelRestY - dy
            if (dx == 0 && dy == 0) { return }
            this.MouseWheel(dx, dy, px, py)
        }

        // the whole part (towards 0)
        static int Whole(float v) {
            if (v >= 0.0) { return Math.Floor(v)!int }
            return Math.Ceiling(v)!int
        }

        undefined MouseWheel(int dx, int dy, int px, int py) {
            this.mouseX = px
            this.mouseY = py
            var e = this.Hit(px, py)
            while (e != undefined) {
                if (e.Enabled && e.MouseWheel(this, dx, dy)) { return }
                e = e.parent
            }
        }

        undefined MouseDown(int button, int px, int py) {
            this.MouseDownCore(button, px, py)
            this.UpdateCursor(px, py)
        }

        // The time for counting clicks, in milliseconds: from `clock`, otherwise from the cycles (60 per second).
        int ClickTime() {
            var c = this.clock
            if (c != undefined) { return c() }
            return this.cycles * 1000 / 60
        }

        // Counts the press into clickCount: the same button, soon enough and near enough to the one before makes it a double (triple, ...) click.
        undefined CountClick(int button, int px, int py) {
            var now = this.ClickTime()
            var near = UI.M.Abs(px - this.lastClickX) <= this.doubleClickDistance && UI.M.Abs(py - this.lastClickY) <= this.doubleClickDistance
            if (button == this.lastClickButton && near && now - this.lastClickTime <= this.doubleClickTime) { this.clickCount = this.clickCount + 1 }
            else { this.clickCount = 1 }
            this.lastClickButton = button
            this.lastClickX = px
            this.lastClickY = py
            this.lastClickTime = now
        }

        undefined MouseDownCore(int button, int px, int py) {
            this.mouseX = px
            this.mouseY = py
            this.CountClick(button, px, py)
            // a click next to the floating elements: the topmost says whether it closes and whether the click is thereby consumed
            if (this.popups.Count > 0 && !this.InsidePopup(px, py)) {
                var consumed = false
                var i = this.popups.Count - 1
                while (i >= 0 && i < this.popups.Count) {
                    var popup = this.popups[i]
                    if (popup.PopupOutside(this, px, py)) { consumed = true }
                    i = i - 1
                }
                if (consumed) { return }
            }
            var hit = this.Hit(px, py)
            if (button == 3 && hit != undefined) {
                // Context menu: the next element upwards that has one
                var e = hit
                while (e != undefined) {
                    if (e.contextMenu != undefined) {
                        this.ShowMenu(e.contextMenu, px, py, e)
                        return
                    }
                    e = e.parent
                }
            }
            if (hit != undefined && hit.Enabled) {
                if (hit.Focusable()) { this.SetFocus(hit) } else { this.SetFocus(undefined) }
                this.pressedElement = hit
                hit.MouseDown(this, button, px, py)
                // a drag may start from here when the pointer moves on with the button held (see MouseMove)
                if (button == 1) {
                    this.dragFrom = hit
                    this.dragX0 = px
                    this.dragY0 = py
                }
            } else {
                this.SetFocus(undefined)
            }
        }

        // Does the point lie in a floating element?
        bool InsidePopup(int px, int py) {
            for (var i = 0; i < this.popups.Count; i = i + 1) {
                if (this.popups[i].HitTest(px, py) != undefined) { return true }
            }
            return false
        }

        undefined MouseUp(int button, int px, int py) {
            this.MouseUpCore(button, px, py)
            this.UpdateCursor(px, py)
        }

        undefined MouseUpCore(int button, int px, int py) {
            this.mouseX = px
            this.mouseY = py
            this.dragFrom = undefined
            if (this.dragging) {
                if (button == 1) { this.FinishDrag(px, py) }
                return
            }
            var target = this.pressedElement
            this.pressedElement = undefined
            if (target != undefined) { target.MouseUp(this, button, px, py) }
        }

        undefined MouseMove(int px, int py) {
            this.mouseX = px
            this.mouseY = py
            var hit = this.Hit(px, py)
            var old = this.hoverElement
            if (hit != old) {
                if (old != undefined) { old.Hover = false }
                this.hoverElement = hit
                if (hit != undefined) { hit.Hover = true }
            }
            if (this.dragging) {
                if (!this.DragOut(px, py)) {
                    this.DragMove(px, py)
                    this.MoveDragImage(px, py)
                }
                this.UpdateCursor(px, py)
                return
            }
            if (this.dragFrom != undefined && this.pressedElement != undefined && UI.M.Abs(px - this.dragX0) + UI.M.Abs(py - this.dragY0) >= 4) {
                if (this.TryStartDrag()) {
                    if (!this.DragOut(px, py)) {
                        this.DragMove(px, py)
                        this.MoveDragImage(px, py)
                    }
                    this.UpdateCursor(px, py)
                    return
                }
            }
            var target = this.pressedElement
            if (target != undefined) { target.MouseMove(this, px, py) }
            else if (hit != undefined) { hit.Hover(this, px, py) }
            this.UpdateCursor(px, py)
        }

        // ---- drag & drop ----
        // The pointer moved far enough with the button held: the pressed element - or the next one around it - that gives data (DragStart) starts a drag.
        // An element that uses the held button itself (KeepsMouseDrag: a text field selects, a scroll bar is dragged) keeps it.
        bool TryStartDrag() {
            var e = this.dragFrom
            this.dragFrom = undefined
            while (e != undefined) {
                if (e.Enabled) {
                    var data = e.DragStart(this, this.dragX0, this.dragY0)
                    if (data != undefined) {
                        if (data.Source == undefined) { data.Source = e }
                        this.dragData = take data
                        this.dragSource = e
                        this.dragging = true
                        this.PrepareDragImage(e)
                        // the press is over: the element does not get its MouseUp (a button does not click)
                        var pressed = this.pressedElement
                        this.pressedElement = undefined
                        if (pressed != undefined) {
                            pressed.Pressed = false
                            pressed.Invalidate()
                        }
                        return true
                    }
                }
                if (e.Dragging() || e.KeepsMouseDrag()) { return false }
                e = e.parent
            }
            return false
        }

        // The element under the point that takes drops (AllowDrop), or undefined.
        UI.Element DropTargetAt(int px, int py) {
            var target = this.Hit(px, py)
            while (target != undefined && !(target.Enabled && target.AcceptsDrops())) { target = target.parent }
            return target
        }

        // The pointer moves during a drag: the target under it says what a drop would do (outside the window: nothing takes it).
        undefined DragMove(int px, int py) {
            UI.Element target = undefined
            if (this.Inside(px, py)) { target = this.DropTargetAt(px, py) }
            var old = this.dragTarget
            if (old != undefined && old != target) { old.DragLeave(this) }
            this.dragTarget = target
            if (target == undefined) { this.dragEffect = UI.DropEffect.None }
            else { this.dragEffect = target.DragOver(this, this.dragData, px, py) }
        }

        // The pointer left the window during a drag (SDL keeps reporting the mouse while the button is held): when the data is something other programs can
        // take (Text or Files) and may leave (AllowExternal), the drag goes on in the desktop (Window.StartDrag) - the target it was over is left, the program
        // waits until the user lets go, and the source hears in OnDragDone what the other program did (None, Copy or Move). False: the drag stays inside.
        // Where the desktop cannot take a drag (Window.CanStartDrag: Wayland, macOS, no desktop) it stays inside as well: the user can come back into the window.
        bool DragOut(int px, int py) {
            if (this.Inside(px, py)) { return false }
            var data = this.dragData
            if (data == undefined || !data.AllowExternal || (!data.HasText && !data.HasFiles)) { return false }
            if (this.window == undefined || this.touchFinger >= 0) { return false }
            if (!this.window.CanStartDrag()) { return false }
            var target = this.dragTarget
            this.dragTarget = undefined
            this.dragEffect = UI.DropEffect.None
            if (target != undefined) { target.DragLeave(this) }
            var r = this.window.StartDrag(data.Text, data.Files)
            var effect = UI.DropEffect.None
            if (r == 1) { effect = UI.DropEffect.Copy }
            else if (r == 2) { effect = UI.DropEffect.Move }
            this.EndDrag(effect)
            return true
        }

        // The button was let go: the target takes the data (if it wants it), the source hears how it ended.
        undefined FinishDrag(int px, int py) {
            this.DragMove(px, py)
            var effect = UI.DropEffect.None
            var target = this.dragTarget
            if (target != undefined && this.dragEffect != UI.DropEffect.None) { effect = target.Drop(this, this.dragData, px, py) }
            this.EndDrag(effect)
        }

        // Cancels a drag (Escape): the target is left, the source hears None.
        undefined CancelDrag() {
            var target = this.dragTarget
            if (target != undefined) { target.DragLeave(this) }
            this.EndDrag(UI.DropEffect.None)
        }

        undefined EndDrag(UI.DropEffect effect) {
            var source = this.dragSource
            var data = this.dragData
            this.dragging = false
            this.dragTarget = undefined
            this.dragSource = undefined
            this.dragEffect = UI.DropEffect.None
            this.dragImageW = 0
            this.ReleaseDragImage()
            if (source != undefined) { source.DragDone(this, data, effect) }
            this.dragData = undefined
            this.Invalidate()
        }

        // Is a drag going on?
        bool IsDragging { get { return this.dragging } }

        // Is the point inside the window?
        bool Inside(int px, int py) { return px >= 0 && py >= 0 && px < this.width && py < this.height }

        // Something of another program is dragged over the window (an event DragHover): the element under it that takes drops hears OnDragOver with a DragData whose
        // content is not known yet (Pending, External); the element it leaves hears OnDragLeave.
        undefined ExternalHover(int px, int py) {
            this.mouseX = px
            this.mouseY = py
            var target = this.DropTargetAt(px, py)
            var old = this.hoverTarget
            if (old != undefined && old != target) { old.DragLeave(this) }
            this.hoverTarget = target
            if (target == undefined) { return }
            if (this.hoverData == undefined) {
                var data = new UI.DragData()
                data.Pending = true
                this.hoverData = take data
            }
            target.DragOver(this, this.hoverData, px, py)
        }

        // It left the window without being dropped (DragLeave): the element under it hears OnDragLeave.
        undefined ExternalLeave() {
            var old = this.hoverTarget
            this.hoverTarget = undefined
            this.hoverData = undefined
            if (old != undefined) { old.DragLeave(this) }
        }

        // ---- the drag image: a small label at the pointer while a drag goes on (DragData.ShowImage = false switches it off) ----

        // What the label shows: the text (one line, at most 30 characters), the name of the file or "n files", else the kind of the data; "" shows nothing.
        string DragImageText(UI.DragData data) {
            if (data == undefined || !data.ShowImage) { return "" }
            if (data.HasText) {
                var text = data.Text.Replace("\r\n", " ").Replace("\n", " ").Replace("\r", " ").Replace("\t", " ")
                if (text.Length > 30) { text = text.Substring(0, 29) + "..." }
                return text
            }
            if (data.HasFiles) {
                if (data.Files.Count > 1) { return data.Files.Count + " files" }
                var path = data.Files[0]
                var cut = UI.M.Max(path.LastIndexOf("/"), path.LastIndexOf("\\"))
                if (cut >= 0 && cut < path.Length - 1) { path = path.Substring(cut + 1) }
                if (path.Length > 30) { path = path.Substring(0, 29) + "..." }
                return path
            }
            return data.Kind
        }

        // The picture at the pointer when a drag begins: the source's own (DragData.Image), else a snapshot of the source element - what the window shows of it,
        // at most 240 x 160 around the press, made see-through (alpha 150) - where the element allows it (DragSnapshot; not a text field, a list, a tree) and
        // DragData.Snapshot is on; else none (the label).
        undefined PrepareDragImage(Element source) {
            this.ReleaseDragImage()
            var data = this.dragData
            if (data == undefined || !data.ShowImage) { return }
            var image = data.Image
            if (image != undefined) {
                this.dragPicture = image
                this.dragPicX = data.ImageX
                this.dragPicY = data.ImageY
                this.dragPicW = this.renderer.Logical(image.Width())
                this.dragPicH = this.renderer.Logical(image.Height())
                return
            }
            if (!data.Snapshot || source == undefined || !source.DragSnapshot() || this.framebuffer.Mode() != 0) { return }
            var x0 = UI.M.Max(0, source.ax)
            var y0 = UI.M.Max(0, source.ay)
            var x1 = UI.M.Min(this.width, source.ax + source.actualWidth)
            var y1 = UI.M.Min(this.height, source.ay + source.actualHeight)
            if (x1 - x0 > 240) {
                x0 = UI.M.Clamp(this.dragX0 - 120, x0, x1 - 240)
                x1 = x0 + 240
            }
            if (y1 - y0 > 160) {
                y0 = UI.M.Clamp(this.dragY0 - 80, y0, y1 - 160)
                y1 = y0 + 160
            }
            var r = this.renderer
            var sx = r.Px(x0)
            var sy = r.Px(y0)
            var sw = UI.M.Min(r.Px(x1), this.framebuffer.Width()) - sx
            var sh = UI.M.Min(r.Px(y1), this.framebuffer.Height()) - sy
            if (sw <= 0 || sh <= 0) { return }
            var shot = new Framebuffer(sw, sh)
            var painter = new Renderer(shot)
            painter.AlphaBlending = false
            painter.BlitRegion(this.framebuffer, sx, sy, sw, sh, 0, 0)
            var bytes = shot.ReadBytes()
            for (var i = 3; i < bytes.length; i = i + 4) { bytes[i] = 150 }
            shot.WriteBytes(bytes)
            this.dragSnapshot = take shot
            this.dragPicture = this.dragSnapshot
            this.dragPicX = x0 - this.dragX0
            this.dragPicY = y0 - this.dragY0
            this.dragPicW = x1 - x0
            this.dragPicH = y1 - y0
        }

        undefined ReleaseDragImage() {
            this.dragPicture = undefined
            if (this.dragSnapshot != undefined) {
                delete this.dragSnapshot
                this.dragSnapshot = undefined
            }
        }

        // The label (or the picture) follows the pointer (px, py): only its old and its new place are repainted.
        undefined MoveDragImage(int px, int py) {
            if (this.dragImageW > 0) { this.InvalidateRect(this.dragImageX, this.dragImageY, this.dragImageW, this.dragImageH) }
            if (this.dragPicture != undefined) {
                // (a pointer outside the window: the picture stays at its edge)
                var cx = UI.M.Clamp(px, 0, this.width - 1)
                var cy = UI.M.Clamp(py, 0, this.height - 1)
                this.dragImageX = cx + this.dragPicX
                this.dragImageY = cy + this.dragPicY
                this.dragImageW = this.dragPicW
                this.dragImageH = this.dragPicH
                this.InvalidateRect(this.dragImageX, this.dragImageY, this.dragImageW, this.dragImageH)
                return
            }
            var text = this.DragImageText(this.dragData)
            if (text == "") {
                this.dragImageW = 0
                return
            }
            var font = this.FontFor(this.theme.font)
            var w = this.renderer.TextWidth(text, font, this.theme.fontSize) + 8
            var h = this.renderer.TextHeight(font, this.theme.fontSize) + 6
            // below and to the right of the pointer, inside the window
            var x = px + 12
            var y = py + 16
            if (x + w > this.width) { x = UI.M.Max(0, this.width - w) }
            if (y + h > this.height) { y = UI.M.Max(0, py - h - 4) }
            this.dragImageX = x
            this.dragImageY = y
            this.dragImageW = w
            this.dragImageH = h
            this.InvalidateRect(x, y, w, h)
        }

        // Paints the label (after the floating elements: it lies above everything).
        undefined DrawDragImage() {
            if (!this.dragging || this.dragImageW <= 0) { return }
            if (!this.Needs(this.dragImageX, this.dragImageY, this.dragImageW, this.dragImageH)) { return }
            var picture = this.dragPicture
            if (picture != undefined) {
                // blended: the snapshot is see-through
                this.renderer.BlitScaled(picture, 0, 0, picture.Width(), picture.Height(), this.dragImageX, this.dragImageY, this.dragImageW, this.dragImageH, 2)
                return
            }
            var text = this.DragImageText(this.dragData)
            if (text == "") { return }
            var font = this.FontFor(this.theme.font)
            this.renderer.FillRect(this.dragImageX, this.dragImageY, this.dragImageW, this.dragImageH, this.theme.menuBack)
            this.renderer.DrawRect(this.dragImageX, this.dragImageY, this.dragImageW, this.dragImageH, this.theme.border)
            this.renderer.DrawText(this.dragImageX + 4, this.dragImageY + 3, text, this.theme.text, undefined, font, this.theme.fontSize)
        }

        // Something another program dropped onto the window (an event DropFiles/DropText): the element under it that takes drops gets it, else onDrop.
        undefined ExternalDrop(any e) {
            var data = new UI.DragData()
            if (e[0] == 40) { foreach (f in e[1]) { data.Files.Add(f) } }
            else { data.Text = e[1] }
            var px = this.ToLogical(e[2])
            var py = this.ToLogical(e[3])
            this.mouseX = px
            this.mouseY = py
            var target = this.DropTargetAt(px, py)
            // the hover ends with the drop: an element it was over that does not get the drop is left
            var hovered = this.hoverTarget
            this.hoverTarget = undefined
            this.hoverData = undefined
            if (hovered != undefined && hovered != target) { hovered.DragLeave(this) }
            if (target != undefined && target.DragOver(this, data, px, py) != UI.DropEffect.None) {
                target.Drop(this, data, px, py)
                this.Invalidate()
                return
            }
            var fallback = this.onDrop
            if (fallback != undefined) { fallback(data, px, py) }
            this.Invalidate()
        }

        // the cursor the window shows now (Inherit: not set yet)
        UI.Cursor shownCursor = UI.Cursor.Inherit

        /// <summary>The mouse pointer at (px, py): the element that holds the mouse, else the one below it, asks itself and the elements around it (CursorAt).</summary>
        UI.Cursor CursorFor(int px, int py) {
            // a drag: a hand over a target that takes it, "not allowed" elsewhere
            if (this.dragging) {
                if (this.dragEffect == UI.DropEffect.None) { return UI.Cursor.No }
                return UI.Cursor.Hand
            }
            Element e = this.pressedElement
            if (e == undefined) { e = this.Hit(px, py) }
            while (e != undefined) {
                var c = e.CursorAt(this, px, py)
                if (c >= 0) { return c }
                e = e.parent
            }
            return UI.Cursor.Arrow
        }

        undefined UpdateCursor(int px, int py) {
            var c = this.CursorFor(px, py)
            if (c == this.shownCursor) { return }
            this.shownCursor = c
            if (this.window != undefined) { this.window.Cursor = c!int }
        }

        undefined KeyDown(int key, int mod) {
            this.modifiers = mod
            if (this.dragging) {
                if (key == UI.Keys.Escape()) { this.CancelDrag() }
                else {
                    // Ctrl pressed or let go during a drag: the target says anew what a drop would do (copy or move)
                    this.DragMove(this.mouseX, this.mouseY)
                }
                return
            }
            var preview = this.onKeyPreview
            if (preview != undefined && preview(key, mod) == true) { return }
            if (key == UI.Keys.Tab()) {
                // an element that takes Tab itself (a TextArea with AcceptsTab) gets it without Shift and Ctrl; those still move the focus
                var holder = this.focusElement
                if (holder != undefined && holder.Enabled && !UI.Keys.Shift(mod) && !UI.Keys.Shortcut(mod) && holder.TakesTab()) {
                    holder.KeyDown(this, key, mod)
                    return
                }
                // the shift keys are bits 1 and 2 of mod
                this.FocusStep(mod % 4 != 0)
                return
            }
            // a menu or a list that wants keys gets them first
            if (this.popups.Count > 0) {
                var top = this.popups[this.popups.Count - 1]
                if (top.grabsKeys) {
                    top.KeyDown(this, key, mod)
                    return
                }
            }
            var target = this.focusElement
            // an arrow key that the focused element does not need itself moves the focus
            if (this.IsArrow(key) && (target == undefined || !target.Enabled || !target.WantsKey(key))) {
                this.FocusMove(key)
                return
            }
            if (target != undefined && target.Enabled) { target.KeyDown(this, key, mod) }
        }

        // A key was let go: only the modifier keys matter (see KeyDown).
        undefined KeyUp(int key, int mod) {
            this.modifiers = mod
            if (this.dragging) {
                this.DragMove(this.mouseX, this.mouseY)
                this.UpdateCursor(this.mouseX, this.mouseY)
            }
        }

        undefined TextInput(string text) {
            var target = this.focusElement
            if (target != undefined && target.Enabled) { target.TextInput(this, text) }
        }
    }
}
