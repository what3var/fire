namespace UI {
    class Label : Element {
        string Text
        // Text colour: undefined = `foreground`, then the brush `text` of the theme
        Brush Color

        construct(string text, defined int x = 0, defined int y = 0) : base(x, y, -1, -1) {
            this.Text = text
        }

        override undefined MeasureCore(Root root, defined int aw, defined int ah) {
            this.cw = this.TextWidth(root, this.Text)
            this.ch = this.TextHeight(root)
        }

        override string StyleKey() { return "Label" }

        override undefined Draw(Root root, defined int ax, defined int ay) {
            if (!this.NeedsDraw(root, ax, ay)) { return }
            if (this.DrawTemplate(root, ax, ay)) { return }
            var c = this.Color
            if (c == undefined) { c = this.Foreground }
            if (c == undefined) { c = root.theme.text }
            if (!this.Enabled) { c = root.theme.textDisabled }
            this.DrawString(root, ax, ay, this.Text, c)
        }
    }

    // A button: its text and/or a symbol in front of it - `icon` (a UI.Geometry, a vector shape such as UI.Icons.Up(), drawn in the colour of the text) or
    // `image` (a Framebuffer, such as Framebuffer.FromResource(new Resource("icons/home.png"))), each `iconSize` pixels big.
    class Button : Element {
        string Text
        lambda OnClick
        bool clicked = false
        UI.Geometry Icon
        Framebuffer Image
        defined int IconSize = 16

        construct(string text, defined int x = 0, defined int y = 0, defined int width = 90, defined int height = 26) : base(x, y, width, height) {
            this.Text = text
        }

        override bool Focusable() { return true }

        override string StyleKey() { return "Button" }

        // Without a fixed size (width/height = -1) as big as the symbol and the text plus margin
        override undefined MeasureCore(Root root, defined int aw, defined int ah) {
            this.cw = this.ContentWidth(root) + 24
            this.ch = UI.M.Max(this.TextHeight(root), this.HasSymbol() ? this.IconSize : 0) + 12
        }

        bool HasSymbol() { return this.Icon != undefined || this.Image != undefined }

        // symbol, gap, text
        defined int ContentWidth(Root root) {
            var w = 0
            if (this.HasSymbol()) { w = this.IconSize }
            if (this.Text != undefined && this.Text != "") {
                if (w > 0) { w = w + 6 }
                w = w + this.TextWidth(root, this.Text)
            }
            return w
        }

        // Draws the symbol into the square (x, y, size): the picture scaled to fit, the geometry scaled to fit and filled (closed figures) or drawn (open ones) with `brush`.
        undefined DrawSymbol(Root root, defined int x, defined int y, Brush brush) {
            var size = this.IconSize
            var picture = this.Image
            if (picture != undefined) {
                var sw = picture.Width()
                var sh = picture.Height()
                if (sw > 0 && sh > 0) {
                    var dw = size
                    var dh = sh * size / sw
                    if (dh > size) {
                        dh = size
                        dw = sw * size / sh
                    }
                    root.renderer.BlitScaled(picture, 0, 0, sw, sh, x + (size - dw) / 2, y + (size - dh) / 2, UI.M.Max(1, dw), UI.M.Max(1, dh), 2)
                }
                return
            }
            var g = this.Icon
            if (g == undefined) { return }
            var box = UI.M.Max(g.Width(), g.Height()) + 1
            var scale = size * 1.0 / box
            var pen = new Pen(__GRPHBshGetColor(brush.id), UI.M.Max(1, size / 8))
            for (var i = 0; i < g.figures.Count; i = i + 1) {
                any f = g.figures[i]
                if (f.Count() < 2) { continue }
                var pts = new float[f.points.Count]
                for (var k = 0; k < f.points.Count; k = k + 2) {
                    pts[k] = x + f.points[k] * scale
                    pts[k + 1] = y + f.points[k + 1] * scale
                }
                if (f.closed && f.Count() >= 3) { root.renderer.FillPolygon(pts, brush) }
                else { root.renderer.DrawPath(pts, pen, f.closed) }
            }
        }

        // Has the button been clicked since the last query? (resets the flag)
        bool TakeClicked() {
            var was = this.clicked
            this.clicked = false
            return was
        }

        undefined Click() {
            this.clicked = true
            var callback = this.OnClick
            if (callback != undefined) { callback() }
        }

        override undefined Draw(Root root, defined int ax, defined int ay) {
            if (!this.NeedsDraw(root, ax, ay)) { return }
            if (this.DrawTemplate(root, ax, ay)) { return }
            var theme = root.theme
            var face = theme.face
            if (!this.Enabled) { face = theme.faceDisabled }
            else if (this.Background != undefined) { face = this.Background }
            else if (this.Pressed && this.Hover) { face = theme.facePressed }
            else if (this.Hover) { face = theme.faceHover }
            var border = theme.border
            if (this.Pen != undefined) { border = this.Pen }
            if (this.Focused) { border = theme.borderFocus }
            root.Box(ax, ay, this.actualWidth, this.actualHeight, face, border)

            var color = theme.text
            if (this.Foreground != undefined) { color = this.Foreground }
            if (!this.Enabled) { color = theme.textDisabled }
            var tx = ax + (this.actualWidth - this.ContentWidth(root)) / 2
            if (this.HasSymbol()) {
                this.DrawSymbol(root, tx, ay + (this.actualHeight - this.IconSize) / 2, color)
                tx = tx + this.IconSize + 6
            }
            if (this.Text != undefined && this.Text != "") {
                var ty = ay + (this.actualHeight - this.TextHeight(root)) / 2
                this.DrawString(root, tx, ty, this.Text, color)
            }
        }

        override undefined MouseDown(Root root, defined int button, defined int px, defined int py) {
            if (button == 1) { this.Pressed = true }
        }

        override undefined MouseUp(Root root, defined int button, defined int px, defined int py) {
            var was = this.Pressed
            this.Pressed = false
            if (was && button == 1 && this.Contains(px, py)) { this.Click() }
        }

        override undefined KeyDown(Root root, defined int key, defined int mod) {
            if (key == UI.Keys.Enter() || key == UI.Keys.Space()) { this.Click() }
        }
    }

    class CheckBox : Element {
        string Text
        bool IsChecked = false
        lambda OnChange
        bool changed = false

        construct(string text, defined int x = 0, defined int y = 0, bool isChecked = false) : base(x, y, -1, -1) {
            this.Text = text
            this.IsChecked = isChecked
        }

        override bool Focusable() { return true }

        override string StyleKey() { return "CheckBox" }

        // Has the state changed since the last query? (resets the flag)
        bool TakeChanged() {
            var was = this.changed
            this.changed = false
            return was
        }

        undefined Toggle() {
            this.IsChecked = !this.IsChecked
            this.changed = true
            var callback = this.OnChange
            if (callback != undefined) { callback() }
        }

        // the box, 6 pixels of spacing, the text
        override undefined MeasureCore(Root root, defined int aw, defined int ah) {
            this.cw = 14 + 6 + this.TextWidth(root, this.Text)
            this.ch = UI.M.Max(this.TextHeight(root), 14)
        }

        override undefined Draw(Root root, defined int ax, defined int ay) {
            var box = 14
            if (!this.NeedsDraw(root, ax, ay)) { return }
            if (this.DrawTemplate(root, ax, ay)) { return }

            var theme = root.theme
            var by = ay + (this.actualHeight - box) / 2
            var back = theme.inputBack
            if (!this.Enabled) { back = theme.faceDisabled }
            else if (this.Background != undefined) { back = this.Background }
            else if (this.Hover) { back = theme.faceHover }
            var border = theme.border
            if (this.Pen != undefined) { border = this.Pen }
            if (this.Focused) { border = theme.borderFocus }
            var corner = UI.M.Min(theme.radius, 3)
            root.Box(ax, by, box, box, back, border, corner)
            if (this.IsChecked) {
                var mark = theme.accent
                if (!this.Enabled) { mark = theme.textDisabled }
                root.Box(ax + 3, by + 3, box - 6, box - 6, mark, undefined, UI.M.Min(corner, 2))
            }
            var color = theme.text
            if (this.Foreground != undefined) { color = this.Foreground }
            if (!this.Enabled) { color = theme.textDisabled }
            this.DrawString(root, ax + box + 6, ay + (this.actualHeight - this.TextHeight(root)) / 2, this.Text, color)
        }

        override undefined MouseDown(Root root, defined int button, defined int px, defined int py) {
            if (button == 1) { this.Pressed = true }
        }

        override undefined MouseUp(Root root, defined int button, defined int px, defined int py) {
            var was = this.Pressed
            this.Pressed = false
            if (was && button == 1 && this.Contains(px, py)) { this.Toggle() }
        }

        override undefined KeyDown(Root root, defined int key, defined int mod) {
            if (key == UI.Keys.Space() || key == UI.Keys.Enter()) { this.Toggle() }
        }
    }

    // One step of the undo history of a text field: at `start` the text `removed` was replaced by `inserted`; where the caret and the other end of the
    // selection were before and after. `kind`: 1 typing, 2 deleting single characters (Backspace/Delete), 0 anything else (never merged with a step around it).
    class TextEdit {
        defined int start
        string removed
        string inserted
        defined int caretBefore
        defined int anchorBefore
        defined int caretAfter = 0
        defined int anchorAfter = -1
        defined int kind
        defined int time

        construct(defined int start, string removed, string inserted, defined int caretBefore, defined int anchorBefore, defined int kind, defined int time) {
            this.start = start
            this.removed = removed
            this.inserted = inserted
            this.caretBefore = caretBefore
            this.anchorBefore = anchorBefore
            this.kind = kind
            this.time = time
        }
    }

    // The undo history of a TextBox/TextArea: the steps [0, done) can be undone (the last one first), the steps [done, Count) redone. Typing goes into the step
    // before it while it goes on at its end, within `pause` milliseconds, and no new word begins (a space typed before it); deleting single characters likewise.
    // `text` is the text after the last step: a field whose Text is something else was set by the program - the history no longer fits and is cleared.
    class TextHistory {
        List steps
        defined int done = 0
        string text = ""
        // the next step starts anew (after Undo/Redo)
        bool sealed = false
        defined int pause = 1000

        construct(string text) {
            this.steps = new List()
            this.text = text
        }

        bool CanUndo { get { return this.done > 0 } }
        bool CanRedo { get { return this.done < this.steps.Count } }

        undefined Clear() {
            for (var i = 0; i < this.steps.Count; i = i + 1) { delete this.steps[i] }
            this.steps.Clear()
            this.done = 0
            this.sealed = false
        }

        // The field's text now: anything else than after the last step clears the history (the program set Text).
        undefined Check(string current) {
            if (current == this.text) { return }
            this.Clear()
            // (the old value stays referenced by a local until the field has the new one)
            var previous = this.text
            this.text = current
        }

        static bool IsSpace(string s, defined int index) {
            any code = s.CharAt(index).ToInt()
            return code == 32 || code == 9 || code == 10
        }

        // Records an edit (the field has just made it; `after` is its text now) and keeps at most `limit` steps (0: none at all).
        undefined Record(defined int start, string removed, string inserted, defined int caretBefore, defined int anchorBefore, defined int caretAfter, defined int anchorAfter, defined int kind, defined int now, defined int limit, string after) {
            // what was undone is gone for good
            while (this.steps.Count > this.done) {
                var last = this.steps.Count - 1
                delete this.steps[last]
                this.steps.RemoveAt(last)
            }
            var previous = this.text
            this.text = after
            if (limit <= 0) {
                this.Clear()
                return
            }
            if (kind != 0 && this.done > 0 && !this.sealed) {
                any step = this.steps[this.done - 1]
                if (step.kind == kind && now - step.time <= this.pause) {
                    if (kind == 1 && removed == "" && start == step.start + step.inserted.Length &&
                        !(step.inserted.Length > 0 && UI.TextHistory.IsSpace(step.inserted, step.inserted.Length - 1) && inserted.Length > 0 && !UI.TextHistory.IsSpace(inserted, 0))) {
                        step.inserted = step.inserted + inserted
                        step.caretAfter = caretAfter
                        step.anchorAfter = anchorAfter
                        step.time = now
                        return
                    }
                    if (kind == 2 && inserted == "" && step.inserted == "") {
                        var merged = false
                        if (start + removed.Length == step.start) {
                            // Backspace: the removed text grows to the front
                            step.start = start
                            step.removed = removed + step.removed
                            merged = true
                        } else if (start == step.start) {
                            // Delete: it grows to the back
                            step.removed = step.removed + removed
                            merged = true
                        }
                        if (merged) {
                            step.caretAfter = caretAfter
                            step.anchorAfter = anchorAfter
                            step.time = now
                            return
                        }
                    }
                }
            }
            var edit = new UI.TextEdit(start, removed, inserted, caretBefore, anchorBefore, kind, now)
            edit.caretAfter = caretAfter
            edit.anchorAfter = anchorAfter
            this.steps.Add(take edit)
            this.done = this.steps.Count
            this.sealed = false
            while (this.steps.Count > limit) {
                delete this.steps[0]
                this.steps.RemoveAt(0)
                this.done = this.done - 1
            }
        }

        // The caret and selection after the last step (a drop selects what it inserted).
        undefined SetAfter(defined int caret, defined int anchor) {
            if (this.done == 0) { return }
            any step = this.steps[this.done - 1]
            step.caretAfter = caret
            step.anchorAfter = anchor
        }

        // The step that Undo takes back (undefined: none) - the history counts it as undone; the field puts `removed` back and sets `text` afterwards.
        UI.TextEdit TakeUndo() {
            if (this.done == 0) { return undefined }
            this.done = this.done - 1
            this.sealed = true
            return this.steps[this.done]
        }
        UI.TextEdit TakeRedo() {
            if (this.done >= this.steps.Count) { return undefined }
            this.done = this.done + 1
            this.sealed = true
            return this.steps[this.done - 1]
        }
        undefined Applied(string after) {
            var previous = this.text
            this.text = after
        }
    }

    // Single-line text field with caret (arrow keys, Home/End, Backspace/Del, mouse click). Enter triggers `onEnter`
    // or `TakeEntered()`, every change of the text `onChange`/`TakeChanged()`.
    class TextBox : Element {
        string Text
        defined int caret = 0
        // the other end of the selection (-1 or equal to caret: nothing is selected); the selection is the text between it and the caret
        defined int anchor = -1
        defined int scroll = 0
        defined int MaxLength = 0
        // the user can select and copy, but not change the text (the program still can)
        bool ReadOnly = false
        lambda OnChange
        lambda OnEnter
        bool changed = false
        bool entered = false
        // what dragging with the held button selects (1 characters, 2 words after a double click, 3 everything after a triple click) and the word of the double click
        defined int selectMode = 1
        defined int wordStart = 0
        defined int wordEnd = 0
        // Undo/Redo (Ctrl+Z, Ctrl+Y / Ctrl+Shift+Z): at most UndoLimit steps (0: no history)
        UI.TextHistory history
        defined int UndoLimit = 100
        // what the next ReplaceSelection is for the history: 1 typing, 2 deleting a character, 0 anything else
        defined int pendingKind = 0
        // dragging the selection: the press was inside it (a click without moving puts the caret at pressColumn), the drag came from here (its text started at
        // dragFrom), a drop into this field moved it already; where a drop would go (the drop caret, -1: none)
        bool pressInSelection = false
        defined int pressColumn = 0
        bool dragOwn = false
        defined int dragFrom = 0
        bool dragMovedHere = false
        defined int dropPos = -1

        construct(string text, defined int x = 0, defined int y = 0, defined int width = 160, defined int height = 24) : base(x, y, width, height) {
            this.cursor = UI.Cursor.IBeam
            this.Text = text
            this.caret = text.Length
            this.history = new UI.TextHistory(text)
            // text and files can be dropped into the field (Drop); AllowDrop = false switches it off
            this.AllowDrop = true
        }

        override bool Focusable() { return true }

        override string StyleKey() { return "TextBox" }

        bool TakeChanged() {
            var was = this.changed
            this.changed = false
            return was
        }

        bool TakeEntered() {
            var was = this.entered
            this.entered = false
            return was
        }

        undefined SetText(string value) {
            // (a local holds the old text until the field has the new one: a native program compares the two after the assignment, see ReplaceSelection)
            var previous = this.Text
            this.Text = value
            this.caret = value.Length
            this.anchor = -1
            this.scroll = 0
            this.ClearUndo()
        }

        // ---- Undo/Redo: typing makes one step per word (or until a pause of a second), deleting single characters likewise; pasting, cutting, deleting a
        // selection and drops are steps of their own. Setting Text (or SetText) from the program clears the history. ReadOnly: nothing is undone. ----
        bool CanUndo {
            get {
                this.history.Check(this.Text)
                return !this.ReadOnly && this.history.CanUndo
            }
        }
        bool CanRedo {
            get {
                this.history.Check(this.Text)
                return !this.ReadOnly && this.history.CanRedo
            }
        }
        undefined ClearUndo() {
            this.history.Clear()
            this.history.Applied(this.Text)
        }
        // Takes the last step back (the caret and the selection as they were before it); false: nothing to undo.
        bool Undo() {
            if (!this.CanUndo) { return false }
            var step = this.history.TakeUndo()
            this.Apply(step.start, step.inserted.Length, step.removed, step.caretBefore, step.anchorBefore)
            return true
        }
        bool Redo() {
            if (!this.CanRedo) { return false }
            var step = this.history.TakeRedo()
            this.Apply(step.start, step.removed.Length, step.inserted, step.caretAfter, step.anchorAfter)
            return true
        }
        undefined Apply(defined int start, defined int count, string value, defined int caret, defined int anchor) {
            var before = this.Text
            this.Text = before.Substring(0, start) + value + before.Substring(start + count)
            this.caret = caret
            this.anchor = anchor
            this.history.Applied(this.Text)
            this.Changed()
        }

        // Replaces `count` characters from `start` by `value` (no MaxLength check here) and records it for Undo; the caret goes behind it.
        undefined EditText(defined int start, defined int count, string value, defined int kind) {
            this.history.Check(this.Text)
            var before = this.Text
            any removed = before.Substring(start, count)
            var caretBefore = this.caret
            var anchorBefore = this.anchor
            if (anchorBefore == caretBefore) { anchorBefore = -1 }
            this.Text = before.Substring(0, start) + value + before.Substring(start + count)
            this.caret = start + value.Length
            this.anchor = -1
            var now = 0
            if (this.host != undefined) { now = this.host.ClickTime() }
            this.history.Record(start, removed, value, caretBefore, anchorBefore, this.caret, -1, kind, now, this.UndoLimit, this.Text)
            this.Changed()
        }

        undefined Changed() {
            this.changed = true
            var callback = this.OnChange
            if (callback != undefined) { callback() }
        }

        // ---- the selection ----
        // (caret and anchor inside the text, also after Text was set from outside)
        undefined Clamp() {
            var length = this.Text.Length
            if (this.caret > length) { this.caret = length }
            if (this.caret < 0) { this.caret = 0 }
            if (this.anchor > length) { this.anchor = length }
        }
        bool HasSelection() {
            this.Clamp()
            return this.anchor >= 0 && this.anchor != this.caret
        }
        // Where the selection starts and how long it is (0: nothing is selected; the start is then the caret).
        defined int SelectionStart {
            get {
                if (!this.HasSelection()) { return this.caret }
                return UI.M.Min(this.anchor, this.caret)
            }
        }
        defined int SelectionLength {
            get {
                if (!this.HasSelection()) { return 0 }
                return UI.M.Abs(this.caret - this.anchor)
            }
        }
        string SelectedText { get { return this.Text.Substring(this.SelectionStart, this.SelectionLength) } }

        // Selects `length` characters from `start` (the caret goes to the end).
        undefined Select(defined int start, defined int length) {
            var total = this.Text.Length
            start = UI.M.Clamp(start, 0, total)
            length = UI.M.Clamp(length, 0, total - start)
            this.anchor = start
            this.caret = start + length
        }
        undefined SelectAll() { this.Select(0, this.Text.Length) }

        // Replaces the selection (or inserts at the caret) with `value`; MaxLength cuts what does not fit. The caret goes behind it.
        undefined ReplaceSelection(string value) {
            this.Clamp()
            var start = this.SelectionStart
            var count = this.SelectionLength
            var rest = this.Text.Length - count
            if (this.MaxLength > 0 && rest + value.Length > this.MaxLength) {
                var room = this.MaxLength - rest
                if (room < 0) { room = 0 }
                value = value.Substring(0, room)
            }
            var kind = this.pendingKind
            this.pendingKind = 0
            if (value == "" && count == 0) { return }
            this.EditText(start, count, value, kind)
        }

        // The clipboard: Copy and Cut put the selection there, Paste puts its text in (line breaks become spaces: the field has one line).
        undefined Copy() { if (this.HasSelection()) { Clipboard.SetText(this.SelectedText) } }
        undefined Cut() {
            if (!this.HasSelection()) { return }
            Clipboard.SetText(this.SelectedText)
            if (!this.ReadOnly) { this.ReplaceSelection("") }
        }
        undefined Paste() {
            if (this.ReadOnly) { return }
            var text = Clipboard.GetText()
            if (text == "") { return }
            this.ReplaceSelection(UI.TextBox.OneLine(text))
        }
        static string OneLine(string text) { return text.Replace("\r\n", " ").Replace("\n", " ").Replace("\r", " ") }

        // The width of the text between two character positions (`start` and `count` characters) in the font of the field.
        defined int Span(Root root, defined int start, defined int count) {
            if (count <= 0) { return 0 }
            return this.TextWidth(root, this.Text.Substring(start, count))
        }

        // Is the field in the font of the renderer (monospaced, so that columns can be counted instead of measured)?
        bool Plain(Root root) { return this.FontName(root) == "" }

        // How many characters, from `scroll` on, fit into the field?
        defined int Fit(Root root) {
            var room = this.actualWidth - 8
            if (this.Plain(root)) { return room / root.cw }
            var count = 0
            while (this.scroll + count < this.Text.Length && this.Span(root, this.scroll, count + 1) <= room) { count = count + 1 }
            return count
        }

        override undefined Draw(Root root, defined int ax, defined int ay) {
            if (!this.NeedsDraw(root, ax, ay)) { return }
            this.Clamp()
            var theme = root.theme
            var back = theme.inputBack
            if (!this.Enabled) { back = theme.faceDisabled }
            else if (this.Background != undefined) { back = this.Background }
            var border = theme.border
            if (this.Pen != undefined) { border = this.Pen }
            if (this.Focused) { border = theme.borderFocus }
            root.Box(ax, ay, this.actualWidth, this.actualHeight, back, border)

            // the caret stays visible: the visible section moves along
            var room = this.actualWidth - 8
            if (this.caret < this.scroll) { this.scroll = this.caret }
            if (this.Plain(root)) {
                var fit = room / root.cw
                if (this.caret > this.scroll + fit) { this.scroll = this.caret - fit }
            } else {
                while (this.scroll < this.caret && this.Span(root, this.scroll, this.caret - this.scroll) > room) { this.scroll = this.scroll + 1 }
            }
            if (this.scroll < 0) { this.scroll = 0 }

            var count = this.Text.Length - this.scroll
            var fits = this.Fit(root)
            if (count > fits) { count = fits }
            if (count < 0) { count = 0 }
            var color = theme.text
            if (this.Foreground != undefined) { color = this.Foreground }
            if (!this.Enabled) { color = theme.textDisabled }
            var ty = ay + (this.actualHeight - this.TextHeight(root)) / 2
            // the visible part in up to three pieces: before the selection, the selection (on its own background), after it
            var s0 = UI.M.Clamp(this.SelectionStart, this.scroll, this.scroll + count)
            var s1 = UI.M.Clamp(this.SelectionStart + this.SelectionLength, this.scroll, this.scroll + count)
            if (s1 > s0 && this.Enabled) {
                var x0 = ax + 4 + this.Span(root, this.scroll, s0 - this.scroll)
                var x1 = ax + 4 + this.Span(root, this.scroll, s1 - this.scroll)
                root.renderer.FillRect(x0, ay + 3, x1 - x0, this.actualHeight - 6, theme.selection)
                if (s0 > this.scroll) { this.DrawString(root, ax + 4, ty, this.Text.Substring(this.scroll, s0 - this.scroll), color) }
                this.DrawString(root, x0, ty, this.Text.Substring(s0, s1 - s0), theme.selectionText)
                if (this.scroll + count > s1) { this.DrawString(root, x1, ty, this.Text.Substring(s1, this.scroll + count - s1), color) }
            } else if (count > 0) {
                this.DrawString(root, ax + 4, ty, this.Text.Substring(this.scroll, count), color)
            }
            if (this.Focused && this.dropPos < 0) {
                var cx = ax + 4 + this.Span(root, this.scroll, this.caret - this.scroll)
                root.renderer.DrawLine(cx, ay + 3, cx, ay + this.actualHeight - 4, theme.caret)
            }
            // where a drop would go: a caret of its own
            var drop = this.dropPos
            if (drop >= this.scroll && drop <= this.scroll + count) {
                var dx = ax + 4 + this.Span(root, this.scroll, drop - this.scroll)
                root.renderer.DrawLine(dx, ay + 3, dx, ay + this.actualHeight - 4, theme.caret)
            }
        }

        // The character boundary next to the point (monospaced: add half a cell width, then divide; otherwise measure the text up to each boundary).
        defined int ColumnAt(Root root, defined int px) {
            var column = 0
            if (this.Plain(root)) {
                column = (px - (this.ax + 4) + root.cw / 2) / root.cw
            } else {
                var rest = this.Text.Length - this.scroll
                var before = 0
                while (column < rest) {
                    var edge = this.Span(root, this.scroll, column + 1)
                    if (this.ax + 4 + edge > px) {
                        if (px - (this.ax + 4 + before) >= this.ax + 4 + edge - px) { column = column + 1 }
                        break
                    }
                    before = edge
                    column = column + 1
                }
            }
            if (px < this.ax + 4) { column = 0 }
            return UI.M.Clamp(this.scroll + column, 0, this.Text.Length)
        }

        // The character under the point (not the boundary next to it, see ColumnAt); the last one beyond the end of the text.
        defined int CharIndexAt(Root root, defined int px) {
            var x = px - (this.ax + 4)
            if (x < 0) { return UI.M.Clamp(this.scroll - 1, 0, UI.M.Max(0, this.Text.Length - 1)) }
            var index = 0
            if (this.Plain(root)) {
                index = this.scroll + x / root.cw
            } else {
                index = this.scroll
                while (index < this.Text.Length && this.Span(root, this.scroll, index + 1 - this.scroll) <= x) { index = index + 1 }
            }
            return UI.M.Clamp(index, 0, UI.M.Max(0, this.Text.Length - 1))
        }

        // A click puts the caret there; dragging with the button held selects (see MouseMove). A double click selects the word under the pointer
        // (letters, digits and _; on spaces or punctuation the run of them), a triple click everything (Root.clickCount).
        override undefined MouseDown(Root root, defined int button, defined int px, defined int py) {
            if (button != 1) { return }
            var clicks = root.clickCount
            if (clicks >= 3) {
                this.selectMode = 3
                this.SelectAll()
                return
            }
            if (clicks == 2 && this.Text.Length > 0) {
                var at = this.CharIndexAt(root, px)
                this.selectMode = 2
                this.wordStart = UI.Words.RunStart(this.Text, at)
                this.wordEnd = UI.Words.RunEnd(this.Text, at)
                this.anchor = this.wordStart
                this.caret = this.wordEnd
                return
            }
            var column = this.ColumnAt(root, px)
            if (this.InSelection(root, px)) {
                // a press inside the selection may drag it (DragStart); without moving it puts the caret there (MouseUp)
                this.pressInSelection = true
                this.pressColumn = column
                this.selectMode = 0
                return
            }
            this.selectMode = 1
            this.caret = column
            this.anchor = this.caret
        }
        // Is the point on the selected text?
        bool InSelection(Root root, defined int px) {
            if (!this.HasSelection()) { return false }
            var s = this.SelectionStart
            var e = s + this.SelectionLength
            var at = this.CharIndexAt(root, px)
            if (at < s || at >= e) { return false }
            // (beyond the end of the text CharIndexAt says the last character)
            return px < this.ax + 4 + this.Span(root, this.scroll, UI.M.Max(0, e - this.scroll))
        }
        override undefined MouseUp(Root root, defined int button, defined int px, defined int py) {
            if (this.pressInSelection) {
                this.pressInSelection = false
                this.caret = this.pressColumn
                this.anchor = -1
                this.selectMode = 1
                this.Invalidate()
            }
        }
        override undefined MouseMove(Root root, defined int px, defined int py) {
            if (this.pressInSelection || this.anchor < 0 || this.selectMode == 3 || this.selectMode == 0) { return }
            var column = this.ColumnAt(root, px)
            if (this.selectMode == 2) {
                // after a double click the selection grows by whole words, the first word stays selected
                if (column < this.wordStart) {
                    this.anchor = this.wordEnd
                    column = UI.Words.RunStart(this.Text, column)
                } else if (column > this.wordEnd) {
                    this.anchor = this.wordStart
                    column = UI.Words.RunEnd(this.Text, column - 1)
                } else {
                    this.anchor = this.wordStart
                    column = this.wordEnd
                }
            }
            if (column != this.caret) {
                this.caret = column
                this.Invalidate()
            }
        }
        override bool KeepsMouseDrag() { return true }

        // Left/Right move the caret, Home/End jump (with Shift they select); Up/Down belong to the focus (to the element above/below)
        override bool WantsKey(defined int key) {
            return key == UI.Keys.Left() || key == UI.Keys.Right() || key == UI.Keys.Home() || key == UI.Keys.End()
        }

        // The caret goes to `position`: with Shift the selection grows or shrinks, without it the selection goes.
        undefined MoveCaret(defined int position, bool extend) {
            this.Clamp()
            if (extend) {
                if (this.anchor < 0) { this.anchor = this.caret }
            } else {
                this.anchor = -1
            }
            this.caret = UI.M.Clamp(position, 0, this.Text.Length)
        }

        override undefined KeyDown(Root root, defined int key, defined int mod) {
            this.Clamp()
            var length = this.Text.Length
            var shift = UI.Keys.Shift(mod)
            var shortcut = UI.Keys.Shortcut(mod)
            if (shortcut && key == UI.Keys.A()) { this.SelectAll() }
            else if (shortcut && (key == UI.Keys.C() || key == UI.Keys.Insert())) { this.Copy() }
            else if ((shortcut && key == UI.Keys.X()) || (shift && key == UI.Keys.Delete())) { this.Cut() }
            else if ((shortcut && key == UI.Keys.V()) || (shift && key == UI.Keys.Insert())) { this.Paste() }
            else if (shortcut && key == UI.Keys.Z()) {
                if (shift) { this.Redo() } else { this.Undo() }
            } else if (shortcut && key == UI.Keys.Y()) { this.Redo() }
            else if (key == UI.Keys.Left()) {
                // without Shift a selection collapses to its start; with Ctrl the caret jumps by words
                if (shortcut) { this.MoveCaret(UI.Words.Previous(this.Text, this.caret), shift) }
                else if (!shift && this.HasSelection()) { this.MoveCaret(this.SelectionStart, false) }
                else { this.MoveCaret(this.caret - 1, shift) }
            } else if (key == UI.Keys.Right()) {
                if (shortcut) { this.MoveCaret(UI.Words.Next(this.Text, this.caret), shift) }
                else if (!shift && this.HasSelection()) { this.MoveCaret(this.SelectionStart + this.SelectionLength, false) }
                else { this.MoveCaret(this.caret + 1, shift) }
            } else if (key == UI.Keys.Home()) {
                this.MoveCaret(0, shift)
            } else if (key == UI.Keys.End()) {
                this.MoveCaret(length, shift)
            } else if ((key == UI.Keys.Backspace() || key == UI.Keys.Delete()) && this.ReadOnly) {
                return
            } else if (key == UI.Keys.Backspace()) {
                if (this.HasSelection()) { this.ReplaceSelection("") }
                else if (this.caret > 0) {
                    var back = this.caret - 1
                    if (shortcut) { back = UI.Words.Previous(this.Text, this.caret) }
                    this.EditText(back, this.caret - back, "", 2)
                }
            } else if (key == UI.Keys.Delete()) {
                if (this.HasSelection()) { this.ReplaceSelection("") }
                else if (this.caret < length) {
                    var ahead = this.caret + 1
                    if (shortcut) { ahead = UI.Words.Next(this.Text, this.caret) }
                    this.EditText(this.caret, ahead - this.caret, "", 2)
                }
            } else if (key == UI.Keys.Enter()) {
                this.entered = true
                var callback = this.OnEnter
                if (callback != undefined) { callback() }
            }
        }

        // Typed text replaces the selection; what does not fit as a whole (MaxLength) is not taken (pasting cuts instead).
        override undefined TextInput(Root root, string value) {
            if (this.ReadOnly) { return }
            if (this.MaxLength > 0 && this.Text.Length - this.SelectionLength + value.Length > this.MaxLength) { return }
            this.pendingKind = 1
            this.ReplaceSelection(value)
        }

        // ---- dragging the selection: a press on it and a move drag its text (to another field: a copy; within the field: moved, with Ctrl copied; out of the
        // window into another program, which may move it: then it is deleted here). OnDragStart of the program decides first. ----
        override UI.DragData DragStart(Root root, defined int px, defined int py) {
            if (this.OnDragStart != undefined) { return base.DragStart(root, px, py) }
            if (!this.pressInSelection || !this.HasSelection()) { return undefined }
            this.pressInSelection = false
            this.selectMode = 1
            this.dragOwn = true
            this.dragMovedHere = false
            this.dragFrom = this.SelectionStart
            return new UI.DragData(this.SelectedText)
        }
        override undefined DragDone(Root root, UI.DragData data, UI.DropEffect effect) {
            var own = this.dragOwn
            var moved = this.dragMovedHere
            this.dragOwn = false
            this.dragMovedHere = false
            this.dropPos = -1
            if (own && effect == UI.DropEffect.Move && !moved && !this.ReadOnly) {
                // the other side took it away: it goes here (if it is still where it was)
                var n = data.Text.Length
                if (this.dragFrom + n <= this.Text.Length && this.Text.Substring(this.dragFrom, n) == data.Text) {
                    this.anchor = -1
                    this.caret = this.dragFrom
                    this.EditText(this.dragFrom, n, "", 0)
                }
            }
            this.Invalidate()
            base.DragDone(root, data, effect)
        }
        // A snapshot of a text field makes no picture of the text: the label shows it.
        override bool DragSnapshot() { return false }

        // ---- a drop target for text and files (the paths, separated by spaces); OnDragOver/OnDrop of the program decide first. While something is dragged
        // over the field, a second caret shows where it would go. ----
        override UI.DropEffect DragOver(Root root, UI.DragData data, defined int px, defined int py) {
            if (this.OnDragOver != undefined) { return base.DragOver(root, data, px, py) }
            var effect = this.DropEffectAt(root, data, px)
            var at = -1
            if (effect != UI.DropEffect.None) { at = this.ColumnAt(root, px) }
            if (at != this.dropPos) {
                this.dropPos = at
                this.Invalidate()
            }
            return effect
        }
        UI.DropEffect DropEffectAt(Root root, UI.DragData data, defined int px) {
            if (this.ReadOnly) { return UI.DropEffect.None }
            if (data.Source == this) {
                // within the field: not onto the dragged text itself; moved, with Ctrl copied
                if (!this.dragOwn || !this.HasSelection()) { return UI.DropEffect.None }
                var at = this.ColumnAt(root, px)
                var s = this.SelectionStart
                if (at >= s && at <= s + this.SelectionLength) { return UI.DropEffect.None }
                if (UI.Keys.Shortcut(root.modifiers)) {
                    if (this.MaxLength > 0 && this.Text.Length + this.SelectionLength > this.MaxLength) { return UI.DropEffect.None }
                    return UI.DropEffect.Copy
                }
                return UI.DropEffect.Move
            }
            if (data.HasText || data.HasFiles || data.Pending) { return UI.DropEffect.Copy }
            return UI.DropEffect.None
        }
        override undefined DragLeave(Root root) {
            if (this.dropPos >= 0) {
                this.dropPos = -1
                this.Invalidate()
            }
            base.DragLeave(root)
        }
        override UI.DropEffect Drop(Root root, UI.DragData data, defined int px, defined int py) {
            this.dropPos = -1
            this.Invalidate()
            if (this.OnDrop != undefined) { return base.Drop(root, data, px, py) }
            var effect = this.DropEffectAt(root, data, px)
            if (effect == UI.DropEffect.None) { return effect }
            var at = this.ColumnAt(root, px)
            if (data.Source == this) {
                var s = this.SelectionStart
                var n = this.SelectionLength
                var piece = this.SelectedText
                if (effect == UI.DropEffect.Copy) {
                    this.EditText(at, 0, piece, 0)
                    this.Select(at, n)
                } else {
                    // moved: one step that rewrites the stretch between the old and the new place
                    var text = this.Text
                    if (at < s) {
                        this.EditText(at, s + n - at, piece + text.Substring(at, s - at), 0)
                        this.Select(at, n)
                    } else {
                        this.EditText(s, at - s, text.Substring(s + n, at - s - n) + piece, 0)
                        this.Select(at - n, n)
                    }
                    this.dragMovedHere = true
                }
                this.history.SetAfter(this.caret, this.anchor)
                root.SetFocus(this)
                return effect
            }
            var text = data.Text
            if (!data.HasText) {
                text = ""
                foreach (f in data.Files) {
                    if (text != "") { text = text + " " }
                    text = text + f
                }
            }
            if (text == "") { return UI.DropEffect.None }
            this.caret = at
            this.anchor = -1
            this.ReplaceSelection(UI.TextBox.OneLine(text))
            // what was dropped stays selected
            if (this.caret > at) {
                this.Select(at, this.caret - at)
                this.history.SetAfter(this.caret, this.anchor)
            }
            root.SetFocus(this)
            return UI.DropEffect.Copy
        }
    }
}
