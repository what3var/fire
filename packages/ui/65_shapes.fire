namespace UI {
    // A polyline of points (part of a Geometry): `points` is [x0, y0, x1, y1, ...] as a list, `closed` connects end and start.
    class Figure {
        List points
        bool closed = false

        construct() { this.points = new List() }

        int Count() { return this.points.count / 2 }

        // The points as an array for the renderer.
        int[] ToArray() {
            var a = new int[this.points.count]
            for (var i = 0; i < this.points.count; i = i + 1) { a[i] = this.points[i] }
            return a
        }
    }

    // A shape made of polylines: MoveTo/LineTo/QuadTo/CubicTo/Close as with a path (curves are broken into segments), AddEllipse/AddArc/AddRect, or
    // `Geometry.Parse("M 10 10 L 50 10 L 50 40 Z")` with the notation of SVG paths (M L H V C Q Z, lower case = relative; numbers are integers, decimal places are dropped).
    class Geometry {
        List figures
        // the current point (start of the next segment) and the start of the current figure
        int cx = 0
        int cy = 0
        int startX = 0
        int startY = 0
        Figure current
        // number of segments per curve
        int segments = 16

        construct() { this.figures = new List() }

        Figure Begin(int x, int y) {
            var f = new Figure()
            f.TakeTo(this)
            this.figures.Add(f)
            this.current = f
            f.points.Add(x)
            f.points.Add(y)
            this.cx = x
            this.cy = y
            this.startX = x
            this.startY = y
            return f
        }

        undefined MoveTo(int x, int y) { this.Begin(x, y) }

        undefined LineTo(int x, int y) {
            if (this.current == undefined) { this.Begin(this.cx, this.cy) }
            this.current.points.Add(x)
            this.current.points.Add(y)
            this.cx = x
            this.cy = y
        }

        // Quadratic curve to the point (x, y) with the control point (qx, qy).
        undefined QuadTo(int qx, int qy, int x, int y) {
            var x0 = this.cx
            var y0 = this.cy
            for (var i = 1; i <= this.segments; i = i + 1) {
                var t = i * 1000 / this.segments
                var u = 1000 - t
                var px = (u * u * x0 + 2 * u * t * qx + t * t * x) / 1000000
                var py = (u * u * y0 + 2 * u * t * qy + t * t * y) / 1000000
                this.LineTo(px, py)
            }
        }

        // Cubic curve to the point (x, y) with the control points (c1x, c1y) and (c2x, c2y).
        undefined CubicTo(int c1x, int c1y, int c2x, int c2y, int x, int y) {
            var x0 = this.cx
            var y0 = this.cy
            for (var i = 1; i <= this.segments; i = i + 1) {
                var t = i * 1000 / this.segments
                var u = 1000 - t
                var a = u * u / 1000 * u / 1000
                var b = 3 * (u * u / 1000) * t / 1000
                var c = 3 * u * (t * t / 1000) / 1000
                var d = t * t / 1000 * t / 1000
                var px = (a * x0 + b * c1x + c * c2x + d * x) / 1000
                var py = (a * y0 + b * c1y + c * c2y + d * y) / 1000
                this.LineTo(px, py)
            }
        }

        // Closes the current figure (the end is connected to the start).
        undefined Close() {
            if (this.current == undefined) { return }
            this.current.closed = true
            this.cx = this.startX
            this.cy = this.startY
            this.current = undefined
        }

        // An arc of an ellipse around (mx, my) with the semi-axes rx and ry, from `start` degrees (0 = right, growing downwards) by `sweep` degrees.
        undefined AddArc(int mx, int my, int rx, int ry, int start, int sweep) {
            var steps = UI.M.Max(2, this.segments * UI.M.Max(1, sweep / 90))
            if (sweep < 0) { steps = UI.M.Max(2, this.segments * UI.M.Max(1, -sweep / 90)) }
            for (var i = 0; i <= steps; i = i + 1) {
                var a = start + sweep * i / steps
                var px = mx + rx * UI.M.Cos(a) / 1000
                var py = my + ry * UI.M.Sin(a) / 1000
                if (i == 0) { this.Begin(px, py) } else { this.LineTo(px, py) }
            }
        }

        undefined AddEllipse(int mx, int my, int rx, int ry) {
            this.AddArc(mx, my, rx, ry, 0, 360)
            this.current.points.RemoveAt(this.current.points.count - 1)
            this.current.points.RemoveAt(this.current.points.count - 1)
            this.Close()
        }

        undefined AddRect(int x, int y, int w, int h) {
            this.Begin(x, y)
            this.LineTo(x + w, y)
            this.LineTo(x + w, y + h)
            this.LineTo(x, y + h)
            this.Close()
        }

        // The size of the rectangle around all points (bottom right = largest coordinates).
        int Width() {
            var w = 0
            for (var i = 0; i < this.figures.count; i = i + 1) {
                var p = this.figures[i].points
                for (var k = 0; k < p.count; k = k + 2) { w = UI.M.Max(w, p[k]) }
            }
            return w
        }

        int Height() {
            var h = 0
            for (var i = 0; i < this.figures.count; i = i + 1) {
                var p = this.figures[i].points
                for (var k = 1; k < p.count; k = k + 2) { h = UI.M.Max(h, p[k]) }
            }
            return h
        }

        // Reads path data (commands M L H V C Q Z, lower case relative to the current point).
        static UI.Geometry Parse(string data) {
            var g = new Geometry()
            var pos = 0
            var command = 32
            var n = data.Length
            var args = new List()
            while (pos < n) {
                var c = data.CharAt(pos).ToInt()
                if (c == 32 || c == 44 || c == 9 || c == 10 || c == 13) {
                    pos = pos + 1
                    continue
                }
                var isLetter = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
                if (isLetter) {
                    command = c
                    pos = pos + 1
                    if (c == 90 || c == 122) { g.Close() }
                    continue
                }
                // a number
                var sign = 1
                if (c == 45) {
                    sign = -1
                    pos = pos + 1
                }
                var value = 0
                while (pos < n) {
                    var d = data.CharAt(pos).ToInt() - 48
                    if (d < 0 || d > 9) { break }
                    value = value * 10 + d
                    pos = pos + 1
                }
                if (pos < n && data.CharAt(pos).ToInt() == 46) {
                    pos = pos + 1
                    while (pos < n) {
                        var d2 = data.CharAt(pos).ToInt() - 48
                        if (d2 < 0 || d2 > 9) { break }
                        pos = pos + 1
                    }
                }
                args.Add(sign * value)
                var need = UI.Geometry.ArgCount(command)
                if (need > 0 && args.count == need) {
                    g.Apply(command, args)
                    args.Clear()
                }
            }
            return g
        }

        static int ArgCount(int command) {
            var c = command
            if (c >= 97) { c = c - 32 }
            if (c == 77 || c == 76) { return 2 }
            if (c == 72 || c == 86) { return 1 }
            if (c == 81) { return 4 }
            if (c == 67) { return 6 }
            return 0
        }

        undefined Apply(int command, any args) {
            var relative = command >= 97
            var c = command
            if (relative) { c = c - 32 }
            var ox = 0
            var oy = 0
            if (relative) {
                ox = this.cx
                oy = this.cy
            }
            if (c == 77) { this.MoveTo(ox + args[0], oy + args[1]) }
            else if (c == 76) { this.LineTo(ox + args[0], oy + args[1]) }
            else if (c == 72) { this.LineTo(ox + args[0], this.cy) }
            else if (c == 86) { this.LineTo(this.cx, oy + args[0]) }
            else if (c == 81) { this.QuadTo(ox + args[0], oy + args[1], ox + args[2], oy + args[3]) }
            else if (c == 67) { this.CubicTo(ox + args[0], oy + args[1], ox + args[2], oy + args[3], ox + args[4], oy + args[5]) }
        }
    }

    // The common properties of the shapes: fill (`fill`, a Brush; undefined: do not fill) and outline (`stroke`, a Pen; undefined: no outline).
    class Shape : Element {
        Brush Fill
        Pen Stroke

        construct(int x = 0, int y = 0, int width = -1, int height = -1) : base(x, y, width, height) { }

        string StyleKey() { return "Shape" }
    }

    // A rectangle of the size of the element.
    class Rectangle : Shape {
        construct(int x = 0, int y = 0, int width = -1, int height = -1) : base(x, y, width, height) { }

        string StyleKey() { return "Rectangle" }

        undefined Draw(Root root, int ax, int ay) {
            if (!this.NeedsDraw(root, ax, ay)) { return }
            if (this.Fill != undefined) { root.renderer.FillRect(ax, ay, this.actualWidth, this.actualHeight, this.Fill) }
            if (this.Stroke != undefined) { root.renderer.DrawRect(ax, ay, this.actualWidth, this.actualHeight, this.Stroke) }
        }
    }

    // An ellipse that fills the rectangle of the element.
    class Ellipse : Shape {
        construct(int x = 0, int y = 0, int width = -1, int height = -1) : base(x, y, width, height) { }

        string StyleKey() { return "Ellipse" }

        undefined Draw(Root root, int ax, int ay) {
            if (!this.NeedsDraw(root, ax, ay)) { return }
            var rx = this.actualWidth / 2
            var ry = this.actualHeight / 2
            var mx = ax + rx
            var my = ay + ry
            // with an odd size the ellipse stays within the rectangle
            if (this.Fill != undefined) { root.renderer.FillEllipse(mx, my, UI.M.Max(0, rx - 1), UI.M.Max(0, ry - 1), this.Fill) }
            if (this.Stroke != undefined) { root.renderer.DrawEllipse(mx, my, UI.M.Max(0, rx - 1), UI.M.Max(0, ry - 1), this.Stroke) }
        }
    }

    // A segment from (x1, y1) to (x2, y2) in the element (coordinates relative to its top left corner).
    class Line : Shape {
        int X1 = 0
        int Y1 = 0
        int X2 = 0
        int Y2 = 0

        construct(int x1 = 0, int y1 = 0, int x2 = 0, int y2 = 0) : base(0, 0, -1, -1) {
            this.X1 = x1
            this.Y1 = y1
            this.X2 = x2
            this.Y2 = y2
        }

        string StyleKey() { return "Line" }

        undefined MeasureCore(Root root, int aw, int ah) {
            this.cw = UI.M.Max(this.X1, this.X2) + 1
            this.ch = UI.M.Max(this.Y1, this.Y2) + 1
        }

        undefined Draw(Root root, int ax, int ay) {
            if (!this.NeedsDraw(root, ax, ay)) { return }
            if (this.Stroke != undefined) { root.renderer.DrawLine(ax + this.X1, ay + this.Y1, ax + this.X2, ay + this.Y2, this.Stroke) }
        }
    }

    // Ready-made symbols for buttons and lists (Button.icon): shapes on a grid of 16 x 16 that are scaled to the size they are drawn at, in the colour of the text.
    class Icons {
        static UI.Geometry Up() { return UI.Geometry.Parse("M 8 1 L 15 8 L 10 8 L 10 15 L 6 15 L 6 8 L 1 8 Z") }
        static UI.Geometry Down() { return UI.Geometry.Parse("M 8 15 L 15 8 L 10 8 L 10 1 L 6 1 L 6 8 L 1 8 Z") }
        static UI.Geometry Back() { return UI.Geometry.Parse("M 1 8 L 8 1 L 8 6 L 15 6 L 15 10 L 8 10 L 8 15 Z") }
        static UI.Geometry Forward() { return UI.Geometry.Parse("M 15 8 L 8 1 L 8 6 L 1 6 L 1 10 L 8 10 L 8 15 Z") }
        static UI.Geometry Home() { return UI.Geometry.Parse("M 8 1 L 15 8 L 13 8 L 13 15 L 9 15 L 9 10 L 7 10 L 7 15 L 3 15 L 3 8 L 1 8 Z") }
        static UI.Geometry Folder() { return UI.Geometry.Parse("M 1 3 L 6 3 L 8 5 L 15 5 L 15 14 L 1 14 Z") }
        static UI.Geometry File() { return UI.Geometry.Parse("M 3 1 L 10 1 L 13 4 L 13 15 L 3 15 Z") }
        static UI.Geometry Close() { return UI.Geometry.Parse("M 3 3 L 13 13 M 13 3 L 3 13") }
        static UI.Geometry Check() { return UI.Geometry.Parse("M 2 8 L 6 12 L 14 3") }
        static UI.Geometry Add() { return UI.Geometry.Parse("M 7 2 L 9 2 L 9 7 L 14 7 L 14 9 L 9 9 L 9 14 L 7 14 L 7 9 L 2 9 L 2 7 L 7 7 Z") }
    }

    // A shape from a Geometry (see above): closed figures are filled (even-odd) and outlined, open ones only drawn. The points are
    // relative to the top left corner of the element; it is as big as the Geometry.
    class Path : Shape {
        Geometry data

        construct(any data = undefined, int x = 0, int y = 0) : base(x, y, -1, -1) {
            this.data = data
        }

        string StyleKey() { return "Path" }

        // Sets the Geometry from path data (see Geometry.Parse).
        undefined SetData(string text) {
            this.data = UI.Geometry.Parse(text)
        }

        undefined MeasureCore(Root root, int aw, int ah) {
            if (this.data == undefined) {
                this.cw = 0
                this.ch = 0
                return
            }
            this.cw = this.data.Width() + 1
            this.ch = this.data.Height() + 1
        }

        undefined Draw(Root root, int ax, int ay) {
            if (!this.NeedsDraw(root, ax, ay)) { return }
            if (this.data == undefined) { return }
            for (var i = 0; i < this.data.figures.count; i = i + 1) {
                var f = this.data.figures[i]
                if (f.Count() < 2) { continue }
                var pts = f.ToArray()
                for (var k = 0; k < pts.length; k = k + 2) {
                    pts[k] = pts[k] + ax
                    pts[k + 1] = pts[k + 1] + ay
                }
                if (f.closed && this.Fill != undefined && f.Count() >= 3) { root.renderer.FillPolygon(pts, this.Fill) }
                if (this.Stroke != undefined) { root.renderer.DrawPath(pts, this.Stroke, f.closed) }
            }
        }
    }

    // A drawing surface: has its own framebuffer (as big as the element) into which the code draws with `renderer`, and shows it. `onPaint` is a lambda with
    // the drawing surface as parameter; it runs when the buffer was created anew (size change), after `Invalidate()` and - with `continuous` - in every frame. With `SetSource`
    // it instead shows a foreign framebuffer (an image, the output of another part of the program). Mouse events are reported by `onMouseDown/onMouseMove/onMouseUp` (lambda with x, y
    // relative to the surface and - for clicks - the button).
    class DrawingCanvas : Element {
        Framebuffer framebuffer
        Renderer renderer
        lambda<DrawingCanvas> OnPaint
        lambda<int, int, int> OnMouseDown
        lambda<int, int> OnMouseMove
        lambda<int, int, int> OnMouseUp
        bool Continuous = false
        bool dirty = true
        bool external = false
        // how the image gets onto the surface: UI.BlitMode (Copy, Transparent, Blend)
        int blendMode = 0

        construct(int x = 0, int y = 0, int width = 200, int height = 150) : base(x, y, width, height) { }

        string StyleKey() { return "DrawingCanvas" }

        // At the next cycle onPaint runs again and the surface is shown anew (also after drawing with `renderer` from outside).
        undefined Invalidate() {
            this.dirty = true
            base.Invalidate()
        }

        // onPaint runs here (not while painting): what it changes on the elements then reports itself like any other change.
        undefined Poll(Root root) {
            base.Poll(root)
            if (this.Continuous) { this.dirty = true }
            // the element has a different size than the surface: it is created anew and repainted
            if (!this.external && this.framebuffer != undefined && (this.framebuffer.Width() != this.actualWidth || this.framebuffer.Height() != this.actualHeight)) { this.dirty = true }
            if (this.external || !this.dirty || this.actualWidth <= 0 || this.actualHeight <= 0) { return }
            // the own fields change here, that is no change of the interface
            root.painting = true
            this.Ensure(this.actualWidth, this.actualHeight)
            this.dirty = false
            root.painting = false
            var paint = this.OnPaint
            if (paint != undefined) { paint(this) }
            base.Invalidate()
        }

        // Shows `source` (a framebuffer that you own yourself) instead of the own surface.
        undefined SetSource(any source) {
            this.DropOwn()
            this.framebuffer = source
            this.external = true
        }

        undefined DropOwn() {
            if (!this.external) {
                if (this.renderer != undefined) { delete this.renderer }
                if (this.framebuffer != undefined) { delete this.framebuffer }
            }
            this.renderer = undefined
            this.framebuffer = undefined
            this.external = false
        }

        // Makes sure that the own buffer is as big as the element.
        undefined Ensure(int w, int h) {
            if (this.external || w <= 0 || h <= 0) { return }
            if (this.framebuffer != undefined && this.framebuffer.Width() == w && this.framebuffer.Height() == h) { return }
            this.DropOwn()
            this.framebuffer = new Framebuffer(w, h)
            this.renderer = new Renderer(this.framebuffer)
            this.dirty = true
        }

        undefined MeasureCore(Root root, int aw, int ah) {
            if (this.external && this.framebuffer != undefined) {
                this.cw = this.framebuffer.Width()
                this.ch = this.framebuffer.Height()
                return
            }
            this.cw = 0
            this.ch = 0
        }

        undefined Draw(Root root, int ax, int ay) {
            if (!this.NeedsDraw(root, ax, ay)) { return }
            if (this.framebuffer == undefined) { return }
            root.PushClip(ax, ay, this.actualWidth, this.actualHeight)
            root.renderer.Blit(this.framebuffer, ax, ay, this.blendMode)
            root.PopClip()
        }

        undefined MouseDown(Root root, int button, int px, int py) {
            var callback = this.OnMouseDown
            if (callback != undefined) { callback(px - this.ax, py - this.ay, button) }
        }

        undefined MouseMove(Root root, int px, int py) {
            var callback = this.OnMouseMove
            if (callback != undefined) { callback(px - this.ax, py - this.ay) }
        }

        undefined Hover(Root root, int px, int py) {
            var callback = this.OnMouseMove
            if (callback != undefined) { callback(px - this.ax, py - this.ay) }
        }

        undefined MouseUp(Root root, int button, int px, int py) {
            var callback = this.OnMouseUp
            if (callback != undefined) { callback(px - this.ax, py - this.ay, button) }
        }
    }
}
