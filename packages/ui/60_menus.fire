namespace UI {
    // A row of a menu: caption, action (lambda without parameters), submenu (Add), separator, check mark, shortcut as text.
    class MenuItem {
        string Header = ""
        lambda OnClick
        List items
        bool separator = false
        // With checkable a click toggles the check mark (isChecked) before onClick runs.
        bool Checkable = false
        bool IsChecked = false
        bool Enabled = true
        // Only a text on the right of the row (for example "Ctrl+S"), the key assignment itself is the program's business
        string Shortcut = ""

        construct(string header = "", any onClick = undefined) {
            this.Header = header
            this.OnClick = onClick
            this.items = new List()
        }

        // A separator.
        static UI.MenuItem Separator() {
            var m = new MenuItem()
            m.separator = true
            return m
        }

        // Appends a submenu row; it belongs to this row.
        any Add(any item) {
            item.TakeTo(this)
            this.items.Add(item)
            return item
        }

        bool HasSubmenu() { return this.items.count > 0 }

        // Executes the action (toggle the check mark, call the lambda).
        undefined Activate() {
            if (this.Checkable) { this.IsChecked = !this.IsChecked }
            var callback = this.OnClick
            if (callback != undefined) { callback() }
        }
    }

    // The expanded list of a menu (floating, see Root.ShowMenu); a submenu is a further MenuPopup next to it.
    class MenuPopup : Element {
        List entries
        int hot = -1
        MenuPopup sub
        int subIndex = -1
        MenuPopup parentMenu

        construct(List entries) : base(0, 0, -1, -1) {
            this.entries = entries
            this.grabsKeys = true
        }

        string StyleKey() { return "MenuPopup" }

        int RowHeight(Root root) { return this.TextHeight(root) + 8 }

        int HeightOf(Root root, any item) {
            if (item.separator) { return 7 }
            return this.RowHeight(root)
        }

        undefined MeasureCore(Root root, int aw, int ah) {
            var w = 0
            var h = 4
            for (var i = 0; i < this.entries.count; i = i + 1) {
                var item = this.entries[i]
                h = h + this.HeightOf(root, item)
                if (item.separator) { continue }
                var line = 28 + this.TextWidth(root, item.Header) + 12
                if (item.Shortcut != "") { line = line + 24 + this.TextWidth(root, item.Shortcut) }
                if (item.HasSubmenu()) { line = line + 12 }
                w = UI.M.Max(w, line)
            }
            this.cw = UI.M.Max(w, 80)
            this.ch = h
        }

        // The index of the row at the screen height `py`, or -1.
        int RowAt(Root root, int py) {
            var y = this.ay + 2
            for (var i = 0; i < this.entries.count; i = i + 1) {
                var h = this.HeightOf(root, this.entries[i])
                if (py >= y && py < y + h) { return i }
                y = y + h
            }
            return -1
        }

        int RowTop(Root root, int index) {
            var y = this.ay + 2
            for (var i = 0; i < index; i = i + 1) { y = y + this.HeightOf(root, this.entries[i]) }
            return y
        }

        undefined Draw(Root root, int ax, int ay) {
            if (!this.NeedsDraw(root, ax, ay)) { return }
            var theme = root.theme
            var r = root.renderer
            var back = this.Background
            if (back == undefined) { back = theme.menuBack }
            r.FillRect(ax, ay, this.actualWidth, this.actualHeight, back)
            var border = this.Pen
            if (border == undefined) { border = theme.border }
            r.DrawRect(ax, ay, this.actualWidth, this.actualHeight, border)
            var y = ay + 2
            for (var i = 0; i < this.entries.count; i = i + 1) {
                var item = this.entries[i]
                var h = this.HeightOf(root, item)
                if (item.separator) {
                    r.DrawLine(ax + 4, y + 3, ax + this.actualWidth - 5, y + 3, theme.border)
                    y = y + h
                    continue
                }
                var text = theme.text
                if (this.Foreground != undefined) { text = this.Foreground }
                if (!item.Enabled) { text = theme.textDisabled }
                if (i == this.hot && item.Enabled) {
                    r.FillRect(ax + 2, y, this.actualWidth - 4, h, theme.selection)
                    text = theme.selectionText
                }
                if (item.IsChecked) {
                    // a check mark
                    var cx = ax + 8
                    var cy = y + h / 2
                    var tick = new Pen(text.Color, 2)
                    r.DrawLine(cx, cy, cx + 3, cy + 4, tick)
                    r.DrawLine(cx + 3, cy + 4, cx + 10, cy - 4, tick)
                }
                var ty = y + (h - this.TextHeight(root)) / 2
                this.DrawString(root, ax + 28, ty, item.Header, text)
                var right = ax + this.actualWidth - 12
                if (item.HasSubmenu()) {
                    // an arrow to the right
                    var my = y + h / 2
                    r.FillTriangle(right - 4, my - 4, right - 4, my + 4, right + 1, my, text)
                    right = right - 12
                }
                if (item.Shortcut != "") { this.DrawString(root, right - this.TextWidth(root, item.Shortcut), ty, item.Shortcut, text) }
                y = y + h
            }
        }

        // Close the submenu if it is open.
        undefined CloseSub(Root root) {
            if (this.sub != undefined) {
                var inner = this.sub
                this.sub = undefined
                this.subIndex = -1
                // first the submenus of the submenu, then itself
                inner.CloseSub(root)
                root.ClosePopup(inner)
            }
        }

        undefined OpenSub(Root root, int index) {
            var item = this.entries[index]
            if (this.subIndex == index && this.sub != undefined) { return }
            this.CloseSub(root)
            if (!item.HasSubmenu() || !item.Enabled) { return }
            var menu = new MenuPopup(item.items)
            menu.parentMenu = this
            root.ShowPopup(menu, this.ax + this.actualWidth - 2, this.RowTop(root, index), true, this)
            this.sub = menu
            this.subIndex = index
        }

        // Selects the row: a submenu opens, otherwise the action runs and everything closes.
        undefined Choose(Root root, int index) {
            var item = this.entries[index]
            if (item.separator || !item.Enabled) { return }
            if (item.HasSubmenu()) {
                this.OpenSub(root, index)
                return
            }
            root.CloseAllPopups()
            item.Activate()
        }

        undefined Hover(Root root, int px, int py) {
            var index = this.RowAt(root, py)
            if (index < 0 || this.entries[index].separator) { return }
            this.hot = index
            if (this.subIndex != index) { this.OpenSub(root, index) }
        }

        // A click outside of all menus closes everything; the menus of a submenu are closed by the root one after the other anyway.
        bool PopupOutside(Root root, int px, int py) {
            var consumed = this.owner != undefined && this.owner.Contains(px, py)
            root.ClosePopup(this)
            return consumed
        }

        undefined MouseDown(Root root, int button, int px, int py) {
            if (button != 1) { return }
            var index = this.RowAt(root, py)
            if (index >= 0) { this.Choose(root, index) }
        }

        undefined KeyDown(Root root, int key, int mod) {
            // the keys go to the topmost menu
            if (key == UI.Keys.Escape()) {
                if (this.parentMenu != undefined) {
                    this.parentMenu.CloseSub(root)
                } else {
                    root.CloseAllPopups()
                }
                return
            }
            if (key == UI.Keys.Down()) { this.Step(1) }
            else if (key == UI.Keys.Up()) { this.Step(-1) }
            else if (key == UI.Keys.Right()) {
                if (this.hot >= 0 && this.entries[this.hot].HasSubmenu()) {
                    this.OpenSub(root, this.hot)
                    if (this.sub != undefined) { this.sub.hot = this.sub.FirstRow() }
                }
            } else if (key == UI.Keys.Left()) {
                if (this.parentMenu != undefined) { this.parentMenu.CloseSub(root) }
            } else if (key == UI.Keys.Enter() || key == UI.Keys.Space()) {
                if (this.hot >= 0) { this.Choose(root, this.hot) }
            }
        }

        int FirstRow() {
            for (var i = 0; i < this.entries.count; i = i + 1) {
                if (!this.entries[i].separator && this.entries[i].Enabled) { return i }
            }
            return -1
        }

        // The next selectable row in the direction `direction` (1 or -1), wrapping around.
        undefined Step(int direction) {
            var n = this.entries.count
            if (n == 0) { return }
            var i = this.hot
            for (var k = 0; k < n; k = k + 1) {
                i = i + direction
                if (i >= n) { i = 0 }
                if (i < 0) { i = n - 1 }
                var item = this.entries[i]
                if (!item.separator && item.Enabled) {
                    this.hot = i
                    return
                }
            }
        }
    }

    // The menu bar: the titles of the top level side by side; a click opens the menu, with a menu open the pointer moving over another title switches the menu.
    class MenuBar : Element {
        List menus
        int openIndex = -1
        // the title under the pointer (-1: none)
        int hotIndex = -1
        MenuPopup open

        construct(int x = 0, int y = 0, int width = -1, int height = -1) : base(x, y, width, height) {
            this.menus = new List()
        }

        string StyleKey() { return "MenuBar" }

        // Appends a menu of the top level (a MenuItem with submenu rows); it belongs to the bar.
        any Add(any item) {
            item.TakeTo(this)
            this.menus.Add(item)
            return item
        }

        int HeaderWidth(Root root, any item) { return this.TextWidth(root, item.Header) + 16 }

        undefined MeasureCore(Root root, int aw, int ah) {
            var w = 0
            for (var i = 0; i < this.menus.count; i = i + 1) { w = w + this.HeaderWidth(root, this.menus[i]) }
            this.cw = w
            this.ch = this.TextHeight(root) + 8
        }

        // The index of the title at the screen position px, or -1.
        int IndexAt(Root root, int px) {
            var x = this.ax
            for (var i = 0; i < this.menus.count; i = i + 1) {
                var w = this.HeaderWidth(root, this.menus[i])
                if (px >= x && px < x + w) { return i }
                x = x + w
            }
            return -1
        }

        int HeaderLeft(Root root, int index) {
            var x = this.ax
            for (var i = 0; i < index; i = i + 1) { x = x + this.HeaderWidth(root, this.menus[i]) }
            return x
        }

        // A menu that has closed is no longer open.
        undefined Poll(Root root) {
            base.Poll(root)
            if (this.open != undefined && !root.IsPopup(this.open)) {
                this.open = undefined
                this.openIndex = -1
            }
        }

        undefined Draw(Root root, int ax, int ay) {
            if (!this.NeedsDraw(root, ax, ay)) { return }
            var theme = root.theme
            var back = this.Background
            if (back == undefined) { back = theme.panel }
            root.renderer.FillRect(ax, ay, this.actualWidth, this.actualHeight, back)
            var x = ax
            for (var i = 0; i < this.menus.count; i = i + 1) {
                var item = this.menus[i]
                var w = this.HeaderWidth(root, item)
                var text = theme.text
                if (this.Foreground != undefined) { text = this.Foreground }
                if (i == this.openIndex) {
                    root.renderer.FillRect(x, ay, w, this.actualHeight, theme.selection)
                    text = theme.selectionText
                } else if (i == this.hotIndex) {
                    root.renderer.FillRect(x, ay, w, this.actualHeight, theme.faceHover)
                }
                if (!item.Enabled) { text = theme.textDisabled }
                this.DrawString(root, x + 8, ay + (this.actualHeight - this.TextHeight(root)) / 2, item.Header, text)
                x = x + w
            }
        }

        undefined Open(Root root, int index) {
            if (this.open != undefined) {
                root.CloseAllPopups()
                this.open = undefined
            }
            this.openIndex = index
            var item = this.menus[index]
            if (!item.Enabled || !item.HasSubmenu()) {
                this.openIndex = -1
                item.Activate()
                return
            }
            this.open = root.ShowMenu(item.items, this.HeaderLeft(root, index), this.ay + this.actualHeight, this)
        }

        undefined MouseDown(Root root, int button, int px, int py) {
            if (button != 1) { return }
            var index = this.IndexAt(root, px)
            if (index >= 0) { this.Open(root, index) }
        }

        // With a menu open, the pointer over another title opens its menu.
        undefined Hover(Root root, int px, int py) {
            this.hotIndex = this.IndexAt(root, px)
            if (this.open == undefined) { return }
            var index = this.hotIndex
            if (index >= 0 && index != this.openIndex) { this.Open(root, index) }
        }
    }
}