{
  "format": 1,
  "name": "fire-usb",
  "type": "library",
  "import": "usb",
  "standard": true,
  "drivers": [
    "UsbDriver"
  ],
  "settings": {
    "version": "1.0.0",
    "author": "fire",
    "license": "fire",
    "description": "The standard library 'usb' of fire: USB devices through libusb (Linux, macOS) and WinUSB (Windows) - control, bulk and interrupt transfers, bulk endpoints as streams, and a simulated device."
  },
  "native": {
    "sources": [
      "native/fire_bridge_usb.h"
    ],
    "discover": false,
    "linkLibraries": {
      "posix": [
        "dl"
      ]
    },
    "functions": [
      {
        "name": "__UsbLastError",
        "arguments": 0,
        "c": "fire_usb_LastError"
      },
      {
        "name": "__UsbLastErrorMessage",
        "arguments": 0,
        "needsList": true,
        "returnsReference": true,
        "c": "fire_usb_LastErrorMessage"
      },
      {
        "name": "__UsbOpenCount",
        "arguments": 0,
        "c": "fire_usb_OpenCount"
      },
      {
        "name": "__UsbSupported",
        "arguments": 0,
        "c": "fire_usb_Supported"
      },
      {
        "name": "__UsbDevices",
        "arguments": 0,
        "needsList": true,
        "returnsReference": true,
        "c": "fire_usb_Devices"
      },
      {
        "name": "__UsbOpen",
        "arguments": 1,
        "c": "fire_usb_Open"
      },
      {
        "name": "__UsbEndpoints",
        "arguments": 1,
        "needsList": true,
        "returnsReference": true,
        "c": "fire_usb_Endpoints"
      },
      {
        "name": "__UsbInterface",
        "arguments": 4,
        "c": "fire_usb_Interface"
      },
      {
        "name": "__UsbControl",
        "arguments": 9,
        "c": "fire_usb_Control"
      },
      {
        "name": "__UsbTransfer",
        "arguments": 7,
        "c": "fire_usb_Transfer"
      },
      {
        "name": "__UsbClearHalt",
        "arguments": 2,
        "c": "fire_usb_ClearHalt"
      },
      {
        "name": "__UsbClose",
        "arguments": 1,
        "c": "fire_usb_Close"
      },
      {
        "name": "__UsbSimInfo",
        "arguments": 1,
        "c": "fire_usb_SimInfo"
      },
      {
        "name": "__UsbSimClear",
        "arguments": 0,
        "c": "fire_usb_SimClear"
      }
    ],
    "reset": "fire_usb_reset",
    "language": "c",
    "platformSources": {
      "dos16": [
        "native/fire_usb_c.h",
        "native/fire_usb_none.h"
      ],
      "esp32": [
        "native/fire_usb_c.h",
        "native/fire_usb_none.h"
      ],
      "freertos": [
        "native/fire_usb_c.h",
        "native/fire_usb_none.h"
      ],
      "posix": [
        "native/fire_usb_c.h",
        "native/fire_usb_desktop.h",
        "native/fire_usb_winusb.h",
        "native/fire_usb_libusb.h",
        "native/fire_usb_none.h"
      ],
      "wasm": [
        "native/fire_usb_c.h",
        "native/fire_usb_none.h"
      ],
      "windows": [
        "native/fire_usb_c.h",
        "native/fire_usb_desktop.h",
        "native/fire_usb_winusb.h",
        "native/fire_usb_libusb.h",
        "native/fire_usb_none.h"
      ],
      "default": [
        "native/fire_usb_c.h",
        "native/fire_usb_none.h"
      ]
    }
  }
}
