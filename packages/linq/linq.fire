#import "reflection"

class LinqEmptyException : Exception {
    string message
    construct(string message) { this.message = message }
}

class LinqWhereEnumerator : IEnumerator {
    IEnumerator inner
    lambda<any> pred
    any current
    construct(IEnumerator inner, lambda<any> pred) { this.inner = inner; this.pred = pred; inner.TakeTo(this) }
    bool MoveNext() {
        var p = this.pred
        while (this.inner.MoveNext()) {
            var item = this.inner.GetCurrent()
            if (p(item)) { this.current = item; return true }
        }
        return false
    }
    any GetCurrent() { return this.current }
}

class LinqSelectEnumerator : IEnumerator {
    IEnumerator inner
    lambda<any> fn
    any current
    construct(IEnumerator inner, lambda<any> fn) { this.inner = inner; this.fn = fn; inner.TakeTo(this) }
    bool MoveNext() {
        if (!this.inner.MoveNext()) { return false }
        var f = this.fn
        this.current = f(this.inner.GetCurrent())
        return true
    }
    any GetCurrent() { return this.current }
}

class LinqSelectManyEnumerator : IEnumerator {
    IEnumerator inner
    lambda<any> fn
    any sub
    any current
    construct(IEnumerator inner, lambda<any> fn) { this.inner = inner; this.fn = fn; inner.TakeTo(this) }
    bool MoveNext() {
        var f = this.fn
        while (true) {
            if (this.sub != undefined) {
                if (this.sub.MoveNext()) { this.current = this.sub.GetCurrent(); return true }
                this.sub = undefined
            }
            if (!this.inner.MoveNext()) { return false }
            var next = Linq.Iter(f(this.inner.GetCurrent()))
            next.TakeTo(this)
            this.sub = next
        }
    }
    any GetCurrent() { return this.current }
}

class LinqTakeEnumerator : IEnumerator {
    IEnumerator inner
    int left
    construct(IEnumerator inner, int n) { this.inner = inner; this.left = n; inner.TakeTo(this) }
    bool MoveNext() {
        if (this.left <= 0) { return false }
        this.left = this.left - 1
        return this.inner.MoveNext()
    }
    any GetCurrent() { return this.inner.GetCurrent() }
}

class LinqSkipEnumerator : IEnumerator {
    IEnumerator inner
    int skip
    construct(IEnumerator inner, int n) { this.inner = inner; this.skip = n; inner.TakeTo(this) }
    bool MoveNext() {
        while (this.skip > 0) {
            this.skip = this.skip - 1
            if (!this.inner.MoveNext()) { return false }
        }
        return this.inner.MoveNext()
    }
    any GetCurrent() { return this.inner.GetCurrent() }
}

class LinqTakeWhileEnumerator : IEnumerator {
    IEnumerator inner
    lambda<any> pred
    any current
    bool done
    construct(IEnumerator inner, lambda<any> pred) { this.inner = inner; this.pred = pred; this.done = false; inner.TakeTo(this) }
    bool MoveNext() {
        if (this.done) { return false }
        var p = this.pred
        if (this.inner.MoveNext()) {
            var item = this.inner.GetCurrent()
            if (p(item)) { this.current = item; return true }
        }
        this.done = true
        return false
    }
    any GetCurrent() { return this.current }
}

class LinqSkipWhileEnumerator : IEnumerator {
    IEnumerator inner
    lambda<any> pred
    bool started
    construct(IEnumerator inner, lambda<any> pred) { this.inner = inner; this.pred = pred; this.started = false; inner.TakeTo(this) }
    bool MoveNext() {
        if (this.started) { return this.inner.MoveNext() }
        this.started = true
        var p = this.pred
        while (this.inner.MoveNext()) {
            if (!p(this.inner.GetCurrent())) { return true }
        }
        return false
    }
    any GetCurrent() { return this.inner.GetCurrent() }
}

class LinqConcatEnumerator : IEnumerator {
    IEnumerator first
    IEnumerator second
    bool inSecond
    construct(IEnumerator first, IEnumerator second) { this.first = first; this.second = second; this.inSecond = false; first.TakeTo(this); second.TakeTo(this) }
    bool MoveNext() {
        if (!this.inSecond) {
            if (this.first.MoveNext()) { return true }
            this.inSecond = true
        }
        return this.second.MoveNext()
    }
    any GetCurrent() {
        if (this.inSecond) { return this.second.GetCurrent() }
        return this.first.GetCurrent()
    }
}

class LinqZipEnumerator : IEnumerator {
    IEnumerator a
    IEnumerator b
    lambda<any, any> fn
    any current
    construct(IEnumerator a, IEnumerator b, lambda<any, any> fn) { this.a = a; this.b = b; this.fn = fn; a.TakeTo(this); b.TakeTo(this) }
    bool MoveNext() {
        if (!this.a.MoveNext()) { return false }
        if (!this.b.MoveNext()) { return false }
        var f = this.fn
        this.current = f(this.a.GetCurrent(), this.b.GetCurrent())
        return true
    }
    any GetCurrent() { return this.current }
}

class LinqRangeEnumerator : IEnumerator {
    int next
    int left
    int current
    construct(int start, int count) { this.next = start; this.left = count }
    bool MoveNext() {
        if (this.left <= 0) { return false }
        this.current = this.next
        this.next = this.next + 1
        this.left = this.left - 1
        return true
    }
    int GetCurrent() { return this.current }
}

class Linq {
    // An enumerator for everything iterable: objects with GetEnumerator() and arrays (which are also IEnumerable)
    static IEnumerator Iter(IEnumerable source) { return source.GetEnumerator() }

    // Reads the member chain `path` (names from outside to inside) from `obj` - via reflection, i.e. with its access rules;
    // the last member must match `kind` ("field", "property" or "member")
    static any GetPath(any obj, any path, string kind) {
        var o = obj
        for (var i = 0; i < path.length; i = i + 1) {
            if (i == path.length - 1) {
                var actual = __refl_member_kind(o, path[i])
                if (!Reflect.KindAllowed(actual, kind)) { throw new ReflectionException(Reflect.KindMessage(path[i], actual, kind)) }
            }
            o = Reflect.Get(o, path[i])
        }
        return o
    }

    static Query<T> From<T>(IEnumerable<T> source) {
        var s = source
        var query = new Query(() => Linq.Iter(s))
        try source.TakeTo(query)   // `Linq.From(new Bag())`: a fresh argument belongs to this call - the query keeps it
        return query
    }

    // A query over a collection that was built for it (the result of an eager operator): the query owns the collection -
    // it reads it lazily, long after the function that built it has returned.
    static Query<T> FromOwned<T>(IEnumerable<T> source) {
        var s = source
        var query = new Query(() => Linq.Iter(s))
        source.TakeTo(query)
        return query
    }

    static Query<int> Range(int start, int count) {
        return new Query(() => new LinqRangeEnumerator(start, count))
    }

    static Query<T> Repeat<T>(T value, int count) {
        var items = new class[count]
        for (var i = 0; i < count; i = i + 1) { items[i] = value }
        return Linq.FromOwned(items)
    }

    // Stable sorting (merge sort): returns the `items` in the order of the `keys` (arrays of equal length)
    static any Sort(any items, any keys, bool desc) {
        var n = items.length
        var idx = new int[n]
        var tmp = new int[n]
        for (var i = 0; i < n; i = i + 1) { idx[i] = i }
        var width = 1
        while (width < n) {
            var lo = 0
            while (lo < n) {
                var mid = lo + width
                if (mid > n) { mid = n }
                var hi = lo + 2 * width
                if (hi > n) { hi = n }
                var a = lo
                var b = mid
                var k = lo
                while (a < mid && b < hi) {
                    var takeRight = false
                    if (desc) { takeRight = keys[idx[a]] < keys[idx[b]] } else { takeRight = keys[idx[b]] < keys[idx[a]] }
                    if (takeRight) { tmp[k] = idx[b]; b = b + 1 } else { tmp[k] = idx[a]; a = a + 1 }
                    k = k + 1
                }
                while (a < mid) { tmp[k] = idx[a]; a = a + 1; k = k + 1 }
                while (b < hi) { tmp[k] = idx[b]; b = b + 1; k = k + 1 }
                lo = lo + 2 * width
            }
            for (var i = 0; i < n; i = i + 1) { idx[i] = tmp[i] }
            width = width * 2
        }
        var result = new class[n]
        for (var i = 0; i < n; i = i + 1) { result[i] = items[idx[i]] }
        return result
    }
}

class Query<T> : IEnumerable<T> {
    lambda factory

    // `factory` is a lambda without parameters that supplies a fresh enumerator on every pass
    construct(lambda factory) { this.factory = factory }

    IEnumerator<T> GetEnumerator() {
        var f = this.factory
        return f()
    }

    // ---- lazy operators
    Query<T> Where(bool lambda<T> pred) {
        var f = this.factory
        return new Query(() => new LinqWhereEnumerator(f(), pred))
    }
    Query<R> Select<R>(R lambda<T> fn) {
        var f = this.factory
        return new Query(() => new LinqSelectEnumerator(f(), fn))
    }
    // Projection onto a member, chosen via selector: `list.SelectMember(p => p.name)` (field or property), `SelectField` (a field only),
    // `SelectProperty` (a property only) - the lambda must be a pure member chain (see `lambda member<T>`). Unlike
    // `Select(fn)` the access goes via reflection (with its access rules) and a member of the wrong kind is a ReflectionException.
    Query SelectField(lambda field<class> sel) {
        var f = this.factory
        var path = flat sel.Path   // (the selector dies with this call; the query keeps its own copy)
        var query = new Query(() => new LinqSelectEnumerator(f(), x => Linq.GetPath(x, path, "field")))
        path.TakeTo(query)
        return query
    }
    Query SelectProperty(lambda property<class> sel) {
        var f = this.factory
        var path = flat sel.Path   // (the selector dies with this call; the query keeps its own copy)
        var query = new Query(() => new LinqSelectEnumerator(f(), x => Linq.GetPath(x, path, "property")))
        path.TakeTo(query)
        return query
    }
    Query SelectMember(lambda member<class> sel) {
        var f = this.factory
        var path = flat sel.Path   // (the selector dies with this call; the query keeps its own copy)
        var query = new Query(() => new LinqSelectEnumerator(f(), x => Linq.GetPath(x, path, "member")))
        path.TakeTo(query)
        return query
    }
    Query SelectMany(lambda<T> fn) {
        var f = this.factory
        return new Query(() => new LinqSelectManyEnumerator(f(), fn))
    }
    Query<T> Take(int n) {
        var f = this.factory
        return new Query(() => new LinqTakeEnumerator(f(), n))
    }
    Query<T> Skip(int n) {
        var f = this.factory
        return new Query(() => new LinqSkipEnumerator(f(), n))
    }
    Query<T> TakeWhile(bool lambda<T> pred) {
        var f = this.factory
        return new Query(() => new LinqTakeWhileEnumerator(f(), pred))
    }
    Query<T> SkipWhile(bool lambda<T> pred) {
        var f = this.factory
        return new Query(() => new LinqSkipWhileEnumerator(f(), pred))
    }
    Query<T> Concat(IEnumerable<T> other) {
        var f = this.factory
        return new Query(() => new LinqConcatEnumerator(f(), Linq.Iter(other)))
    }
    Query<R> Zip<U, R>(IEnumerable<U> other, R lambda<T, U> fn) {
        var f = this.factory
        return new Query(() => new LinqZipEnumerator(f(), Linq.Iter(other), fn))
    }

    // ---- eager operators (work on a copy, return a Query again)
    Query<T> OrderBy(lambda<T> key) { return this.Ordered(key, false) }
    Query<T> OrderByDescending(lambda<T> key) { return this.Ordered(key, true) }
    Query<T> Ordered(any key, bool desc) {
        var items = this.ToArray()
        var keys = new class[items.length]
        for (var i = 0; i < items.length; i = i + 1) { keys[i] = key(items[i]) }
        return Linq.FromOwned(Linq.Sort(items, keys, desc))
    }
    Query<T> Reverse() {
        var items = this.ToArray()
        var n = items.length
        var result = new class[n]
        for (var i = 0; i < n; i = i + 1) { result[i] = items[n - 1 - i] }
        return Linq.FromOwned(result)
    }
    Query<T> Distinct() {
        var seen = new List()
        foreach (x in this) {
            var known = false
            foreach (y in seen) { if (x == y) { known = true } }
            if (!known) { seen.Add(x) }
        }
        return Linq.FromOwned(seen)
    }

    // ---- Abschluss-Operatoren
    List<T> ToList() {
        var result = new List()
        foreach (x in this) { result.Add(x) }
        return result
    }
    T[] ToArray() {
        var l = this.ToList()
        var result = new class[l.count]
        for (var i = 0; i < l.count; i = i + 1) { result[i] = l[i] }
        return result
    }
    T First() {
        foreach (x in this) { return x }
        throw new LinqEmptyException("The sequence contains no element")
    }
    T First(bool lambda<T> pred) {
        foreach (x in this) { if (pred(x)) { return x } }
        throw new LinqEmptyException("The sequence contains no matching element")
    }
    T FirstOrDefault(T fallback) {
        foreach (x in this) { return x }
        return fallback
    }
    T FirstOrDefault(bool lambda<T> pred, T fallback) {
        foreach (x in this) { if (pred(x)) { return x } }
        return fallback
    }
    T Last() {
        var found = false
        var last = undefined
        foreach (x in this) { last = x; found = true }
        if (!found) { throw new LinqEmptyException("The sequence contains no element") }
        return last
    }
    T ElementAt(int index) {
        var i = 0
        foreach (x in this) {
            if (i == index) { return x }
            i = i + 1
        }
        throw new LinqEmptyException("Index " + index + " is outside of the sequence")
    }
    bool Any() {
        foreach (x in this) { return true }
        return false
    }
    bool Any(bool lambda<T> pred) {
        foreach (x in this) { if (pred(x)) { return true } }
        return false
    }
    bool All(bool lambda<T> pred) {
        foreach (x in this) { if (!pred(x)) { return false } }
        return true
    }
    int Count() {
        var n = 0
        foreach (x in this) { n = n + 1 }
        return n
    }
    int Count(bool lambda<T> pred) {
        var n = 0
        foreach (x in this) { if (pred(x)) { n = n + 1 } }
        return n
    }
    T Sum() {
        var s = 0
        foreach (x in this) { s = s + x }
        return s
    }
    R Sum<R>(R lambda<T> fn) {
        var s = 0
        foreach (x in this) { s = s + fn(x) }
        return s
    }
    T Min() { return this.Select(x => x).Extreme(true) }
    R Min<R>(R lambda<T> fn) { return this.Select(fn).Extreme(true) }
    T Max() { return this.Select(x => x).Extreme(false) }
    R Max<R>(R lambda<T> fn) { return this.Select(fn).Extreme(false) }
    any Extreme(bool smallest) {
        var found = false
        var best = undefined
        foreach (x in this) {
            if (!found) { best = x; found = true }
            else if (smallest) { if (x < best) { best = x } }
            else { if (x > best) { best = x } }
        }
        if (!found) { throw new LinqEmptyException("The sequence contains no element") }
        return best
    }
    float Average() { return this.Average(x => x) }
    float Average(lambda<T> fn) {
        var s = 0.0
        var n = 0
        foreach (x in this) { s = s + fn(x); n = n + 1 }
        if (n == 0) { throw new LinqEmptyException("The sequence contains no element") }
        return s / n
    }
    A Aggregate<A>(A seed, A lambda<A, T> fn) {
        var acc = seed
        foreach (x in this) { acc = fn(acc, x) }
        return acc
    }
    bool Contains(T value) {
        foreach (x in this) { if (x == value) { return true } }
        return false
    }
    undefined ForEach(lambda<T> fn) {
        foreach (x in this) { fn(x) }
    }
    string Join(string separator) {
        var s = ""
        var first = true
        foreach (x in this) {
            if (!first) { s = s + separator }
            s = s + x
            first = false
        }
        return s
    }
}
class extends List {
    Query<T> Where(bool lambda<T> pred) { return Linq.From(this).Where(pred) }
    Query<R> Select<R>(R lambda<T> fn) { return Linq.From(this).Select(fn) }
    Query SelectField(lambda field<class> sel) { return Linq.From(this).SelectField(sel) }
    Query SelectProperty(lambda property<class> sel) { return Linq.From(this).SelectProperty(sel) }
    Query SelectMember(lambda member<class> sel) { return Linq.From(this).SelectMember(sel) }
    Query SelectMany(lambda<T> fn) { return Linq.From(this).SelectMany(fn) }
    Query<T> Take(int n) { return Linq.From(this).Take(n) }
    Query<T> Skip(int n) { return Linq.From(this).Skip(n) }
    Query<T> TakeWhile(bool lambda<T> pred) { return Linq.From(this).TakeWhile(pred) }
    Query<T> SkipWhile(bool lambda<T> pred) { return Linq.From(this).SkipWhile(pred) }
    Query<T> Concat(IEnumerable<T> other) { return Linq.From(this).Concat(other) }
    Query<R> Zip<U, R>(IEnumerable<U> other, R lambda<T, U> fn) { return Linq.From(this).Zip(other, fn) }
    Query<T> OrderBy(lambda<T> key) { return Linq.From(this).OrderBy(key) }
    Query<T> OrderByDescending(lambda<T> key) { return Linq.From(this).OrderByDescending(key) }
    Query<T> Reverse() { return Linq.From(this).Reverse() }
    Query<T> Distinct() { return Linq.From(this).Distinct() }
    T[] ToArray() { return Linq.From(this).ToArray() }
    T First() { return Linq.From(this).First() }
    T First(bool lambda<T> pred) { return Linq.From(this).First(pred) }
    T FirstOrDefault(T fallback) { return Linq.From(this).FirstOrDefault(fallback) }
    T FirstOrDefault(bool lambda<T> pred, T fallback) { return Linq.From(this).FirstOrDefault(pred, fallback) }
    T Last() { return Linq.From(this).Last() }
    T ElementAt(int index) { return Linq.From(this).ElementAt(index) }
    bool Any() { return Linq.From(this).Any() }
    bool Any(bool lambda<T> pred) { return Linq.From(this).Any(pred) }
    bool All(bool lambda<T> pred) { return Linq.From(this).All(pred) }
    int Count() { return Linq.From(this).Count() }
    int Count(bool lambda<T> pred) { return Linq.From(this).Count(pred) }
    T Sum() { return Linq.From(this).Sum() }
    R Sum<R>(R lambda<T> fn) { return Linq.From(this).Sum(fn) }
    T Min() { return Linq.From(this).Min() }
    R Min<R>(R lambda<T> fn) { return Linq.From(this).Min(fn) }
    T Max() { return Linq.From(this).Max() }
    R Max<R>(R lambda<T> fn) { return Linq.From(this).Max(fn) }
    float Average() { return Linq.From(this).Average() }
    float Average(lambda<T> fn) { return Linq.From(this).Average(fn) }
    A Aggregate<A>(A seed, A lambda<A, T> fn) { return Linq.From(this).Aggregate(seed, fn) }
    bool Contains(T value) { return Linq.From(this).Contains(value) }
    undefined ForEach(lambda<T> fn) { return Linq.From(this).ForEach(fn) }
    string Join(string separator) { return Linq.From(this).Join(separator) }
    List<T> ToList() { return new List(this.ToArray()) }
}

class extends array {
    Query<any> Where(bool lambda<any> pred) { return Linq.From(this).Where(pred) }
    Query<R> Select<R>(R lambda<any> fn) { return Linq.From(this).Select(fn) }
    Query SelectField(lambda field<class> sel) { return Linq.From(this).SelectField(sel) }
    Query SelectProperty(lambda property<class> sel) { return Linq.From(this).SelectProperty(sel) }
    Query SelectMember(lambda member<class> sel) { return Linq.From(this).SelectMember(sel) }
    Query SelectMany(lambda<any> fn) { return Linq.From(this).SelectMany(fn) }
    Query<any> Take(int n) { return Linq.From(this).Take(n) }
    Query<any> Skip(int n) { return Linq.From(this).Skip(n) }
    Query<any> TakeWhile(bool lambda<any> pred) { return Linq.From(this).TakeWhile(pred) }
    Query<any> SkipWhile(bool lambda<any> pred) { return Linq.From(this).SkipWhile(pred) }
    Query<any> Concat(IEnumerable<any> other) { return Linq.From(this).Concat(other) }
    Query<R> Zip<U, R>(IEnumerable<U> other, R lambda<any, U> fn) { return Linq.From(this).Zip(other, fn) }
    Query<any> OrderBy(lambda<any> key) { return Linq.From(this).OrderBy(key) }
    Query<any> OrderByDescending(lambda<any> key) { return Linq.From(this).OrderByDescending(key) }
    Query<any> Reverse() { return Linq.From(this).Reverse() }
    Query<any> Distinct() { return Linq.From(this).Distinct() }
    any[] ToArray() { return Linq.From(this).ToArray() }
    any First() { return Linq.From(this).First() }
    any First(bool lambda<any> pred) { return Linq.From(this).First(pred) }
    any FirstOrDefault(any fallback) { return Linq.From(this).FirstOrDefault(fallback) }
    any FirstOrDefault(bool lambda<any> pred, any fallback) { return Linq.From(this).FirstOrDefault(pred, fallback) }
    any Last() { return Linq.From(this).Last() }
    any ElementAt(int index) { return Linq.From(this).ElementAt(index) }
    bool Any() { return Linq.From(this).Any() }
    bool Any(bool lambda<any> pred) { return Linq.From(this).Any(pred) }
    bool All(bool lambda<any> pred) { return Linq.From(this).All(pred) }
    int Count() { return Linq.From(this).Count() }
    int Count(bool lambda<any> pred) { return Linq.From(this).Count(pred) }
    any Sum() { return Linq.From(this).Sum() }
    R Sum<R>(R lambda<any> fn) { return Linq.From(this).Sum(fn) }
    any Min() { return Linq.From(this).Min() }
    R Min<R>(R lambda<any> fn) { return Linq.From(this).Min(fn) }
    any Max() { return Linq.From(this).Max() }
    R Max<R>(R lambda<any> fn) { return Linq.From(this).Max(fn) }
    float Average() { return Linq.From(this).Average() }
    float Average(lambda<any> fn) { return Linq.From(this).Average(fn) }
    A Aggregate<A>(A seed, A lambda<A, any> fn) { return Linq.From(this).Aggregate(seed, fn) }
    bool Contains(any value) { return Linq.From(this).Contains(value) }
    undefined ForEach(lambda<any> fn) { return Linq.From(this).ForEach(fn) }
    string Join(string separator) { return Linq.From(this).Join(separator) }
    List ToList() { return new List(this) }
}
