#import "graphics"

enum Template { Box = 0, Sphere = 1, Cylinder = 2, Cone = 3, Plane = 4, Quad = 5 }
enum BillboardMode { Off = 0, Facing = 1, Vertical = 2 }
enum LightKind { Ambient = 0, Directional = 1, Point = 2 }
// Who draws a scene: the software renderer (everywhere, the same pixels everywhere), the GPU (Vulkan; where there is none, the software renderer draws), or the lean
// renderer (Fast: light per corner, no shadows yet, little memory - the picture is drawn in bands straight into the framebuffer, also in its palette; for old and small machines).
enum RenderMode { Software = 0, Hardware = 1, Fast = 2 }

class Scene3DException : Exception {
    construct(string message) : base(message) { }
}

// Units: lengths in meters, angles in radians (the units of the language convert, a number without a unit is refused).
class S3D {
    static float Length(any v) {
        if (!(v is in m)) { throw new Scene3DException("A length needs a unit of length (m, cm, mm, ...), got: " + v) }
        any f = v * 1.0
        return (f:m) / 1m
    }

    static float Angle(any v) {
        if (v is in deg) {
            any d = v * 1.0
            return ((d:deg) / 1deg) * 0.017453292519943295
        }
        if (v is in rad) {
            any r = v * 1.0
            return (r:rad) / 1rad
        }
        throw new Scene3DException("An angle needs a unit (deg or rad), got: " + v)
    }

    // A time in seconds (s, ms, min, ...: a number without a unit is refused).
    static float Seconds(any v) {
        if (!(v is in s)) { throw new Scene3DException("A time needs a unit of time (s, ms, ...), got: " + v) }
        any f = v * 1.0
        return (f:s) / 1s
    }

    // A speed in meters a second (m/s, km/h, ...).
    static defined float Speed(defined float v : m/s) { return v / (1m / 1s) }

    static defined float:m Meters(defined float m) { return m * 1m }
    static defined float:deg Degrees(defined float radians) { return (radians * 57.29577951308232) * 1deg }

    // The colour 0xAABBGGRR as three fractions.
    static defined float Red(defined int c) { return (c & 255) / 255.0 }
    static defined float Green(defined int c) { return ((c >> 8) & 255) / 255.0 }
    static defined float Blue(defined int c) { return ((c >> 16) & 255) / 255.0 }

    // A colour from its parts (0..255 each).
    static defined int Rgb(defined int r, defined int g, defined int b) { return r + g * 256 + b * 65536 + 255 * 16777216 }
    // A colour with its alpha (0 transparent .. 255 solid).
    static defined int Rgba(defined int r, defined int g, defined int b, defined int a) { return r + g * 256 + b * 65536 + a * 16777216 }

    // The GPU that RenderMode.Hardware draws with ("" when there is none: no Vulkan, no driver, no GPU; HardwareError says why).
    static string HardwareName() { return __S3DHardwareName() }

    // Why there is no GPU to draw with ("" when there is one).
    static string HardwareError() {
        __S3DHardwareName()
        return __S3DHardwareError()
    }
}

// The triangles of an object, to be shared by objects: from a template, from the text of a Wavefront OBJ file, from arrays - or a model of fire's own file (.f3d,
// docs/graphics/models.md): parts in a tree with their colours, and animations (Object.Play). forge makes .f3d from glTF 2.0 (a resource "x.gltf"/"x.glb" is
// converted when the program is built, `forge model x.gltf`).
class Model {
    int handle
    int model

    // (the handle of a mesh: use FromObj, FromArrays or FromTemplate)
    construct(int handle) {
        this.handle = handle
        this.model = 0
    }

    destruct() {
        if (this.handle > 0) { __S3DMeshFree(this.handle) }
        if (this.model > 0) { __S3DModelFree(this.model) }
    }

    // A model from the bytes of an .f3d file.
    static Model FromBytes(byte data[]) {
        var h = __S3DModelRead(data)
        if (h == 0) { throw new Scene3DException("The bytes are not a model (an .f3d file is expected - forge makes one from glTF: a resource \"x.gltf\" is converted when the program is built).") }
        var m = new Model(0)
        m.model = h
        return m
    }

    // A model from a resource of the program (`Model.FromResource(new Resource("robot.gltf"))`: glTF is made an .f3d when the program is built).
    static Model FromResource(any resource) { return Model.FromBytes(resource.Bytes()) }

    // The parts of a model file (1 for a mesh), its animations and their lengths.
    int Parts {
        get {
            if (this.model > 0) { return __S3DModelInfo(this.model, 0) }
            return 1
        }
    }
    List Animations {
        get {
            var list = new List()
            if (this.model > 0) {
                var n = __S3DModelInfo(this.model, 1)
                for (var i = 0; i < n; i++) { list.Add(__S3DModelName(this.model, 0, i)) }
            }
            return list
        }
    }
    float:s AnimationLength(string name) {
        if (this.model > 0) {
            var n = __S3DModelInfo(this.model, 1)
            for (var i = 0; i < n; i++) {
                if (__S3DModelName(this.model, 0, i) == name) { return __S3DModelClipLength(this.model, i) * 1s }
            }
        }
        throw new Scene3DException("The model has no animation '" + name + "'.")
    }

    // `v`, `vt` and `f` lines (polygons are cut into triangles); the normals are computed. The unit of the coordinates is the meter.
    static Model FromObj(string text) {
        var h = __S3DMeshFromObj(text)
        if (h == 0) { throw new Scene3DException("The text holds no triangles (a Wavefront OBJ file with v and f lines is expected).") }
        return new Model(h)
    }

    // Positions: x, y, z per vertex (meters); uvs: u, v per vertex (or an empty array); indices: three per triangle, counter clockwise seen from outside.
    static Model FromArrays(float positions[], float uvs[], int indices[]) {
        var h = __S3DMeshNew(positions, uvs, indices)
        if (h == 0) { throw new Scene3DException("The arrays do not make a mesh (3 numbers per vertex, 2 per texture coordinate, 3 indices per triangle, indices below the number of vertices).") }
        return new Model(h)
    }

    // A box, sphere, cylinder, cone, plane or quad of the size 1m (a plane is 1m x 1m lying down, a quad 1m x 1m standing, facing +Z); `detail` is the number of segments around a round shape.
    static Model FromTemplate(Template template, int detail = 24) {
        var h = __S3DMeshTemplate(template!int, detail)
        if (h == 0) { throw new Scene3DException("Unknown template: " + template) }
        return new Model(h)
    }

    int Triangles {
        get {
            if (this.model > 0) { return __S3DModelInfo(this.model, 2) }
            return __S3DMeshTriangleCount(this.handle)
        }
    }
}

// How a surface answers to light: Specular is the strength of the highlights (0 = matt), Shininess how small they are, Smooth shades with the interpolated normals (false: every triangle
// flat), TwoSided draws both sides of a triangle, Emissive is a colour that the surface gives off by itself.
// (The scene lives in the renderer: objects, lights, cameras, materials and scenes are items there, and their properties read and write the slots of the item -
// fire_bridge_scene3d.h lists them. Nothing is put together in fire for every picture.)
class Material {
    int h

    construct(float specular = 0.0, float shininess = 32.0, bool smooth = true, bool twoSided = false, int emissive = 0) {
        this.h = __S3DNew(5)
        if (this.h == 0) { throw new Scene3DException("No memory for a material.") }
        this.Specular = specular
        this.Shininess = shininess
        this.Smooth = smooth
        this.TwoSided = twoSided
        this.Emissive = emissive
    }

    destruct() { __S3DFree(this.h) }

    float Specular { get { return __S3DGetF(this.h, 0) } set { __S3DSetF(this.h, 0, value) } }
    float Shininess { get { return __S3DGetF(this.h, 1) } set { __S3DSetF(this.h, 1, value) } }
    bool Smooth { get { return __S3DGetB(this.h, 0) } set { __S3DSetI(this.h, 0, value) } }
    bool TwoSided { get { return __S3DGetB(this.h, 1) } set { __S3DSetI(this.h, 1, value) } }
    int Emissive { get { return __S3DGetI(this.h, 2) } set { __S3DSetI(this.h, 2, value) } }

    static Material Matte() { return new Material(0.0, 32.0) }
    static Material Plastic() { return new Material(0.4, 32.0) }
    static Material Metal() { return new Material(0.9, 96.0) }
}

// A picture to put on objects (RGBA). It belongs to a scene (scene.Add(texture, "key")) or is assigned to an object directly.
class Texture {
    int handle
    int width
    int height

    // From a framebuffer in the colour mode Rgba (the pixels are copied).
    construct(Framebuffer source) {
        this.width = source.Width()
        this.height = source.Height()
        this.handle = __S3DTexNew(this.width, this.height, source.ReadBytes())
        if (this.handle == 0) { throw new Scene3DException("The framebuffer cannot be a texture (it has to be in the colour mode Rgba).") }
    }

    construct(int width, int height, byte bytes[]) {
        this.handle = __S3DTexNew(width, height, bytes)
        this.width = width
        this.height = height
        if (this.handle == 0) { throw new Scene3DException("A texture needs width * height * 4 bytes (R, G, B, A per pixel).") }
    }

    // (the handle of a picture of the renderer: use Checker)
    construct(int handle, int width, int height, bool made) {
        this.handle = handle
        this.width = width
        this.height = height
    }

    destruct() {
        if (this.handle > 0) { __S3DTexFree(this.handle) }
    }

    // A checker board of cells x cells squares (the colours are 0xAABBGGRR) in a picture of size x size pixels.
    static Texture Checker(int size = 64, int cells = 8, int colorA = 4294967295, int colorB = 4282400832) {
        var h = __S3DTexChecker(size, cells, colorA, colorB)
        if (h == 0) { throw new Scene3DException("A checker board needs 1 <= cells <= size <= 4096.") }
        return new Texture(h, size, size, true)
    }

    int Width { get { return this.width } }
    int Height { get { return this.height } }
    // Whether the texture has a bump map.
    bool hasBump { get { return __S3DTexHasBump(this.handle) } }
    // How strongly the bump map tilts the light (1 = a full step of the heights over one texel is a slope of 45 degrees).
    float BumpStrength { get { return __S3DTexStrength(this.handle) } set { __S3DTexSetStrength(this.handle, value) } }

    // A bump map made from the brightness of the texture itself: bright is high, dark is low (a little smoothed).
    undefined AddBumpmap() {
        if (!__S3DTexBumpAuto(this.handle)) { throw new Scene3DException("The texture cannot get a bump map.") }
    }

    // A bump map from a picture (a framebuffer in the colour mode Rgba): its brightness is the height. A picture of another size is scaled to the texture.
    undefined AddBumpmap(Framebuffer source) {
        if (!__S3DTexBump(this.handle, source.Width(), source.Height(), 4, source.ReadBytes())) { throw new Scene3DException("The picture cannot be a bump map (it has to be in the colour mode Rgba).") }
    }

    // A bump map from bytes: width * height heights (0..255), or width * height * 4 bytes (R, G, B, A) whose brightness is the height.
    undefined AddBumpmap(int width, int height, byte bytes[]) {
        var channels = 1
        if (bytes.length == width * height * 4) { channels = 4 }
        else if (bytes.length != width * height) { throw new Scene3DException("A bump map needs width * height bytes (heights) or width * height * 4 bytes (R, G, B, A).") }
        if (!__S3DTexBump(this.handle, width, height, channels, bytes)) { throw new Scene3DException("The bytes cannot be a bump map.") }
    }

    // Takes the bump map away again.
    undefined RemoveBumpmap() { __S3DTexBumpClear(this.handle) }
}

// A light: ambient (everywhere), directional (parallel rays, like the sun) or point (from a place, weaker with the distance).
class Light {
    int h

    construct(LightKind kind = LightKind.Point, int color = 4294967295, float intensity = 1.0) {
        this.h = __S3DNew(2)
        if (this.h == 0) { throw new Scene3DException("No memory for a light.") }
        __S3DSetI(this.h, 0, kind!int)
        __S3DSetI(this.h, 1, color)
        __S3DSetF(this.h, 0, intensity)
    }

    destruct() { __S3DFree(this.h) }

    static Light Ambient(int color = 4294967295, float intensity = 0.3) { return new Light(LightKind.Ambient, color, intensity) }

    // Rays that travel in the direction (dx, dy, dz) (a vector without a unit).
    static Light Directional(float dx, float dy, float dz, int color = 4294967295, float intensity = 1.0) {
        var l = new Light(LightKind.Directional, color, intensity)
        l.Direction(dx, dy, dz)
        return l
    }

    static Light Point(float x : any m, float y : any m, float z : any m, int color = 4294967295, float intensity = 1.0) {
        var l = new Light(LightKind.Point, color, intensity)
        __S3DSetF3(l.h, 1, S3D.Length(x), S3D.Length(y), S3D.Length(z), false)
        return l
    }

    undefined Direction(float dx, float dy, float dz) { __S3DSetF3(this.h, 4, dx, dy, dz, false) }

    LightKind Kind { get { return __S3DGetI(this.h, 0)!LightKind } set { __S3DSetI(this.h, 0, value!int) } }
    int Color { get { return __S3DGetI(this.h, 1) } set { __S3DSetI(this.h, 1, value) } }
    float Intensity { get { return __S3DGetF(this.h, 0) } set { __S3DSetF(this.h, 0, value) } }
    float X : m { get { return __S3DGetF(this.h, 1) * 1m } set { __S3DSetF(this.h, 1, S3D.Length(value)) } }
    float Y : m { get { return __S3DGetF(this.h, 2) * 1m } set { __S3DSetF(this.h, 2, S3D.Length(value)) } }
    float Z : m { get { return __S3DGetF(this.h, 3) * 1m } set { __S3DSetF(this.h, 3, S3D.Length(value)) } }
    // The distance at which a point light has half of its strength.
    float Range : m { get { return __S3DGetF(this.h, 7) * 1m } set { __S3DSetF(this.h, 7, S3D.Length(value)) } }
    // false: the light is off (it lights nothing and casts no shadow).
    bool Enabled { get { return __S3DGetB(this.h, 2) } set { __S3DSetI(this.h, 2, value) } }
    // Whether what the light hits throws shadows (the scene's Shadows has to be on, too).
    bool CastShadows { get { return __S3DGetB(this.h, 3) } set { __S3DSetI(this.h, 3, value) } }
    // The layers of objects that it lights: a number whose bits (1, 2, 4, ... up to 8388608) are layers; an object is lit when it shares a layer with the light (default: all).
    int Layers { get { return __S3DGetI(this.h, 4) } set { __S3DSetI(this.h, 4, value) } }
}

// Something in the scene with triangles, a position, a size and a look.
class Object {
    int h
    Texture texture
    Material material
    string Key

    // An empty object: add triangles with AddTriangle.
    construct() { this.Init() }

    // An object from a model (or from the text of a Wavefront OBJ file): at the origin, in the size of the model.
    construct(any modelData) {
        this.Init()
        any model = modelData
        if (modelData is of string) { model = Model.FromObj(modelData) }
        if (!(model is of Model)) { throw new Scene3DException("An object is made from a Model or the text of an OBJ file.") }
        if (model.model > 0) { __S3DObjModel(this.h, model.model) }
        else { __S3DObjMesh(this.h, model.handle) }
    }

    // ---- animations of a model (an object made from a model file with clips) ----
    // Plays the animation from its start (looping as the model says, or as `loop` says); Play("") shows the rest pose.
    undefined Play(string name) {
        if (!__S3DObjPlay(this.h, name, -1)) { throw new Scene3DException("The object's model has no animation '" + name + "'.") }
    }
    undefined Play(string name, bool loop) {
        var l = 0
        if (loop) { l = 1 }
        if (!__S3DObjPlay(this.h, name, l)) { throw new Scene3DException("The object's model has no animation '" + name + "'.") }
    }
    // Stops where it is (Play starts again; AnimationTime can still be set).
    undefined Stop() { __S3DObjAnimate(this.h, 3, 0.0) }
    // The time goes on for the object (call it every frame with the time that passed: obj.Advance(16ms); Scene.Advance does it for all objects): its animation,
    // its spin, the scroll of its texture, its particles (scene3d.effects).
    undefined Advance(float time : any s) { __S3DObjAdvance(this.h, S3D.Seconds(time)) }
    // The time in the animation (set it to show a moment of it).
    float AnimationTime : s {
        get { return __S3DObjAnimate(this.h, 2, 0.0) * 1s }
        set { __S3DObjAnimate(this.h, 1, S3D.Seconds(value)) }
    }
    // The name of the animation ("" none) and whether it runs (an animation that does not loop stops at its end).
    string Animation { get { return __S3DObjClip(this.h, 0) } }
    bool Playing { get { return __S3DObjClip(this.h, 1) != "" } }

    // From a template (Template.Box, Sphere, Cylinder, Cone, Plane, Quad): at (x, y, z), the outer dimensions width, height and depth (a plane has no height, a quad no depth: pass 0m).
    construct(Template template, float x : any m, float y : any m, float z : any m, float width : any m, float height : any m, float depth : any m, int detail = 24) {
        this.Init()
        var m = __S3DMeshTemplate(template!int, detail)
        if (m == 0) { throw new Scene3DException("Unknown template: " + template) }
        __S3DObjMesh(this.h, m)
        __S3DMeshFree(m)
        if (template == Template.Plane || template == Template.Quad) { __S3DSetI(this.h, 2, true) }
        this.SetPosition(x, y, z)
        this.Width = width
        if (template != Template.Plane) { this.Height = height }
        if (template != Template.Quad) { this.Depth = depth }
    }

    destruct() { __S3DFree(this.h) }

    undefined Init() {
        this.h = __S3DNew(1)
        if (this.h == 0) { throw new Scene3DException("No memory for an object.") }
        this.Key = ""
    }

    // ---- position, rotation, anchor ----
    float X : m { get { return __S3DGetF(this.h, 0) * 1m } set { __S3DSetF(this.h, 0, S3D.Length(value)) } }
    float Y : m { get { return __S3DGetF(this.h, 1) * 1m } set { __S3DSetF(this.h, 1, S3D.Length(value)) } }
    float Z : m { get { return __S3DGetF(this.h, 2) * 1m } set { __S3DSetF(this.h, 2, S3D.Length(value)) } }
    float RotationX : any { get { return S3D.Degrees(__S3DGetF(this.h, 3)) } set { __S3DSetF(this.h, 3, S3D.Angle(value)) } }
    float RotationY : any { get { return S3D.Degrees(__S3DGetF(this.h, 4)) } set { __S3DSetF(this.h, 4, S3D.Angle(value)) } }
    float RotationZ : any { get { return S3D.Degrees(__S3DGetF(this.h, 5)) } set { __S3DSetF(this.h, 5, S3D.Angle(value)) } }

    // Where the position takes hold of the object, as a fraction of its width, height and depth (default 0.5: the centre).
    float AnchorX { get { return __S3DGetF(this.h, 9) } set { __S3DSetF(this.h, 9, value) } }
    float AnchorY { get { return __S3DGetF(this.h, 10) } set { __S3DSetF(this.h, 10, value) } }
    float AnchorZ { get { return __S3DGetF(this.h, 11) } set { __S3DSetF(this.h, 11, value) } }

    undefined SetPosition(float x : any m, float y : any m, float z : any m) { __S3DSetF3(this.h, 0, S3D.Length(x), S3D.Length(y), S3D.Length(z), false) }
    undefined SetAnchor(float x, float y, float z) { __S3DSetF3(this.h, 9, x, y, z, false) }
    undefined SetRotation(float x : any, float y : any, float z : any) { __S3DSetF3(this.h, 3, S3D.Angle(x), S3D.Angle(y), S3D.Angle(z), false) }
    undefined Move(float dx : any m, float dy : any m, float dz : any m) { __S3DSetF3(this.h, 0, S3D.Length(dx), S3D.Length(dy), S3D.Length(dz), true) }
    undefined Rotate(float x : any, float y : any, float z : any) { __S3DSetF3(this.h, 3, S3D.Angle(x), S3D.Angle(y), S3D.Angle(z), true) }

    // ---- size: the outer dimensions (what is set becomes the scale of the axis) ----
    // (the size of the mesh itself, before it is scaled)
    float MeshWidth() { return __S3DObjExtent(this.h, 0, false) }
    float MeshHeight() { return __S3DObjExtent(this.h, 1, false) }
    float MeshDepth() { return __S3DObjExtent(this.h, 2, false) }

    float Width : m {
        get { return __S3DObjExtent(this.h, 0, true) * 1m }
        set { if (!__S3DObjSize(this.h, 0, S3D.Length(value))) { throw new Scene3DException("This object has no width to scale.") } }
    }
    float Height : m {
        get { return __S3DObjExtent(this.h, 1, true) * 1m }
        set { if (!__S3DObjSize(this.h, 1, S3D.Length(value))) { throw new Scene3DException("This object has no height to scale.") } }
    }
    float Depth : m {
        get { return __S3DObjExtent(this.h, 2, true) * 1m }
        set { if (!__S3DObjSize(this.h, 2, S3D.Length(value))) { throw new Scene3DException("This object has no depth to scale.") } }
    }

    undefined SetSize(float width : any m, float height : any m, float depth : any m) {
        this.Width = width
        this.Height = height
        this.Depth = depth
    }

    // The scale factors themselves (1 = the size of the mesh).
    float ScaleX { get { return __S3DGetF(this.h, 6) } set { __S3DSetF(this.h, 6, value) } }
    float ScaleY { get { return __S3DGetF(this.h, 7) } set { __S3DSetF(this.h, 7, value) } }
    float ScaleZ { get { return __S3DGetF(this.h, 8) } set { __S3DSetF(this.h, 8, value) } }

    // ---- look ----
    // The colour (0xAABBGGRR, S3D.Rgb).
    int Color { get { return __S3DGetI(this.h, 0) } set { __S3DSetI(this.h, 0, value) } }
    bool Visible { get { return __S3DGetB(this.h, 1) } set { __S3DSetI(this.h, 1, value) } }
    // 1 = solid, below that the object is see-through (a texture with transparent pixels is see-through, too). Transparent objects are drawn after the solid ones, from far to near.
    float Opacity { get { return __S3DGetF(this.h, 17) } set { __S3DSetF(this.h, 17, value) } }
    // Above 0: pixels of the texture that are more transparent than this are left out completely and the rest is solid (leaves, fences: no sorting problems).
    float AlphaCutoff { get { return __S3DGetF(this.h, 18) } set { __S3DSetF(this.h, 18, value) } }
    // false: no lighting, the colour as it is.
    bool Lit { get { return __S3DGetB(this.h, 3) } set { __S3DSetI(this.h, 3, value) } }
    // Whether the object throws shadows / shows the shadows of others (a transparent object throws none).
    bool CastShadows { get { return __S3DGetB(this.h, 4) } set { __S3DSetI(this.h, 4, value) } }
    bool ReceiveShadows { get { return __S3DGetB(this.h, 5) } set { __S3DSetI(this.h, 5, value) } }
    // The layers of the object (see Light.Layers): only lights that share a layer with it light it (default: all).
    int Layers { get { return __S3DGetI(this.h, 6) } set { __S3DSetI(this.h, 6, value) } }
    // BillboardMode.Facing: the object always faces the camera (Template.Quad: sprites, labels); Vertical: it turns around the vertical axis only (trees).
    BillboardMode Billboard { get { return __S3DGetI(this.h, 7)!BillboardMode } set { __S3DSetI(this.h, 7, value!int) } }

    Texture Texture {
        get { return this.texture }
        set {
            if (value != undefined) { try value.TakeTo(this) }
            this.texture = value
            var t = 0
            if (value != undefined) { t = value.handle }
            __S3DObjTexture(this.h, t)
        }
    }

    Material Material {
        get { return this.material }
        set {
            if (value != undefined) { try value.TakeTo(this) }
            this.material = value
            var m = 0
            if (value != undefined) { m = value.h }
            __S3DObjMaterial(this.h, m)
        }
    }

    // The part of the object one copy of the texture covers (default: the whole object once); a smaller size repeats the texture.
    float TextureWidth : m { get { return __S3DGetF(this.h, 14) * 1m } set { __S3DSetF(this.h, 14, S3D.Length(value)) } }
    float TextureHeight : m { get { return __S3DGetF(this.h, 15) * 1m } set { __S3DSetF(this.h, 15, S3D.Length(value)) } }
    // Where the texture starts on the object, and its rotation.
    float TextureX : m { get { return __S3DGetF(this.h, 12) * 1m } set { __S3DSetF(this.h, 12, S3D.Length(value)) } }
    float TextureY : m { get { return __S3DGetF(this.h, 13) * 1m } set { __S3DSetF(this.h, 13, S3D.Length(value)) } }
    float TextureRotation : any { get { return S3D.Degrees(__S3DGetF(this.h, 16)) } set { __S3DSetF(this.h, 16, S3D.Angle(value)) } }

    // ---- movement by itself (Advance moves it on) ----
    // How far the object turns in a second about each axis (90deg: a quarter turn a second).
    float SpinX : any { get { return S3D.Degrees(__S3DGetF(this.h, 19)) } set { __S3DSetF(this.h, 19, S3D.Angle(value)) } }
    float SpinY : any { get { return S3D.Degrees(__S3DGetF(this.h, 20)) } set { __S3DSetF(this.h, 20, S3D.Angle(value)) } }
    float SpinZ : any { get { return S3D.Degrees(__S3DGetF(this.h, 21)) } set { __S3DSetF(this.h, 21, S3D.Angle(value)) } }
    undefined SetSpin(float x : any, float y : any, float z : any) { __S3DSetF3(this.h, 19, S3D.Angle(x), S3D.Angle(y), S3D.Angle(z), false) }
    // How fast the texture runs over the object (water, lava, a conveyor belt): TextureX / TextureY move on by this much a second.
    defined float TextureScrollX : m/s { get { return __S3DGetF(this.h, 22) * 1m / 1s } set { __S3DSetF(this.h, 22, S3D.Speed(value)) } }
    defined float TextureScrollY : m/s { get { return __S3DGetF(this.h, 23) * 1m / 1s } set { __S3DSetF(this.h, 23, S3D.Speed(value)) } }

    int Triangles { get { return __S3DObjTriangles(this.h) } }

    // ---- triangles of an empty object (coordinates in meters, counter clockwise seen from outside) ----
    undefined AddTriangle(float x1 : any m, float y1 : any m, float z1 : any m, float x2 : any m, float y2 : any m, float z2 : any m, float x3 : any m, float y3 : any m, float z3 : any m) {
        if (!(__S3DObjCorner(this.h, S3D.Length(x1), S3D.Length(y1), S3D.Length(z1)) && __S3DObjCorner(this.h, S3D.Length(x2), S3D.Length(y2), S3D.Length(z2))
            && __S3DObjCorner(this.h, S3D.Length(x3), S3D.Length(y3), S3D.Length(z3)))) {
            throw new Scene3DException("Only an empty object takes triangles.")
        }
    }
}

// The view of a camera on its scene, drawn into a framebuffer (in the colour mode Rgba).
class Camera {
    int h
    Framebuffer framebuffer
    byte pixels[]
    byte clearBytes[]
    Scene scene
    string Key

    construct(Framebuffer target) {
        this.framebuffer = target
        try target.TakeTo(this)
        this.h = __S3DNew(3)
        if (this.h == 0) { throw new Scene3DException("No memory for a camera.") }
        this.Key = ""
    }

    destruct() { __S3DFree(this.h) }

    Framebuffer Framebuffer { get { return this.framebuffer } }
    float X : m { get { return __S3DGetF(this.h, 0) * 1m } set { __S3DSetF(this.h, 0, S3D.Length(value)) } }
    float Y : m { get { return __S3DGetF(this.h, 1) * 1m } set { __S3DSetF(this.h, 1, S3D.Length(value)) } }
    float Z : m { get { return __S3DGetF(this.h, 2) * 1m } set { __S3DSetF(this.h, 2, S3D.Length(value)) } }
    float RotationX : any { get { return S3D.Degrees(__S3DGetF(this.h, 3)) } set { __S3DSetF(this.h, 3, S3D.Angle(value)) } }
    float RotationY : any { get { return S3D.Degrees(__S3DGetF(this.h, 4)) } set { __S3DSetF(this.h, 4, S3D.Angle(value)) } }
    float RotationZ : any { get { return S3D.Degrees(__S3DGetF(this.h, 5)) } set { __S3DSetF(this.h, 5, S3D.Angle(value)) } }
    // The vertical angle of view (default 60deg).
    float FieldOfView : any {
        get { return S3D.Degrees(__S3DGetF(this.h, 6)) }
        set {
            var a = S3D.Angle(value)
            if (a < 0.01 || a > 3.0) { throw new Scene3DException("The field of view has to be between about 1deg and 170deg.") }
            __S3DSetF(this.h, 6, a)
        }
    }
    // What is nearer than Near or farther than Far is not drawn.
    float Near : m { get { return __S3DGetF(this.h, 7) * 1m } set { __S3DSetF(this.h, 7, S3D.Length(value)) } }
    float Far : m { get { return __S3DGetF(this.h, 8) * 1m } set { __S3DSetF(this.h, 8, S3D.Length(value)) } }
    // The colour of what no object covers (0xAABBGGRR).
    int Background { get { return __S3DGetI(this.h, 0) } set { __S3DSetI(this.h, 0, value) } }
    // true: with the scene's RenderMode.Hardware the pictures go straight from the GPU into the window that shows the framebuffer, without the way through the framebuffer.
    // The framebuffer is then cleared to transparent by Render: what the program draws into it afterwards is laid over the picture (a HUD). Where that is not possible (no GPU,
    // no window, a window system the GPU cannot draw into) the camera draws as without.
    bool DirectDrawing { get { return __S3DGetB(this.h, 1) } set { __S3DSetI(this.h, 1, value) } }

    undefined SetPosition(float x : any m, float y : any m, float z : any m) { __S3DSetF3(this.h, 0, S3D.Length(x), S3D.Length(y), S3D.Length(z), false) }

    // Turns the camera (pitch and yaw, no roll) towards a point.
    undefined LookAt(float x : any m, float y : any m, float z : any m) { __S3DCamLookAt(this.h, S3D.Length(x), S3D.Length(y), S3D.Length(z)) }

    // Draws what the camera sees into its framebuffer.
    undefined Render() {
        if (this.scene == undefined) { throw new Scene3DException("The camera is not in a scene: scene.Add(camera).") }
        var w = this.framebuffer.Width()
        var h = this.framebuffer.Height()
        var lean = __S3DLean()
        if (this.scene.Renderer == RenderMode.Fast || (lean & 2) != 0) {
            // the lean renderer: straight into the framebuffer where it can (a native build), else through a picture of the camera
            var mode = this.framebuffer.Mode()
            var drawn = 0
            if ((lean & 1) != 0) { drawn = __S3DRenderLean(this.h, this.scene.h, this.framebuffer.id, w, h, mode, undefined, undefined) }
            else {
                var size = w * h * 4
                if (mode == 1) { size = w * h }
                if (this.pixels == undefined || this.pixels.length != size) { this.pixels = new byte[size] }
                any palette = undefined
                if (mode == 1) { palette = this.framebuffer.ReadPalette(true) }
                drawn = __S3DRenderLean(this.h, this.scene.h, this.framebuffer.id, w, h, mode, this.pixels, palette)
                if (drawn == 0) { this.framebuffer.WriteBytes(this.pixels) }
            }
            if (drawn < 0) { throw new Scene3DException("The framebuffer has no usable size (or the memory is gone).") }
            return
        }
        if (this.pixels == undefined || this.pixels.length != w * h * 4) { this.pixels = new byte[w * h * 4] }
        var drawn = __S3DRender(this.h, this.scene.h, this.pixels, w, h, this.framebuffer.id)
        if (drawn < 0) { throw new Scene3DException("The framebuffer has no usable size (or the memory is gone).") }
        if (drawn == 2) {
            // the picture went to the window: the framebuffer becomes transparent, for what the program lays over it
            if (this.clearBytes == undefined || this.clearBytes.length != w * h * 4) { this.clearBytes = new byte[w * h * 4] }
            this.framebuffer.WriteBytes(this.clearBytes)
        } else {
            this.framebuffer.WriteBytes(this.pixels)
        }
    }

    // The last picture went straight from the GPU into the window (DirectDrawing), not through the framebuffer.
    bool DrewDirectly { get { return __S3DCamRenderer(this.h) == 2 } }

    // Who drew the last picture: RenderMode.Software, RenderMode.Hardware (the scene asked for the hardware renderer and there is a GPU) or RenderMode.Fast.
    RenderMode LastRenderer {
        get {
            var r = __S3DCamRenderer(this.h)
            if (r == 0) { return RenderMode.Software }
            if (r == 3) { return RenderMode.Fast }
            return RenderMode.Hardware
        }
    }
}

// The space: objects, cameras, lights and textures, each also reachable by a key.
class Scene {
    int h
    List Objects
    List Cameras
    List Lights
    List Textures
    List keyNames
    List keyItems

    construct() {
        this.h = __S3DNew(4)
        if (this.h == 0) { throw new Scene3DException("No memory for a scene.") }
        this.Objects = new List()
        this.Cameras = new List()
        this.Lights = new List()
        this.Textures = new List()
        this.keyNames = new List()
        this.keyItems = new List()
    }

    destruct() { __S3DFree(this.h) }

    int AmbientColor { get { return __S3DGetI(this.h, 0) } set { __S3DSetI(this.h, 0, value) } }
    float AmbientIntensity { get { return __S3DGetF(this.h, 0) } set { __S3DSetF(this.h, 0, value) } }
    // false: no shadows at all (faster).
    bool Shadows { get { return __S3DGetB(this.h, 1) } set { __S3DSetI(this.h, 1, value) } }
    // The size of a shadow map in pixels (64 .. 4096): bigger is sharper and slower.
    int ShadowResolution { get { return __S3DGetI(this.h, 2) } set { __S3DSetI(this.h, 2, value) } }
    // How many threads draw (0 = as many as the machine has, up to 8; 1 = one). The picture is the same for every number.
    int Threads { get { return __S3DGetI(this.h, 3) } set { __S3DSetI(this.h, 3, value) } }
    // RenderMode.Software (default) or RenderMode.Hardware: the GPU draws (Vulkan), where there is one; else the software renderer.
    RenderMode Renderer { get { return __S3DGetI(this.h, 4)!RenderMode } set { __S3DSetI(this.h, 4, value!int) } }

    // ---- the effects on the whole picture ----
    // Fog: from `start` on, the picture goes into the colour, from `end` on it is all fog - also where no object is (the background). It hides the end of the
    // world and is cheap (Fast and Software; the GPU draws no fog yet). NoFog() takes it away.
    undefined Fog(int color, float start : any m, float end : any m) {
        __S3DSetI(this.h, 5, color)
        __S3DSetF(this.h, 1, S3D.Length(start))
        __S3DSetF(this.h, 2, S3D.Length(end))
    }
    undefined NoFog() { __S3DSetF(this.h, 1, 0.0); __S3DSetF(this.h, 2, 0.0) }
    int FogColor { get { return __S3DGetI(this.h, 5) } set { __S3DSetI(this.h, 5, value) } }
    float FogStart : m { get { return __S3DGetF(this.h, 1) * 1m } set { __S3DSetF(this.h, 1, S3D.Length(value)) } }
    float FogEnd : m { get { return __S3DGetF(this.h, 2) * 1m } set { __S3DSetF(this.h, 2, S3D.Length(value)) } }
    // The tint: the whole picture towards a colour by `amount` (0 nothing .. 1 all the colour): fading out (black), a flash (white), under water (blue).
    undefined Tint(int color, float amount) { __S3DSetI(this.h, 6, color); __S3DSetF(this.h, 3, amount) }
    int TintColor { get { return __S3DGetI(this.h, 6) } set { __S3DSetI(this.h, 6, value) } }
    float TintAmount { get { return __S3DGetF(this.h, 3) } set { __S3DSetF(this.h, 3, value) } }

    // The time goes on for every object of the scene (Object.Advance: animations, spin, texture scroll, particles) - once a frame: scene.Advance(16ms).
    undefined Advance(float time : any s) { __S3DSceneAdvance(this.h, S3D.Seconds(time)) }

    // Adds an object, camera, light or texture (to Objects, Cameras, Lights or Textures); with a key the item can be fetched with Get(key). Returns the item.
    any Add(any item, string key = "") {
        if (!(item is of Object || item is of Camera || item is of Light || item is of Texture)) {
            throw new Scene3DException("A scene takes objects, cameras, lights and textures.")
        }
        if (key != "") {
            for (var i = 0; i < this.keyNames.Count; i++) {
                if (this.keyNames[i] == key) { throw new Scene3DException("The key '" + key + "' is used already.") }
            }
        }
        try item.TakeTo(this)
        if (item is of Object) {
            this.Objects.Add(item)
            __S3DSceneAdd(this.h, item.h)
        } else if (item is of Camera) {
            this.Cameras.Add(item)
            item.scene = this
        } else if (item is of Light) {
            this.Lights.Add(item)
            __S3DSceneAdd(this.h, item.h)
        } else {
            this.Textures.Add(item)
        }
        if (key != "") {
            this.keyNames.Add(key)
            this.keyItems.Add(item)
        }
        return item
    }

    // The item with the key (undefined if there is none).
    any Get(string key) {
        for (var i = 0; i < this.keyNames.Count; i++) {
            if (this.keyNames[i] == key) { return this.keyItems[i] }
        }
        return undefined
    }

    // Takes an item out of the scene again.
    undefined Remove(any item) {
        if (item is of Object) { this.RemoveFrom(this.Objects, item); __S3DSceneRemove(this.h, item.h) }
        else if (item is of Camera) { this.RemoveFrom(this.Cameras, item); item.scene = undefined }
        else if (item is of Light) { this.RemoveFrom(this.Lights, item); __S3DSceneRemove(this.h, item.h) }
        else if (item is of Texture) { this.RemoveFrom(this.Textures, item) }
        for (var i = 0; i < this.keyItems.Count; i++) {
            if (this.keyItems[i] == item) {
                this.keyItems.RemoveAt(i)
                this.keyNames.RemoveAt(i)
                break
            }
        }
    }

    undefined RemoveFrom(List list, any item) {
        for (var i = 0; i < list.Count; i++) {
            if (list[i] == item) {
                list.RemoveAt(i)
                return
            }
        }
    }
}
