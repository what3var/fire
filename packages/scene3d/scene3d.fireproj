{
  "format": 1,
  "name": "fire-scene3d",
  "type": "library",
  "import": "scene3d",
  "standard": true,
  "settings": {
    "version": "1.0.0",
    "author": "fire",
    "license": "fire",
    "description": "The standard library 'scene3d' of fire: prelude and C sources (the software renderer and the hardware renderer, Vulkan)."
  },
  "native": {
    "sources": [
      "native/s3d_engine.h",
      "native/s3d_vk.h",
      "native/s3d_shaders.h",
      "native/s3d_gpu_vk.h",
      "native/fire_bridge_scene3d.h"
    ],
    "discover": false,
    "linkLibraries": {
      "posix": [
        "dl",
        "pthread"
      ]
    },
    "functions": [
      {
        "name": "__S3DMeshNew",
        "returns": "int",
        "arguments": 3,
        "c": "fire_s3d_MeshNew"
      },
      {
        "name": "__S3DMeshTemplate",
        "returns": "int",
        "arguments": 2,
        "c": "fire_s3d_MeshTemplate"
      },
      {
        "name": "__S3DMeshFromObj",
        "returns": "int",
        "arguments": 1,
        "c": "fire_s3d_MeshFromObj"
      },
      {
        "name": "__S3DLookAt",
        "returns": "any[]",
        "arguments": 6,
        "c": "fire_s3d_LookAt",
        "needsList": true,
        "returnsReference": true
      },
      {
        "name": "__S3DMeshRetain",
        "returns": "bool",
        "arguments": 1,
        "c": "fire_s3d_MeshRetain"
      },
      {
        "name": "__S3DMeshFree",
        "returns": "bool",
