        "c": "fire_s3d_MeshFree"
      },
      {
        "name": "__S3DMeshBounds",
        "returns": "any[]",
        "arguments": 1,
        "c": "fire_s3d_MeshBounds",
        "needsList": true,
        "returnsReference": true
      },
      {
        "name": "__S3DMeshTriangleCount",
        "returns": "int",
        "arguments": 1,
        "c": "fire_s3d_MeshTriangleCount"
      },
      {
        "name": "__S3DTexNew",
        "returns": "int",
        "arguments": 3,
        "c": "fire_s3d_TexNew"
      },
      {
        "name": "__S3DTexChecker",
        "returns": "int",
