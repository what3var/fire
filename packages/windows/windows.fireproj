{
  "format": 1,
  "name": "fire-windows",
  "type": "library",
  "import": "windows",
  "standard": true,
  "settings": {
    "version": "1.0.0",
    "author": "fire",
    "license": "fire",
    "description": "The standard library 'windows' of fire: prelude and C sources."
  },
  "native": {
    "sources": [
      "native/fire_bridge_windows.h"
    ],
    "discover": false,
    "language": "c",
    "platformSources": {
      "posix": [
        "native/fire_display_select.h"
      ],
      "windows": [
        "native/fire_display_select.h"
      ],
      "wasm": [
        "native/fire_display_wasm.h"
      ],
      "dos16": [
        "native/fire_display_dos.h"
      ],
      "esp32": [
        "native/fire_display_none.h"
      ],
      "freertos": [
        "native/fire_display_none.h"
      ],
      "default": [
        "native/fire_display_none.h"
      ],
      "dos32": [
        "native/fire_display_dos.h"
      ],
      "win16": [
        "native/fire_display_win16.h"
      ]
    },
    "headers": [
      "native/fire_display_c.h",
      "native/fire_display_cocoa.h",
      "native/fire_display_common.h",
      "native/fire_display_dcomp.h",
      "native/fire_display_desktop.h",
      "native/fire_display_dos.h",
      "native/fire_display_headless.h",
      "native/fire_display_joystick.h",
      "native/fire_display_keys.h",
      "native/fire_display_none.h",
      "native/fire_display_wayland.h",
      "native/fire_display_web.h",
      "native/fire_display_win32.h",
      "native/fire_display_x11.h",
      "native/fire_dragout.h",
      "native/fire_systheme.h",
      "native/fire_display_select.h",
      "native/fire_display_wasm.h"
    ],
    "bridge": [
      { "name": "__GRPHWinCreate", "arguments": 2, "c": "fire_win_WinCreate" },
      { "name": "__GRPHWinDestroy", "arguments": 1, "c": "fire_win_WinDestroy" },
      { "name": "__GRPHWinTick", "arguments": 1, "c": "fire_win_WinTick" },
      { "name": "__GRPHWinEnableEvents", "arguments": 1, "c": "fire_win_WinEnableEvents" },
      { "name": "__GRPHWinNextEvent", "arguments": 1, "c": "fire_win_WinNextEvent", "needsList": true },
      { "name": "__GRPHWinRegisterEvent", "arguments": 3, "c": "fire_win_WinRegisterEvent" },
      { "name": "__GRPHWinSetVSync", "arguments": 2, "c": "fire_win_WinSetVSync" },
      { "name": "__GRPHWinGetVSync", "arguments": 1, "c": "fire_win_WinGetVSync" },
      { "name": "__GRPHWinSetAutoResize", "arguments": 2, "c": "fire_win_WinSetAutoResize" },
      { "name": "__GRPHWinGetAutoResize", "arguments": 1, "c": "fire_win_WinGetAutoResize" },
      { "name": "__GRPHWinSetTouchMouse", "arguments": 2, "c": "fire_win_WinSetTouchMouse" },
      { "name": "__GRPHWinGetTouchMouse", "arguments": 1, "c": "fire_win_WinGetTouchMouse" },
      { "name": "__GRPHWinPump", "arguments": 1, "c": "fire_win_WinPump" },
      { "name": "__GRPHWinPresent", "arguments": 1, "c": "fire_win_WinPresent" },
      { "name": "__GRPHWinMgrCreate", "arguments": 0, "c": "fire_win_WinMgrCreate" },
      { "name": "__GRPHWinMgrAttach", "arguments": 2, "c": "fire_win_WinMgrAttach" },
      { "name": "__GRPHWinMgrDetach", "arguments": 2, "c": "fire_win_WinMgrDetach" },
      { "name": "__GRPHWinMgrStart", "arguments": 2, "c": "fire_win_WinMgrStart" },
      { "name": "__GRPHWinMgrWait", "arguments": 2, "c": "fire_win_WinMgrWait" },
      { "name": "__GRPHWinSetBlocked", "arguments": 2, "c": "fire_win_WinSetBlocked" },
      { "name": "__GRPHWinMgrServed", "arguments": 1, "c": "fire_win_WinMgrServed" },
      { "name": "__GRPHWinSetAutoClose", "arguments": 2, "c": "fire_win_WinSetAutoClose" },
      { "name": "__GRPHWinGetAutoClose", "arguments": 1, "c": "fire_win_WinGetAutoClose" },
      { "name": "__GRPHWinSetSize", "arguments": 3, "c": "fire_win_WinSetSize" },
      { "name": "__GRPHWinSystemTheme", "arguments": 0, "c": "fire_win_WinSystemTheme", "needsList": true },
      { "name": "__GRPHWinSetCursor", "arguments": 2, "c": "fire_win_WinSetCursor" },
      { "name": "__GRPHWinClipboardSetText", "arguments": 1, "c": "fire_win_WinClipboardSetText" },
      { "name": "__GRPHWinClipboardGetText", "arguments": 0, "c": "fire_win_WinClipboardGetText", "needsList": true },
      { "name": "__GRPHWinClipboardHasText", "arguments": 0, "c": "fire_win_WinClipboardHasText" },
      { "name": "__GRPHWinClipboardGetImage", "arguments": 0, "c": "fire_win_WinClipboardGetImage", "needsList": true },
      { "name": "__GRPHWinClipboardSetImage", "arguments": 1, "c": "fire_win_WinClipboardSetImage" },
      { "name": "__GRPHWinClipboardHasImage", "arguments": 0, "c": "fire_win_WinClipboardHasImage" },
      { "name": "__GRPHWinClipboardGetFiles", "arguments": 0, "c": "fire_win_WinClipboardGetFiles", "needsList": true },
      { "name": "__GRPHWinClipboardSetFiles", "arguments": 1, "c": "fire_win_WinClipboardSetFiles" },
      { "name": "__GRPHWinClipboardHasFiles", "arguments": 0, "c": "fire_win_WinClipboardHasFiles" },
      { "name": "__GRPHWinStartDrag", "arguments": 3, "c": "fire_win_WinStartDrag" },
      { "name": "__GRPHWinCanStartDrag", "arguments": 1, "c": "fire_win_WinCanStartDrag" },
      { "name": "__GRPHWinSetTextInputRect", "arguments": 5, "c": "fire_win_WinSetTextInputRect" },
      { "name": "__GRPHWinSetBackdrop", "arguments": 2, "c": "fire_win_WinSetBackdrop" },
      { "name": "__GRPHWinGetBackdrop", "arguments": 1, "c": "fire_win_WinGetBackdrop" },
      { "name": "__GRPHWinGetScale", "arguments": 1, "c": "fire_win_WinGetScale" },
      { "name": "__GRPHWinPresentArea", "arguments": 5, "c": "fire_win_WinPresentArea" },
      { "name": "__GRPHWinPresentPath", "arguments": 1, "c": "fire_win_WinPresentPath", "needsList": true },
      { "name": "__GRPHWinSetStyle", "arguments": 2, "c": "fire_win_WinSetStyle" },
      { "name": "__GRPHWinMove", "arguments": 3, "c": "fire_win_WinMove" },
      { "name": "__GRPHWinBeginMove", "arguments": 1, "c": "fire_win_WinBeginMove" },
      { "name": "__GRPHWinWorkArea", "arguments": 2, "c": "fire_win_WinWorkArea" },
      { "name": "__GRPHWinPosition", "arguments": 2, "c": "fire_win_WinPosition" },
      { "name": "__GRPHWinSetIcon", "arguments": 2, "c": "fire_win_WinSetIcon" },
      { "name": "__GRPHWinSetClickThrough", "arguments": 2, "c": "fire_win_WinSetClickThrough" },
      { "name": "__GRPHWinSetFullscreen", "arguments": 2, "c": "fire_win_WinSetFullscreen" },
      { "name": "__GRPHWinGetFullscreen", "arguments": 2, "c": "fire_win_WinGetFullscreen" }
    ]
  }
}
