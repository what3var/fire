// data.postgres (docs/data/README.md): the PostgreSQL driver of Data, written in fire over a TCP connection (no client library):
//     new Data.Connection("postgres://db.local:5432/shop", new Data.Credentials("app", secret))      (also postgresql://)
//     postgres://host/shop?sslmode=prefer   TLS when the server offers it (default; the certificate is not checked) - require: TLS or nothing,
//                                           verify-full (verify): TLS with the certificate checked, disable (off): never
//     &ca=/etc/ssl/db.pem                   the certificate(s) of the authority for verify-full (PEM; without: the system's)
//     &timeout=10000                        connecting and waiting for an answer, in ms
//     &search_path=app                      the schema(s) of the session (SET search_path)
// The protocol 3.0: the startup, SSLRequest, the logins (SCRAM-SHA-256, MD5, the password as it is), the extended query protocol (Parse, Bind, Execute -
// the parameters are never text in the SQL; `?` becomes `$1`, `$2`, ...), rows streamed from the socket, the simple query protocol for SQL without
// parameters (several statements at once). Text results converted by their types (bytea comes in binary).
#import "data"
#import "net"
#import "tls"
#import "hash"
#import "io"

namespace Data {
    [Keep]
    [Driver "postgres,postgresql"]
    class PostgresDriver : Data.IDriver {
        construct() { }
        Data.IDriverConnection Open(string target, Data.Credentials credentials) { return new Data.PostgresConnection(target, credentials) }

        // The SQLSTATE as the number of an exception: its digits (23505), else read in base 36 (42P01) - the text is in State.
        static int CodeOf(string state) {
            if (state == undefined) { return 0 }
            int v = 0
            bool digits = true
            for (var i = 0; i < state.Length; i++) {
                char c = state[i]
                if (c < '0' || c > '9') { digits = false }
            }
            if (digits) {
                any n = state.ToInt()
                if (n == undefined) { return 0 }
                return trust n
            }
            string alphabet = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
            for (var i = 0; i < state.Length; i++) {
                int d = alphabet.IndexOf(state.Substring(i, 1).ToUpper())
                if (d < 0) { d = 0 }
                v = v * 36 + d
            }
            return v
        }

        // An ErrorResponse as the exception of its kind (class 23: constraints; 40001, 40P01, 55P03: busy; class 28, 3D, 08: the connection).
        static undefined Fail(string state, string message) {
            int code = Data.PostgresDriver.CodeOf(state)
            string cls = ""
            if (state != undefined && state.Length >= 2) { cls = state.Substring(0, 2) }
            Data.DataException e = undefined
            if (cls == "23") { e = new Data.ConstraintException(message, code) }
            else if (state == "40001" || state == "40P01" || state == "55P03" || state == "57014") { e = new Data.BusyException(message, code) }
            else if (cls == "28" || cls == "3D" || cls == "08") { e = new Data.ConnectionException(message, code) }
            else { e = new Data.DataException(message, code) }
            e.State = state
            throw e
        }
    }

    class PostgresDialect : Data.Dialect {
        construct() : base("postgres") { }
        override string ColumnType(Data.ColumnMap c) {
            if (c.kind == "int") { return "BIGINT" }
            if (c.kind == "bool") { return "BOOLEAN" }
            if (c.kind == "float") { return "DOUBLE PRECISION" }
            if (c.kind == "bytes") { return "BYTEA" }
            if (c.kind == "time") { return "VARCHAR(40)" }
            if (c.kind == "enum") { return "VARCHAR(255)" }
            if (c.kind == "json") { return "TEXT" }
            if (c.length > 0) { return "VARCHAR(" + c.length + ")" }
            return "TEXT"
        }
        override string Generated() { return " GENERATED BY DEFAULT AS IDENTITY" }
        override string ColumnsQuery() { return "SELECT column_name FROM information_schema.columns WHERE table_schema = current_schema() AND table_name = ?" }
        override string TablesQuery() { return "SELECT table_name FROM information_schema.tables WHERE table_schema = current_schema() AND table_type = 'BASE TABLE' ORDER BY table_name" }
        override string ColumnInfoQuery() {
            return "SELECT c.column_name, CASE WHEN c.data_type = 'character varying' THEN 'varchar(' || c.character_maximum_length || ')' ELSE c.data_type END, c.is_nullable = 'YES', " +
                "EXISTS (SELECT 1 FROM information_schema.table_constraints tc JOIN information_schema.key_column_usage k ON k.constraint_name = tc.constraint_name AND k.table_schema = tc.table_schema " +
                "WHERE tc.constraint_type = 'PRIMARY KEY' AND tc.table_schema = c.table_schema AND tc.table_name = c.table_name AND k.column_name = c.column_name) " +
                "FROM information_schema.columns c WHERE c.table_schema = current_schema() AND c.table_name = ? ORDER BY c.ordinal_position"
        }
        override string IndexesQuery() {
            return "SELECT i.relname, a.attname, x.indisunique FROM pg_index x JOIN pg_class t ON t.oid = x.indrelid JOIN pg_class i ON i.oid = x.indexrelid " +
                "JOIN pg_namespace n ON n.oid = t.relnamespace JOIN LATERAL unnest(x.indkey) WITH ORDINALITY AS k(attnum, ord) ON true " +
                "JOIN pg_attribute a ON a.attrelid = t.oid AND a.attnum = k.attnum " +
                "WHERE n.nspname = current_schema() AND t.relname = ? AND NOT x.indisprimary " +
                "ORDER BY i.relname, k.ord"
        }
        override string IndexQuery() { return "SELECT count(*) FROM pg_indexes WHERE schemaname = current_schema() AND tablename = ? AND indexname = ?" }
        override string Limit(int count, int offset) {
            if (count < 0 && offset <= 0) { return "" }
            var t = ""
            if (count >= 0) { t = " LIMIT " + count }
            if (offset > 0) { t = t + " OFFSET " + offset }
            return t
        }
        // (PostgreSQL sorts NULL as the greatest value: as the others sort it)
        override string Order(string term, bool descending) {
            if (descending) { return term + " DESC NULLS LAST" }
            return term + " NULLS FIRST"
        }
        override string StartsWith(string a, string b) { return "strpos(" + a + ", " + b + ") = 1" }
        override string EndsWith(string a, string b, string b2) { return "right(" + a + ", char_length(" + b + ")) = " + b2 }
        override string Contains(string a, string b) { return "strpos(" + a + ", " + b + ") > 0" }
        override string Length(string a) { return "char_length(" + a + ")" }
    }

    // ---- bytes ----

    /// <summary>Messages being written: big-endian numbers, texts with a NUL; a message is begun with its type and ended (its length is filled in).</summary>
    class PostgresOut {
        IO.MemoryStream all
        IO.MemoryStream body
        defined int type
        bool open
        construct() {
            this.all = new IO.MemoryStream()
            this.body = new IO.MemoryStream()
            this.open = false
            this.type = 0
        }
        undefined Raw(byte b[], defined int n) {
            if (n == 0) { return }
            if (this.open) { this.body.Write(b, 0, n) } else { this.all.Write(b, 0, n) }
        }
        undefined Byte(defined int v) {
            byte b[] = new byte[1]
            b[0] = v & 255
            this.Raw(b, 1)
        }
        undefined Int16(defined int v) {
            byte b[] = new byte[2]
            b[0] = (v >> 8) & 255
            b[1] = v & 255
            this.Raw(b, 2)
        }
        static byte[] Be32(defined int v) {
            byte b[] = new byte[4]
            b[0] = (v >> 24) & 255
            b[1] = (v >> 16) & 255
            b[2] = (v >> 8) & 255
            b[3] = v & 255
            return b
        }
        undefined Int32(defined int v) { this.Raw(Data.PostgresOut.Be32(v), 4) }
        undefined Bytes(byte data[]) { this.Raw(data, data.length) }
        undefined Nul(string text) {
            this.Bytes(IO.Utf8.GetBytes(text))
            this.Byte(0)
        }
        // (a message: its type (0: the startup, which has none), its body, then End writes the type and the length before it)
        undefined Begin(defined int type) {
            this.type = type
            this.body = new IO.MemoryStream()
            this.open = true
        }
        undefined End() {
            this.open = false
            byte data[] = this.body.ToBuffer()
            if (this.type != 0) { this.Byte(this.type) }
            this.Int32(data.length + 4)
            this.Bytes(data)
        }
        byte[] ToBuffer() { return this.all.ToBuffer() }
    }

    /// <summary>A message read: its type and its body.</summary>
    class PostgresIn {
        defined int type
        byte data[]
        defined int at
        construct(defined int type, byte data[]) {
            this.type = type
            this.data = take data
            this.at = 0
        }
        defined int Left { get { return this.data.length - this.at } }
        defined int Byte() {
            if (this.at >= this.data.length) { throw new Data.DataException("data.postgres: a message ended too soon.") }
            int b = this.data[this.at]
            this.at = this.at + 1
            return b
        }
        defined int Int16() {
            int v = (this.Byte() << 8) | this.Byte()
            if (v >= 32768) { v = v - 65536 }
            return v
        }
        defined int Int32() {
            int v = (this.Byte() << 24) | (this.Byte() << 16) | (this.Byte() << 8) | this.Byte()
            if (v >= 2147483648) { v = v - 4294967296 }
            return v
        }
        byte[] Bytes(defined int n) {
            if (n > this.Left) { throw new Data.DataException("data.postgres: a message ended too soon.") }
            byte b[] = new byte[n]
            for (var i = 0; i < n; i++) { b[i] = this.data[this.at + i] }
            this.at = this.at + n
            return b
        }
        string Text(defined int n) {
            string t = IO.Utf8.GetString(this.data, this.at, n)
            this.at = this.at + n
            return t
        }
        string Nul() {
            int end = this.at
            while (end < this.data.length && this.data[end] != 0) { end++ }
            string t = IO.Utf8.GetString(this.data, this.at, end - this.at)
            this.at = end + 1
            return t
        }
        string Rest() { return this.Text(this.Left) }
    }

    /// <summary>A column of a result: its name and the oid of its type.</summary>
    class PostgresColumn {
        string name
        defined int oid
        construct(string name, defined int oid) {
            this.name = name
            this.oid = oid
        }
    }

    /// <summary>The rest of the messages of a result that a command interrupted.</summary>
    class PostgresParked {
        int token
        List messages
        construct(int token, List messages) {
            this.token = token
            this.messages = take messages
        }
    }

    // ---- the login: SCRAM-SHA-256, MD5 ----

    class PostgresAuth {
        static string Base64(byte data[]) {
            string alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            var t = ""
            int i = 0
            while (i < data.length) {
                int b0 = data[i]
                int b1 = 0
                int b2 = 0
                if (i + 1 < data.length) { b1 = data[i + 1] }
                if (i + 2 < data.length) { b2 = data[i + 2] }
                int n = (b0 << 16) | (b1 << 8) | b2
                t = t + alphabet.Substring((n >> 18) & 63, 1) + alphabet.Substring((n >> 12) & 63, 1)
                if (i + 1 < data.length) { t = t + alphabet.Substring((n >> 6) & 63, 1) } else { t = t + "=" }
                if (i + 2 < data.length) { t = t + alphabet.Substring(n & 63, 1) } else { t = t + "=" }
                i = i + 3
            }
            return t
        }
        static byte[] FromBase64(string text) {
            string alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            var m = new IO.MemoryStream()
            byte one[] = new byte[1]
            int acc = 0
            int bits = 0
            for (var i = 0; i < text.Length; i++) {
                string c = text.Substring(i, 1)
                if (c == "=") { break }
                int d = alphabet.IndexOf(c)
                if (d < 0) { continue }
                acc = ((acc << 6) | d) & 16777215
                bits = bits + 6
                if (bits >= 8) {
                    bits = bits - 8
                    one[0] = (acc >> bits) & 255
                    m.Write(one, 0, 1)
                }
            }
            return m.ToBuffer()
        }
        static byte[] Join(byte a[], byte b[]) {
            byte out[] = new byte[a.length + b.length]
            for (var i = 0; i < a.length; i++) { out[i] = a[i] }
            for (var i = 0; i < b.length; i++) { out[a.length + i] = b[i] }
            return out
        }
        static byte[] Xor(byte a[], byte b[]) {
            byte out[] = new byte[a.length]
            for (var i = 0; i < a.length; i++) {
                int x = a[i]
                int y = b[i]
                out[i] = x # y
            }
            return out
        }
        static byte[] Hmac(byte key[], byte data[]) { return Hash.Hmac.Of(Hash.Algorithm.Sha256, key, data) }

        // ("md5" + md5(md5(password + user) + salt) in hex)
        static string Md5(string user, string password, byte salt[]) {
            string inner = Hash.Md5.HexOf(IO.Utf8.GetBytes(password + user))
            return "md5" + Hash.Md5.HexOf(Data.PostgresAuth.Join(IO.Utf8.GetBytes(inner), salt))
        }

        // Hi(password, salt, i) of RFC 5802: PBKDF2 with HMAC-SHA-256, one block
        static byte[] SaltedPassword(string password, byte salt[], defined int iterations) {
            byte pw[] = IO.Utf8.GetBytes(password)
            byte first[] = new byte[4]
            first[3] = 1
            byte u[] = Data.PostgresAuth.Hmac(pw, Data.PostgresAuth.Join(salt, first))
            byte result[] = copy u
            for (var i = 1; i < iterations; i++) {
                u = Data.PostgresAuth.Hmac(pw, u)
                result = Data.PostgresAuth.Xor(result, u)
            }
            return result
        }

        // The client's final message of SCRAM-SHA-256 and the signature the server must send: (final, server signature in base64)
        static any ScramFinal(string password, string clientFirstBare, string serverFirst) {
            string nonce = undefined
            string saltText = undefined
            int iterations = 0
            any parts = serverFirst.Split(",")
            for (var i = 0; i < parts.length; i++) {
                string p = parts[i]
                if (p.StartsWith("r=")) { nonce = p.Substring(2) }
                else if (p.StartsWith("s=")) { saltText = p.Substring(2) }
                else if (p.StartsWith("i=")) { iterations = p.Substring(2).ToInt() }
            }
            if (nonce == undefined || saltText == undefined || iterations <= 0) { throw new Data.ConnectionException("data.postgres: the server's SCRAM message is not understood.", 28000) }
            byte salted[] = Data.PostgresAuth.SaltedPassword(password, Data.PostgresAuth.FromBase64(saltText), iterations)
            byte clientKey[] = Data.PostgresAuth.Hmac(salted, IO.Utf8.GetBytes("Client Key"))
            byte storedKey[] = Hash.Sha256.Of(clientKey)
            string withoutProof = "c=biws,r=" + nonce
            string authMessage = clientFirstBare + "," + serverFirst + "," + withoutProof
            byte signature[] = Data.PostgresAuth.Hmac(storedKey, IO.Utf8.GetBytes(authMessage))
            byte proof[] = Data.PostgresAuth.Xor(clientKey, signature)
            byte serverKey[] = Data.PostgresAuth.Hmac(salted, IO.Utf8.GetBytes("Server Key"))
            byte serverSignature[] = Data.PostgresAuth.Hmac(serverKey, IO.Utf8.GetBytes(authMessage))
            any result = new any[2]
            result[0] = withoutProof + ",p=" + Data.PostgresAuth.Base64(proof)
            result[1] = Data.PostgresAuth.Base64(serverSignature)
            return result
        }
    }

    // ---- the connection ----

    class PostgresConnection : Data.IDriverConnection {
        Net.TcpClient tcp
        Tls.Stream tls
        bool closed
        bool secure
        Data.PostgresDialect dialect
        int timeout
        int changes
        // the state of the transaction from ReadyForQuery: 'I' none, 'T' in one, 'E' failed
        int state
        // the result whose rows are being read from the socket (0: none), the numbers of the results, the rest of results interrupted by a command
        int streamToken
        int tokens
        List parked
        // the statements to close with the next command, the ReadyForQuery messages still to come of commands no one waits for
        List closing
        int unanswered
        int statements
        string serverVersion

        construct(string target, Data.Credentials credentials) {
            this.dialect = new Data.PostgresDialect()
            this.closed = true
            this.streamToken = 0
            this.tokens = 0
            this.parked = new List()
            this.closing = new List()
            this.unanswered = 0
            this.statements = 0
            this.state = 73
            this.changes = 0
            this.serverVersion = ""
            // //[user@]host[:port]/database?options
            string rest = target
            if (rest.StartsWith("//")) { rest = rest.Substring(2) }
            string options = ""
            int q = rest.IndexOf("?")
            if (q >= 0) {
                options = rest.Substring(q + 1)
                rest = rest.Substring(0, q)
            }
            string user = undefined
            string password = ""
            if (credentials != undefined) {
                user = credentials.User
                if (credentials.Password != undefined) { password = credentials.Password }
            }
            int atSign = rest.IndexOf("@")
            if (atSign >= 0) {
                if (user == undefined) { user = rest.Substring(0, atSign) }
                rest = rest.Substring(atSign + 1)
            }
            string database = user
            int slash = rest.IndexOf("/")
            if (slash >= 0) {
                if (slash + 1 < rest.Length) { database = rest.Substring(slash + 1) }
                rest = rest.Substring(0, slash)
            }
            string host = rest
            int port = 5432
            int colon = rest.LastIndexOf(":")
            if (colon >= 0) {
                host = rest.Substring(0, colon)
                any parsed = rest.Substring(colon + 1).ToInt()
                if (parsed == undefined) { throw new ArgumentException("data.postgres: the port '" + rest.Substring(colon + 1) + "' is not a number.") }
                port = trust parsed
            }
            if (host == "") { host = "localhost" }
            string tlsMode = "prefer"
            string ca = undefined
            string searchPath = undefined
            this.timeout = 10000
            if (options != "") {
                any parts = options.Split("&")
                for (var i = 0; i < parts.length; i++) {
                    string option = parts[i]
                    int eq = option.IndexOf("=")
                    if (eq < 0) { continue }
                    string key = option.Substring(0, eq).ToLower()
                    string value = option.Substring(eq + 1)
                    if (key == "sslmode" || key == "tls" || key == "ssl") { tlsMode = value.ToLower() }
                    else if (key == "timeout" || key == "connect_timeout") {
                        any ms = value.ToInt()
                        if (ms == undefined) { throw new ArgumentException("data.postgres: the timeout '" + value + "' is not a number.") }
                        this.timeout = trust ms
                    }
                    else if (key == "ca" || key == "sslrootcert") { ca = value }
                    else if (key == "search_path") { searchPath = value }
                    else { throw new ArgumentException("data.postgres: unknown option '" + option + "' (sslmode=disable|prefer|require|verify-full, ca=file, search_path=schema, timeout=ms).") }
                }
            }
            if (tlsMode == "disable") { tlsMode = "off" }
            if (tlsMode == "verify-full" || tlsMode == "verify-ca") { tlsMode = "verify" }
            if (!(tlsMode == "off" || tlsMode == "prefer" || tlsMode == "require" || tlsMode == "verify")) { throw new ArgumentException("data.postgres: sslmode is disable, prefer, require or verify-full, not '" + tlsMode + "'.") }
            if (user == undefined || user == "") { throw new ArgumentException("data.postgres: a user is needed (Data.Credentials or postgres://user@host/db).") }
            try {
                var tcp = new Net.TcpClient(host, port, this.timeout)
                tcp.NoDelay = true
                tcp.ReadTimeout = this.timeout
                this.tcp = take tcp
            } catch (Net.NetException e) {
                throw new Data.ConnectionException("data.postgres: cannot connect to " + host + ":" + port + " (" + e.message + ").", 8001)
            }
            this.closed = false
            try {
                this.Login(host, user, password, database, tlsMode, ca)
                if (searchPath != undefined) { this.Exec("SET search_path TO " + searchPath) }
            } catch (e) {
                this.Close()
                throw e
            }
        }
        destruct() { this.Close() }

        // Is the connection encrypted (TLS)?
        bool Secure { get { return this.secure } }
        // The version of the server (server_version).
        string ServerVersion { get { return this.serverVersion } }
        // The state of the transaction as the server reports it: 'I' (none), 'T' (in one), 'E' (failed, until ROLLBACK).
        string TransactionState {
            get {
                if (this.state == 84) { return "T" }
                if (this.state == 69) { return "E" }
                return "I"
            }
        }

        // ---- messages ----
        any Io() {
            if (this.tls != undefined) { return this.tls }
            return this.tcp
        }
        undefined ReadFully(byte buffer[], int count) {
            any io = this.Io()
            int done = 0
            while (done < count) {
                int n = io.Read(buffer, done, count - done)
                if (n <= 0) {
                    this.closed = true
                    throw new Data.ConnectionException("data.postgres: the server closed the connection.", 8006)
                }
                done = done + n
            }
        }
        // (the next message - notices, parameters of the server and what closing statements answers are passed over)
        Data.PostgresIn Read() {
            while (true) {
                byte head[] = new byte[5]
                this.ReadFully(head, 5)
                int type = head[0]
                int length = (head[1] << 24) | (head[2] << 16) | (head[3] << 8) | head[4]
                byte body[] = new byte[length - 4]
                if (length > 4) { this.ReadFully(body, length - 4) }
                var m = new Data.PostgresIn(type, take body)
                if (type == 78 || type == 65 || type == 51) { continue }   // (a notice, a notification, CloseComplete)
                if (type == 83) {
                    string name = m.Nul()
                    string value = m.Nul()
                    if (name == "server_version") { this.serverVersion = value }
                    continue
                }
                if (type == 90 && this.unanswered > 0) {
                    this.unanswered = this.unanswered - 1
                    this.state = m.Byte()
                    continue
                }
                return m
            }
        }
        undefined Write(byte payload[]) {
            any io = this.Io()
            io.Write(payload, 0, payload.length)
            io.Flush()
        }
        undefined Check() { if (this.closed) { throw new Data.StateException("data.postgres: the connection is closed.") } }

        // (a command begins: the rows of a streaming result are parked, the statements closed since the last command are closed with it)
        Data.PostgresOut Command() {
            this.Check()
            if (this.streamToken != 0) { this.Park() }
            var o = new Data.PostgresOut()
            if (this.closing.Count > 0) {
                for (var i = 0; i < this.closing.Count; i++) {
                    string name = this.closing[i]
                    o.Begin(67)
                    o.Byte(83)
                    o.Nul(name)
                    o.End()
                }
                this.closing.Clear()
                o.Begin(83)
                o.End()
                this.unanswered = this.unanswered + 1
            }
            return o
        }

        // (an ErrorResponse: its fields)
        static any ErrorOf(Data.PostgresIn m) {
            string state = undefined
            string message = ""
            string detail = undefined
            while (m.Left > 0) {
                int field = m.Byte()
                if (field == 0) { break }
                string value = m.Nul()
                if (field == 67) { state = value }
                else if (field == 77) { message = value }
                else if (field == 68) { detail = value }
            }
            if (detail != undefined) { message = message + " (" + detail + ")" }
            any e = new any[2]
            e[0] = state
            e[1] = message
            return e
        }
        // (the error of a command: the rest of its answer up to ReadyForQuery is read, then the exception)
        undefined Fail(Data.PostgresIn m) {
            any e = Data.PostgresConnection.ErrorOf(m)
            this.UntilReady()
            Data.PostgresDriver.Fail(e[0], e[1])
        }
        undefined UntilReady() {
            while (true) {
                var r = this.Read()
                if (r.type == 90) {
                    this.state = r.Byte()
                    return
                }
            }
        }
        // (CommandComplete: the rows a statement changed - "INSERT 0 3", "UPDATE 2", "DELETE 1", "SELECT 5")
        undefined Complete(Data.PostgresIn m) {
            string tag = m.Nul()
            int space = tag.LastIndexOf(" ")
            this.changes = 0
            if (space < 0) { return }
            string verb = tag.Substring(0, tag.IndexOf(" "))
            if (verb == "INSERT" || verb == "UPDATE" || verb == "DELETE" || verb == "MERGE" || verb == "COPY") {
                any n = tag.Substring(space + 1).ToInt()
                if (n != undefined) { this.changes = trust n }
            }
        }

        // ---- the login ----
        undefined Login(string host, string user, string password, string database, string tlsMode, string ca) {
            if (tlsMode != "off") {
                var ask = new Data.PostgresOut()
                ask.Int32(8)
                ask.Int32(80877103)                       // (SSLRequest)
                this.Write(ask.ToBuffer())
                byte answer[] = new byte[1]
                this.ReadFully(answer, 1)
                if (answer[0] == 83) {
                    var options = new Tls.Options()
                    options.verify = tlsMode == "verify"
                    if (ca != undefined) { options.caFile = ca }
                    var plain = take this.tcp
                    try {
                        var stream = new Tls.Stream(take plain, host, options, this.timeout)
                        this.tls = take stream
                    } catch (Net.NetException e) {
                        this.closed = true
                        throw new Data.ConnectionException("data.postgres: the TLS handshake with " + host + " failed (" + e.message + ").", 8001)
                    }
                    this.secure = true
                } else if (tlsMode == "require" || tlsMode == "verify") {
                    this.closed = true
                    throw new Data.ConnectionException("data.postgres: the server does not offer TLS (sslmode=" + tlsMode + ").", 8001)
                }
            }
            var start = new Data.PostgresOut()
            start.Begin(0)
            start.Int32(196608)                           // (protocol 3.0)
            start.Nul("user")
            start.Nul(user)
            start.Nul("database")
            start.Nul(database)
            start.Nul("client_encoding")
            start.Nul("UTF8")
            start.Nul("DateStyle")
            start.Nul("ISO")
            start.Nul("application_name")
            start.Nul("fire")
            start.Byte(0)
            start.End()
            this.Write(start.ToBuffer())
            string clientFirstBare = undefined
            string expectedSignature = undefined
            while (true) {
                var m = this.Read()
                if (m.type == 69) {
                    any e = Data.PostgresConnection.ErrorOf(m)
                    this.closed = true
                    Data.PostgresDriver.Fail(e[0], e[1])
                }
                if (m.type == 75) { continue }               // (BackendKeyData: for a cancel - not used)
                if (m.type == 90) {
                    this.state = m.Byte()
                    return
                }
                if (m.type != 82) { throw new Data.ConnectionException("data.postgres: an unexpected message in the login (" + m.type + ").", 8001) }
                int kind = m.Int32()
                if (kind == 0) { continue }                   // (AuthenticationOk)
                if (kind == 3) {
                    // (the password as it is - over TLS, or the server asks for it)
                    var o = new Data.PostgresOut()
                    o.Begin(112)
                    o.Nul(password)
                    o.End()
                    this.Write(o.ToBuffer())
                } else if (kind == 5) {
                    byte salt[] = m.Bytes(4)
                    var o = new Data.PostgresOut()
                    o.Begin(112)
                    o.Nul(Data.PostgresAuth.Md5(user, password, salt))
                    o.End()
                    this.Write(o.ToBuffer())
                } else if (kind == 10) {
                    // (SASL: the mechanisms the server offers; SCRAM-SHA-256 without channel binding)
                    bool scram = false
                    while (m.Left > 0) {
                        string mech = m.Nul()
                        if (mech == "SCRAM-SHA-256") { scram = true }
                        if (mech == "") { break }
                    }
                    if (!scram) { throw new Data.ConnectionException("data.postgres: the server offers no SASL mechanism this driver knows (SCRAM-SHA-256).", 28000) }
                    clientFirstBare = "n=,r=" + Data.PostgresAuth.Base64(Net.SecureRandom.Bytes(18))
                    byte first[] = IO.Utf8.GetBytes("n,," + clientFirstBare)
                    var o = new Data.PostgresOut()
                    o.Begin(112)
                    o.Nul("SCRAM-SHA-256")
                    o.Int32(first.length)
                    o.Bytes(first)
                    o.End()
                    this.Write(o.ToBuffer())
                } else if (kind == 11) {
                    string serverFirst = m.Rest()
                    if (clientFirstBare == undefined || !serverFirst.StartsWith("r=" + clientFirstBare.Substring(5))) { throw new Data.ConnectionException("data.postgres: the server's SCRAM nonce does not continue ours.", 28000) }
                    any final = Data.PostgresAuth.ScramFinal(password, clientFirstBare, serverFirst)
                    expectedSignature = final[1]
                    var o = new Data.PostgresOut()
                    o.Begin(112)
                    o.Bytes(IO.Utf8.GetBytes(final[0]))
                    o.End()
                    this.Write(o.ToBuffer())
                } else if (kind == 12) {
                    string serverFinal = m.Rest()
                    if (expectedSignature == undefined || serverFinal != "v=" + expectedSignature) { throw new Data.ConnectionException("data.postgres: the server did not prove that it knows the password (SCRAM).", 28000) }
                } else {
                    throw new Data.ConnectionException("data.postgres: the login method " + kind + " is not supported (SCRAM-SHA-256, MD5, password).", 28000)
                }
            }
        }

        // ---- commands ----

        // SQL without parameters (several statements: the simple query protocol). The changes are those of the last statement.
        undefined Exec(string sql) {
            var o = this.Command()
            o.Begin(81)
            o.Nul(sql)
            o.End()
            this.Write(o.ToBuffer())
            any error = undefined
            this.changes = 0
            while (true) {
                var m = this.Read()
                if (m.type == 67) { this.Complete(m) }
                else if (m.type == 69) { error = Data.PostgresConnection.ErrorOf(m) }
                else if (m.type == 71) {
                    // (COPY ... FROM STDIN: not supported - refused)
                    var f = new Data.PostgresOut()
                    f.Begin(102)
                    f.Nul("data.postgres does not send COPY data")
                    f.End()
                    this.Write(f.ToBuffer())
                }
                else if (m.type == 90) {
                    this.state = m.Byte()
                    break
                }
            }
            if (error != undefined) { Data.PostgresDriver.Fail(error[0], error[1]) }
        }

        // (`?` as $1, $2, ... - not in texts, quoted names, comments or dollar quotes): the SQL and the number of parameters
        static any Numbered(string sql) {
            var t = ""
            int n = 0
            int i = 0
            int start = 0
            while (i < sql.Length) {
                char c = sql[i]
                if (c == '\'' || c == '"') {
                    int j = i + 1
                    while (j < sql.Length) {
                        if (sql[j] == c) {
                            if (j + 1 < sql.Length && sql[j + 1] == c) { j = j + 2; continue }
                            break
                        }
                        j++
                    }
                    i = j + 1
                    continue
                }
                if (c == '-' && i + 1 < sql.Length && sql[i + 1] == '-') {
                    int e = sql.IndexOf("\n", i)
                    if (e < 0) { e = sql.Length }
                    i = e
                    continue
                }
                if (c == '/' && i + 1 < sql.Length && sql[i + 1] == '*') {
                    int e = sql.IndexOf("*/", i + 2)
                    if (e < 0) { e = sql.Length - 2 }
                    i = e + 2
                    continue
                }
                if (c == '$') {
                    // ($$ ... $$ or $tag$ ... $tag$)
                    int e = i + 1
                    while (e < sql.Length && (sql[e] == '_' || (sql[e] >= 'a' && sql[e] <= 'z') || (sql[e] >= 'A' && sql[e] <= 'Z') || (sql[e] >= '0' && sql[e] <= '9'))) { e++ }
                    if (e < sql.Length && sql[e] == '$' && !(e > i + 1 && sql[i + 1] >= '0' && sql[i + 1] <= '9')) {
                        string tag = sql.Substring(i, e - i + 1)
                        int close = sql.IndexOf(tag, e + 1)
                        if (close < 0) { close = sql.Length - tag.Length }
                        i = close + tag.Length
                        continue
                    }
                }
                if (c == '?') {
                    n++
                    t = t + sql.Substring(start, i - start) + "$" + n
                    start = i + 1
                }
                i++
            }
            t = t + sql.Substring(start)
            any result = new any[2]
            result[0] = t
            result[1] = n
            return result
        }

        Data.IStatement Prepare(string sql) {
            any numbered = Data.PostgresConnection.Numbered(sql)
            string text = numbered[0]
            int params = numbered[1]
            this.statements = this.statements + 1
            string name = "fire" + this.statements
            var o = this.Command()
            o.Begin(80)
            o.Nul(name)
            o.Nul(text)
            o.Int16(0)
            o.End()
            o.Begin(68)
            o.Byte(83)
            o.Nul(name)
            o.End()
            o.Begin(83)
            o.End()
            this.Write(o.ToBuffer())
            var cols = new List()
            var types = new List()
            while (true) {
                var m = this.Read()
                if (m.type == 69) { this.Fail(m) }
                if (m.type == 116) {
                    int count = m.Int16()
                    for (var i = 0; i < count; i++) { types.Add(m.Int32()) }
                } else if (m.type == 84) {
                    int count = m.Int16()
                    for (var i = 0; i < count; i++) {
                        string colName = m.Nul()
                        m.Int32()
                        m.Int16()
                        int oid = m.Int32()
                        m.Int16()
                        m.Int32()
                        m.Int16()
                        cols.Add(new Data.PostgresColumn(colName, oid))
                    }
                } else if (m.type == 90) {
                    this.state = m.Byte()
                    break
                }
            }
            if (types.Count > params) { params = types.Count }
            return new Data.PostgresStatement(this, name, params, take cols, take types)
        }

        int Changes() { return this.changes }

        // The key the last INSERT generated: lastval() of the session (in a transaction behind a savepoint: an INSERT without a sequence makes it fail).
        int LastId() {
            this.Check()
            if (this.state == 84) {
                try {
                    any v = this.ScalarText("SAVEPOINT fire_lastval; SELECT lastval(); RELEASE SAVEPOINT fire_lastval")
                    if (v == undefined) { return 0 }
                    string s = v
                    return s.ToInt()
                } catch (Data.DataException e) {
                    try { this.Exec("ROLLBACK TO SAVEPOINT fire_lastval; RELEASE SAVEPOINT fire_lastval") } catch (Data.DataException e2) { }
                    return 0
                }
            }
            if (this.state == 69) { return 0 }
            try {
                any v = this.ScalarText("SELECT lastval()")
                if (v == undefined) { return 0 }
                string s = v
                return s.ToInt()
            } catch (Data.DataException e) { return 0 }
        }
        // (the first value of the first row of SQL without parameters, as text)
        any ScalarText(string sql) {
            var o = this.Command()
            o.Begin(81)
            o.Nul(sql)
            o.End()
            this.Write(o.ToBuffer())
            any error = undefined
            any value = undefined
            bool found = false
            while (true) {
                var m = this.Read()
                if (m.type == 68 && !found) {
                    found = true
                    int n = m.Int16()
                    if (n > 0) {
                        int len = m.Int32()
                        if (len >= 0) { value = m.Text(len) }
                    }
                }
                else if (m.type == 69) { error = Data.PostgresConnection.ErrorOf(m) }
                else if (m.type == 90) {
                    this.state = m.Byte()
                    break
                }
            }
            if (error != undefined) { Data.PostgresDriver.Fail(error[0], error[1]) }
            return value
        }
        Data.Dialect Dialect() { return this.dialect }

        int NewToken() {
            this.tokens = this.tokens + 1
            return this.tokens
        }
        // A command while the rows of a result are still on the socket: they are read and kept for their statement (`foreach (row in db.Query(...))`
        // with an Execute in the loop works as with SQLite; only then are the rows in memory).
        undefined Park() {
            int token = this.streamToken
            this.streamToken = 0
            var messages = new List()
            while (true) {
                var m = this.Read()
                bool ready = m.type == 90
                if (ready) {
                    this.state = m.Byte()
                    m.at = 0
                }
                messages.Add(take m)
                if (ready) { break }
            }
            this.parked.Add(new Data.PostgresParked(token, take messages))
        }
        // (the next parked message of a result; undefined: none parked)
        Data.PostgresIn Unpark(int token) {
            for (var i = 0; i < this.parked.Count; i++) {
                Data.PostgresParked e = this.parked[i]
                if (e.token == token) {
                    if (e.messages.Count == 0) {
                        this.parked.RemoveAt(i)
                        return undefined
                    }
                    Data.PostgresIn m = take e.messages[0]
                    e.messages.RemoveAt(0)
                    if (e.messages.Count == 0) { this.parked.RemoveAt(i) }
                    return m
                }
            }
            return undefined
        }
        // (the rest of a result is not wanted: from the socket or the parked ones)
        undefined Discard(int token) {
            if (token == 0) { return }
            if (this.streamToken == token) {
                this.streamToken = 0
                this.UntilReady()
                return
            }
            for (var i = 0; i < this.parked.Count; i++) {
                Data.PostgresParked e = this.parked[i]
                if (e.token == token) {
                    this.parked.RemoveAt(i)
                    return
                }
            }
        }

        undefined Close() {
            if (this.closed) { return }
            try {
                var o = new Data.PostgresOut()
                o.Begin(88)
                o.End()
                this.Write(o.ToBuffer())
            } catch (e) { }
            this.closed = true
            try {
                if (this.tls != undefined) { this.tls.Close() } else if (this.tcp != undefined) { this.tcp.Close() }
            } catch (e) { }
        }
    }

    class PostgresStatement : Data.IStatement {
        Data.PostgresConnection connection
        string name
        defined int params
        List columns
        List types
        any args
        any current
        int token
        bool done
        bool ran
        bool open

        construct(Data.PostgresConnection connection, string name, defined int params, List columns, List types) {
            this.connection = connection
            this.name = name
            this.params = params
            this.columns = take columns
            this.types = take types
            this.token = 0
            this.done = true
            this.ran = false
            this.open = true
        }
        destruct() { this.Close() }

        undefined Bind(any args) {
            int have = 0
            if (args != undefined) { have = args.length }
            if (have != this.params) { throw new ArgumentException("The statement has " + this.params + " parameter(s), " + have + " value(s) were given.") }
            if (args == undefined) { this.args = new any[0] } else { this.args = copy args }
            this.Reset()
        }

        // (bytes of a parameter: a byte buffer, or an array of 0..255)
        static byte[] BytesOf(any v) {
            byte out[] = new byte[v.length]
            for (var i = 0; i < v.length; i++) { out[i] = v[i] }
            return out
        }

        // (Bind, Execute, Sync: the parameters as text - a bool as 1/0, which a boolean and a number read -, bytes in binary; the results as text,
        // bytea in binary)
        undefined Run() {
            var cn = this.connection
            var o = cn.Command()
            o.Begin(66)
            o.Nul("")
            o.Nul(this.name)
            int n = this.args.length
            o.Int16(n)
            for (var i = 0; i < n; i++) {
                any v = this.args[i]
                bool binary = !(v == undefined || v is of int || v is of float || v is of string || v is of bool || v is of char)
                if (binary) { o.Int16(1) } else { o.Int16(0) }
            }
            o.Int16(n)
            for (var i = 0; i < n; i++) {
                any v = this.args[i]
                if (v == undefined) { o.Int32(-1); continue }
                byte data[] = undefined
                if (v is of bool) {
                    if (v) { data = IO.Utf8.GetBytes("1") } else { data = IO.Utf8.GetBytes("0") }
                }
                else if (v is of int || v is of string || v is of char) { data = IO.Utf8.GetBytes("" + v) }
                else if (v is of float) { data = IO.Utf8.GetBytes(Data.PostgresStatement.FloatText(v)) }
                else { data = Data.PostgresStatement.BytesOf(v) }
                o.Int32(data.length)
                o.Bytes(data)
            }
            int c = this.columns.Count
            o.Int16(c)
            for (var i = 0; i < c; i++) {
                Data.PostgresColumn col = this.columns[i]
                if (col.oid == 17) { o.Int16(1) } else { o.Int16(0) }
            }
            o.End()
            o.Begin(69)
            o.Nul("")
            o.Int32(0)
            o.End()
            o.Begin(83)
            o.End()
            cn.Write(o.ToBuffer())
            cn.changes = 0
            var first = cn.Read()
            if (first.type == 69) { cn.Fail(first) }
            // (BindComplete; then the rows stay on the socket: Next reads them one by one)
            this.token = cn.NewToken()
            cn.streamToken = this.token
            this.done = false
            if (c == 0) {
                // (no rows: the statement is run to its end at once - its changes are known after Execute)
                while (this.Next()) { }
            }
        }
        static string FloatText(float v) {
            if (v != v) { return "NaN" }
            if (v > 1.0e308) { return "Infinity" }
            if (v < -1.0e308) { return "-Infinity" }
            return "" + v
        }

        // (a DataRow: the values by the types of the columns)
        any RowOf(Data.PostgresIn m) {
            int n = m.Int16()
            any values = new any[n]
            for (var i = 0; i < n; i++) {
                int len = m.Int32()
                if (len < 0) { values[i] = undefined; continue }
                int oid = 25
                if (i < this.columns.Count) {
                    Data.PostgresColumn col = this.columns[i]
                    oid = col.oid
                }
                if (oid == 17) { values[i] = m.Bytes(len); continue }
                values[i] = Data.PostgresStatement.ValueOf(m.Text(len), oid)
            }
            return values
        }

        static any ValueOf(string text, defined int oid) {
            if (oid == 20 || oid == 21 || oid == 23 || oid == 26 || oid == 28) {
                any n = text.ToInt()
                if (n == undefined) { return text }
                return n
            }
            if (oid == 16) {
                if (text == "t") { return 1 }
                return 0
            }
            if (oid == 700 || oid == 701) {
                if (text == "NaN") { return 0.0 / 0.0 }
                if (text == "Infinity") { return 1.0e308 * 10.0 }
                if (text == "-Infinity") { return -1.0e308 * 10.0 }
                return text.ToFloat()
            }
            if (oid == 1700) {
                // (numeric: an int when it has no fraction)
                if (text.IndexOf(".") < 0 && text != "NaN") {
                    any n = text.ToInt()
                    if (n != undefined) { return n }
                }
                return text.ToFloat()
            }
            return text
        }

        bool Next() {
            if (!this.ran) {
                this.ran = true
                this.Run()
            }
            var cn = this.connection
            while (true) {
                if (this.done) { return false }
                Data.PostgresIn m = undefined
                bool fromSocket = cn.streamToken == this.token
                if (fromSocket) { m = cn.Read() } else { m = cn.Unpark(this.token) }
                if (m == undefined) {
                    this.done = true
                    return false
                }
                if (m.type == 68) {
                    this.current = this.RowOf(m)
                    return true
                }
                if (m.type == 67) { cn.Complete(m); continue }
                if (m.type == 69) {
                    any e = Data.PostgresConnection.ErrorOf(m)
                    this.done = true
                    if (fromSocket) {
                        cn.streamToken = 0
                        cn.UntilReady()
                    } else { cn.Discard(this.token) }
                    this.token = 0
                    Data.PostgresDriver.Fail(e[0], e[1])
                }
                if (m.type == 90) {
                    this.done = true
                    if (fromSocket) {
                        cn.streamToken = 0
                        cn.state = m.Byte()
                    }
                    this.token = 0
                    return false
                }
                // ('2' BindComplete, 'I' EmptyQueryResponse, 's' PortalSuspended, 'n' NoData: passed over)
            }
            return false
        }
        any Values() {
            any row = this.current
            return copy row
        }
        any Names() {
            any names = new any[this.columns.Count]
            for (var i = 0; i < this.columns.Count; i++) {
                Data.PostgresColumn c = this.columns[i]
                names[i] = c.name
            }
            return names
        }
        undefined Reset() {
            this.Finish()
            this.ran = false
            this.done = true
            this.current = undefined
        }
        // (the rows not read yet are thrown away)
        undefined Finish() {
            var cn = this.connection
            if (this.token != 0 && cn != undefined && !cn.closed) {
                try { cn.Discard(this.token) } catch (e) { }
            }
            this.token = 0
        }
        undefined Close() {
            if (!this.open) { return }
            this.Finish()
            this.open = false
            var cn = this.connection
            if (cn == undefined || cn.closed) { return }
            cn.closing.Add(this.name)                     // (closed with the next command: no round trip of its own)
        }
    }
}
