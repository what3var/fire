#import "ai"
#import "json"
#import "time"

// ai.agent (docs/ai/agent.md): an agent on a small language model of the package ai - instructions, a conversation it remembers (but does not show),
// tools it may call, and choices among options.
//
//     var agent = new AI.Agent("Qwen3.5-0.8B-Q4_0.gguf", "You help with the files of a project.")
//     agent.Tool("read_file", "Reads a text file", ["path: the file"], (JsonObject args) => File.ReadAllText(args.Get("path")))
//     print(agent.Ask("What is in notes.txt?"))          // calls read_file, then answers
//     print(agent.Choose("Is this a question or a bug report: 'it crashes'?", ["A question", "A bug report"]))   // 1
//
// A user interface does not wait: Start(text), then Update() in its timer gives the new text (and runs the tools when the model asks for them).
namespace AI {
    // A tool the agent may call: its name, what it does, its parameters (all text) and what runs.
    class AgentTool {
        string Name
        string Description
        List parameters = new List()
        List descriptions = new List()
        string schema = ""
        string lambda<JsonObject> handler

        // The tool as the models expect it (OpenAI style JSON: name, description, parameters as a JSON schema).
        string Json() {
            var opts = new JsonOptions()
            opts.typeNames = false
            // (the objects are owned by this method until the text is made: JsonObject.Set does not take them, and a block would end them before)
            var fn = new JsonObject()
            var ps = new JsonObject()
            var props = new JsonObject()
            var required = new List()
            var items = new List()
            any parsed = undefined
            fn.Set("name", this.Name)
            fn.Set("description", this.Description)
            if (this.schema != "") {
                parsed = Json.Parse(this.schema)
                fn.Set("parameters", parsed)
            }
            else {
                for (var i = 0; i < this.parameters.Count; i++) {
                    var p = new JsonObject()
                    p.Set("type", "string")
                    p.Set("description", this.descriptions[i])
                    props.Set(this.parameters[i], p)
                    required.Add(this.parameters[i])
                    items.Add(take p)
                }
                ps.Set("type", "object")
                ps.Set("properties", props)
                ps.Set("required", required)
                fn.Set("parameters", ps)
            }
            return Json.Serialize(fn, opts)
        }
    }

    // A call of a tool the model asked for, and what the tool answered.
    class AgentCall {
        string Name
        JsonObject Arguments
        string Result = ""
    }

    // An agent: a model, its instructions and tools, and the conversation so far. The conversation is kept as the model has read it (the cache of the
    // session holds it: the next question only computes what is new); History gives it as messages for the one who wants to see it.
    class Agent {
        AI.Model model
        AI.Session session
        bool ownsModel = false
        string Instructions = ""
        // How the answers are written (Exact: the most likely words, always the same; the default writes a little freer).
        AI.Settings Settings
        // The rounds of tool calls of one question at most.
        int MaxSteps = 6
        // Let the model think first (Qwen 3.5, LFM 3): better for hard questions, slower; the thinking is not shown.
        bool Thinking = false
        // The tokens it may think (per round): then its thinking is closed and it has to answer (a small model may think on and on otherwise).
        int ThinkingBudget = 384
        // A tool's answer longer than this (characters) is cut (a long file must not fill the context: the question would go, or the prompt not fit).
        int MaxResultLength = 3000
        List tools = new List()
        // the conversation: the turns as the model read them, and as messages
        List turns = new List()
        List roles = new List()
        List texts = new List()
        int contextTokens
        // the job: what the model wrote of the turn so far, what of it was shown
        string raw = ""
        int shown = 0
        int steps = 0
        bool running = false
        List calls = new List()
        List callKeys = new List()
        // the turn of the question that is answered (older turns may go when the context is full, this one and those after it stay)
        int questionTurn = 0
        // the tokens written for the question in the rounds before this one; its thinking was closed by the budget
        int generatedBefore = 0
        bool thinkingCut = false
        // the answer waits for the instructions that Prepare reads (its job is not cancelled: what it read is the start of the prompt, and a cancel
        // waits for the batch it computes - seconds on a slow machine, in the thread of the user interface)
        bool afterPrepare = false
        bool preparing = false
        bool finalRound = false
        // What the model wrote last, as it wrote it (with the calls of tools and the thinking) - for finding out why it did what it did.
        string LastOutput = ""
        // Called with each call of a tool before it runs (a user interface shows "reading notes.txt ..."); undefined: none.
        any OnToolCall = undefined

        // An agent on the model file `path` (GGUF: Qwen3.5-0.8B, LFM3-1.7B, Qwen2.5 ...).
        construct(string path, string instructions = "", int context = 4096) {
            this.model = new AI.Model(path)
            this.ownsModel = true
            this.Init(instructions, context)
        }

        // An agent on a model that is loaded already (several agents can share it).
        construct(AI.Model model, string instructions = "", int context = 4096) {
            this.model = model
            this.Init(instructions, context)
        }

        undefined Init(string instructions, int context) {
            this.Instructions = instructions
            this.contextTokens = context
            this.session = new AI.Session(this.model, context)
            this.Settings = new AI.Settings()
            this.Settings.Temperature = 0.3
            this.Settings.MaxTokens = 768
        }

        destruct() { this.Close() }

        undefined Close() {
            if (this.session != undefined) { this.session.Close() }
            if (this.ownsModel && this.model != undefined) { this.model.Close() }
        }

        AI.Model Model { get { return this.model } }

        // A tool with parameters of text: each "name: what it is" (all are required). The handler gets them as a JsonObject and returns its answer as text.
        undefined Tool(string name, string description, string parameters[], string lambda<JsonObject> handler) {
            var t = new AI.AgentTool()
            t.Name = name
            t.Description = description
            foreach (p in parameters) {
                int at = p.IndexOf(":")
                if (at < 0) { t.parameters.Add(p.Trim()); t.descriptions.Add("") }
                else { t.parameters.Add(p.Substring(0, at).Trim()); t.descriptions.Add(p.Substring(at + 1).Trim()) }
            }
            t.handler = take handler
            this.tools.Add(take t)
        }

        // A tool with the parameters as a JSON schema (numbers, choices, optional ones; the tools of an MCP server come this way).
        undefined ToolWithSchema(string name, string description, string schemaJson, string lambda<JsonObject> handler) {
            var t = new AI.AgentTool()
            t.Name = name
            t.Description = description
            t.schema = schemaJson
            t.handler = take handler
            this.tools.Add(take t)
        }

        undefined RemoveTool(string name) {
            for (var i = 0; i < this.tools.Count; i++) {
                AI.AgentTool t = this.tools[i]
                if (t.Name == name) { this.tools.RemoveAt(i); return }
            }
        }

        int ToolCount { get { return this.tools.Count } }

        // ---- the prompt ----

        string Family { get { return this.model.Architecture } }

        // The system message the model reads: the instructions and the tools in the format of the model.
        string SystemPrompt { get { return this.SystemText() } }

        string SystemText() {
            string text = this.Instructions
            if (this.tools.Count == 0) { return text }
            string list = ""
            for (var i = 0; i < this.tools.Count; i++) {
                AI.AgentTool t = this.tools[i]
                list += "\n" + AI.Agent.Spaced(t.Json())
            }
            if (this.Family == "lfm3") {
                if (text != "") { text += "\n\n" }
                return text + "<tools>" + list + "\n</tools>"
            }
            string tools = "# Tools\n\nYou have access to the following functions:\n\n<tools>" + list + "\n</tools>\n\n"
            tools += "If you choose to call a function ONLY reply in the following format with NO suffix:\n\n<tool_call>\n<function=example_function_name>\n"
            tools += "<parameter=example_parameter_1>\nvalue_1\n</parameter>\n</function>\n</tool_call>\n\n<IMPORTANT>\nReminder:\n"
            tools += "- Function calls MUST follow the specified format: an inner <function=...></function> block must be nested within <tool_call></tool_call> XML tags\n"
            tools += "- Required parameters MUST be specified\n- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after\n"
            tools += "- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n</IMPORTANT>"
            if (text != "") { tools += "\n\n" + text }
            return tools
        }

        // JSON as the chat templates write it (json.dumps: ", " and ": " outside of strings) - the models learned it so.
        static string Spaced(string json) {
            string b = ""
            bool inString = false
            bool escaped = false
            foreach (c in json) {
                b += c
                if (inString) {
                    if (escaped) { escaped = false }
                    else if (c == '\\') { escaped = true }
                    else if (c == '"') { inString = false }
                }
                else if (c == '"') { inString = true }
                else if (c == ',' || c == ':') { b += " " }
            }
            return b
        }

        string Begin() {
            string b = ""
            if (this.Family == "lfm3") { b = this.model.StartText }
            string sys = this.SystemText()
            if (sys != "") { b += "<|im_start|>system\n" + sys + "<|im_end|>\n" }
            return b
        }

        string AssistantStart() {
            string b = "<|im_start|>assistant\n"
            string f = this.Family
            if (f == "qwen3" || f == "qwen35") {
                if (this.Thinking) { b += "<think>\n" } else { b += "<think>\n\n</think>\n\n" }
            }
            else if (f == "lfm3") {
                if (this.Thinking) { b += "<think>" } else { b += "<think></think>" }
            }
            return b
        }

        // What the model reads: the beginning, the turns so far and the start of the answer. Old turns go when it does not fit - never the question
        // that is answered and what the tools said about it.
        string Prompt() {
            string begin = this.Begin()
            string all = ""
            foreach (t in this.turns) { all += t }
            string p = begin + all + this.AssistantStart() + this.raw
            while (this.questionTurn > 0 && this.model.CountTokens(p) > this.contextTokens - this.Settings.MaxTokens - 16) {
                this.turns.RemoveAt(0)
                this.questionTurn--
                all = ""
                foreach (t in this.turns) { all += t }
                p = begin + all + this.AssistantStart() + this.raw
            }
            return p
        }

        // ---- asking ----

        // The answer to `text`: the model may call tools first (MaxSteps rounds at most). Waits for it.
        string Ask(string text) {
            this.Start(text)
            string answer = ""
            while (this.Running) {
                answer += this.Update()
                if (this.Running) { Sleep(2ms) }
            }
            return answer.Trim()
        }

        // Starts the answer to `text` (a question of the user); Update gives it while it comes.
        undefined Start(string text) {
            if (this.running) { this.Cancel() }
            this.questionTurn = this.turns.Count
            this.turns.Add("<|im_start|>user\n" + text + "<|im_end|>\n")
            this.roles.Add("user")
            this.texts.Add(text)
            this.raw = ""
            this.shown = 0
            this.steps = 0
            this.calls.Clear()
            this.callKeys.Clear()
            this.generatedBefore = 0
            this.thinkingCut = false
            this.finalRound = false
            this.LastEnd = AI.End.Model
            this.running = true
            this.Generate()
        }

        // Reads the instructions and tools now, in the background (they are most of every prompt: on a slow or busy machine minutes), so the first
        // question does not wait for them. A question that comes earlier goes on from where it got.
        undefined Prepare() {
            if (this.running || this.session.Busy) { return }
            string begin = this.Begin()
            if (begin == "") { return }
            this.session.Keep(begin)
            this.session.Start(begin, AI.Settings.Exact(1))
            this.preparing = true
        }

        undefined Generate() {
            // (a Prepare that still runs: the answer starts when it is done - Update)
            if (this.session.Busy && this.preparing) {
                this.afterPrepare = true
                return
            }
            this.afterPrepare = false
            this.preparing = false
            if (this.session.Busy) { this.session.Cancel() }
            var s = copy this.Settings
            s.Stops.Add(this.finalRound ? "<tool_call>" : "</tool_call>")
            // (the instructions and tools stay computed for every prompt, also when the turns after them change)
            this.session.Keep(this.Begin())
            string prompt = this.Prompt()
            int tokens = this.model.CountTokens(prompt)
            if (tokens + 16 > this.contextTokens) {
                this.running = false
                throw new AI.AIException("The question does not fit into the context of the model (" + tokens + " of " + this.contextTokens + " tokens): ask it shorter, or start a new topic.")
            }
            // (not more tokens than the context still holds)
            if (s.MaxTokens <= 0 || s.MaxTokens > this.contextTokens - tokens - 8) { s.MaxTokens = this.contextTokens - tokens - 8 }
            this.session.Start(prompt, s)
        }

        // ---- what it is doing (a user interface shows it while the answer does not come) ----

        // The session that computes (its numbers: PromptDone, Generated, TokensPerSecond ...).
        AI.Session Session { get { return this.session } }
        // Whether it reads the prompt (its instructions, the conversation, what the tools said) - before it writes.
        bool Reading { get { return this.running && this.session.State == AI.State.Prompt } }
        // The tokens of the prompt read so far, and of all of it (without those it still had from before).
        int ReadDone { get { return this.session.PromptDone - this.session.PromptReused } }
        int ReadTotal { get { return this.session.PromptTokens - this.session.PromptReused } }
        // The tokens written for the question so far (also the thinking and the calls of tools; all rounds).
        int Written { get { return this.generatedBefore + this.session.Generated } }
        // Whether it is thinking now (the thinking is not shown).
        bool InThought { get { return this.running && AI.Agent.ThinkingOpen(this.raw, this.OpensThinking()) } }
        // How the last answer ended: Model (complete), MaxTokens (cut at Settings.MaxTokens), Context (the context was full), Cancelled.
        AI.End LastEnd = AI.End.Model
        // The thinking of the last answer was closed at ThinkingBudget.
        bool ThinkingCut { get { return this.thinkingCut } }

        // Whether the prompt opens the thinking (Thinking, and a model that thinks first).
        bool OpensThinking() {
            string f = this.Family
            return this.Thinking && (f == "qwen3" || f == "qwen35" || f == "lfm3")
        }

        // Whether `raw` (the answer so far) is in its thinking: after a <think> without its </think>, or from the start when the prompt opened it.
        static bool ThinkingOpen(string raw, bool openedByPrompt) {
            if (raw.IndexOf("</think>") >= 0) { return false }
            return openedByPrompt || raw.TrimStart().StartsWith("<think>")
        }

        // Whether the agent is still at work (writing, or calling tools).
        bool Running { get { return this.running } }

        // The text of the answer that came since the last call ("" when nothing came). Runs the tools when the model asked for them and goes on.
        string Update() {
            if (!this.running) { return "" }
            if (this.afterPrepare) {
                if (this.session.Busy) { return "" }
                this.session.Take()   // (the token of Prepare)
                this.Generate()
                return ""
            }
            this.raw += this.session.Take()
            if (this.session.Busy) {
                // thinking too long: its thinking is closed, the model goes on with the answer
                if (this.ThinkingBudget > 0 && this.session.Generated >= this.ThinkingBudget && AI.Agent.ThinkingOpen(this.raw, this.OpensThinking())) {
                    this.session.Cancel()
                    this.raw += this.session.Take()
                    this.generatedBefore += this.session.Generated
                    this.raw = this.raw.TrimEnd() + "\n</think>\n\n"
                    this.thinkingCut = true
                    this.Generate()
                    return ""
                }
                return this.Visible(false)
            }
            if (this.session.State == AI.State.Failed) {
                this.running = false
                throw new AI.AIException(this.session.Error)
            }
            string shownNow = this.Visible(true)
            this.LastOutput = this.raw
            this.generatedBefore += this.session.Generated
            int call = this.raw.IndexOf("<tool_call>")
            if (call >= 0 && this.steps <= this.MaxSteps && this.session.State == AI.State.Done && !AI.Agent.ThinkingOpen(this.raw.Substring(0, call), this.OpensThinking())) {
                // the model asked for tools: run them, give it the answers, let it go on - after MaxSteps rounds it gets no more answers but the request to
                // answer with what it has (a small model goes on searching otherwise, and the question stays without an answer)
                this.raw += "</tool_call>"
                List results = new List()
                if (this.steps < this.MaxSteps) { results = this.RunTools(this.raw.Substring(call)) }
                else { results.Add("No more tools now: answer the question with what you found so far.") }
                this.turns.Add(this.AssistantStart() + this.raw + "<|im_end|>\n")
                this.turns.Add(this.ToolTurn(results))
                this.raw = ""
                this.shown = 0
                this.steps++
                // the last round: no tools (a call ends the text, what came before it is the answer), no thinking - the answer comes now
                if (this.steps > this.MaxSteps) {
                    this.finalRound = true
                    if (this.OpensThinking()) { this.raw = "\n</think>\n\n" }
                }
                this.Generate()
                return shownNow
            }
            // the answer is complete (an answer that is still thinking has none)
            this.LastEnd = this.session.EndReason
            string answer = this.raw
            if (AI.Agent.ThinkingOpen(answer, this.OpensThinking())) { answer = "" }
            answer = AI.Chat.WithoutThinking(answer)
            int at = answer.IndexOf("<tool_call>")
            if (at >= 0) { answer = answer.Substring(0, at) }
            this.turns.Add(this.AssistantStart() + this.raw + "<|im_end|>\n")
            this.roles.Add("assistant")
            this.texts.Add(answer.Trim())
            this.raw = ""
            this.running = false
            return shownNow
        }

        // The part of raw that can be shown and was not yet: without the thinking and without a call of a tool (and while it writes, without what could
        // still become "<tool_call>").
        string Visible(bool final) {
            string text = this.raw
            int think = text.IndexOf("</think>")
            var begin = 0
            if (think >= 0) { begin = think + 8 }
            else if (AI.Agent.ThinkingOpen(text, this.OpensThinking())) { return "" }
            int end = text.IndexOf("<tool_call>")
            if (end < 0) {
                end = text.Length
                if (!final) {
                    // hold back a "<" that might start a tag
                    int lt = text.LastIndexOf("<")
                    if (lt >= begin && text.Length - lt < 12) { end = lt }
                }
            }
            if (begin < this.shown) { begin = this.shown }
            if (end <= begin) { return "" }
            string part = text.Substring(begin, end - begin)
            if (this.shown == 0) { part = part.TrimStart() }
            this.shown = end
            return part
        }

        // The calls in `text` (<tool_call><function=name><parameter=p>value</parameter></function></tool_call>, or the JSON of Qwen 2.5:
        // <tool_call>{"name": ..., "arguments": {...}}</tool_call>), each run; their answers.
        List RunTools(string text) {
            var results = new List()
            string rest = text
            int at = rest.IndexOf("<tool_call>")
            while (at >= 0) {
                int close = rest.IndexOf("</tool_call>", at)
                if (close < 0) { close = rest.Length }
                string body = rest.Substring(at + 11, close - at - 11).Trim()
                var call = AI.Agent.ParseCall(body)
                if (call != undefined) {
                    results.Add(this.RunTool(call))
                }
                if (close >= rest.Length) { break }
                rest = rest.Substring(close + 12)
                at = rest.IndexOf("<tool_call>")
            }
            return results
        }

        // A call of a tool as the model wrote it between <tool_call> and </tool_call> (XML of Qwen 3.5 / LFM 3, or JSON); undefined when it is none.
        static AI.AgentCall ParseCall(string body) {
            var call = new AI.AgentCall()
            call.Arguments = new JsonObject()
            if (body.StartsWith("{")) {
                try {
                    any o = Json.Parse(body)
                    call.Name = o.Get("name")
                    any args = o.Get("arguments")
                    if (args is of string) { args = Json.Parse(args) }
                    if (args != undefined) { call.Arguments = args }
                    return call
                } catch (Exception e) { return undefined }
            }
            int f = body.IndexOf("<function=")
            if (f < 0) { return undefined }
            int gt = body.IndexOf(">", f)
            if (gt < 0) { return undefined }
            call.Name = body.Substring(f + 10, gt - f - 10).Trim()
            int p = body.IndexOf("<parameter=", gt)
            while (p >= 0) {
                int pgt = body.IndexOf(">", p)
                if (pgt < 0) { break }
                string name = body.Substring(p + 11, pgt - p - 11).Trim()
                // the value ends at </parameter> - or, when the model forgot it, at the next parameter or the end of the function
                int pend = AI.Agent.First(body, pgt, "</parameter>", "<parameter=", "</function>")
                string value = body.Substring(pgt + 1, pend - pgt - 1)
                if (value.StartsWith("\n")) { value = value.Substring(1) }
                value = value.TrimEnd()
                if (AI.Agent.IsName(name)) { call.Arguments.Set(name, value) }
                if (pend >= body.Length) { break }
                p = body.IndexOf("<parameter=", pend)
            }
            return call
        }

        // A name of a parameter: letters, digits, _ and - (what else the model wrote there is no parameter).
        static bool IsName(string name) {
            if (name == "") { return false }
            foreach (c in name) {
                if (!(c.IsLetterOrDigit() || c == '_' || c == '-')) { return false }
            }
            return true
        }

        // The arguments as the schema wants them: the models write every value as text (XML), and small ones add a comma or a word ("12,", "3 lines").
        // A number, integer or boolean property gets the number or truth its text begins with.
        static undefined Coerce(JsonObject args, string schema) {
            any parsed = undefined
            try { parsed = Json.Parse(schema) } catch (Exception e) { return }
            if (!(parsed is of JsonObject) || !parsed.Has("properties")) { return }
            JsonObject props = parsed.Get("properties")
            foreach (k in args.Keys()) {
                string key = k
                if (!props.Has(key)) { continue }
                any spec = props.Get(key)
                any v = args.Get(key)
                if (!(spec is of JsonObject) || !spec.Has("type") || !(v is of string)) { continue }
                string type = spec.Get("type")
                string text = v
                text = text.Trim()
                if (type == "integer" || type == "number") {
                    string digits = ""
                    for (var i = 0; i < text.Length; i++) {
                        char c = text[i]
                        if (c.IsDigit() || (i == 0 && c == '-') || (type == "number" && c == '.')) { digits += c } else { break }
                    }
                    if (digits != "" && digits != "-") {
                        if (type == "integer" || digits.IndexOf(".") < 0) { args.Set(key, digits.ToInt()) } else { args.Set(key, digits.ToFloat()) }
                    }
                }
                else if (type == "boolean") {
                    string lower = text.ToLower()
                    if (lower.StartsWith("true") || lower.StartsWith("yes")) { args.Set(key, true) }
                    else if (lower.StartsWith("false") || lower.StartsWith("no")) { args.Set(key, false) }
                }
            }
        }

        // The first place at or after `start` of one of the three texts (the end of `text` when none comes).
        static int First(string text, int start, string a, string b, string c) {
            int best = text.Length
            int at = text.IndexOf(a, start)
            if (at >= 0 && at < best) { best = at }
            at = text.IndexOf(b, start)
            if (at >= 0 && at < best) { best = at }
            at = text.IndexOf(c, start)
            if (at >= 0 && at < best) { best = at }
            return best
        }

        string RunTool(AI.AgentCall call) {
            AI.AgentTool tool = undefined
            for (var i = 0; i < this.tools.Count; i++) {
                AI.AgentTool t = this.tools[i]
                if (t.Name == call.Name) { tool = t }
            }
            if (this.OnToolCall != undefined) { this.OnToolCall(call.Name, call.Arguments) }
            string result = ""
            if (tool == undefined) { result = "Error: there is no tool '" + call.Name + "'." }
            else {
                if (tool.schema != "") { AI.Agent.Coerce(call.Arguments, tool.schema) }
                // the same call again (a small model may ask for the same thing round after round): no new answer
                string key = call.Name + " " + Json.Serialize(call.Arguments)
                if (this.callKeys.Contains(key)) { result = "You called " + call.Name + " with these arguments already: its answer is above. Use it, or answer now." }
                else {
                    this.callKeys.Add(key)
                    try { result = tool.handler(call.Arguments) }
                    catch (Exception e) { result = "Error: " + e.message }
                }
            }
            if (this.MaxResultLength > 0 && result.Length > this.MaxResultLength) {
                result = result.Substring(0, this.MaxResultLength) + "\n... (cut: " + (result.Length - this.MaxResultLength) + " more characters)"
            }
            call.Result = result
            this.calls.Add(take call)
            return result
        }

        string ToolTurn(List results) {
            string role = "user"
            if (this.Family == "lfm3") { role = "tool" }
            string b = "<|im_start|>" + role + "\n"
            for (var i = 0; i < results.Count; i++) {
                if (i > 0) { b += "\n" }
                b += "<tool_response>\n" + results[i] + "\n</tool_response>"
            }
            return b + "<|im_end|>\n"
        }

        // The calls of tools of the last question (name, arguments, result).
        List Calls { get { return this.calls } }

        // Stops the answer (what came so far stays in the conversation).
        undefined Cancel() {
            if (!this.running) { return }
            // (the answer still waits for Prepare: that goes on - the instructions are read for the next question)
            if (this.afterPrepare) { this.afterPrepare = false }
            else {
                this.session.Cancel()
                this.raw += this.session.Take()
            }
            this.LastEnd = AI.End.Cancelled
            if (AI.Agent.ThinkingOpen(this.raw, this.OpensThinking())) { this.raw += "\n</think>\n\n" }
            this.turns.Add(this.AssistantStart() + this.raw + "<|im_end|>\n")
            this.roles.Add("assistant")
            this.texts.Add(AI.Chat.WithoutThinking(this.raw).Trim())
            this.raw = ""
            this.running = false
        }

        // ---- the conversation ----

        // The messages so far ("user" / "assistant" and the text) - not shown by default, only for those who want to see them.
        int HistoryCount { get { return this.roles.Count } }
        string HistoryRole(int i) { return this.roles[i] }
        string HistoryText(int i) { return this.texts[i] }

        // Takes a message into the conversation without an answer of the model - a conversation that was saved goes on ("user" or "assistant").
        undefined Remember(string role, string text) {
            if (this.running) { this.Cancel() }
            if (role == "assistant") { this.turns.Add(this.AssistantStart() + text + "<|im_end|>\n") }
            else { this.turns.Add("<|im_start|>user\n" + text + "<|im_end|>\n") }
            this.roles.Add(role == "assistant" ? "assistant" : "user")
            this.texts.Add(text)
        }

        // A new topic: the conversation is forgotten (the instructions and tools stay).
        undefined Forget() {
            if (this.running) { this.Cancel() }
            this.questionTurn = 0
            this.turns.Clear()
            this.roles.Clear()
            this.texts.Clear()
        }

        // ---- choices ----

        // The index of the most likely of `options` as the answer to `question` (the model reads the options and the start of the answer and weighs
        // each option; it does not write). The conversation is not changed.
        int Choose(string question, string options[]) {
            if (!this.running && this.session.Busy) { this.session.Cancel() }   // (a Prepare)
            this.preparing = false
            string q = question + "\n\nOptions:\n"
            foreach (o in options) { q += "- " + o + "\n" }
            q += "\nAnswer with one of the options."
            var spaced = new string[options.Length]
            for (var i = 0; i < options.Length; i++) { spaced[i] = " " + options[i] }
            var chat = new AI.Chat()
            chat.For(this.model)
            string sys = "You answer questions correctly and briefly."
            if (this.Instructions != "") { sys = this.Instructions + "\n\n" + sys }
            chat.System(sys)
            chat.User(q)
            return this.session.Choose(chat.Prompt("Answer:"), spaced, true)
        }

        // The answer to `question` alone, outside the conversation (nothing is remembered, no tools).
        string Once(string question) {
            if (!this.running && this.session.Busy) { this.session.Cancel() }   // (a Prepare)
            this.preparing = false
            var s = copy this.Settings
            return this.session.Ask(this.Instructions, question, s)
        }
    }
}
