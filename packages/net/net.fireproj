        "arguments": 2,
        "c": "fire_net_ConnectBegin"
      },
      {
        "name": "__NetConnectStep",
        "arguments": 1,
        "c": "fire_net_ConnectStep"
      },
      {
        "name": "__NetTcpListen",
        "arguments": 3,
        "c": "fire_net_TcpListen"
      },
      {
        "name": "__NetAccept",
        "arguments": 2,
        "c": "fire_net_Accept"
      },
      {
        "name": "__NetSend",
        "arguments": 5,
        "c": "fire_net_Send"
      },
      {
        "name": "__NetRecv",
        "arguments": 5,
        "c": "fire_net_Recv"
      },
      {
        "name": "__NetUdpOpen",
        "arguments": 2,
        "c": "fire_net_UdpOpen"
      },
      {
        "name": "__NetSendTo",
        "arguments": 6,
        "c": "fire_net_SendTo"
      },
      {
        "name": "__NetRecvFrom",
        "arguments": 5,
        "c": "fire_net_RecvFrom"
      },
      {
        "name": "__NetPeerHost",
        "arguments": 1,
        "needsList": true,
        "returnsReference": true,
        "c": "fire_net_PeerHost"
      },
      {
        "name": "__NetPeerPort",
        "arguments": 1,
