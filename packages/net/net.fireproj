{
  "format": 1,
  "name": "fire-net",
  "type": "library",
  "import": "net",
  "standard": true,
  "settings": {
    "version": "1.0.0",
    "author": "fire",
    "license": "fire",
    "description": "The standard library 'net' of fire: prelude and C sources."
  },
  "native": {
    "sources": [
      "native/fire_bridge_net.h"
    ],
    "discover": false,
    "linkLibraries": {
      "windows": [
        "ws2_32"
      ]
    },
    "functions": [
      {
        "name": "__NetLastError",
        "arguments": 0,
        "c": "fire_net_LastError"
      },
      {
        "name": "__NetLastErrorMessage",
        "arguments": 0,
        "needsList": true,
        "returnsReference": true,
        "c": "fire_net_LastErrorMessage"
      },
      {
        "name": "__NetOpenCount",
        "arguments": 0,
        "c": "fire_net_OpenCount"
      },
      {
        "name": "__NetSupported",
        "arguments": 0,
        "c": "fire_net_Supported"
      },
      {
        "name": "__NetNativeHandle",
        "arguments": 1,
        "c": "fire_net_NativeHandle"
      },
      {
