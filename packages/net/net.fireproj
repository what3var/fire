        "returnsReference": true,
        "c": "fire_net_LocalHost"
      },
      {
        "name": "__NetLocalPort",
        "arguments": 1,
        "c": "fire_net_LocalPort"
      },
      {
        "name": "__NetAvailable",
        "arguments": 1,
        "c": "fire_net_Available"
      },
      {
        "name": "__NetPoll",
        "arguments": 4,
        "c": "fire_net_Poll"
      },
      {
        "name": "__NetSetOption",
        "arguments": 3,
        "c": "fire_net_SetOption"
      },
      {
        "name": "__NetShutdown",
        "arguments": 2,
        "c": "fire_net_Shutdown"
      },
      {
        "name": "__NetClose",
        "arguments": 1,
        "c": "fire_net_Close"
      },
      {
        "name": "__NetResolve",
        "arguments": 1,
        "needsList": true,
        "returnsReference": true,
        "c": "fire_net_Resolve"
      }
