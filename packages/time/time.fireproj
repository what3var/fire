      "native/fire_bridge_time.hpp"
    ],
    "discover": false,
    "functions": [
      {
        "name": "Sleep",
        "arguments": 1,
        "cpp": "sleepNative",
        "host": true
      },
      {
        "name": "__time_now",
        "arguments": 0,
        "cpp": "tm_now"
      },
      {
        "name": "__time_local_offset",
        "arguments": 1,
        "cpp": "tm_localOffset"
      },
      {
        "name": "__time_parts",
        "arguments": 1,
        "cpp": "tm_parts",
        "needsList": true,
        "returnsReference": true
      },
      {
        "name": "__time_make",
        "arguments": 7,
        "cpp": "tm_make"
      },
      {
        "name": "__time_parse",
        "arguments": 1,
        "cpp": "tm_parse"
      },
      {
        "name": "__time_format",
        "arguments": 2,
        "cpp": "tm_format",
        "needsList": true,
        "returnsReference": true
      },
      {
        "name": "__time_add_months",
        "arguments": 2,
        "cpp": "tm_addMonths"
      },
      {
        "name": "__time_days_in_month",
        "arguments": 2,
