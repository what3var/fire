// Data (docs/data/README.md, docs/ROADMAP_DATA.md): databases. `new Data.Connection(url)` finds the driver of the URL's scheme (a package of its own: data.sqlite, ...),
// a Data.Connection runs SQL with bound parameters - Execute, Query (rows one by one), Rows, Scalar, QueryList/QueryOne (rows as objects) - and transactions.
// A connection belongs to the thread that opened it, like any object; every call can be awaited (`await db.QueryList(...)`).
#import "reflection"
#import "json"
#import "linq"
#import "time"

namespace Data {
    /// <summary>An error of the database: its message, and its code (the driver's: SQLite's extended result code, MySQL's error number, ...).</summary>
    class DataException : Exception {
        int Code
        // The SQLSTATE of the error when the driver knows it ("23505"; PostgreSQL), else undefined.
        string State
        construct(string message, int code = 0) {
            this.message = message
            this.Code = code
        }
    }
    /// <summary>A constraint was broken: unique, primary key, foreign key, not null, check.</summary>
    class ConstraintException : Data.DataException {
        construct(string message, int code = 0) : base(message, code) { }
    }
    /// <summary>The database is busy or locked by another connection longer than the connection waits (its timeout).</summary>
    class BusyException : Data.DataException {
        construct(string message, int code = 0) : base(message, code) { }
    }
    /// <summary>The database cannot be opened or reached (no such file, not a database, refused, the host does not allow it).</summary>
    class ConnectionException : Data.DataException {
        construct(string message, int code = 0) : base(message, code) { }
    }

    /// <summary>A call that does not fit the state of the connection: it is closed, Commit without Begin.</summary>
    class StateException : Data.DataException {
        construct(string message) : base(message, 0) { }
    }

    /// <summary>Who connects (for the drivers with a server; SQLite needs none). Not part of the URL, so it is not in logs.</summary>
    class Credentials {
        string User
        string Password
        construct(string user, string password) {
            this.User = user
            this.Password = password
        }
    }

    // ---- what a driver implements (a class with [Driver "scheme"] and [Keep], made by Data.Open) ----

    interface IDriver {
        // The connection to `target` (the URL without "scheme:").
        Data.IDriverConnection Open(string target, Data.Credentials credentials)
    }

    interface IDriverConnection {
        // The first statement of `sql`, prepared (parameters `?`).
        Data.IStatement Prepare(string sql)
        // SQL without parameters and rows (several statements).
        undefined Exec(string sql)
        // The rows the last INSERT, UPDATE or DELETE changed; the key the last INSERT generated.
        int Changes()
        int LastId()
        Data.Dialect Dialect()
        undefined Close()
    }

    interface IStatement {
        // Resets the statement and binds the values (an array; undefined: none).
        undefined Bind(any args)
        // The next row: true when there is one.
        bool Next()
        // The values of the current row (an array: int, float, string, byte[], undefined).
        any Values()
        // The names of the columns.
        any Names()
        undefined Reset()
        undefined Close()
    }

    /// <summary>What differs between the databases (quoting, transactions, ...): the driver gives its own.</summary>
    class Dialect {
        string Name
        construct(string name = "sql") { this.Name = name }
        string Quote(string name) { return "\"" + name.Replace("\"", "\"\"") + "\"" }
        string Begin() { return "BEGIN" }
        string Commit() { return "COMMIT" }
        string Rollback() { return "ROLLBACK" }
        string Savepoint(string name) { return "SAVEPOINT " + name }
        string Release(string name) { return "RELEASE SAVEPOINT " + name }
        string RollbackTo(string name) { return "ROLLBACK TO SAVEPOINT " + name }

        // ---- the schema (Ensure) ----
        // The SQL type of a column.
        string ColumnType(Data.ColumnMap c) {
            if (c.kind == "int" || c.kind == "bool") { return "INTEGER" }
            if (c.kind == "float") { return "REAL" }
            if (c.kind == "bytes") { return "BLOB" }
            if (c.kind == "string" && c.length > 0) { return "VARCHAR(" + c.length + ")" }
            return "TEXT"
        }
        // The definition of a column in CREATE TABLE / ADD COLUMN ([DbType] gives the type of a database by its name, [Check] a condition).
        string ColumnDefinition(Data.ColumnMap c) {
            string type = Data.ColumnMap.TypeIn(c.dbType, this.Name)
            if (type == undefined) { type = this.ColumnType(c) }
            var t = this.Quote(c.column) + " " + type
            if (c.key) {
                t = t + " PRIMARY KEY"
                if (c.generated) { t = t + this.Generated() }
            } else if (c.required) { t = t + " NOT NULL" }
            if (c.check != undefined) { t = t + " CHECK (" + c.check + ")" }
            return t
        }
        // A view ([View "SELECT ..."] of a [Table] class).
        string CreateView(string name, string sql) { return "CREATE VIEW " + name + " AS " + sql }
        string DropView(string name) { return "DROP VIEW " + this.Quote(name) }
        // (after PRIMARY KEY of a generated key)
        string Generated() { return "" }
        // An INSERT of a row with only the default values.
        string InsertDefault(string table) { return "INSERT INTO " + table + " DEFAULT VALUES" }
        // undefined: the database knows CREATE INDEX IF NOT EXISTS; else a query (the table, the index name) whose first value is not 0 when it is there.
        string IndexQuery() { return undefined }
        // What follows ")" in the CREATE TABLE of Ensure (MySQL: the character set).
        string TableOptions() { return "" }
        // A table made only when it is not there (`body`: "(columns...)").
        string CreateTableIfMissing(string table, string body) { return "CREATE TABLE IF NOT EXISTS " + table + " " + body }
        // A new column of a table.
        string AddColumn(string table, string definition) { return "ALTER TABLE " + table + " ADD COLUMN " + definition }
        // What follows "CREATE [UNIQUE] INDEX i ON t (c)" (SQL Server: a unique index ignores NULL, as in the other databases).
        string IndexSuffix(string column, bool unique) { return "" }
        // A boolean value (a column, a parameter) as a condition (SQL Server: "x = 1"; the others take the value itself).
        string Truth(string value) { return value }
        // A term of ORDER BY: NULL comes first when ascending, last when descending (as SQLite, MySQL and SQL Server sort - PostgreSQL says it).
        string Order(string term, bool descending) {
            if (descending) { return term + " DESC" }
            return term
        }
        // ---- migrations (Data.Migrator): the names are plain, the dialect quotes them ----
        string DropTable(string table) { return "DROP TABLE " + this.Quote(table) }
        string DropColumn(string table, string column) { return "ALTER TABLE " + this.Quote(table) + " DROP COLUMN " + this.Quote(column) }
        string RenameColumn(string table, string column, string to) { return "ALTER TABLE " + this.Quote(table) + " RENAME COLUMN " + this.Quote(column) + " TO " + this.Quote(to) }
        string DropIndex(string name, string table) { return "DROP INDEX " + this.Quote(name) }
        // ---- the schema as it is (db.Schema(), forge data diff/import) ----
        // The names of the tables (no parameter).
        string TablesQuery() { return "SELECT table_name FROM information_schema.tables WHERE table_type = 'BASE TABLE'" }
        // The columns of a table (the table): name, type, nullable (1/0), part of the primary key (1/0) - in their order.
        string ColumnInfoQuery() { return "SELECT column_name, data_type, is_nullable = 'YES', 0 FROM information_schema.columns WHERE table_name = ? ORDER BY ordinal_position" }
        // The indexes of a table (the table) that are not its primary key: name, column, unique (1/0) - a row per column; undefined: not known.
        string IndexesQuery() { return undefined }
        // The paging of a query; `ordered`: it has an ORDER BY (SQL Server pages only ordered rows).
        string Paging(int count, int offset, bool ordered) { return this.Limit(count, offset) }
        // A query (one parameter: the table) whose first column is the name of each column the table has; undefined: the table is not there.
        string ColumnsQuery() { return "select column_name from information_schema.columns where table_name = ?" }

        // ---- the pieces of the queries (Data.Query) ----
        // LIMIT/OFFSET after the rest of a SELECT (count -1: no limit).
        string Limit(int count, int offset) {
            if (count < 0 && offset <= 0) { return "" }
            var t = " LIMIT " + count
            if (offset > 0) { t = t + " OFFSET " + offset }
            return t
        }
        // Text functions (case-sensitive, like fire's): a starts with b, a ends with b, a contains b; the length of a.
        string StartsWith(string a, string b) { return "instr(" + a + ", " + b + ") = 1" }
        string EndsWith(string a, string b, string b2) { return "substr(" + a + ", length(" + a + ") - length(" + b + ") + 1) = " + b2 }
        string Contains(string a, string b) { return "instr(" + a + ", " + b + ") > 0" }
        string Length(string a) { return "length(" + a + ")" }
        string Lower(string a) { return "lower(" + a + ")" }
        string Upper(string a) { return "upper(" + a + ")" }
        string Concat(string a, string b) { return "(" + a + " || " + b + ")" }
    }

    /// <summary>A row of a query: its values by the name of the column (`row["name"]`, `row.Int("age")`) or by position (`row.Get(0)`).</summary>
    class Row {
        any names
        any values

        construct(any names, any values) {
            this.names = take names
            this.values = take values
        }

        int Count { get { return this.values.length } }
        string Name(int index) { return this.names[index] }
        any Names() { return copy this.names }

        // The position of the column `name` (-1: none; the case of the letters does not count).
        int IndexOf(string name) {
            for (var i = 0; i < this.names.length; i++) { if (this.names[i] == name) { return i } }
            string lower = name.ToLower()
            for (var i = 0; i < this.names.length; i++) {
                string n = this.names[i]
                if (n.ToLower() == lower) { return i }
            }
            return -1
        }
        bool Has(string name) { return this.IndexOf(name) >= 0 }

        // The value of a column by its name or position (undefined for NULL).
        any Get(any column) {
            int at = this.At(column)
            return this.values[at]
        }
        any operator[](string name) { return this.Get(name) }

        bool IsNull(any column) { return this.Get(column) == undefined }
        int Int(any column) {
            any v = this.Get(column)
            if (v == undefined) { return 0 }
            if (v is of string) { string t = v; return t.ToInt() }
            return v!int
        }
        float Float(any column) {
            any v = this.Get(column)
            if (v == undefined) { return 0.0 }
            if (v is of string) { string t = v; return t.ToFloat() }
            return v!float
        }
        string Text(any column) {
            any v = this.Get(column)
            if (v == undefined) { return undefined }
            return "" + v
        }
        bool Bool(any column) {
            any v = this.Get(column)
            if (v == undefined) { return false }
            if (v is of bool) { return v }
            if (v is of string) { string t = v; return t == "1" || t.ToLower() == "true" }
            return v != 0
        }
        byte[] Bytes(any column) { return this.Get(column) }

        int At(any column) {
            if (column is of int) {
                int i = column
                if (i < 0 || i >= this.values.length) { throw new IndexOutOfBoundsException("The row has " + this.values.length + " column(s), not " + (i + 1) + ".") }
                return i
            }
            string name = "" + column
            int at = this.IndexOf(name)
            if (at < 0) { throw new ArgumentException("The row has no column '" + name + "' (it has: " + Data.Row.List(this.names) + ").") }
            return at
        }

        static string List(any names) {
            var t = ""
            for (var i = 0; i < names.length; i++) {
                if (i > 0) { t = t + ", " }
                t = t + names[i]
            }
            return t
        }

        string ToString() {
            var t = "{"
            for (var i = 0; i < this.values.length; i++) {
                if (i > 0) { t = t + ", " }
                t = t + this.names[i] + ": " + Json.Serialize(this.values[i])
            }
            return t + "}"
        }
    }

    /// <summary>The rows of a query, one by one (`foreach (row in db.Query(...))`): the statement is read while the loop goes; it ends with the loop or with
    /// Close().</summary>
    class Reader : IEnumerable<Data.Row> {
        Data.IStatement statement
        any names
        bool done

        construct(Data.IStatement statement) {
            this.statement = take statement
            this.names = this.statement.Names()
            this.done = false
        }
        destruct() { this.Close() }

        IEnumerator<Data.Row> GetEnumerator() { return new Data.ReaderEnumerator(this) }

        // The next row, or undefined at the end (the statement is closed there).
        Data.Row Next() {
            if (this.done) { return undefined }
            if (!this.statement.Next()) {
                this.Close()
                return undefined
            }
            return new Data.Row(copy this.names, this.statement.Values())
        }

        undefined Close() {
            if (this.done) { return }
            this.done = true
            this.statement.Close()
        }
    }

    class ReaderEnumerator : IEnumerator<Data.Row> {
        Data.Reader reader
        Data.Row current
        construct(Data.Reader reader) { this.reader = reader }
        bool MoveNext() {
            this.current = this.reader.Next()
            return this.current != undefined
        }
        Data.Row GetCurrent() { return this.current }
    }

    /// <summary>A connection to a database: `new Data.Connection("sqlite:app.db")`, `new Data.Connection("mysql://host/shop", new Data.Credentials("app",
    /// secret))` - the scheme of the URL picks the driver (its package must be imported), the rest is the driver's (a file, a host and a database).</summary>
    class Connection {
        Data.IDriverConnection driver
        string url
        int depth
        bool closed
        Dictionary<string, Data.EntityMap> maps

        construct(string url, Data.Credentials credentials = undefined) {
            this.url = url
            this.depth = 0
            this.closed = false
            int colon = url.IndexOf(":")
            if (colon <= 0) { throw new ArgumentException("Data.Connection: the URL needs a scheme ('sqlite:app.db', 'mysql://host/db'), not '" + url + "'.") }
            string scheme = url.Substring(0, colon).ToLower()
            Data.IDriver d = Data.Connection.Driver(scheme)
            if (d == undefined) { throw new Data.ConnectionException("Data.Connection: no driver for '" + scheme + ":' - import its package (#import \"data." + scheme + "\").") }
            this.driver = d.Open(url.Substring(colon + 1), credentials)
        }

        // (the values of a list as an array - the parameters of a statement; bytes are copied: the field keeps its own)
        static any ArrayOf(List values) {
            any a = new any[values.Count]
            for (var i = 0; i < values.Count; i++) {
                any v = values[i]
                if (v == undefined || v is of int || v is of float || v is of string || v is of bool) { a[i] = v } else { a[i] = copy v }
            }
            return a
        }

        // (the driver of a scheme: the class with [Driver "scheme"])
        static Data.IDriver Driver(string scheme) {
            any all = Type.Names()
            for (var i = 0; i < all.length; i++) {
                string full = all[i]
                Type t = Type.Named(full)
                if (t == undefined) { continue }
                Attribute a = t.FindAttribute("Driver")
                if (a == undefined || a.ArgCount() == 0) { continue }
                // ([Driver "postgres,postgresql"]: several schemes)
                any schemes = ("" + a.Args[0]).Split(",")
                for (var j = 0; j < schemes.length; j++) {
                    string one = schemes[j]
                    if (one.Trim() == scheme) { return t.New(new any[0]) }
                }
            }
            return undefined
        }
        destruct() { this.Close() }

        Data.Dialect Dialect { get { return this.driver.Dialect() } }
        string Url { get { return this.url } }
        bool IsOpen { get { return !this.closed } }
        // Is a transaction open (Begin or Transaction)?
        bool InTransaction { get { return this.depth > 0 } }

        // Runs a statement - INSERT, UPDATE, DELETE, CREATE ... - with the values of `args` for its `?` (an array); the number of rows it changed.
        // Without `args` the text may hold several statements (`;` between them).
        int Execute(string sql, any args = undefined) {
            this.Check()
            if (args == undefined) {
                this.driver.Exec(sql)
                return this.driver.Changes()
            }
            var st = this.driver.Prepare(sql)
            st.Bind(args)
            while (st.Next()) { }
            st.Close()
            return this.driver.Changes()
        }

        // The rows of a query, one by one (`foreach (row in db.Query("select ...", [args]))`).
        Data.Reader Query(string sql, any args = undefined) {
            this.Check()
            var st = this.driver.Prepare(sql)
            st.Bind(args)
            return new Data.Reader(take st)
        }

        // All rows of a query at once.
        List<Data.Row> Rows(string sql, any args = undefined) {
            this.Check()
            var all = new List<Data.Row>()
            var st = this.driver.Prepare(sql)
            st.Bind(args)
            any names = st.Names()
            while (st.Next()) { all.Add(new Data.Row(copy names, st.Values())) }
            st.Close()
            return all
        }

        // The first value of the first row (undefined: no row, or NULL).
        any Scalar(string sql, any args = undefined) {
            this.Check()
            var st = this.driver.Prepare(sql)
            st.Bind(args)
            any value = undefined
            if (st.Next()) {
                any values = st.Values()
                if (values.length > 0) { value = copy values[0] }
            }
            st.Close()
            return value
        }

        // The rows as objects of the class or record `typeName` (`db.QueryList("Person", "select * from person")`): a column goes to the field of the same name
        // (the case of the letters and `_` do not count: `full_name` is `fullName`), converted to its type; a column without a field is left out, a field
        // without a column stays undefined. The objects are made without their constructors (like Json.Deserialize).
        List QueryList(string typeName, string sql, any args = undefined) {
            var all = new List()
            this.Fill(all, typeName, sql, args)
            return all
        }

        // (the objects of the rows into `into`)
        undefined Fill(any into, string typeName, string sql, any args) {
            this.Check()
            var map = new Data.RowMap(typeName)
            var st = this.driver.Prepare(sql)
            st.Bind(args)
            map.Columns(st.Names())
            while (st.Next()) { into.Add(map.Make(st.Values())) }
            st.Close()
        }

        // The same with the class as the type argument: `List<Person> people = db.QueryList<Person>("select * from person")`.
        List<T> QueryList<T>(string sql, any args = undefined) {
            var all = new List<T>()
            this.Fill(all, Type.Of<T>().Name, sql, args)
            return all
        }
        T QueryOne<T>(string sql, any args = undefined) { return this.QueryOne(Type.Of<T>().Name, sql, args) }

        // The first row as an object of `typeName` (undefined: no row).
        any QueryOne(string typeName, string sql, any args = undefined) {
            this.Check()
            var map = new Data.RowMap(typeName)
            var st = this.driver.Prepare(sql)
            st.Bind(args)
            map.Columns(st.Names())
            any one = undefined
            if (st.Next()) { one = map.Make(st.Values()) }
            st.Close()
            return one
        }

        // The key the last INSERT of this connection generated.
        int LastInsertId { get { return this.driver.LastId() } }

        // ---- objects of mapped classes (docs/data/README.md "Mapping"): [Table], [Key], [Column], [Ignore], ... or the convention ----

        // How the class maps to its table (read once per connection).
        Data.EntityMap Map(string typeName) {
            if (this.maps == undefined) { this.maps = new Dictionary<string, Data.EntityMap>() }
            if (!this.maps.ContainsKey(typeName)) { this.maps.Add(typeName, new Data.EntityMap(typeName)) }
            return this.maps[typeName]
        }
        Data.EntityMap MapOf(any obj) {
            if (obj == undefined) { throw new ArgumentException("Data: undefined is no object to write.") }
            return this.Map(Type.Of(obj).Name)
        }

        // Makes the table of the class when it is not there, and the columns and indexes it lacks (never drops anything).
        undefined Ensure(string typeName) {
            this.Check()
            var map = this.Map(typeName)
            var d = this.driver.Dialect()
            List have = new List()
            foreach (row in this.Rows(d.ColumnsQuery(), [map.table])) { have.Add(("" + row.Get(0)).ToLower()) }
            if (map.view != undefined) {
                // (a view: made when it is not there - its query names the tables, which Ensure made before)
                if (have.Count == 0) { this.driver.Exec(d.CreateView(d.Quote(map.table), map.view)) }
                return
            }
            if (have.Count == 0) {
                this.driver.Exec("CREATE TABLE " + d.Quote(map.table) + " " + map.TableBody(d) + d.TableOptions())
            } else {
                for (var i = 0; i < map.columns.Count; i++) {
                    Data.ColumnMap c = map.columns[i]
                    if (have.IndexOf(c.column.ToLower()) < 0) { this.driver.Exec(d.AddColumn(d.Quote(map.table), d.ColumnDefinition(c))) }
                }
            }
            for (var i = 0; i < map.relations.Count; i++) {
                Data.RelationMap r = map.relations[i]
                if (!r.join) { continue }
                map.NeedKey()
                var target = this.Map(r.target)
                target.NeedKey()
                var a = new Data.ColumnMap(r.thisColumn, r.thisColumn, map.key.typeName, map.key.kind)
                a.required = true
                var b = new Data.ColumnMap(r.otherColumn, r.otherColumn, target.key.typeName, target.key.kind)
                b.required = true
                this.driver.Exec(d.CreateTableIfMissing(d.Quote(r.joinTable), "(" + d.ColumnDefinition(a) + ", " + d.ColumnDefinition(b) + ")" + d.TableOptions()))
                this.CreateIndex("ix_" + r.joinTable + "_" + r.thisColumn, r.joinTable, r.thisColumn, false)
            }
            for (var i = 0; i < map.columns.Count; i++) {
                Data.ColumnMap c = map.columns[i]
                if (!c.unique && !c.index) { continue }
                var kind = "INDEX"
                if (c.unique) { kind = "UNIQUE INDEX" }
                string name = "ix_" + map.table + "_" + c.column
                this.CreateIndex(name, map.table, c.column, c.unique)
            }
        }

        // The SQL that makes the table of a class in an empty database, in the dialect of the connection (the table, the join tables of its
        // [ManyToMany] fields, the indexes) - what Ensure would run there, without running it; each statement ends with ";" and a line break.
        string CreateScript(string typeName) { return Data.Script.Of(this.driver.Dialect(), [typeName]) }
        // The script of several classes (Data.Model.Types() of a data model): each table once - a join table is made by the first class that has it.
        string CreateScriptOf(any typeNames) { return Data.Script.Of(this.driver.Dialect(), typeNames) }

        // (an index when it is not there - with IF NOT EXISTS where the database knows it, else after asking its catalog)
        undefined CreateIndex(string name, string table, string column, bool unique) {
            var d = this.driver.Dialect()
            var kind = "INDEX"
            if (unique) { kind = "UNIQUE INDEX" }
            string ask = d.IndexQuery()
            if (ask == undefined) {
                this.driver.Exec("CREATE " + kind + " IF NOT EXISTS " + d.Quote(name) + " ON " + d.Quote(table) + " (" + d.Quote(column) + ")")
                return
            }
            any n = this.Scalar(ask, [table, name])
            if (n != undefined && n != 0) { return }
            this.driver.Exec("CREATE " + kind + " " + d.Quote(name) + " ON " + d.Quote(table) + " (" + d.Quote(column) + ")" + d.IndexSuffix(d.Quote(column), unique))
        }

        // Writes a new row of the object; the generated key goes into the object's key field (a class; a record keeps its fields) and is returned.
        any Insert(any obj) {
            this.Check()
            var map = this.MapOf(obj)
            var d = this.driver.Dialect()
            var names = ""
            var marks = ""
            var args = new List()
            for (var i = 0; i < map.columns.Count; i++) {
                Data.ColumnMap c = map.columns[i]
                any v = Reflect.Get(obj, c.field)
                if (c.key && c.generated && (v == undefined || v == 0)) { continue }
                if (args.Count > 0) { names = names + ", "; marks = marks + ", " }
                names = names + d.Quote(c.column)
                marks = marks + "?"
                args.Add(Data.EntityMap.ToDb(v, c))
            }
            var sql = "INSERT INTO " + d.Quote(map.table) + " (" + names + ") VALUES (" + marks + ")"
            if (args.Count == 0) { sql = d.InsertDefault(d.Quote(map.table)) }
            this.Execute(sql, Data.Connection.ArrayOf(args))
            if (map.key == undefined) { return undefined }
            any key = Reflect.Get(obj, map.key.field)
            if (map.key.generated && (key == undefined || key == 0)) {
                key = this.driver.LastId()
                try { Reflect.Set(obj, map.key.field, key) } catch (e) { }   // (a record keeps its fields: the key is the result)
            }
            return key
        }

        // Writes all columns of the object to its row (by the key); the number of rows changed (0: there is none).
        int Update(any obj) {
            this.Check()
            var map = this.MapOf(obj)
            map.NeedKey()
            var d = this.driver.Dialect()
            var sets = ""
            var args = new List()
            for (var i = 0; i < map.columns.Count; i++) {
                Data.ColumnMap c = map.columns[i]
                if (c.key) { continue }
                if (args.Count > 0) { sets = sets + ", " }
                sets = sets + d.Quote(c.column) + " = ?"
                args.Add(Data.EntityMap.ToDb(Reflect.Get(obj, c.field), c))
            }
            if (args.Count == 0) { return 0 }
            args.Add(Data.EntityMap.ToDb(Reflect.Get(obj, map.key.field), map.key))
            return this.Execute("UPDATE " + d.Quote(map.table) + " SET " + sets + " WHERE " + d.Quote(map.key.column) + " = ?", Data.Connection.ArrayOf(args))
        }

        // Deletes the object's row (by the key); the number of rows deleted.
        int Delete(any obj) {
            this.Check()
            var map = this.MapOf(obj)
            map.NeedKey()
            var d = this.driver.Dialect()
            return this.Execute("DELETE FROM " + d.Quote(map.table) + " WHERE " + d.Quote(map.key.column) + " = ?", [Data.EntityMap.ToDb(Reflect.Get(obj, map.key.field), map.key)])
        }

        // Insert or update: a new object (its generated key is not set) is inserted, else its row is updated (inserted when there is none). The key.
        any Save(any obj) {
            var map = this.MapOf(obj)
            map.NeedKey()
            any key = Reflect.Get(obj, map.key.field)
            if (key == undefined || (map.key.generated && key == 0)) { return this.Insert(obj) }
            if (this.Update(obj) == 0) { return this.Insert(obj) }
            return key
        }

        undefined Ensure<T>() { this.Ensure(Type.Of<T>().Name) }

        // ---- migrations and the schema (docs/data/README.md "Migrations") ----
        // Runs the migrations ([Migration n, "title"] classes) that are not in the table _fire_migrations yet, in the order of their numbers, each in a
        // transaction; the number that ran.
        int Migrate() { return Data.Migrations.Up(this, -1) }
        // Up or down (their Down methods) to the migration `version` (0: before the first).
        int MigrateTo(int version) {
            int now = Data.Migrations.Current(this)
            if (version >= now) { return Data.Migrations.Up(this, version) }
            return Data.Migrations.Down(this, version)
        }
        // The numbers of the migrations that ran on this database.
        List Applied() { return Data.Migrations.Applied(this) }
        // The tables as the database has them: their columns and indexes (Data.SchemaTable).
        List Schema() { return Data.SchemaReader.Read(this) }

        // A query of the objects of a class, with expression trees: `db.From<Person>().Where(p => p.age >= 18).OrderBy(p => p.name).ToList()`.
        Data.Query<T> From<T>() { return new Data.Query<T>(this, Type.Of<T>().Name) }

        // A unit of work on this connection (docs/data/README.md "Sessions"): what it loads or gets it keeps (one object per row), Save writes the changes.
        Data.Session Session() { return new Data.Session(this) }
        T Find<T>(any key) { return this.Find(Type.Of<T>().Name, key) }
        List<T> All<T>() {
            var all = new List<T>()
            string typeName = Type.Of<T>().Name
            this.Fill(all, typeName, this.AllSql(typeName), undefined)
            return all
        }

        // The object of the class `typeName` with the key (undefined: none).
        any Find(string typeName, any key) {
            var map = this.Map(typeName)
            map.NeedKey()
            var d = this.driver.Dialect()
            return this.QueryOne(typeName, "SELECT * FROM " + d.Quote(map.table) + " WHERE " + d.Quote(map.key.column) + " = ?", [Data.EntityMap.ToDb(key, map.key)])
        }

        // All objects of the class (in the order of the key).
        List All(string typeName) { return this.QueryList(typeName, this.AllSql(typeName)) }

        string AllSql(string typeName) {
            var map = this.Map(typeName)
            var d = this.driver.Dialect()
            var order = ""
            if (map.key != undefined) { order = " ORDER BY " + d.Quote(map.key.column) }
            return "SELECT * FROM " + d.Quote(map.table) + order
        }

        // (SQL of the dialect that may be empty: nothing to do then)
        undefined Run(string sql) { if (sql != "") { this.driver.Exec(sql) } }

        // A transaction: Begin, then Commit or Rollback. Inside another one it is a savepoint (Rollback goes back to it).
        undefined Begin() {
            this.Check()
            var d = this.driver.Dialect()
            if (this.depth == 0) { this.driver.Exec(d.Begin()) }
            else { this.driver.Exec(d.Savepoint("fire_" + this.depth)) }
            this.depth = this.depth + 1
        }
        undefined Commit() {
            this.Check()
            if (this.depth == 0) { throw new Data.StateException("Commit without Begin.") }
            this.depth = this.depth - 1
            var d = this.driver.Dialect()
            if (this.depth == 0) { this.driver.Exec(d.Commit()) }
            else { this.Run(d.Release("fire_" + this.depth)) }
        }
        undefined Rollback() {
            this.Check()
            if (this.depth == 0) { throw new Data.StateException("Rollback without Begin.") }
            this.depth = this.depth - 1
            var d = this.driver.Dialect()
            if (this.depth == 0) { this.driver.Exec(d.Rollback()) }
            else {
                this.driver.Exec(d.RollbackTo("fire_" + this.depth))
                this.Run(d.Release("fire_" + this.depth))
            }
        }

        // Runs `work` in a transaction: Commit at its end, Rollback when it throws (the exception goes on). `work` gets the connection:
        // `db.Transaction(t => { t.Execute(...) })`.
        undefined Transaction(lambda<Data.Connection> work) {
            this.Begin()
            try {
                work(this)
            } catch (e) {
                this.Rollback()
                throw e
            }
            this.Commit()
        }

        undefined Close() {
            if (this.closed) { return }
            this.closed = true
            this.driver.Close()
        }

        undefined Check() { if (this.closed) { throw new Data.StateException("The connection to '" + this.url + "' is closed.") } }
    }

    /// <summary>The home of a pool (an actor on a thread of its own): it owns the idle connections; Take hands one over (moved, never copied), or allows
    /// one more to be opened, or registers the caller to be woken when one comes back.</summary>
    actor PoolHome {
        List idle            // Data.Connection
        List waiters         // Completion
        List waiterIds       // the number of each waiter (its Take finds its own)
        int open             // connections out there and idle
        int max
        bool stopped

        construct(int max) {
            this.idle = new List()
            this.waiters = new List()
            this.waiterIds = new List()
            this.lastWaiter = 0
            this.open = 0
            this.max = max
            this.stopped = false
        }

        int lastWaiter
        // (a number for a wait of a Take)
        int NewWaiter() {
            this.lastWaiter = this.lastWaiter + 1
            return this.lastWaiter
        }

        // A caller that may have to wait: `wake` is set when a connection comes back (a plain message before its Take - a Completion does not go with
        // an awaited call).
        undefined Register(int id, Completion wake) {
            this.waiters.Add(take wake)
            this.waiterIds.Add(id)
        }

        // An idle connection (moved to the caller), true (open a new one: counted already), or false (all are in use: the waiter `id` stays registered).
        any Take(int id) {
            if (this.stopped) { throw new Data.StateException("The pool is closed.") }
            if (this.idle.Count > 0) {
                Data.PoolHome.Unregister(this.waiters, this.waiterIds, id)
                any c = take this.idle[this.idle.Count - 1]
                this.idle.RemoveAt(this.idle.Count - 1)
                return c
            }
            if (this.open < this.max) {
                Data.PoolHome.Unregister(this.waiters, this.waiterIds, id)
                this.open = this.open + 1
                return true
            }
            return false
        }

        static undefined Unregister(List waiters, List ids, int id) {
            int at = ids.IndexOf(id)
            if (at < 0) { return }
            waiters.RemoveAt(at)
            ids.RemoveAt(at)
        }

        // A connection back: closed or broken ones are forgotten, an open transaction is rolled back.
        undefined Give(Data.Connection c) {
            if (c == undefined) { return }
            if (this.stopped || !c.IsOpen) {
                this.open = this.open - 1
                c.Close()
            } else {
                try { while (c.InTransaction) { c.Rollback() } } catch (e) { }
                this.idle.Add(take c)
            }
            Data.PoolHome.Wake(this.waiters)
            this.waiterIds.Clear()
        }

        // A connection that could not be opened (or was lost): one more may be opened.
        undefined Forget() {
            this.open = this.open - 1
            Data.PoolHome.Wake(this.waiters)
            this.waiterIds.Clear()
        }

        // (every waiter looks again - one that gave up meanwhile is not woken in vain for the others)
        static undefined Wake(List waiters) {
            for (var i = 0; i < waiters.Count; i++) {
                Completion w = waiters[i]
                w.Set(true)
            }
            waiters.Clear()
        }

        int Idle() { return this.idle.Count }
        int Open() { return this.open }

        undefined Stop() {
            for (var i = 0; i < this.idle.Count; i++) {
                Data.Connection c = this.idle[i]
                c.Close()
            }
            this.idle = new List()
            this.open = 0
            this.stopped = true
            Data.PoolHome.Wake(this.waiters)
            this.waiterIds.Clear()
        }
    }

    /// <summary>A pool of connections to one database, for servers and many tasks: `Take` gives a connection that belongs to the caller until `Give` returns
    /// it (at most `max` are open at once; a Take waits until one comes back, at most `limit`); `Use(c => ...)` takes and gives back. A pool can go to any
    /// thread (its home is an actor); a connection goes only with Take and Give.</summary>
    class Pool {
        Data.PoolHome home
        string url
        Data.Credentials credentials
        bool closed

        construct(string url, Data.Credentials credentials = undefined, int max = 10) {
            this.url = url
            this.closed = false
            if (credentials != undefined) { this.credentials = take credentials }
            if (max < 1) { throw new ArgumentException("Data.Pool: max is at least 1.") }
            var ready = new Completion()
            var back = ready.Share()
            Data.Pool.StartHome(max, take back)
            this.home = ready.Wait(10s)
        }

        static undefined StartHome(int max, Completion back) {
            fire handover back taking max {
                var h = new Data.PoolHome(max)
                back.Set(h)
                while (!h.stopped) { process h }
            }
        }

        // A connection of the pool (opened when there is none idle and fewer than max are open); a TimeoutException after `limit`.
        Data.Connection Take(float:any limit = 10s) {
            if (this.closed) { throw new Data.StateException("The pool is closed.") }
            var h = this.home
            DateTime deadline = DateTime.UtcNow + TimeSpan.FromMilliseconds(Data.Pool.Millis(limit))
            while (true) {
                var wake = new Completion()
                int id = await h.NewWaiter()
                h.Register(id, wake.Share())
                any got = await h.Take(id)
                if (got is of Data.Connection) { return got }
                if (got == true) {
                    try { return new Data.Connection(this.url, this.credentials) }
                    catch (e) {
                        await h.Forget()
                        throw e
                    }
                }
                TimeSpan left = deadline - DateTime.UtcNow
                if (left.TotalMilliseconds <= 0) { throw new TimeoutException("Data.Pool: no connection came back within the limit (all " + await h.Open() + " are in use).") }
                // (woken when one comes back; at the latest after 50 ms it asks again - the order of the Register and the Take of two tasks is not
                // fixed everywhere, a wake that came before the Register is not lost that way)
                float ms = left.TotalMilliseconds
                if (ms > 50.0) { ms = 50.0 }
                try { wake.Wait(ms * 1ms) } catch (TimeoutException t) { }
            }
            return undefined
        }

        // Gives a connection back (`pool.Give(take c)`): it is the pool's again.
        undefined Give(Data.Connection c) {
            if (this.closed) {
                c.Close()
                return
            }
            var h = this.home
            await h.Give(take c)   // (awaited: a message of a task that runs beside others would wait for its end - the others wait for this one)
        }

        // Takes a connection, runs `work` with it and gives it back - also when work throws (the exception goes on). What work returns.
        any Use(lambda<Data.Connection> work, float:any limit = 10s) {
            var c = this.Take(limit)
            any result = undefined
            try { result = work(c) }
            catch (e) {
                this.Give(take c)
                throw e
            }
            this.Give(take c)
            return result
        }

        int Idle {
            get {
                if (this.closed) { return 0 }
                var h = this.home
                int n = await h.Idle()
                return n
            }
        }
        int Open {
            get {
                if (this.closed) { return 0 }
                var h = this.home
                int n = await h.Open()
                return n
            }
        }

        // Closes the idle connections; the ones in use are closed when they come back.
        undefined Close() {
            if (this.closed) { return }
            this.closed = true
            var h = this.home
            await h.Stop()
        }

        // (a limit in milliseconds: a time value - 10s, 200ms -, or a plain number of milliseconds)
        static defined float Millis(float:any limit) {
            try {
                float ms = limit / 1ms
                return ms
            } catch (UnitMismatchException e) {
                if (limit == undefined) { return 10000.0 }
                float plain = limit
                return trust plain
            }
            return 10000.0
        }
    }

    /// <summary>Somebody else changed or deleted the row since it was read (a field with [Version] did not match): nothing of the Save was written.</summary>
    class ConcurrencyException : Data.DataException {
        construct(string message) : base(message, 0) { }
    }

    /// <summary>The keys of the objects in a [ManyToMany] list of an object when it was loaded or saved (what Save compares).</summary>
    class LinkSnapshot {
        string field
        List keys            // their keys as JSON texts
        construct(string field) {
            this.field = field
            this.keys = new List()
        }
    }

    /// <summary>What a session knows of an object: the object (the session owns it), its class, the text of its key, the values of its columns when it was
    /// read or saved, and its state - 0 read (changes are written), 1 added (inserted), 2 removed (deleted).</summary>
    class SessionEntry {
        any obj
        string typeName
        string keyText
        any snapshot
        int state
        bool lent           // (the object belongs to the list of another object of the session, not to the session)
        List links          // Data.LinkSnapshot: the pairs of its [ManyToMany] fields when they were loaded or saved
        construct(any obj, string typeName, int state) {
            this.obj = take obj
            this.typeName = typeName
            this.state = state
            this.keyText = ""
            this.lent = false
            this.links = new List()
        }
        // (an entry for an object that belongs to somebody else - a child in the list of a parent)
        static Data.SessionEntry Lent(any obj, string typeName) {
            var e = new Data.SessionEntry(undefined, typeName, 1)
            e.obj = obj
            e.lent = true
            return e
        }
        // (an object of somebody else whose row is there: read now - what changes from here on is written)
        static Data.SessionEntry LentRead(any obj, string typeName, string keyText, any snapshot) {
            var e = new Data.SessionEntry(undefined, typeName, 0)
            e.obj = obj
            e.lent = true
            e.keyText = keyText
            e.snapshot = take snapshot
            return e
        }
    }

    /// <summary>A unit of work (`db.Session()`): the objects it reads (Find, From) and gets (Add, Attach) are its own - one object per row, however often it
    /// is read - and Save writes what changed since, in one transaction: the added ones (INSERT, the generated keys go into the objects), the changed
    /// ones (UPDATE of the columns that changed; a [Version] field is checked and counted), the removed ones (DELETE).</summary>
    class Session {
        Data.Connection db
        List entries

        construct(Data.Connection db) {
            this.db = db
            this.entries = new List()
        }

        // (the keys now in the [ManyToMany] list of the object: its snapshot)
        undefined KeepLinks(any obj, Data.RelationMap r) {
            var e = this.EntryOf(obj)
            if (e == undefined) { return }
            for (var i = e.links.Count - 1; i >= 0; i--) {
                Data.LinkSnapshot old = e.links[i]
                if (old.field == r.field) { e.links.RemoveAt(i) }
            }
            var snap = new Data.LinkSnapshot(r.field)
            any list = Reflect.Get(obj, r.field)
            if (list != undefined) {
                var tmap = this.db.Map(r.target)
                for (var i = 0; i < list.Count; i++) {
                    any item = list[i]
                    snap.keys.Add(Json.Serialize(Reflect.Get(item, tmap.key.field)))
                }
            }
            e.links.Add(take snap)
        }
        Data.LinkSnapshot LinksOf(Data.SessionEntry e, string field) {
            for (var i = 0; i < e.links.Count; i++) {
                Data.LinkSnapshot l = e.links[i]
                if (l.field == field) { return l }
            }
            return undefined
        }

        // (the rows of the join tables: what was added to a [ManyToMany] list since its snapshot is inserted, what was taken out deleted; a list never
        // loaded is compared with the rows that are there)
        int SaveLinks() {
            var d = this.db.Dialect
            int written = 0
            for (var i = 0; i < this.entries.Count; i++) {
                Data.SessionEntry e = this.entries[i]
                if (e.state == 2) { continue }
                var map = this.db.Map(e.typeName)
                for (var k = 0; k < map.relations.Count; k++) {
                    Data.RelationMap r = map.relations[k]
                    if (!r.join) { continue }
                    any list = Reflect.Get(e.obj, r.field)
                    if (list == undefined) { continue }
                    any owner = Reflect.Get(e.obj, map.key.field)
                    var tmap = this.db.Map(r.target)
                    var now = new List()
                    var nowValues = new List()
                    for (var c = 0; c < list.Count; c++) {
                        any item = list[c]
                        any key = Reflect.Get(item, tmap.key.field)
                        string text = Json.Serialize(key)
                        if (now.IndexOf(text) >= 0) { continue }
                        now.Add(text)
                        nowValues.Add(key)
                    }
                    var before = new List()
                    var snap = this.LinksOf(e, r.field)
                    if (snap != undefined) { foreach (t in snap.keys) { before.Add(t) } }
                    else if (e.state == 0) {
                        foreach (row in this.db.Rows("SELECT " + d.Quote(r.otherColumn) + " FROM " + d.Quote(r.joinTable) + " WHERE " + d.Quote(r.thisColumn) + " = ?", [owner])) { before.Add(Json.Serialize(row.Get(0))) }
                    }
                    for (var c = 0; c < now.Count; c++) {
                        if (before.IndexOf(now[c]) >= 0) { continue }
                        written = written + this.db.Execute("INSERT INTO " + d.Quote(r.joinTable) + " (" + d.Quote(r.thisColumn) + ", " + d.Quote(r.otherColumn) + ") VALUES (?, ?)", [owner, nowValues[c]])
                    }
                    for (var c = 0; c < before.Count; c++) {
                        if (now.IndexOf(before[c]) >= 0) { continue }
                        written = written + this.db.Execute("DELETE FROM " + d.Quote(r.joinTable) + " WHERE " + d.Quote(r.thisColumn) + " = ? AND " + d.Quote(r.otherColumn) + " = ?", [owner, Json.Parse(before[c])])
                    }
                }
            }
            return written
        }

        Data.Connection Connection { get { return this.db } }
        // The number of objects the session has.
        int Count { get { return this.entries.Count } }

        // (the entry of an object, of a row)
        Data.SessionEntry EntryOf(any obj) {
            for (var i = 0; i < this.entries.Count; i++) {
                Data.SessionEntry e = this.entries[i]
                if (e.obj == obj) { return e }
            }
            return undefined
        }
        Data.SessionEntry EntryByKey(string typeName, string keyText) {
            for (var i = 0; i < this.entries.Count; i++) {
                Data.SessionEntry e = this.entries[i]
                if (e.typeName == typeName && e.keyText == keyText && e.state != 1) { return e }
            }
            return undefined
        }
        static string KeyText(any obj, Data.EntityMap map) {
            if (map.key == undefined) { return "" }
            return Json.Serialize(Reflect.Get(obj, map.key.field))
        }
        // (the values of the columns as the database gets them, as text: what Save compares)
        static any Snapshot(any obj, Data.EntityMap map) {
            any values = new any[map.columns.Count]
            for (var i = 0; i < map.columns.Count; i++) {
                Data.ColumnMap c = map.columns[i]
                values[i] = Json.Serialize(Data.EntityMap.ToDb(Reflect.Get(obj, c.field), c))
            }
            return values
        }

        // The object of the class with the key: the session's own when it has it, else read (and kept); undefined when there is none or it was removed.
        any Find(string typeName, any key) {
            var map = this.db.Map(typeName)
            map.NeedKey()
            var e = this.EntryByKey(typeName, Json.Serialize(Data.EntityMap.ToDb(key, map.key)))
            if (e == undefined) { e = this.EntryByKey(typeName, Json.Serialize(key)) }
            if (e != undefined) {
                if (e.state == 2) { return undefined }
                return e.obj
            }
            any obj = this.db.Find(typeName, key)
            if (obj == undefined) { return undefined }
            return this.Track(take obj, typeName)
        }
        T Find<T>(any key) { return this.Find(Type.Of<T>().Name, key) }

        // Loads a navigation field of objects of the session (`s.Load(p, "orders")`, also a list of them) - like Include of a query.
        undefined Load(any objects, string field) {
            if (objects == undefined) { return }
            if (objects is of List) {
                List l = objects
                if (l.Count == 0) { return }
                Data.Loader.Include(this.db, l, Type.Of(l[0]).Name, field, this)
                return
            }
            var one = new List()
            one.Add(objects)
            Data.Loader.Include(this.db, one, Type.Of(objects).Name, field, this)
        }

        // A query whose objects are the session's.
        Data.Query<T> From<T>() {
            var q = new Data.Query<T>(this.db, Type.Of<T>().Name)
            q.session = this
            return q
        }
        List<T> All<T>() { return this.From<T>().ToList() }

        // (an object read from the database: the session's own for its row when it has one - then this one is dropped -, else this one, kept from now on)
        any Track(any obj, string typeName) {
            var map = this.db.Map(typeName)
            string keyText = Data.Session.KeyText(obj, map)
            if (map.key != undefined) {
                var known = this.EntryByKey(typeName, keyText)
                if (known != undefined) { return known.obj }
            }
            var e = new Data.SessionEntry(take obj, typeName, 0)
            e.keyText = keyText
            e.snapshot = Data.Session.Snapshot(e.obj, map)
            any back = e.obj
            this.entries.Add(take e)
            return back
        }

        // A new object for the database (`s.Add(new Person(...))`, `s.Add(take p)`): the session owns it, Save inserts it. The object (for its fields).
        any Add(any obj) {
            if (obj == undefined) { throw new ArgumentException("Data.Session.Add: undefined is no object.") }
            var known = this.EntryOf(obj)
            if (known != undefined) { return known.obj }
            var e = new Data.SessionEntry(take obj, Type.Of(obj).Name, 1)
            any back = e.obj
            this.entries.Add(take e)
            return back
        }

        // An object that the session does not know yet but whose row is there (it came over RPC, from another thread): kept as read now - its changes
        // from here on are written. An object without a key is added instead.
        any Attach(any obj) {
            if (obj == undefined) { throw new ArgumentException("Data.Session.Attach: undefined is no object.") }
            var known = this.EntryOf(obj)
            if (known != undefined) { return known.obj }
            string typeName = Type.Of(obj).Name
            var map = this.db.Map(typeName)
            any key = undefined
            if (map.key != undefined) { key = Reflect.Get(obj, map.key.field) }
            if (key == undefined || (map.key.generated && key == 0)) { return this.Add(take obj) }
            if (this.EntryByKey(typeName, Data.Session.KeyText(obj, map)) != undefined) {
                throw new ArgumentException("Data.Session.Attach: the session has another object of " + typeName + " with the key " + key + ".")
            }
            return this.Track(take obj, typeName)
        }

        // The object is deleted by Save (an added one is just forgotten).
        undefined Remove(any obj) {
            var e = this.EntryOf(obj)
            if (e == undefined) { throw new ArgumentException("Data.Session.Remove: the object is not one of the session's.") }
            if (e.state == 1) {
                this.entries.Remove(e)
                return
            }
            e.state = 2
        }

        // The object leaves the session (its changes are not written any more) and belongs to the caller: `Person p = s.Detach(p)`.
        any Detach(any obj) {
            for (var i = 0; i < this.entries.Count; i++) {
                Data.SessionEntry e = this.entries[i]
                if (e.obj == obj) {
                    if (e.lent) {
                        any shared = e.obj
                        this.entries.RemoveAt(i)
                        return shared   // (it stays in the list it belongs to)
                    }
                    any out = take e.obj
                    this.entries.RemoveAt(i)
                    return out
                }
            }
            throw new ArgumentException("Data.Session.Detach: the object is not one of the session's.")
        }

        // Has an object changed since it was read or saved (or is it added, removed)?
        bool IsChanged(any obj) {
            var e = this.EntryOf(obj)
            if (e == undefined) { return false }
            if (e.state != 0) { return true }
            return this.ChangedColumns(e).Count > 0
        }
        bool HasChanges {
            get {
                for (var i = 0; i < this.entries.Count; i++) {
                    Data.SessionEntry e = this.entries[i]
                    if (e.state != 0 || this.ChangedColumns(e).Count > 0) { return true }
                }
                return false
            }
        }

        // (the new objects in the lists of the session's objects - `p.orders.Add(new Order(...))` - become added entries; they stay the lists')
        undefined Discover() {
            for (var i = 0; i < this.entries.Count; i++) {
                Data.SessionEntry e = this.entries[i]
                if (e.state == 2) { continue }
                var map = this.db.Map(e.typeName)
                for (var k = 0; k < map.relations.Count; k++) {
                    Data.RelationMap r = map.relations[k]
                    if (!r.many && !r.join) {
                        // (an object it points to that the session does not know: inserted when it is new - else its row is there)
                        any target = Reflect.Get(e.obj, r.field)
                        if (target == undefined || this.EntryOf(target) != undefined) { continue }
                        if (this.IsNew(target, r.target)) { this.entries.Add(Data.SessionEntry.Lent(target, r.target)) }
                        continue
                    }
                    any value = Reflect.Get(e.obj, r.field)
                    if (value == undefined) { continue }
                    List list = Data.RelationMap.Items(r, value)
                    for (var c = 0; c < list.Count; c++) {
                        any child = list[c]
                        if (child == undefined || this.EntryOf(child) != undefined) { continue }
                        string childType = Type.Of(child).Name
                        if (this.IsNew(child, childType)) { this.entries.Add(Data.SessionEntry.Lent(child, childType)) }
                        else if (!r.join) {
                            // (a child whose row is there, in the list of a [HasMany] field: read now - its foreign key is written when it changes)
                            var cmap = this.db.Map(childType)
                            this.entries.Add(Data.SessionEntry.LentRead(child, childType, Data.Session.KeyText(child, cmap), Data.Session.Snapshot(child, cmap)))
                        }
                        // (an object of a join list whose row is there: only the pair is written)
                    }
                }
            }
        }

        // Is the object new for the database? Without a key (or 0 for a generated one): yes; with a generated key: no - the database gave it; with a key
        // of the program (a text, [Key "manual"]): when the table has no row with it.
        bool IsNew(any obj, string typeName) {
            var map = this.db.Map(typeName)
            if (map.key == undefined) { return true }
            any key = Reflect.Get(obj, map.key.field)
            if (key == undefined) { return true }
            if (map.key.generated) { return key == 0 }
            var d = this.db.Dialect
            any n = this.db.Scalar("SELECT count(*) FROM " + d.Quote(map.table) + " WHERE " + d.Quote(map.key.column) + " = ?", [Data.EntityMap.ToDb(key, map.key)])
            return n == 0
        }

        // (inserts an added entry: first what it points to and the parent whose list it is in - they give its foreign keys)
        int InsertEntry(Data.SessionEntry e, List done, List inserted) {
            if (done.IndexOf(e) >= 0) { return 0 }
            done.Add(e)
            int written = 0
            var map = this.db.Map(e.typeName)
            for (var k = 0; k < map.relations.Count; k++) {
                Data.RelationMap r = map.relations[k]
                if (r.many || r.join) { continue }
                any target = Reflect.Get(e.obj, r.field)
                if (target == undefined) { continue }
                var te = this.EntryOf(target)
                if (te != undefined && te.state == 1) { written = written + this.InsertEntry(te, done, inserted) }
                var tmap = this.db.Map(r.target)
                if (tmap.key != undefined) { Reflect.Set(e.obj, r.foreign, Reflect.Get(target, tmap.key.field)) }
            }
            for (var i = 0; i < this.entries.Count; i++) {
                Data.SessionEntry pe = this.entries[i]
                if (pe == e || pe.state == 2) { continue }
                var pmap = this.db.Map(pe.typeName)
                for (var k = 0; k < pmap.relations.Count; k++) {
                    Data.RelationMap r = pmap.relations[k]
                    if (!r.many || r.target != e.typeName) { continue }
                    any value = Reflect.Get(pe.obj, r.field)
                    if (value == undefined) { continue }
                    List list = Data.RelationMap.Items(r, value)
                    if (list.IndexOf(e.obj) < 0) { continue }
                    if (pe.state == 1) { written = written + this.InsertEntry(pe, done, inserted) }
                    Reflect.Set(e.obj, r.foreign, Reflect.Get(pe.obj, pmap.key.field))
                }
            }
            if (map.version != undefined) {
                any v = Reflect.Get(e.obj, map.version.field)
                if (v == undefined || v == 0) { try { Reflect.Set(e.obj, map.version.field, 1) } catch (x) { } }
            }
            any before = undefined
            if (map.key != undefined) { before = Reflect.Get(e.obj, map.key.field) }
            this.db.Insert(e.obj)
            if (map.key != undefined && map.key.generated && (before == undefined || before == 0)) { inserted.Add(e) }
            return written + 1
        }

        // (after the inserts: the foreign keys follow the navigation fields - a child in a parent's list gets its key, an object its owner's - so a move
        // from one list to another is written as an update)
        undefined Link() {
            for (var i = 0; i < this.entries.Count; i++) {
                Data.SessionEntry e = this.entries[i]
                if (e.state == 2) { continue }
                var map = this.db.Map(e.typeName)
                for (var k = 0; k < map.relations.Count; k++) {
                    Data.RelationMap r = map.relations[k]
                    if (r.join) { continue }
                    any value = Reflect.Get(e.obj, r.field)
                    if (value == undefined) { continue }
                    if (r.many) {
                        if (map.key == undefined) { continue }
                        any key = Reflect.Get(e.obj, map.key.field)
                        List children = Data.RelationMap.Items(r, value)
                        for (var c = 0; c < children.Count; c++) {
                            any child = children[c]
                            if (child != undefined && Reflect.Get(child, r.foreign) != key) { Reflect.Set(child, r.foreign, key) }
                        }
                    } else {
                        var tmap = this.db.Map(r.target)
                        if (tmap.key == undefined) { continue }
                        any key = Reflect.Get(value, tmap.key.field)
                        if (Reflect.Get(e.obj, r.foreign) != key) { Reflect.Set(e.obj, r.foreign, key) }
                    }
                }
            }
        }

        // (the positions of the columns whose values differ from the snapshot)
        List ChangedColumns(Data.SessionEntry e) {
            var map = this.db.Map(e.typeName)
            any now = Data.Session.Snapshot(e.obj, map)
            var changed = new List()
            for (var i = 0; i < map.columns.Count; i++) { if (now[i] != e.snapshot[i]) { changed.Add(i) } }
            return changed
        }

        // Writes what changed in one transaction - first the added objects, then the changed ones, then the removed ones; when anything fails nothing is
        // written (the exception goes on). The number of rows written.
        int Save() {
            var d = this.db.Dialect
            int written = 0
            List inserted = new List()        // (entries whose key this Save generated: undefined again after a rollback)
            List versions = new List()        // (entry, the new version) to set after the commit
            this.Discover()
            this.db.Begin()
            try {
                var done = new List()
                for (var i = 0; i < this.entries.Count; i++) {
                    Data.SessionEntry e = this.entries[i]
                    if (e.state != 1) { continue }
                    written = written + this.InsertEntry(e, done, inserted)
                }
                this.Link()
                written = written + this.SaveLinks()
                for (var i = 0; i < this.entries.Count; i++) {
                    Data.SessionEntry e = this.entries[i]
                    if (e.state != 0) { continue }
                    var changed = this.ChangedColumns(e)
                    if (changed.Count == 0) { continue }
                    var map = this.db.Map(e.typeName)
                    map.NeedKey()
                    var sets = ""
                    var args = new List()
                    for (var k = 0; k < changed.Count; k++) {
                        int at = changed[k]
                        Data.ColumnMap c = map.columns[at]
                        if (c.key) { throw new Data.DataException("Data.Session.Save: the key of a " + e.typeName + " changed - a key is not changed, delete and add instead.") }
                        if (map.version != undefined && c.field == map.version.field) { continue }
                        if (args.Count > 0) { sets = sets + ", " }
                        sets = sets + d.Quote(c.column) + " = ?"
                        args.Add(Data.EntityMap.ToDb(Reflect.Get(e.obj, c.field), c))
                    }
                    any version = undefined
                    if (map.version != undefined) {
                        version = Reflect.Get(e.obj, map.version.field)
                        if (version == undefined) { version = 0 }
                        if (args.Count > 0) { sets = sets + ", " }
                        sets = sets + d.Quote(map.version.column) + " = ?"
                        args.Add(version + 1)
                    }
                    if (args.Count == 0) { continue }
                    var sql = "UPDATE " + d.Quote(map.table) + " SET " + sets + " WHERE " + d.Quote(map.key.column) + " = ?"
                    args.Add(Data.EntityMap.ToDb(Reflect.Get(e.obj, map.key.field), map.key))
                    if (map.version != undefined) {
                        sql = sql + " AND " + d.Quote(map.version.column) + " = ?"
                        args.Add(version)
                    }
                    int n = this.db.Execute(sql, Data.Connection.ArrayOf(args))
                    if (n == 0 && map.version != undefined) { throw new Data.ConcurrencyException("Data.Session.Save: the " + e.typeName + " with the key " + e.keyText + " was changed or deleted by somebody else (version " + version + ").") }
                    if (map.version != undefined) { versions.Add(e) }
                    written = written + n
                }
                for (var i = 0; i < this.entries.Count; i++) {
                    Data.SessionEntry e = this.entries[i]
                    if (e.state != 2) { continue }
                    var map = this.db.Map(e.typeName)
                    map.NeedKey()
                    for (var k = 0; k < map.relations.Count; k++) {
                        Data.RelationMap jr = map.relations[k]
                        if (jr.join) { this.db.Execute("DELETE FROM " + d.Quote(jr.joinTable) + " WHERE " + d.Quote(jr.thisColumn) + " = ?", [Reflect.Get(e.obj, map.key.field)]) }
                    }
                    var sql = "DELETE FROM " + d.Quote(map.table) + " WHERE " + d.Quote(map.key.column) + " = ?"
                    var args = new List()
                    args.Add(Data.EntityMap.ToDb(Reflect.Get(e.obj, map.key.field), map.key))
                    if (map.version != undefined) {
                        any version = Reflect.Get(e.obj, map.version.field)
                        if (version == undefined) { version = 0 }
                        sql = sql + " AND " + d.Quote(map.version.column) + " = ?"
                        args.Add(version)
                    }
                    int n = this.db.Execute(sql, Data.Connection.ArrayOf(args))
                    if (n == 0 && map.version != undefined) { throw new Data.ConcurrencyException("Data.Session.Save: the " + e.typeName + " with the key " + e.keyText + " was changed or deleted by somebody else.") }
                    written = written + n
                }
            } catch (failure) {
                this.db.Rollback()
                for (var i = 0; i < inserted.Count; i++) {
                    Data.SessionEntry e = inserted[i]
                    var map = this.db.Map(e.typeName)
                    try { Reflect.Set(e.obj, map.key.field, undefined) } catch (x) { }
                }
                throw failure
            }
            this.db.Commit()
            // (the state after the commit: versions counted, snapshots new, the removed ones gone)
            for (var i = 0; i < versions.Count; i++) {
                Data.SessionEntry e = versions[i]
                var map = this.db.Map(e.typeName)
                any v = Reflect.Get(e.obj, map.version.field)
                if (v == undefined) { v = 0 }
                Reflect.Set(e.obj, map.version.field, v + 1)
            }
            for (var i = this.entries.Count - 1; i >= 0; i--) {
                Data.SessionEntry e = this.entries[i]
                if (e.state == 2) {
                    this.entries.RemoveAt(i)
                    continue
                }
                var map = this.db.Map(e.typeName)
                e.state = 0
                e.keyText = Data.Session.KeyText(e.obj, map)
                e.snapshot = Data.Session.Snapshot(e.obj, map)
                for (var k = 0; k < map.relations.Count; k++) {
                    Data.RelationMap r = map.relations[k]
                    if (r.join && Reflect.Get(e.obj, r.field) != undefined) { this.KeepLinks(e.obj, r) }
                }
            }
            return written
        }
    }

    /// <summary>Loads navigation fields (Data.Query.Include, Data.Session.Load): the children of many objects with one query (`foreign IN (...)`).</summary>
    class Loader {
        // (keys in groups: an IN with fewer parameters than every database allows)
        static int Chunk() { return 400 }

        static undefined Include(Data.Connection db, any objects, string typeName, string field, Data.Session session) {
            var map = db.Map(typeName)
            var r = map.Relation(field)
            if (r == undefined) { throw new ArgumentException("Data: '" + field + "' of " + typeName + " is no navigation field.") }
            if (r.join) { Data.Loader.Join(db, objects, map, r, session) }
            else if (r.many) { Data.Loader.Many(db, objects, map, r, session) }
            else { Data.Loader.One(db, objects, map, r, session) }
        }

        // ([ManyToMany]: the pairs of the join table, then the objects they name - the session's own; its snapshot of the pairs for Save)
        static undefined Join(Data.Connection db, any objects, Data.EntityMap map, Data.RelationMap r, Data.Session session) {
            map.NeedKey()
            var target = db.Map(r.target)
            target.NeedKey()
            var d = db.Dialect
            var keys = new List()
            for (var i = 0; i < objects.Count; i++) {
                any o = objects[i]
                if (Reflect.Get(o, r.field) == undefined) { Reflect.Set(o, r.field, new List()) }
                any k = Reflect.Get(o, map.key.field)
                if (k != undefined && keys.IndexOf(k) < 0) { keys.Add(k) }
            }
            var pairThis = new List()
            var pairOther = new List()
            for (var start = 0; start < keys.Count; start = start + Data.Loader.Chunk()) {
                var marks = ""
                var args = new List()
                for (var i = start; i < keys.Count && i < start + Data.Loader.Chunk(); i++) {
                    if (args.Count > 0) { marks = marks + ", " }
                    marks = marks + "?"
                    args.Add(keys[i])
                }
                foreach (row in db.Rows("SELECT " + d.Quote(r.thisColumn) + ", " + d.Quote(r.otherColumn) + " FROM " + d.Quote(r.joinTable) + " WHERE " + d.Quote(r.thisColumn) + " IN (" + marks + ") ORDER BY " + d.Quote(r.otherColumn), Data.Connection.ArrayOf(args))) {
                    pairThis.Add(Json.Serialize(row.Get(0)))
                    pairOther.Add(row.Get(1))
                }
            }
            var others = new List()
            for (var i = 0; i < pairOther.Count; i++) { if (others.IndexOf(pairOther[i]) < 0) { others.Add(pairOther[i]) } }
            var found = new List()
            var foundTexts = new List()
            for (var start = 0; start < others.Count; start = start + Data.Loader.Chunk()) {
                var marks = ""
                var args = new List()
                for (var i = start; i < others.Count && i < start + Data.Loader.Chunk(); i++) {
                    if (args.Count > 0) { marks = marks + ", " }
                    marks = marks + "?"
                    args.Add(others[i])
                }
                var loaded = new List()
                db.Fill(loaded, r.target, "SELECT * FROM " + d.Quote(target.table) + " WHERE " + d.Quote(target.key.column) + " IN (" + marks + ")", Data.Connection.ArrayOf(args))
                for (var i = 0; i < loaded.Count; i++) {
                    any t = loaded[i]
                    foundTexts.Add(Json.Serialize(Reflect.Get(t, target.key.field)))
                    if (session != undefined) { found.Add(session.Track(take t, r.target)) } else { found.Add(take t) }
                }
            }
            for (var i = 0; i < objects.Count; i++) {
                any o = objects[i]
                string mine = Json.Serialize(Reflect.Get(o, map.key.field))
                List list = Reflect.Get(o, r.field)
                for (var p = 0; p < pairThis.Count; p++) {
                    if (pairThis[p] != mine) { continue }
                    int at = foundTexts.IndexOf(Json.Serialize(pairOther[p]))
                    if (at < 0) { continue }
                    any t = found[at]
                    if (session != undefined) { if (list.IndexOf(t) < 0) { list.Add(t) } }
                    else { list.Add(copy t) }   // (without a session: a copy of its own in each list)
                }
                if (session != undefined) { session.KeepLinks(o, r) }
            }
        }

        // ([HasMany]: the children of each object into its list - the list made when the field has none)
        static undefined Many(Data.Connection db, any objects, Data.EntityMap map, Data.RelationMap r, Data.Session session) {
            map.NeedKey()
            var child = db.Map(r.target)
            var fk = child.Column(r.foreign)
            if (fk == undefined) { throw new ArgumentException("Data: " + r.target + " has no column '" + r.foreign + "' (the foreign key of " + map.typeName + "." + r.field + ").") }
            var keys = new List()
            var keyTexts = new List()
            for (var i = 0; i < objects.Count; i++) {
                any o = objects[i]
                if (!r.single && Reflect.Get(o, r.field) == undefined) { Reflect.Set(o, r.field, new List()) }   // (the object owns its list)
                any k = Reflect.Get(o, map.key.field)
                if (k == undefined) { continue }
                string text = Json.Serialize(k)
                if (keyTexts.IndexOf(text) >= 0) { continue }
                keyTexts.Add(text)
                keys.Add(k)
            }
            var d = db.Dialect
            for (var start = 0; start < keys.Count; start = start + Data.Loader.Chunk()) {
                var marks = ""
                var args = new List()
                for (var i = start; i < keys.Count && i < start + Data.Loader.Chunk(); i++) {
                    if (args.Count > 0) { marks = marks + ", " }
                    marks = marks + "?"
                    args.Add(Data.EntityMap.ToDb(keys[i], fk))
                }
                var order = ""
                if (child.key != undefined) { order = " ORDER BY " + d.Quote(child.key.column) }
                var loaded = new List()
                db.Fill(loaded, r.target, "SELECT * FROM " + d.Quote(child.table) + " WHERE " + d.Quote(fk.column) + " IN (" + marks + ")" + order, Data.Connection.ArrayOf(args))
                for (var i = 0; i < loaded.Count; i++) {
                    any c = loaded[i]
                    string text = Json.Serialize(Reflect.Get(c, r.foreign))
                    for (var p = 0; p < objects.Count; p++) {
                        any o = objects[p]
                        if (Json.Serialize(Reflect.Get(o, map.key.field)) != text) { continue }
                        if (r.single) {
                            // ([HasOne]: the child is the field - the first one when the table has more)
                            if (Reflect.Get(o, r.field) == undefined) {
                                if (session != undefined) { Reflect.Set(o, r.field, session.Track(take c, r.target)) } else { Reflect.Set(o, r.field, take c) }
                            }
                            break
                        }
                        List list = Reflect.Get(o, r.field)
                        if (session != undefined) {
                            any tracked = session.Track(take c, r.target)
                            if (list.IndexOf(tracked) < 0) { list.Add(tracked) }
                        } else {
                            list.Add(take c)
                        }
                        break
                    }
                }
            }
        }

        // ([BelongsTo]: the object each one points to - the session's own, else a copy for each)
        static undefined One(Data.Connection db, any objects, Data.EntityMap map, Data.RelationMap r, Data.Session session) {
            var target = db.Map(r.target)
            target.NeedKey()
            var keys = new List()
            var keyTexts = new List()
            for (var i = 0; i < objects.Count; i++) {
                any o = objects[i]
                any k = Reflect.Get(o, r.foreign)
                if (k == undefined) { continue }
                string text = Json.Serialize(k)
                if (keyTexts.IndexOf(text) >= 0) { continue }
                keyTexts.Add(text)
                keys.Add(k)
            }
            var d = db.Dialect
            var found = new List()          // the loaded (or the session's) objects
            var foundTexts = new List()
            for (var start = 0; start < keys.Count; start = start + Data.Loader.Chunk()) {
                var marks = ""
                var args = new List()
                for (var i = start; i < keys.Count && i < start + Data.Loader.Chunk(); i++) {
                    if (args.Count > 0) { marks = marks + ", " }
                    marks = marks + "?"
                    args.Add(Data.EntityMap.ToDb(keys[i], target.key))
                }
                var loaded = new List()
                db.Fill(loaded, r.target, "SELECT * FROM " + d.Quote(target.table) + " WHERE " + d.Quote(target.key.column) + " IN (" + marks + ")", Data.Connection.ArrayOf(args))
                for (var i = 0; i < loaded.Count; i++) {
                    any t = loaded[i]
                    foundTexts.Add(Json.Serialize(Reflect.Get(t, target.key.field)))
                    if (session != undefined) { found.Add(session.Track(take t, r.target)) } else { found.Add(take t) }
                }
            }
            for (var i = 0; i < objects.Count; i++) {
                any o = objects[i]
                any k = Reflect.Get(o, r.foreign)
                if (k == undefined) { continue }
                int at = foundTexts.IndexOf(Json.Serialize(k))
                if (at < 0) { continue }
                any t = found[at]
                if (session != undefined) { Reflect.Set(o, r.field, t) }   // (the session's object: a reference)
                else { Reflect.Set(o, r.field, copy t) }                   // (without a session: a copy of its own for each object)
            }
        }
    }

    /// <summary>A part of an expression tree that the database cannot run (a call of an own method, a member of a member, ...): what it is.</summary>
    class NotTranslatableException : Data.DataException {
        construct(string message) : base(message, 0) { }
    }

    /// <summary>A query of the objects of a mapped class (`db.From<Person>()`): conditions, order and paging as expression trees, translated to the SQL of
    /// the database when it runs (ToList, First, Count, Any, Delete). Every call returns the query itself, so they chain; nothing runs before the end.</summary>
    class Query<T> {
        Data.Connection db
        string typeName
        Data.Session session // (a query of a session: its objects are the session's)
        List includes        // the navigation fields to load with the objects
        List wheres          // LambdaExpression
        List orders          // LambdaExpression
        List descending      // bool per order
        int skipped
        int limited

        construct(Data.Connection db, string typeName) {
            this.db = db
            this.typeName = typeName
            this.wheres = new List()
            this.orders = new List()
            this.descending = new List()
            this.skipped = 0
            this.limited = -1
            this.includes = new List()
        }

        // Only the objects for which the condition holds (several Where: all of them).
        Data.Query<T> Where(lambda expression<T> condition) {
            this.wheres.Add(take condition)
            return this
        }
        // The order: by the key, then by the next (ThenBy); the default is that of the database.
        Data.Query<T> OrderBy(lambda expression<T> key) { return this.Order(take key, false, true) }
        Data.Query<T> OrderByDescending(lambda expression<T> key) { return this.Order(take key, true, true) }
        Data.Query<T> ThenBy(lambda expression<T> key) { return this.Order(take key, false, false) }
        Data.Query<T> ThenByDescending(lambda expression<T> key) { return this.Order(take key, true, false) }
        // (a key of the order: the tree, its direction; `first`: the keys before it go)
        Data.Query<T> Order(LambdaExpression key, bool desc, bool first) {
            if (first) {
                this.orders = new List()
                this.descending = new List()
            }
            this.orders.Add(take key)
            this.descending.Add(desc)
            return this
        }
        // Loads a navigation field with the objects: `Include(p => p.orders)` ([HasMany]: the lists filled), `Include(o => o.owner)` ([BelongsTo]) - one query
        // more per Include, not one per object.
        Data.Query<T> Include(lambda expression<T> navigation) {
            LambdaExpression e = navigation
            if (!(e.Body is of MemberExpression)) { throw new ArgumentException("Data: Include takes a navigation field (p => p.orders), not " + e + ".") }
            MemberExpression m = e.Body
            var map = this.db.Map(this.typeName)
            if (map.Relation(m.Name) == undefined) { throw new ArgumentException("Data: '" + m.Name + "' of " + this.typeName + " is no navigation field ([HasMany] or [BelongsTo]).") }
            this.includes.Add(m.Name)
            return this
        }

        Data.Query<T> Skip(int count) {
            this.skipped = count
            return this
        }
        Data.Query<T> Take(int count) {
            this.limited = count
            return this
        }

        // ---- the ends ----
        List<T> ToList() {
            var all = new List<T>()
            var q = this.Sql("SELECT *", true)
            if (this.session == undefined) {
                this.db.Fill(all, this.typeName, q.text, q.Parameters())
                this.LoadIncludes(all)
                return all
            }
            var loaded = new List()
            this.db.Fill(loaded, this.typeName, q.text, q.Parameters())
            for (var i = 0; i < loaded.Count; i++) {
                any o = loaded[i]
                all.Add(this.session.Track(take o, this.typeName))
            }
            this.LoadIncludes(all)
            return all
        }

        // (the navigation fields of Include for these objects)
        undefined LoadIncludes(any objects) {
            for (var i = 0; i < this.includes.Count; i++) { Data.Loader.Include(this.db, objects, this.typeName, this.includes[i], this.session) }
        }
        // The first object (Data.DataException when there is none) / undefined when there is none.
        T First() {
            T one = this.FirstOrDefault()
            if (one == undefined) { throw new Data.DataException("The query has no rows (" + this.typeName + ").") }
            return one
        }
        T FirstOrDefault() {
            int before = this.limited
            this.limited = 1
            var q = this.Sql("SELECT *", true)
            this.limited = before
            any one = this.db.QueryOne(this.typeName, q.text, q.Parameters())
            if (one == undefined) { return one }
            if (this.session != undefined) {
                any tracked = this.session.Track(take one, this.typeName)
                var single = new List()
                single.Add(tracked)
                this.LoadIncludes(single)
                return tracked
            }
            var only = new List()
            only.Add(one)
            this.LoadIncludes(only)
            return one
        }
        int Count() {
            var q = this.Sql("SELECT count(*)", false)
            any n = this.db.Scalar(q.text, q.Parameters())
            return n!int
        }
        bool Any() { return this.Count() > 0 }
        // Deletes the rows of the query; their number.
        int Delete() {
            var q = this.Sql("DELETE", false)
            return this.db.Execute(q.text, q.Parameters())
        }
        // The SQL and its parameters (for logs and tests): `SELECT * FROM "people" WHERE ("age" >= ?) [18]`.
        string ToSql() {
            var q = this.Sql("SELECT *", true)
            return q.text + " " + Json.Serialize(q.Parameters())
        }

        // (the statement: `head` FROM the table, the conditions, and with `full` the order and the paging)
        Data.SqlWriter Sql(string head, bool full) {
            var map = this.db.Map(this.typeName)
            var d = this.db.Dialect
            var w = new Data.SqlWriter(map, d)
            w.db = this.db
            var filter = ""
            for (var i = 0; i < this.wheres.Count; i++) {
                LambdaExpression e = this.wheres[i]
                if (i > 0) { filter = filter + " AND " }
                filter = filter + w.Predicate(e)
            }
            var sql = head + " FROM " + d.Quote(map.table)
            if (filter != "") { sql = sql + " WHERE " + filter }
            if (full) {
                if (this.orders.Count > 0) {
                    sql = sql + " ORDER BY "
                    for (var i = 0; i < this.orders.Count; i++) {
                        LambdaExpression e = this.orders[i]
                        if (i > 0) { sql = sql + ", " }
                        sql = sql + d.Order(w.Lambda(e), this.descending[i])
                    }
                }
                sql = sql + d.Paging(this.limited, this.skipped, this.orders.Count > 0)
            }
            w.text = sql
            return w
        }
    }

    /// <summary>An expression tree as SQL (Data.Query): the members of the lambda's parameter are the columns of the mapped class, what the tree captured
    /// are parameters (`?`) - never text in the SQL.</summary>
    class SqlWriter : ExpressionVisitor {
        Data.EntityMap map
        Data.Dialect dialect
        List values
        string text
        Data.Connection db       // (for the maps of the other classes: subqueries of navigation fields)
        // the lambda parameters in reach - the object of the query, and those of the lambdas of subqueries: their names, maps and qualifiers
        List scopeNames
        List scopeMaps
        List scopeQualifiers
        int aliases

        construct(Data.EntityMap map, Data.Dialect dialect) {
            this.map = map
            this.dialect = dialect
            this.values = new List()
            this.text = ""
            this.scopeNames = new List()
            this.scopeMaps = new List()
            this.scopeQualifiers = new List()
            this.aliases = 0
        }

        // (the scope of a parameter: its position, -1 none)
        int ScopeOf(string name) {
            for (var i = this.scopeNames.Count - 1; i >= 0; i--) { if (this.scopeNames[i] == name) { return i } }
            return -1
        }

        any Parameters() { return Data.Connection.ArrayOf(this.values) }

        // The body of a lambda with one parameter (the object of the row).
        string Lambda(LambdaExpression e) {
            this.Enter(e)
            return this.Sql(e.Body)
        }
        // (the scope of a query lambda: its parameter is the mapped class)
        undefined Enter(LambdaExpression e) {
            if (e.Parameters.length != 1) { throw new Data.NotTranslatableException("A query lambda has one parameter (the object), not " + e.Parameters.length + ": " + e) }
            this.scopeNames = new List()
            this.scopeMaps = new List()
            this.scopeQualifiers = new List()
            this.scopeNames.Add(e.Parameters[0].Name)
            this.scopeMaps.Add(this.map)
            this.scopeQualifiers.Add("")
        }

        string Sql(Expression e) { return "" + e.Accept(this) }

        // A lambda whose body is a condition (Where).
        string Predicate(LambdaExpression e) {
            this.Enter(e)
            return this.Condition(e.Body)
        }
        // (a part that must be a condition: a boolean column or value alone becomes the dialect's truth test)
        string Condition(Expression e) {
            string sql = this.Sql(e)
            var c = this.ColumnOf(e)
            if (c != undefined && c.kind == "bool") { return this.dialect.Truth(sql) }
            if (e is of CapturedExpression || e is of ConstantExpression) { return this.dialect.Truth(sql) }
            return sql
        }

        undefined Fail(Expression e, string why) { throw new Data.NotTranslatableException("Data: '" + e + "' cannot run in the database (" + why + ").") }

        // (the column of a member of the parameter - also at the end of a navigation x.customer.name -, or undefined)
        Data.ColumnMap ColumnOf(Expression e) {
            if (!(e is of MemberExpression)) { return undefined }
            MemberExpression m = e
            if (m.Target is of MemberExpression && this.db != undefined) {
                Data.EntityMap last = this.NavigationEnd(m.Target)
                if (last == undefined) { return undefined }
                return last.Column(m.Name)
            }
            if (!(m.Target is of ParameterExpression)) { return undefined }
            ParameterExpression p = m.Target
            int at = this.ScopeOf(p.Name)
            if (at < 0) { return undefined }
            Data.EntityMap scope = this.scopeMaps[at]
            return scope.Column(m.Name)
        }

        // (is the part a text: by its type, or a text column - in a nested lambda the type checker may not know it)
        bool IsText(Expression e) {
            if (e.Type == "string") { return true }
            var c = this.ColumnOf(e)
            if (c != undefined && c.kind == "string") { return true }
            if (e is of CapturedExpression) { CapturedExpression x = e; return x.Value is of string }
            if (e is of ConstantExpression) { ConstantExpression x = e; return x.Value is of string }
            return false
        }

        // (a value of the program as a parameter, converted for its column like the mapping does)
        string Value(any v, Data.ColumnMap column) {
            if (column != undefined) { this.values.Add(Data.EntityMap.ToDb(v, column)) }
            else if (v is of DateTime) { any t = v; this.values.Add(t.ToString("o")) }
            else { this.values.Add(v) }
            return "?"
        }

        override any VisitParameter(ParameterExpression e) { this.Fail(e, "the object itself is not a value of a column"); return undefined }
        override any VisitConstant(ConstantExpression e) {
            if (e.Value == undefined) { return "NULL" }
            return this.Value(e.Value, undefined)
        }
        override any VisitCaptured(CapturedExpression e) {
            if (e.Value == undefined) { return "NULL" }
            return this.Value(e.Value, undefined)
        }
        override any VisitMember(MemberExpression e) {
            if (e.Target is of ParameterExpression) {
                ParameterExpression p = e.Target
                int at = this.ScopeOf(p.Name)
                if (at < 0) { this.Fail(e, "an unknown parameter") }
                Data.EntityMap scope = this.scopeMaps[at]
                var c = scope.Column(e.Name)
                if (c == undefined) {
                    Data.RelationMap nav = scope.Relation(e.Name)
                    if (nav != undefined && !nav.many && !nav.join) {
                        // (the object of a [BelongsTo] field as a value: its foreign key - x.customer == undefined is "customerId IS NULL")
                        c = scope.Column(nav.foreign)
                    }
                    else if (nav != undefined) { this.Fail(e, "a list is no value - use Any(...)") }
                    else { this.Fail(e, "'" + e.Name + "' is not a column of " + scope.typeName) }
                }
                string q = this.scopeQualifiers[at]
                if (q == "") { return this.dialect.Quote(c.column) }
                return q + "." + this.dialect.Quote(c.column)
            }
            if (e.Name == "Length" && this.IsText(e.Target)) { return this.dialect.Length(this.Sql(e.Target)) }
            if (e.Target is of MemberExpression) {
                string nav = this.Navigation(e)
                if (nav != undefined) { return nav }
            }
            this.Fail(e, "only the columns of the object, the columns of what its [BelongsTo] fields point to, and the Length of a text")
            return undefined
        }

        // (the entity at the end of a navigation of [BelongsTo] fields: x.customer -> Customer, x.customer.country -> Country)
        Data.EntityMap NavigationEnd(Expression e) {
            Expression at = e
            var names = new List()
            while (at is of MemberExpression) {
                MemberExpression m = at
                names.Add(m.Name)
                at = m.Target
            }
            if (!(at is of ParameterExpression)) { return undefined }
            ParameterExpression p = at
            int scope = this.ScopeOf(p.Name)
            if (scope < 0) { return undefined }
            Data.EntityMap map = this.scopeMaps[scope]
            for (var i = names.Count - 1; i >= 0; i--) {
                string name = names[i]
                Data.RelationMap r = map.Relation(name)
                if (r == undefined || (r.many && !r.single) || r.join) { return undefined }
                map = this.db.Map(r.target)
            }
            return map
        }
        // A column at the end of a navigation of [BelongsTo] fields as a correlated subquery - each hop one, nested (no JOIN: every database and the
        // in-memory one run it): x.customer.name -> (SELECT t1."name" FROM "customers" AS t1 WHERE t1."id" = "purchases"."customerId"),
        // x.customer.country.name -> (SELECT t2."name" FROM "countries" AS t2 WHERE t2."code" = (SELECT t1."countryCode" FROM "customers" AS t1 WHERE ...)).
        string Navigation(MemberExpression e) {
            if (this.db == undefined) { this.Fail(e, "a navigation needs the connection") }
            Expression at = e.Target
            var names = new List()
            while (at is of MemberExpression) {
                MemberExpression m = at
                names.Add(m.Name)
                at = m.Target
            }
            if (!(at is of ParameterExpression)) { return undefined }
            ParameterExpression p = at
            int scope = this.ScopeOf(p.Name)
            if (scope < 0) { this.Fail(e, "an unknown parameter") }
            Data.EntityMap map = this.scopeMaps[scope]
            string ownerQ = this.scopeQualifiers[scope]
            if (ownerQ == "") { ownerQ = this.dialect.Quote(map.table) }
            var d = this.dialect
            // (the hops from the parameter on: the relation of each, checked)
            var hops = new List()
            var maps = new List()
            for (var i = names.Count - 1; i >= 0; i--) {
                string name = names[i]
                Data.RelationMap r = map.Relation(name)
                if (r == undefined) { this.Fail(e, "'" + name + "' is no [BelongsTo] or [HasOne] field of " + map.typeName) }
                if ((r.many && !r.single) || r.join) { this.Fail(e, "'" + name + "' is a list - use Any(...)") }
                if (!r.single && map.Column(r.foreign) == undefined) { this.Fail(e, map.typeName + " has no column '" + r.foreign + "'") }
                if (r.single) { map.NeedKey() }
                hops.Add(r)
                maps.Add(map)
                map = this.db.Map(r.target)
                map.NeedKey()
                if (r.single && map.Column(r.foreign) == undefined) { this.Fail(e, map.typeName + " has no column '" + r.foreign + "'") }
            }
            var c = map.Column(e.Name)
            if (c == undefined) {
                if (map.Relation(e.Name) != undefined) { this.Fail(e, "'" + e.Name + "' is a navigation: name a column of it") }
                this.Fail(e, "'" + e.Name + "' is not a column of " + map.typeName)
            }
            // ([BelongsTo]: the target whose key is the owner's foreign key; [HasOne]: the target whose foreign key is the owner's key)
            Data.RelationMap first = hops[0]
            Data.EntityMap firstOwner = maps[0]
            string value = undefined
            if (first.single) { value = ownerQ + "." + d.Quote(firstOwner.key.column) }
            else { value = ownerQ + "." + d.Quote(firstOwner.Column(first.foreign).column) }
            for (var i = 0; i < hops.Count; i++) {
                Data.RelationMap r = hops[i]
                var target = this.db.Map(r.target)
                string column = c.column
                if (i + 1 < hops.Count) {
                    Data.RelationMap next = hops[i + 1]
                    if (next.single) { column = target.key.column } else { column = target.Column(next.foreign).column }
                }
                string match = target.key.column
                if (r.single) { match = target.Column(r.foreign).column }
                this.aliases = this.aliases + 1
                string alias = "t" + this.aliases
                value = "(SELECT " + alias + "." + d.Quote(column) + " FROM " + d.Quote(target.table) + " AS " + alias + " WHERE " + alias + "." + d.Quote(match) + " = " + value + ")"
            }
            return value
        }
        override any VisitUnary(UnaryExpression e) {
            if (e.Op == "!") { return "NOT (" + this.Condition(e.Operand) + ")" }
            if (e.Op == "-") { return "-(" + this.Sql(e.Operand) + ")" }
            this.Fail(e, "the operator " + e.Op)
            return undefined
        }
        override any VisitConvert(ConvertExpression e) { return this.Sql(e.Operand) }
        override any VisitBinary(BinaryExpression e) {
            string op = e.Op
            if (op == "&&") { return "(" + this.Condition(e.Left) + " AND " + this.Condition(e.Right) + ")" }
            if (op == "||") { return "(" + this.Condition(e.Left) + " OR " + this.Condition(e.Right) + ")" }
            // (x == undefined: IS NULL)
            if ((op == "==" || op == "!=") && Data.SqlWriter.IsNull(e.Right)) {
                if (op == "==") { return "(" + this.Sql(e.Left) + " IS NULL)" }
                return "(" + this.Sql(e.Left) + " IS NOT NULL)"
            }
            if ((op == "==" || op == "!=") && Data.SqlWriter.IsNull(e.Left)) {
                if (op == "==") { return "(" + this.Sql(e.Right) + " IS NULL)" }
                return "(" + this.Sql(e.Right) + " IS NOT NULL)"
            }
            // (a value compared with a column is converted for that column: a DateTime, an enum)
            var lc = this.ColumnOf(e.Left)
            var rc = this.ColumnOf(e.Right)
            string left = this.Side(e.Left, rc)
            string right = this.Side(e.Right, lc)
            if (op == "+" && (e.Type == "string" || this.IsText(e.Left) || this.IsText(e.Right))) { return this.dialect.Concat(left, right) }
            if (op == "??") { return "coalesce(" + left + ", " + right + ")" }
            string sqlOp = op
            if (op == "==") { sqlOp = "=" }
            else if (op == "!=") { sqlOp = "<>" }
            else if (!(op == "<" || op == "<=" || op == ">" || op == ">=" || op == "+" || op == "-" || op == "*" || op == "/" || op == "%")) { this.Fail(e, "the operator " + op) }
            return "(" + left + " " + sqlOp + " " + right + ")"
        }
        // (one side of a comparison: a captured value or a constant converted for the column on the other side)
        string Side(Expression e, Data.ColumnMap other) {
            if (other != undefined && e is of CapturedExpression) {
                CapturedExpression c = e
                if (c.Value == undefined) { return "NULL" }
                return this.Value(c.Value, other)
            }
            if (other != undefined && e is of ConstantExpression) {
                ConstantExpression c = e
                if (c.Value == undefined) { return "NULL" }
                return this.Value(c.Value, other)
            }
            return this.Sql(e)
        }
        static bool IsNull(Expression e) {
            if (e is of ConstantExpression) { ConstantExpression c = e; return c.Value == undefined }
            if (e is of CapturedExpression) { CapturedExpression c = e; return c.Value == undefined }
            return false
        }
        override any VisitConditional(ConditionalExpression e) {
            return "(CASE WHEN " + this.Sql(e.Test) + " THEN " + this.Sql(e.IfTrue) + " ELSE " + this.Sql(e.IfFalse) + " END)"
        }
        override any VisitCall(CallExpression e) {
            string m = e.Method
            // (a navigation field of the object with Any(...) / All(...): EXISTS of a subquery of the children)
            if ((m == "Any" || m == "All") && e.Target is of MemberExpression) {
                MemberExpression nav = e.Target
                if (nav.Target is of ParameterExpression) {
                    ParameterExpression owner = nav.Target
                    int at = this.ScopeOf(owner.Name)
                    if (at >= 0) {
                        Data.EntityMap ownerMap = this.scopeMaps[at]
                        var r = ownerMap.Relation(nav.Name)
                        if (r != undefined && r.many) { return this.Exists(e, ownerMap, at, r, m == "All") }
                        if (r != undefined && r.join) { return this.ExistsJoin(e, ownerMap, at, r, m == "All") }
                    }
                }
            }
            if (e.Target != undefined && this.IsText(e.Target)) {
                string target = this.Sql(e.Target)
                if (m == "ToLower" && e.Arguments.length == 0) { return this.dialect.Lower(target) }
                if (m == "ToUpper" && e.Arguments.length == 0) { return this.dialect.Upper(target) }
                if ((m == "StartsWith" || m == "EndsWith" || m == "Contains") && e.Arguments.length == 1) {
                    string arg = this.Sql(e.Arguments[0])
                    if (m == "StartsWith") { return "(" + this.dialect.StartsWith(target, arg) + ")" }
                    if (m == "Contains") { return "(" + this.dialect.Contains(target, arg) + ")" }
                    string arg2 = this.Sql(e.Arguments[0])
                    return "(" + this.dialect.EndsWith(target, arg, arg2) + ")"
                }
            }
            // (a list or an array of the program that contains a column: IN (...))
            if (m == "Contains" && e.Arguments.length == 1 && e.Target is of CapturedExpression) {
                CapturedExpression list = e.Target
                var column = this.ColumnOf(e.Arguments[0])
                string item = this.Sql(e.Arguments[0])
                any items = list.Value
                int n = 0
                if (items is of List) { List l = items; n = l.Count } else { n = items.length }
                if (n == 0) { return "(1 = 0)" }
                var t = "(" + item + " IN ("
                for (var i = 0; i < n; i++) {
                    if (i > 0) { t = t + ", " }
                    t = t + this.Value(items[i], column)
                }
                return t + "))"
            }
            this.Fail(e, "the method " + m + " (the database knows StartsWith, EndsWith, Contains, ToLower, ToUpper of a text and Contains of a list)")
            return undefined
        }
        // EXISTS (SELECT 1 FROM children AS t1 WHERE t1.foreign = owner.key [AND condition]); All: NOT EXISTS of the children where it does not hold.
        string Exists(CallExpression e, Data.EntityMap ownerMap, int ownerScope, Data.RelationMap r, bool all) {
            if (this.db == undefined) { this.Fail(e, "a subquery needs the connection") }
            ownerMap.NeedKey()
            var child = this.db.Map(r.target)
            var fk = child.Column(r.foreign)
            if (fk == undefined) { this.Fail(e, r.target + " has no column '" + r.foreign + "'") }
            this.aliases = this.aliases + 1
            string alias = "t" + this.aliases
            // (inside the subquery the outer object's columns are named with their table)
            string before = this.scopeQualifiers[ownerScope]
            if (before == "") { this.scopeQualifiers[ownerScope] = this.dialect.Quote(ownerMap.table) }
            string ownerQ = this.scopeQualifiers[ownerScope]
            var sql = "EXISTS (SELECT 1 FROM " + this.dialect.Quote(child.table) + " AS " + alias + " WHERE " + alias + "." + this.dialect.Quote(fk.column) + " = " + ownerQ + "." + this.dialect.Quote(ownerMap.key.column)
            if (e.Arguments.length > 0) {
                if (!(e.Arguments[0] is of LambdaExpression)) { this.Fail(e, "Any/All take a lambda (o => ...)") }
                LambdaExpression inner = e.Arguments[0]
                this.scopeNames.Add(inner.Parameters[0].Name)
                this.scopeMaps.Add(child)
                this.scopeQualifiers.Add(alias)
                string condition = this.Condition(inner.Body)
                this.scopeNames.RemoveAt(this.scopeNames.Count - 1)
                this.scopeMaps.RemoveAt(this.scopeMaps.Count - 1)
                this.scopeQualifiers.RemoveAt(this.scopeQualifiers.Count - 1)
                if (all) { sql = sql + " AND NOT (" + condition + ")" } else { sql = sql + " AND " + condition }
            } else if (all) { this.Fail(e, "All needs a condition") }
            this.scopeQualifiers[ownerScope] = before
            sql = sql + ")"
            if (all) { return "(NOT " + sql + ")" }
            return "(" + sql + ")"
        }

        // EXISTS (SELECT 1 FROM join AS j WHERE j.this = owner.key AND EXISTS (SELECT 1 FROM target AS t WHERE t.key = j.other [AND condition]))
        string ExistsJoin(CallExpression e, Data.EntityMap ownerMap, int ownerScope, Data.RelationMap r, bool all) {
            if (this.db == undefined) { this.Fail(e, "a subquery needs the connection") }
            ownerMap.NeedKey()
            var target = this.db.Map(r.target)
            target.NeedKey()
            this.aliases = this.aliases + 1
            string j = "j" + this.aliases
            string t = "t" + this.aliases
            string before = this.scopeQualifiers[ownerScope]
            if (before == "") { this.scopeQualifiers[ownerScope] = this.dialect.Quote(ownerMap.table) }
            string ownerQ = this.scopeQualifiers[ownerScope]
            var q = this.dialect
            var sql = "EXISTS (SELECT 1 FROM " + q.Quote(r.joinTable) + " AS " + j + " WHERE " + j + "." + q.Quote(r.thisColumn) + " = " + ownerQ + "." + q.Quote(ownerMap.key.column) +
                " AND EXISTS (SELECT 1 FROM " + q.Quote(target.table) + " AS " + t + " WHERE " + t + "." + q.Quote(target.key.column) + " = " + j + "." + q.Quote(r.otherColumn)
            if (e.Arguments.length > 0) {
                if (!(e.Arguments[0] is of LambdaExpression)) { this.Fail(e, "Any/All take a lambda (x => ...)") }
                LambdaExpression inner = e.Arguments[0]
                this.scopeNames.Add(inner.Parameters[0].Name)
                this.scopeMaps.Add(target)
                this.scopeQualifiers.Add(t)
                string condition = this.Condition(inner.Body)
                this.scopeNames.RemoveAt(this.scopeNames.Count - 1)
                this.scopeMaps.RemoveAt(this.scopeMaps.Count - 1)
                this.scopeQualifiers.RemoveAt(this.scopeQualifiers.Count - 1)
                if (all) { sql = sql + " AND NOT (" + condition + ")" } else { sql = sql + " AND " + condition }
            } else if (all) { this.Fail(e, "All needs a condition") }
            this.scopeQualifiers[ownerScope] = before
            sql = sql + "))"
            if (all) { return "(NOT " + sql + ")" }
            return "(" + sql + ")"
        }

        override any VisitNew(NewExpression e) { this.Fail(e, "a new object"); return undefined }
        override any VisitIsType(IsTypeExpression e) { this.Fail(e, "is of"); return undefined }
        override any VisitIndex(IndexExpression e) { this.Fail(e, "an index"); return undefined }
        override any VisitLambda(LambdaExpression e) { this.Fail(e, "a nested lambda"); return undefined }
    }

    /// <summary>A field of a mapped class and its column (Data.EntityMap).</summary>
    class ColumnMap {
        string field
        string column
        string typeName
        // int, float, string, bool, bytes, time (DateTime), enum, json ([Json]: a record or class as JSON text)
        string kind
        bool key
        bool generated
        bool unique
        bool index
        bool required
        int length
        // [Check "age >= 0"]: a condition of the column; [DbType "postgres: jsonb; mysql: JSON; *: TEXT"]: its type in a database (by the
        // name of the dialect; `*`: the others) in place of the one the dialect chooses
        string check
        string dbType
        construct(string field, string column, string typeName, string kind) {
            this.field = field
            this.column = column
            this.typeName = typeName
            this.kind = kind
            this.length = 0
            this.key = false
            this.generated = false
            this.unique = false
            this.index = false
            this.required = false
        }
        // (the type of [DbType "postgres: jsonb; mysql: JSON; *: TEXT"] for the dialect `name`; undefined: none given for it)
        static string TypeIn(string spec, string name) {
            if (spec == undefined) { return undefined }
            if (spec.IndexOf(":") < 0) { return spec.Trim() }
            string other = undefined
            any parts = spec.Split(";")
            for (var i = 0; i < parts.length; i++) {
                string p = parts[i]
                int colon = p.IndexOf(":")
                if (colon < 0) { continue }
                string who = p.Substring(0, colon).Trim().ToLower()
                string type = p.Substring(colon + 1).Trim()
                if (who == name) { return type }
                if (who == "*") { other = type }
            }
            return other
        }
    }

    /// <summary>A navigation field: `[HasMany "personId"] List<Order> orders` (the children whose field `personId` is this object's key) or
    /// `[BelongsTo "personId"] Person owner` (the object whose key is this object's field `personId`).</summary>
    class RelationMap {
        string field
        string target        // the class of the other side
        string foreign       // the field that holds the key: of the children (many), of this object (one)
        bool many
        bool single          // [HasOne "personId"] Profile profile: one child (many with at most one; the field is the object, not a list)
        bool join            // [ManyToMany "table", "thisColumn", "otherColumn"]: the pairs in a join table
        string joinTable
        string thisColumn
        string otherColumn
        construct(string field, string typeName) {
            this.field = field
            this.target = typeName
            this.many = false
            this.single = false
            this.join = false
        }
        // (the children of a [HasMany] list or the one of a [HasOne] field as a list)
        static List Items(Data.RelationMap r, any value) {
            if (!r.single) { return value }
            var l = new List()
            if (value != undefined) { l.Add(value) }
            return l
        }
        // ("List<Order>" -> "Order")
        static string ElementType(string typeName) {
            int lt = typeName.IndexOf("<")
            int gt = typeName.LastIndexOf(">")
            if (lt < 0 || gt < lt) { return undefined }
            return typeName.Substring(lt + 1, gt - lt - 1)
        }
    }

    /// <summary>How a class maps to a table: the name of the class (`[Table "people"]` changes it), the key (the field with `[Key]`, else `id`; an `int` key
    /// is generated unless `[Key "manual"]`), a column per field of a type the database stores (`[Column "full_name"]`, `[Ignore]`, `[Unique]`, `[Index]`,
    /// `[Required]`, `[Length 100]`, `[Json]` for a record or class as JSON text).</summary>
    class EntityMap {
        string typeName
        string table
        List columns
        Data.ColumnMap key
        Data.ColumnMap version   // (the field with [Version]: optimistic concurrency in sessions)
        List relations           // Data.RelationMap: the navigation fields ([HasMany], [HasOne], [BelongsTo], [ManyToMany])
        string view              // [View "SELECT ..."]: the table is a view of this query
        string check             // [Check "a < b"] of the class: a condition of the table

        construct(string typeName) {
            this.typeName = typeName
            Type t = Type.Named(typeName)
            if (t == undefined) { throw new ArgumentException("Data: there is no class '" + typeName + "'.") }
            string short = t.Name
            int dot = short.LastIndexOf(".")
            if (dot >= 0) { short = short.Substring(dot + 1) }
            this.table = short
            Attribute ta = t.FindAttribute("Table")
            if (ta != undefined && ta.ArgCount() > 0) { this.table = "" + ta.Args[0] }
            Attribute va = t.FindAttribute("View")
            if (va != undefined && va.ArgCount() > 0) { this.view = "" + va.Args[0] }
            Attribute cha = t.FindAttribute("Check")
            if (cha != undefined && cha.ArgCount() > 0) { this.check = "" + cha.Args[0] }
            this.columns = new List()
            this.relations = new List()
            List members = t.Fields()
            Data.ColumnMap byName = undefined
            for (var i = 0; i < members.Count; i++) {
                Member m = members[i]
                if (m.IsStatic || m.HasAttribute("Ignore")) { continue }
                Attribute many = m.FindAttribute("HasMany")
                Attribute one = m.FindAttribute("BelongsTo")
                Attribute owned = m.FindAttribute("HasOne")
                Attribute pairs = m.FindAttribute("ManyToMany")
                if (pairs != undefined) {
                    if (pairs.ArgCount() < 3) { throw new ArgumentException("Data: [ManyToMany \"table\", \"thisColumn\", \"otherColumn\"] for '" + m.Name + "' of " + typeName + ".") }
                    var jr = new Data.RelationMap(m.Name, Data.RelationMap.ElementType(m.TypeName))
                    jr.join = true
                    jr.joinTable = "" + pairs.Args[0]
                    jr.thisColumn = "" + pairs.Args[1]
                    jr.otherColumn = "" + pairs.Args[2]
                    if (jr.target == undefined) { throw new ArgumentException("Data: [ManyToMany] needs a List<T> field ('" + m.Name + "' of " + typeName + ").") }
                    jr.target = Data.EntityMap.Qualify(jr.target, typeName)
                    this.relations.Add(take jr)
                    continue
                }
                if (many != undefined || one != undefined || owned != undefined) {
                    var r = new Data.RelationMap(m.Name, m.TypeName)
                    if (owned != undefined) {
                        r.many = true
                        r.single = true
                        if (owned.ArgCount() > 0) { r.foreign = "" + owned.Args[0] }
                    } else if (many != undefined) {
                        r.many = true
                        r.target = Data.RelationMap.ElementType(m.TypeName)
                        if (many.ArgCount() > 0) { r.foreign = "" + many.Args[0] }
                    } else {
                        r.many = false
                        if (one.ArgCount() > 0) { r.foreign = "" + one.Args[0] }
                    }
                    if (r.foreign == undefined || r.target == undefined) { throw new ArgumentException("Data: the relation '" + m.Name + "' of " + typeName + " needs its foreign key field ([HasMany \"personId\"] List<Order> ..., [HasOne \"personId\"] Profile ..., [BelongsTo \"personId\"] Person ...).") }
                    r.target = Data.EntityMap.Qualify(r.target, typeName)
                    this.relations.Add(take r)
                    continue
                }
                string kind = Data.EntityMap.KindOf(m.TypeName, m.HasAttribute("Json"))
                if (kind == undefined) { continue }
                string column = m.Name
                Attribute ca = m.FindAttribute("Column")
                if (ca != undefined && ca.ArgCount() > 0) { column = "" + ca.Args[0] }
                var c = new Data.ColumnMap(m.Name, column, m.TypeName, kind)
                Attribute ka = m.FindAttribute("Key")
                if (ka != undefined) {
                    c.key = true
                    c.generated = kind == "int" && !(ka.ArgCount() > 0 && ("" + ka.Args[0]) == "manual")
                }
                c.unique = m.HasAttribute("Unique")
                c.index = m.HasAttribute("Index")
                c.required = m.HasAttribute("Required")
                Attribute fc = m.FindAttribute("Check")
                if (fc != undefined && fc.ArgCount() > 0) { c.check = "" + fc.Args[0] }
                Attribute dt = m.FindAttribute("DbType")
                if (dt != undefined && dt.ArgCount() > 0) { c.dbType = "" + dt.Args[0] }
                Attribute la = m.FindAttribute("Length")
                if (la != undefined && la.ArgCount() > 0) { c.length = la.Args[0] }
                if (c.key) { this.key = c }
                if (m.HasAttribute("Version")) {
                    if (kind != "int") { throw new ArgumentException("Data: [Version] needs an int field ('" + m.Name + "' of " + typeName + ").") }
                    this.version = c
                }
                if (m.Name.ToLower() == "id") { byName = c }
                this.columns.Add(take c)
            }
            if (this.key == undefined && byName != undefined) {
                this.key = byName
                byName.key = true
                byName.generated = byName.kind == "int"
            }
        }

        // The columns of CREATE TABLE in parentheses, with the condition of the table ([Check] of the class).
        string TableBody(Data.Dialect d) {
            var cols = ""
            for (var i = 0; i < this.columns.Count; i++) {
                Data.ColumnMap c = this.columns[i]
                if (i > 0) { cols = cols + ", " }
                cols = cols + d.ColumnDefinition(c)
            }
            if (this.check != undefined) { cols = cols + ", CHECK (" + this.check + ")" }
            return "(" + cols + ")"
        }

        // (the class of a relation: as it is written, or - in a namespace - the class of the owner's namespace)
        static string Qualify(string name, string owner) {
            if (Type.Named(name) != undefined) { return name }
            int dot = owner.LastIndexOf(".")
            if (dot < 0) { return name }
            string full = owner.Substring(0, dot + 1) + name
            if (Type.Named(full) != undefined) { return full }
            return name
        }

        // (what the database stores of a field of type `typeName`; undefined: not a column - a class, a list: later the relations)
        static string KindOf(string typeName, bool json) {
            if (json) { return "json" }
            if (typeName == "int" || typeName == "float" || typeName == "string" || typeName == "bool") { return typeName }
            if (typeName == "byte[]" || typeName == "int[8][]") { return "bytes" }   // (a byte field: `byte data[]`)
            if (typeName == "DateTime") { return "time" }
            if (typeName == "char") { return "string" }
            if (typeName == "any" || typeName.StartsWith("List") || typeName.StartsWith("Dictionary") || typeName.EndsWith("[]")) { return undefined }
            if (Type.Named(typeName) == undefined) { return "enum" }   // (an enum: no class of that name - stored by the name of its member)
            return undefined
        }

        Data.RelationMap Relation(string field) {
            for (var i = 0; i < this.relations.Count; i++) {
                Data.RelationMap r = this.relations[i]
                if (r.field == field) { return r }
            }
            return undefined
        }

        undefined NeedKey() { if (this.key == undefined) { throw new ArgumentException("Data: the class '" + this.typeName + "' has no key ([Key] or a field 'id').") } }

        Data.ColumnMap Column(string field) {
            for (var i = 0; i < this.columns.Count; i++) {
                Data.ColumnMap c = this.columns[i]
                if (c.field == field) { return c }
            }
            return undefined
        }
        // (the column of this name in the table)
        Data.ColumnMap ColumnByName(string column) {
            for (var i = 0; i < this.columns.Count; i++) {
                Data.ColumnMap c = this.columns[i]
                if (c.column.ToLower() == column.ToLower()) { return c }
            }
            return undefined
        }

        // A value of a field as a parameter.
        static any ToDb(any v, Data.ColumnMap c) {
            if (v == undefined) { return undefined }
            if (c.kind == "time") { any t = v; return t.ToString("o") }
            if (c.kind == "enum") { return "" + v }   // (by its name: readable, and new members do not move the old ones)
            if (c.kind == "json") { return Json.Serialize(v) }
            return v
        }
    }

    /// <summary>How the columns of a result go to the fields of a class (QueryList, QueryOne).</summary>
    class RowMap {
        string typeName
        List fields         // per column: the field's name (undefined: no field)
        List kinds          // per column: what the field is (Data.ColumnMap.kind)
        Data.EntityMap map

        construct(string typeName) {
            this.typeName = typeName
            this.map = new Data.EntityMap(typeName)
            this.fields = new List()
            this.kinds = new List()
        }

        static string Key(string name) { return name.Replace("_", "").ToLower() }

        undefined Columns(any names) {
            this.fields = new List()
            this.kinds = new List()
            for (var n = 0; n < names.length; n++) {
                string key = Data.RowMap.Key(names[n])
                any found = undefined
                any kind = undefined
                for (var f = 0; f < this.map.columns.Count; f++) {
                    Data.ColumnMap c = this.map.columns[f]
                    if (c.column.ToLower() == ("" + names[n]).ToLower() || Data.RowMap.Key(c.field) == key) {
                        found = c.field
                        kind = c.kind
                        break
                    }
                }
                this.fields.Add(found)
                this.kinds.Add(kind)
            }
        }

        // An object of the row (made from JSON: without the constructor, also a record).
        any Make(any values) {
            var json = "{"
            var first = true
            for (var c = 0; c < values.length; c++) {
                any field = this.fields[c]
                any v = values[c]
                if (field == undefined || v == undefined) { continue }
                if (!first) { json = json + ", " }
                first = false
                json = json + Json.Serialize(field) + ": " + Data.RowMap.Value(v, this.kinds[c])
            }
            json = json + "}"
            return Json.Deserialize(json, this.typeName)
        }

        // (a value of the database as the JSON of a field of the kind `kind`)
        static string Value(any v, any kind) {
            if (kind == "bool") {
                if (v is of string) { string t = v; return Json.Serialize(t == "1" || t.ToLower() == "true") }
                return Json.Serialize(v != 0)
            }
            if (kind == "string" && !(v is of string)) { return Json.Serialize("" + v) }
            if (kind == "int" && v is of float) { float f = v; return Json.Serialize(f!int) }
            if (kind == "int" && v is of string) { string t = v; return Json.Serialize(t.ToInt()) }
            if (kind == "float" && v is of string) { string t = v; return Json.Serialize(t.ToFloat()) }
            if (kind == "time") { return Json.Serialize(DateTime.Parse("" + v)) }
            if (kind == "json") { return "" + v }
            return Json.Serialize(v)
        }
    }

    // ---- migrations ----

    /// <summary>What a migration does to the database (`Up(Data.Migrator m)` / `Down`): tables, columns and indexes in the words of no database - the
    /// dialect of the connection makes the SQL - and plain SQL where that is not enough. A column: `m.Column("email", "string", 255, true)` (name, kind
    /// - int, float, bool, string, bytes, time, enum, json -, length, required), a key: `m.Key("id")` (an int generated by the database).</summary>
    class Migrator {
        Data.Connection db
        // (what ran: the SQL of every step)
        List log

        construct(Data.Connection db) {
            this.db = db
            this.log = new List()
        }

        Data.Connection Connection { get { return this.db } }

        Data.ColumnMap Column(string name, string kind = "string", int length = 0, bool required = false) {
            if (!(kind == "int" || kind == "float" || kind == "bool" || kind == "string" || kind == "bytes" || kind == "time" || kind == "enum" || kind == "json")) {
                throw new ArgumentException("Data.Migrator: the kind of a column is int, float, bool, string, bytes, time, enum or json, not '" + kind + "'.")
            }
            var c = new Data.ColumnMap(name, name, kind, kind)
            c.length = length
            c.required = required
            return c
        }
        Data.ColumnMap Key(string name = "id", string kind = "int", bool generated = true, int length = 0) {
            var c = this.Column(name, kind, length, true)
            c.key = true
            c.generated = generated && kind == "int"
            return c
        }

        undefined Run(string sql) {
            if (sql == "") { return }
            this.log.Add(sql)
            this.db.Execute(sql)
        }
        // Plain SQL (with parameters).
        undefined Sql(string sql, any args = undefined) {
            this.log.Add(sql)
            this.db.Execute(sql, args)
        }
        // A table of these columns (an array of m.Column/m.Key).
        undefined CreateTable(string table, any columns) {
            var d = this.db.Dialect
            var cols = ""
            for (var i = 0; i < columns.length; i++) {
                Data.ColumnMap c = columns[i]
                if (i > 0) { cols = cols + ", " }
                cols = cols + d.ColumnDefinition(c)
            }
            this.Run("CREATE TABLE " + d.Quote(table) + " (" + cols + ")" + d.TableOptions())
        }
        // The table of a class as its mapping has it now (columns, join tables, indexes) - what Ensure would make.
        undefined CreateTableFor(string typeName) {
            this.db.Ensure(typeName)
            this.log.Add("-- Ensure " + typeName)
        }
        undefined DropTable(string table) { this.Run(this.db.Dialect.DropTable(table)) }
        undefined AddColumn(string table, Data.ColumnMap column) {
            var d = this.db.Dialect
            this.Run(d.AddColumn(d.Quote(table), d.ColumnDefinition(column)))
        }
        undefined DropColumn(string table, string column) { this.Run(this.db.Dialect.DropColumn(table, column)) }
        undefined RenameColumn(string table, string column, string to) { this.Run(this.db.Dialect.RenameColumn(table, column, to)) }
        undefined CreateIndex(string name, string table, string column, bool unique = false) {
            var d = this.db.Dialect
            var kind = "INDEX"
            if (unique) { kind = "UNIQUE INDEX" }
            this.Run("CREATE " + kind + " " + d.Quote(name) + " ON " + d.Quote(table) + " (" + d.Quote(column) + ")" + d.IndexSuffix(d.Quote(column), unique))
        }
        undefined DropIndex(string name, string table) { this.Run(this.db.Dialect.DropIndex(name, table)) }
    }

    /// <summary>A migration of the program: its number, title and class.</summary>
    class MigrationInfo {
        int version
        string title
        string typeName
        construct(int version, string title, string typeName) {
            this.version = version
            this.title = title
            this.typeName = typeName
        }
    }

    /// <summary>The migrations of the program ([Migration n, "title"] classes) and their table `_fire_migrations` (version, name, applied).</summary>
    class Migrations {
        static string Table() { return "_fire_migrations" }

        // (the migrations of the program, by their numbers)
        static List Found() {
            var found = new List()
            any all = Type.Names()
            for (var i = 0; i < all.length; i++) {
                string full = all[i]
                Type t = Type.Named(full)
                if (t == undefined) { continue }
                Attribute a = t.FindAttribute("Migration")
                if (a == undefined || a.ArgCount() == 0) { continue }
                any v = a.Args[0]
                if (!(v is of int)) { throw new ArgumentException("Data: [Migration] of '" + full + "' needs its number first: [Migration 3, \"title\"].") }
                string title = ""
                if (a.ArgCount() > 1) { title = "" + a.Args[1] }
                int version = v
                for (var k = 0; k < found.Count; k++) {
                    Data.MigrationInfo other = found[k]
                    if (other.version == version) { throw new ArgumentException("Data: the migrations '" + other.typeName + "' and '" + full + "' have the same number " + version + ".") }
                }
                found.Add(new Data.MigrationInfo(version, title, full))
            }
            // (in the order of their numbers)
            var sorted = new List()
            var used = new List()
            for (var n = 0; n < found.Count; n++) {
                int best = -1
                for (var k = 0; k < found.Count; k++) {
                    if (used.IndexOf(k) >= 0) { continue }
                    Data.MigrationInfo x = found[k]
                    if (best < 0) { best = k }
                    else {
                        Data.MigrationInfo b = found[best]
                        if (x.version < b.version) { best = k }
                    }
                }
                used.Add(best)
                Data.MigrationInfo pick = found[best]
                sorted.Add(new Data.MigrationInfo(pick.version, pick.title, pick.typeName))
            }
            return sorted
        }


        static undefined EnsureTable(Data.Connection db) {
            var d = db.Dialect
            if (db.Rows(d.ColumnsQuery(), [Data.Migrations.Table()]).Count > 0) { return }
            var m = new Data.Migrator(db)
            m.CreateTable(Data.Migrations.Table(), [m.Key("version", "int", false), m.Column("name", "string", 255), m.Column("applied", "string", 40)])
        }

        static List Applied(Data.Connection db) {
            Data.Migrations.EnsureTable(db)
            var list = new List()
            var d = db.Dialect
            foreach (row in db.Rows("SELECT " + d.Quote("version") + " FROM " + d.Quote(Data.Migrations.Table()) + " ORDER BY " + d.Quote("version"))) {
                int v = row.Int(0)
                list.Add(v)
            }
            return list
        }

        static int Current(Data.Connection db) {
            List done = Data.Migrations.Applied(db)
            if (done.Count == 0) { return 0 }
            int last = done[done.Count - 1]
            return last
        }

        // Runs the missing migrations up to `upto` (-1: all); how many ran.
        static int Up(Data.Connection db, int upto) {
            List done = Data.Migrations.Applied(db)
            List found = Data.Migrations.Found()
            int ran = 0
            var d = db.Dialect
            for (var i = 0; i < found.Count; i++) {
                Data.MigrationInfo info = found[i]
                if (upto >= 0 && info.version > upto) { break }
                if (done.IndexOf(info.version) >= 0) { continue }
                Data.Migrations.Step(db, info, true)
                db.Execute("INSERT INTO " + d.Quote(Data.Migrations.Table()) + " (" + d.Quote("version") + ", " + d.Quote("name") + ", " + d.Quote("applied") + ") VALUES (?, ?, ?)", [info.version, info.title, DateTime.UtcNow.ToString("o")])
                db.Commit()
                ran++
            }
            return ran
        }

        // Undoes the migrations above `version` with their Down methods, the newest first; how many.
        static int Down(Data.Connection db, int version) {
            List done = Data.Migrations.Applied(db)
            List found = Data.Migrations.Found()
            int ran = 0
            var d = db.Dialect
            for (var i = done.Count - 1; i >= 0; i--) {
                int v = done[i]
                if (v <= version) { break }
                Data.MigrationInfo info = undefined
                for (var k = 0; k < found.Count; k++) {
                    Data.MigrationInfo f = found[k]
                    if (f.version == v) { info = f }
                }
                if (info == undefined) { throw new Data.StateException("Data: the migration " + v + " ran on this database, but the program has no [Migration " + v + "] to undo it.") }
                Data.Migrations.Step(db, info, false)
                db.Execute("DELETE FROM " + d.Quote(Data.Migrations.Table()) + " WHERE " + d.Quote("version") + " = ?", [v])
                db.Commit()
                ran++
            }
            return ran
        }

        // (one migration in a transaction - the caller commits after it wrote its row; a failure rolls back and says which migration it was)
        static undefined Step(Data.Connection db, Data.MigrationInfo info, bool up) {
            Type t = Type.Named(info.typeName)
            any migration = t.New(new any[0])
            var m = new Data.Migrator(db)
            db.Begin()
            try {
                if (up) { migration.Up(m) } else { migration.Down(m) }
            } catch (e) {
                try { db.Rollback() } catch (e2) { }
                string what = "Up"
                if (!up) { what = "Down" }
                string why = "" + e
                if (e is of Exception) { Exception x = e; why = x.message }
                throw new Data.DataException("Data: the migration " + info.version + " '" + info.title + "' (" + info.typeName + "." + what + ") failed: " + why)
            }
        }
    }

    // ---- the schema as the database has it ----

    class SchemaColumn {
        string name
        string type
        bool nullable
        bool key
        construct(string name, string type, bool nullable, bool key) {
            this.name = name
            this.type = type
            this.nullable = nullable
            this.key = key
        }
    }
    class SchemaIndex {
        string name
        string column
        bool unique
        construct(string name, string column, bool unique) {
            this.name = name
            this.column = column
            this.unique = unique
        }
    }
    class SchemaTable {
        string name
        List columns     // Data.SchemaColumn
        List indexes     // Data.SchemaIndex
        construct(string name) {
            this.name = name
            this.columns = new List()
            this.indexes = new List()
        }
        Data.SchemaColumn Column(string name) {
            for (var i = 0; i < this.columns.Count; i++) {
                Data.SchemaColumn c = this.columns[i]
                if (c.name.ToLower() == name.ToLower()) { return c }
            }
            return undefined
        }
        Data.SchemaIndex Index(string name) {
            for (var i = 0; i < this.indexes.Count; i++) {
                Data.SchemaIndex x = this.indexes[i]
                if (x.name.ToLower() == name.ToLower()) { return x }
            }
            return undefined
        }
    }

    class SchemaReader {
        static bool Flag(any v) {
            if (v == undefined) { return false }
            if (v is of bool) { bool b = v; return b }
            if (v is of string) { string t = v; return t == "1" || t.ToLower() == "true" || t.ToLower() == "yes" }
            return v != 0
        }
        // (the tables of the database - not the table of the migrations)
        static List Read(Data.Connection db) {
            var d = db.Dialect
            var tables = new List()
            foreach (row in db.Rows(d.TablesQuery())) {
                string name = "" + row.Get(0)
                if (name.ToLower() == Data.Migrations.Table()) { continue }
                var t = new Data.SchemaTable(name)
                foreach (c in db.Rows(d.ColumnInfoQuery(), [name])) { t.columns.Add(new Data.SchemaColumn("" + c.Get(0), ("" + c.Get(1)).ToLower(), Data.SchemaReader.Flag(c.Get(2)), Data.SchemaReader.Flag(c.Get(3)))) }
                string iq = d.IndexesQuery()
                if (iq != undefined) {
                    foreach (x in db.Rows(iq, [name])) { t.indexes.Add(new Data.SchemaIndex("" + x.Get(0), "" + x.Get(1), Data.SchemaReader.Flag(x.Get(2)))) }
                }
                tables.Add(take t)
            }
            return tables
        }
        static Data.SchemaTable Find(List tables, string name) {
            for (var i = 0; i < tables.Count; i++) {
                Data.SchemaTable t = tables[i]
                if (t.name.ToLower() == name.ToLower()) { return t }
            }
            return undefined
        }
    }

    // ---- the difference of the mapping to the database, as a migration ----

    class Differ {
        // (the classes of the program with [Table])
        static List Entities() {
            var list = new List()
            any all = Type.Names()
            for (var i = 0; i < all.length; i++) {
                string full = all[i]
                Type t = Type.Named(full)
                if (t == undefined) { continue }
                if (t.FindAttribute("Table") != undefined) { list.Add(full) }
            }
            return list
        }
        static string Text(string s) { return "\"" + s.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"" }
        // (a column as the code of the migration: m.Key(...) / m.Column(...))
        static string Spec(Data.ColumnMap c) {
            string kind = c.kind
            if (c.key) {
                if (kind == "int" && c.generated) { return "m.Key(" + Data.Differ.Text(c.column) + ")" }
                var k = "m.Key(" + Data.Differ.Text(c.column) + ", " + Data.Differ.Text(kind) + ", false"
                if (c.length > 0) { k = k + ", " + c.length }
                return k + ")"
            }
            var t = "m.Column(" + Data.Differ.Text(c.column) + ", " + Data.Differ.Text(kind)
            if (c.length > 0 || c.required) { t = t + ", " + c.length }
            if (c.required) { t = t + ", true" }
            return t + ")"
        }

        // The code of the migration `version` that makes the database what the mapping of the [Table] classes says (new tables, columns, indexes,
        // join tables); "" when nothing is missing. What the database has and the mapping not is named in comments, never dropped.
        static string Diff(Data.Connection db, int version, string title) {
            List tables = Data.SchemaReader.Read(db)
            List entities = Data.Differ.Entities()
            var up = new List()
            var down = new List()
            var notes = new List()
            var made = new List()
            var viewsUp = new List()
            var viewsDown = new List()
            for (var e = 0; e < entities.Count; e++) {
                string typeName = entities[e]
                var map = db.Map(typeName)
                if (map.view != undefined) {
                    // (a view: made when the database has none of that name - its query is the program's; a changed query is not compared)
                    if (db.Rows(db.Dialect.ColumnsQuery(), [map.table]).Count == 0) {
                        viewsUp.Add("m.Sql(" + Data.Differ.Text(db.Dialect.CreateView(db.Dialect.Quote(map.table), map.view)) + ")")
                        viewsDown.Add("m.Sql(" + Data.Differ.Text(db.Dialect.DropView(map.table)) + ")")
                    }
                    continue
                }
                Data.SchemaTable have = Data.SchemaReader.Find(tables, map.table)
                if (have == undefined && made.IndexOf(map.table.ToLower()) < 0) {
                    made.Add(map.table.ToLower())
                    var cols = ""
                    bool special = map.check != undefined
                    for (var i = 0; i < map.columns.Count; i++) {
                        Data.ColumnMap c = map.columns[i]
                        if (i > 0) { cols = cols + ", " }
                        cols = cols + Data.Differ.Spec(c)
                        if (c.check != undefined || c.dbType != undefined) { special = true }
                    }
                    // (with [Check] or [DbType]: the CREATE TABLE of this database as it is - m.Column knows neither)
                    if (special) { up.Add("m.Sql(" + Data.Differ.Text("CREATE TABLE " + db.Dialect.Quote(map.table) + " " + map.TableBody(db.Dialect) + db.Dialect.TableOptions()) + ")") }
                    else { up.Add("m.CreateTable(" + Data.Differ.Text(map.table) + ", [" + cols + "])") }
                    down.Add("m.DropTable(" + Data.Differ.Text(map.table) + ")")
                } else if (have != undefined) {
                    for (var i = 0; i < map.columns.Count; i++) {
                        Data.ColumnMap c = map.columns[i]
                        if (have.Column(c.column) != undefined) { continue }
                        // (a new column that must have a value: the rows that are there have none - it is added as it may be NULL)
                        var spec = Data.Differ.Spec(c)
                        if (c.required && !c.key) {
                            spec = spec.Substring(0, spec.LastIndexOf(", true")) + ")"
                            notes.Add("// " + map.table + "." + c.column + " is [Required]: the rows that are there have no value - fill them, then make the column NOT NULL by SQL")
                        }
                        up.Add("m.AddColumn(" + Data.Differ.Text(map.table) + ", " + spec + ")")
                        down.Add("m.DropColumn(" + Data.Differ.Text(map.table) + ", " + Data.Differ.Text(c.column) + ")")
                    }
                    for (var i = 0; i < have.columns.Count; i++) {
                        Data.SchemaColumn sc = have.columns[i]
                        if (map.ColumnByName(sc.name) == undefined) { notes.Add("// " + map.table + "." + sc.name + " is in the database, not in the mapping: m.DropColumn(" + Data.Differ.Text(map.table) + ", " + Data.Differ.Text(sc.name) + ") would drop it") }
                    }
                }
                // (the indexes of [Unique] and [Index] columns, named as Ensure names them)
                for (var i = 0; i < map.columns.Count; i++) {
                    Data.ColumnMap c = map.columns[i]
                    if (!c.unique && !c.index) { continue }
                    string name = "ix_" + map.table + "_" + c.column
                    if (have != undefined && have.Index(name) != undefined) { continue }
                    var line = "m.CreateIndex(" + Data.Differ.Text(name) + ", " + Data.Differ.Text(map.table) + ", " + Data.Differ.Text(c.column)
                    if (c.unique) { line = line + ", true" }
                    up.Add(line + ")")
                    if (have != undefined) { down.Add("m.DropIndex(" + Data.Differ.Text(name) + ", " + Data.Differ.Text(map.table) + ")") }
                }
                // (the join tables of [ManyToMany] fields)
                for (var i = 0; i < map.relations.Count; i++) {
                    Data.RelationMap r = map.relations[i]
                    if (!r.join) { continue }
                    string joinIndex = "ix_" + r.joinTable + "_" + r.thisColumn
                    Data.SchemaTable haveJoin = Data.SchemaReader.Find(tables, r.joinTable)
                    if (haveJoin != undefined || made.IndexOf(r.joinTable.ToLower()) >= 0) {
                        // (the join table is there or made by the other side: the index of this side when it lacks)
                        bool hasIndex = haveJoin != undefined && haveJoin.Index(joinIndex) != undefined
                        if (!hasIndex && made.IndexOf(joinIndex.ToLower()) < 0) {
                            made.Add(joinIndex.ToLower())
                            up.Add("m.CreateIndex(" + Data.Differ.Text(joinIndex) + ", " + Data.Differ.Text(r.joinTable) + ", " + Data.Differ.Text(r.thisColumn) + ")")
                            if (haveJoin != undefined) { down.Add("m.DropIndex(" + Data.Differ.Text(joinIndex) + ", " + Data.Differ.Text(r.joinTable) + ")") }
                        }
                        continue
                    }
                    made.Add(r.joinTable.ToLower())
                    made.Add(joinIndex.ToLower())
                    map.NeedKey()
                    var target = db.Map(r.target)
                    target.NeedKey()
                    up.Add("m.CreateTable(" + Data.Differ.Text(r.joinTable) + ", [m.Column(" + Data.Differ.Text(r.thisColumn) + ", " + Data.Differ.Text(map.key.kind) + ", 0, true), m.Column(" + Data.Differ.Text(r.otherColumn) + ", " + Data.Differ.Text(target.key.kind) + ", 0, true)])")
                    up.Add("m.CreateIndex(" + Data.Differ.Text("ix_" + r.joinTable + "_" + r.thisColumn) + ", " + Data.Differ.Text(r.joinTable) + ", " + Data.Differ.Text(r.thisColumn) + ")")
                    down.Add("m.DropTable(" + Data.Differ.Text(r.joinTable) + ")")
                }
            }
            // (the views after the tables their queries name; dropped first)
            for (var i = 0; i < viewsUp.Count; i++) { up.Add(viewsUp[i]) }
            for (var i = 0; i < viewsDown.Count; i++) { down.Add(viewsDown[i]) }
            if (up.Count == 0) { return "" }
            var t = "// Made by forge data diff: what the database lacks of the mapping of the [Table] classes.\n"
            for (var i = 0; i < notes.Count; i++) { t = t + notes[i] + "\n" }
            t = t + "[Migration " + version + ", " + Data.Differ.Text(title) + "]\nclass Migration" + version + " {\n    undefined Up(Data.Migrator m) {\n"
            for (var i = 0; i < up.Count; i++) { t = t + "        " + up[i] + "\n" }
            t = t + "    }\n    undefined Down(Data.Migrator m) {\n"
            for (var i = down.Count - 1; i >= 0; i--) { t = t + "        " + down[i] + "\n" }
            return t + "    }\n}\n"
        }
    }

    // ---- a database as classes (forge data import) ----

    class Importer {
        // (the fire type of a column type of the database)
        static string FireType(string type) {
            string t = type.ToLower()
            if (t == "bit" || t == "boolean" || t == "bool" || t.StartsWith("tinyint(1)")) { return "bool" }
            if (t.IndexOf("int") >= 0) { return "int" }
            if (t.IndexOf("float") >= 0 || t.IndexOf("double") >= 0 || t.IndexOf("real") >= 0 || t.IndexOf("decimal") >= 0 || t.IndexOf("numeric") >= 0 || t.IndexOf("money") >= 0) { return "float" }
            if (t.IndexOf("blob") >= 0 || t.IndexOf("binary") >= 0 || t.IndexOf("image") >= 0 || t == "bytea") { return "byte[]" }
            if (t == "date" || t.StartsWith("datetime") || t.StartsWith("timestamp") || t == "smalldatetime") { return "DateTime" }
            return "string"
        }
        // (the length of "varchar(80)", 0 for none or max)
        static int LengthOf(string type) {
            int open = type.IndexOf("(")
            int close = type.IndexOf(")")
            if (open < 0 || close < open) { return 0 }
            any n = type.Substring(open + 1, close - open - 1).TryToInt()
            if (n == undefined) { return 0 }
            int v = n
            return v
        }
        static string Ident(string name) {
            var t = ""
            for (var i = 0; i < name.Length; i++) {
                string c = name.Substring(i, 1)
                int k = name.CharAt(i).ToInt()
                bool letter = (k >= 97 && k <= 122) || (k >= 65 && k <= 90) || k == 95
                bool digit = k >= 48 && k <= 57
                if (letter || (digit && i > 0)) { t = t + c } else { t = t + "_" }
            }
            if (t == "") { t = "_" }
            return t
        }
        static string ClassName(string table) {
            string n = Data.Importer.Ident(table)
            return n.Substring(0, 1).ToUpper() + n.Substring(1)
        }

        // Classes for the tables of the database: [Table], [Key], [Required], [Length], [Unique]/[Index] - the start of a mapping to edit.
        static string Import(Data.Connection db, string ns) {
            List tables = Data.SchemaReader.Read(db)
            var t = "// Made by forge data import from the tables of the database.\n#import \"data\"\n\n"
            var indent = ""
            if (ns != undefined && ns != "") {
                t = t + "namespace " + ns + " {\n"
                indent = "    "
            }
            for (var i = 0; i < tables.Count; i++) {
                Data.SchemaTable table = tables[i]
                if (i > 0) { t = t + "\n" }
                t = t + indent + "[Table " + Data.Differ.Text(table.name) + "]\n" + indent + "class " + Data.Importer.ClassName(table.name) + " {\n"
                for (var c = 0; c < table.columns.Count; c++) {
                    Data.SchemaColumn col = table.columns[c]
                    var line = ""
                    if (col.key) { line = line + "[Key] " }
                    else if (!col.nullable) { line = line + "[Required] " }
                    string ft = Data.Importer.FireType(col.type)
                    int length = Data.Importer.LengthOf(col.type)
                    if (ft == "string" && length > 0) { line = line + "[Length " + length + "] " }
                    for (var x = 0; x < table.indexes.Count; x++) {
                        Data.SchemaIndex ix = table.indexes[x]
                        if (ix.column.ToLower() == col.name.ToLower()) {
                            if (ix.unique) { line = line + "[Unique] " } else { line = line + "[Index] " }
                            break
                        }
                    }
                    string field = Data.Importer.Ident(col.name)
                    if (field != col.name) { line = line + "[Column " + Data.Differ.Text(col.name) + "] " }
                    if (ft == "byte[]") { line = line + "byte " + field + "[]" } else { line = line + ft + " " + field }
                    t = t + indent + "    " + line + "\n"
                }
                t = t + indent + "    construct() { }\n" + indent + "}\n"
            }
            if (indent != "") { t = t + "}\n" }
            return t
        }
    }

    /// <summary>A database as a data model (`.fdata`, docs/data/designer.md): what forge data import --format fdata and the designer of spark make of it.</summary>
    class ModelImporter {
        // (a table name as the name of an entity: singular, a fire name - customers -> Customer, order_lines -> OrderLine)
        static string EntityName(string table) {
            string t = Data.ModelImporter.Singular(table)
            var name = ""
            bool upper = true
            for (var i = 0; i < t.Length; i++) {
                string c = t.Substring(i, 1)
                int k = t.CharAt(i).ToInt()
                bool letter = (k >= 97 && k <= 122) || (k >= 65 && k <= 90)
                bool digit = k >= 48 && k <= 57
                if (!letter && !(digit && name != "")) {
                    upper = true
                    continue
                }
                if (upper) { name = name + c.ToUpper() } else { name = name + c }
                upper = false
            }
            if (name == "") { name = "Table" }
            return name
        }
        static string Singular(string name) {
            string low = name.ToLower()
            if (low.EndsWith("ies") && name.Length > 3) { return name.Substring(0, name.Length - 3) + "y" }
            if (low.EndsWith("sses") || low.EndsWith("xes") || low.EndsWith("ches") || low.EndsWith("shes")) { return name.Substring(0, name.Length - 2) }
            if (low.EndsWith("s") && !low.EndsWith("ss") && name.Length > 1) { return name.Substring(0, name.Length - 1) }
            return name
        }
        // (the entity a column like customerId / customer_id points to: the table whose singular name is its start; undefined: none)
        static Data.SchemaTable Target(List tables, string column) {
            string low = column.ToLower()
            string start = undefined
            if (low.EndsWith("_id") && low.Length > 3) { start = low.Substring(0, low.Length - 3) }
            else if (low.EndsWith("id") && low.Length > 2 && column.Substring(column.Length - 2, 1) == "I") { start = low.Substring(0, low.Length - 2) }
            if (start == undefined) { return undefined }
            string plain = start.Replace("_", "")
            for (var i = 0; i < tables.Count; i++) {
                Data.SchemaTable t = tables[i]
                string single = Data.ModelImporter.Singular(t.name).ToLower().Replace("_", "")
                if (single == plain || t.name.ToLower().Replace("_", "") == plain) { return t }
            }
            return undefined
        }
        static Data.SchemaColumn KeyOf(Data.SchemaTable t) {
            for (var i = 0; i < t.columns.Count; i++) {
                Data.SchemaColumn c = t.columns[i]
                if (c.key) { return c }
            }
            return undefined
        }
        static bool IsJoin(List tables, Data.SchemaTable t) {
            if (t.columns.Count != 2 || Data.ModelImporter.KeyOf(t) != undefined) { return false }
            Data.SchemaColumn a = t.columns[0]
            Data.SchemaColumn b = t.columns[1]
            return Data.ModelImporter.Target(tables, a.name) != undefined && Data.ModelImporter.Target(tables, b.name) != undefined
        }
        static string Json(string s) { return Data.Differ.Text(s) }
        static string Lower(string s) {
            if (s == "") { return s }
            return s.Substring(0, 1).ToLower() + s.Substring(1)
        }
        static string Plural(string s) {
            if (s.EndsWith("y") && s.Length > 1) { return s.Substring(0, s.Length - 1) + "ies" }
            if (s.EndsWith("s") || s.EndsWith("x") || s.EndsWith("ch") || s.EndsWith("sh")) { return s + "es" }
            return s + "s"
        }

        static string Model(Data.Connection db, string ns) {
            List tables = Data.SchemaReader.Read(db)
            if (ns == undefined || ns == "") { ns = "Model" }
            var entities = ""
            var relations = ""
            var shapes = ""
            int placed = 0
            for (var i = 0; i < tables.Count; i++) {
                Data.SchemaTable t = tables[i]
                if (Data.ModelImporter.IsJoin(tables, t)) {
                    // (a join table: a many-to-many relation of the two tables)
                    Data.SchemaColumn a = t.columns[0]
                    Data.SchemaColumn b = t.columns[1]
                    string fromEntity = Data.ModelImporter.EntityName(Data.ModelImporter.Target(tables, a.name).name)
                    string toEntity = Data.ModelImporter.EntityName(Data.ModelImporter.Target(tables, b.name).name)
                    if (relations != "") { relations = relations + ",\n" }
                    relations = relations + "    { \"kind\": \"many-to-many\", \"from\": " + Data.ModelImporter.Json(fromEntity) + ", \"to\": " + Data.ModelImporter.Json(toEntity) +
                        ", \"navigation\": " + Data.ModelImporter.Json(Data.ModelImporter.Lower(Data.ModelImporter.Plural(toEntity))) + ", \"inverse\": " + Data.ModelImporter.Json(Data.ModelImporter.Lower(Data.ModelImporter.Plural(fromEntity))) +
                        ", \"joinTable\": " + Data.ModelImporter.Json(t.name) + ", \"fromColumn\": " + Data.ModelImporter.Json(a.name) + ", \"toColumn\": " + Data.ModelImporter.Json(b.name) + " }"
                    continue
                }
                string entity = Data.ModelImporter.EntityName(t.name)
                var fields = ""
                for (var c = 0; c < t.columns.Count; c++) {
                    Data.SchemaColumn col = t.columns[c]
                    string ft = Data.Importer.FireType(col.type)
                    if (ft == "byte[]") { ft = "bytes" }
                    string field = Data.Importer.Ident(col.name)
                    var f = "{ \"name\": " + Data.ModelImporter.Json(field) + ", \"type\": " + Data.ModelImporter.Json(ft)
                    if (field != col.name) { f = f + ", \"column\": " + Data.ModelImporter.Json(col.name) }
                    if (col.key) {
                        f = f + ", \"key\": true"
                        if (ft != "int") { f = f + ", \"generated\": false" }
                    }
                    else if (!col.nullable) { f = f + ", \"required\": true" }
                    int length = Data.Importer.LengthOf(col.type)
                    if (ft == "string" && length > 0) { f = f + ", \"length\": " + length }
                    for (var x = 0; x < t.indexes.Count; x++) {
                        Data.SchemaIndex ix = t.indexes[x]
                        if (ix.column.ToLower() == col.name.ToLower()) {
                            if (ix.unique) { f = f + ", \"unique\": true" } else { f = f + ", \"index\": true" }
                            break
                        }
                    }
                    if (fields != "") { fields = fields + ",\n" }
                    fields = fields + "        " + f + " }"
                    // (a column that points to another table: a one-to-many relation)
                    Data.SchemaTable target = Data.ModelImporter.Target(tables, col.name)
                    if (!col.key && target != undefined && target.name != t.name && Data.ModelImporter.KeyOf(target) != undefined && !Data.ModelImporter.IsJoin(tables, target)) {
                        string one = Data.ModelImporter.EntityName(target.name)
                        if (relations != "") { relations = relations + ",\n" }
                        relations = relations + "    { \"kind\": \"one-to-many\", \"from\": " + Data.ModelImporter.Json(one) + ", \"to\": " + Data.ModelImporter.Json(entity) +
                            ", \"foreignKey\": " + Data.ModelImporter.Json(field) + ", \"navigation\": " + Data.ModelImporter.Json(Data.ModelImporter.Lower(Data.ModelImporter.Plural(entity))) +
                            ", \"inverse\": " + Data.ModelImporter.Json(Data.ModelImporter.Lower(one)) + " }"
                    }
                }
                if (entities != "") { entities = entities + ",\n" }
                entities = entities + "    { \"name\": " + Data.ModelImporter.Json(entity) + ", \"table\": " + Data.ModelImporter.Json(t.name) + ",\n      \"fields\": [\n" + fields + "\n      ] }"
                if (shapes != "") { shapes = shapes + ", " }
                shapes = shapes + Data.ModelImporter.Json(entity) + ": { \"x\": " + (40 + (placed % 4) * 280) + ", \"y\": " + (40 + (placed / 4) * 260) + " }"
                placed++
            }
            var t2 = "{\n  \"format\": 1,\n  \"namespace\": " + Data.ModelImporter.Json(ns) + ",\n  \"entities\": [\n" + entities + "\n  ],\n  \"relations\": [\n" + relations + "\n  ],\n"
            return t2 + "  \"diagrams\": [ { \"name\": \"Main\", \"shapes\": { " + shapes + " } } ]\n}\n"
        }
    }

    /// <summary>What `forge data` runs in the program (the VM, with the classes and migrations of the project).</summary>
    class Tools {
        static string Run(string command, string url, string user, string password, string arg, string arg2) {
            Data.Credentials credentials = undefined
            if (user != undefined && user != "") { credentials = new Data.Credentials(user, password) }
            var db = new Data.Connection(url, credentials)
            var t = ""
            if (command == "migrate") {
                int ran = 0
                if (arg != undefined && arg != "") {
                    any to = arg.TryToInt()
                    if (to == undefined) { throw new ArgumentException("forge data migrate --to takes the number of a migration, not '" + arg + "'.") }
                    ran = db.MigrateTo(trust to)
                } else { ran = db.Migrate() }
                t = "migrations run: " + ran + ", the database is at " + Data.Migrations.Current(db)
            } else if (command == "status") {
                List done = db.Applied()
                List found = Data.Migrations.Found()
                for (var i = 0; i < found.Count; i++) {
                    Data.MigrationInfo f = found[i]
                    var state = "pending"
                    if (done.IndexOf(f.version) >= 0) { state = "applied" }
                    t = t + f.version + "  " + state + "  " + f.title + "  (" + f.typeName + ")\n"
                }
                for (var i = 0; i < done.Count; i++) {
                    int v = done[i]
                    bool known = false
                    for (var k = 0; k < found.Count; k++) { Data.MigrationInfo f = found[k]; if (f.version == v) { known = true } }
                    if (!known) { t = t + v + "  applied, not in the program\n" }
                }
                if (t == "") { t = "no migrations" }
            } else if (command == "diff") {
                int next = 1
                List found = Data.Migrations.Found()
                if (found.Count > 0) { Data.MigrationInfo last = found[found.Count - 1]; next = last.version + 1 }
                List done = db.Applied()
                if (done.Count > 0) { int top = done[done.Count - 1]; if (top + 1 > next) { next = top + 1 } }
                string title = arg
                if (title == undefined || title == "") { title = "from forge data diff" }
                // (the difference is what comes after the migrations the program has: they must have run on this database)
                var pending = ""
                for (var i = 0; i < found.Count; i++) {
                    Data.MigrationInfo f = found[i]
                    if (done.IndexOf(f.version) < 0) { pending = pending + " " + f.version }
                }
                if (pending != "") { throw new Data.StateException("forge data diff: the migrations" + pending + " have not run on this database - run forge data migrate first (the difference is what comes after them).") }
                t = Data.Differ.Diff(db, next, title)
                if (t == "") { t = "// The database has everything the mapping of the [Table] classes needs.\n" }
            } else if (command == "import") {
                if (arg2 == "fdata") { t = Data.ModelImporter.Model(db, arg) } else { t = Data.Importer.Import(db, arg) }
            } else { throw new ArgumentException("forge data: the commands are migrate, status, diff and import, not '" + command + "'.") }
            db.Close()
            return t
        }
    }

    /// <summary>The SQL that makes the tables of classes in an empty database, in a dialect - no connection needed (`Data.Script.Of(new
    /// Data.MysqlDialect(), Shop.Model.Types())`: what the designer shows for each database).</summary>
    class Script {
        static string Of(Data.Dialect d, any typeNames) {
            var t = ""
            var views = ""
            var made = new List()
            var maps = new Dictionary<string, Data.EntityMap>()
            for (var n = 0; n < typeNames.length; n++) {
                string typeName = "" + typeNames[n]
                var map = Data.Script.MapOf(maps, typeName)
                if (map.view != undefined) {
                    views = views + d.CreateView(d.Quote(map.table), map.view) + ";\n"
                    continue
                }
                t = t + "CREATE TABLE " + d.Quote(map.table) + " " + map.TableBody(d) + d.TableOptions() + ";\n"
                for (var i = 0; i < map.relations.Count; i++) {
                    Data.RelationMap r = map.relations[i]
                    if (!r.join) { continue }
                    map.NeedKey()
                    var target = Data.Script.MapOf(maps, r.target)
                    target.NeedKey()
                    // (the join table once - by the first class that has it -, the index of each side)
                    if (made.IndexOf(r.joinTable.ToLower()) < 0) {
                        made.Add(r.joinTable.ToLower())
                        var a = new Data.ColumnMap(r.thisColumn, r.thisColumn, map.key.typeName, map.key.kind)
                        a.required = true
                        var b = new Data.ColumnMap(r.otherColumn, r.otherColumn, target.key.typeName, target.key.kind)
                        b.required = true
                        t = t + d.CreateTableIfMissing(d.Quote(r.joinTable), "(" + d.ColumnDefinition(a) + ", " + d.ColumnDefinition(b) + ")" + d.TableOptions()) + ";\n"
                    }
                    t = t + "CREATE INDEX " + d.Quote("ix_" + r.joinTable + "_" + r.thisColumn) + " ON " + d.Quote(r.joinTable) + " (" + d.Quote(r.thisColumn) + ");\n"
                }
                for (var i = 0; i < map.columns.Count; i++) {
                    Data.ColumnMap c = map.columns[i]
                    if (!c.unique && !c.index) { continue }
                    var kind = "INDEX"
                    if (c.unique) { kind = "UNIQUE INDEX" }
                    t = t + "CREATE " + kind + " " + d.Quote("ix_" + map.table + "_" + c.column) + " ON " + d.Quote(map.table) + " (" + d.Quote(c.column) + ")" + d.IndexSuffix(d.Quote(c.column), c.unique) + ";\n"
                }
            }
            return t + views
        }
        static Data.EntityMap MapOf(Dictionary<string, Data.EntityMap> maps, string typeName) {
            if (!maps.ContainsKey(typeName)) { maps.Add(typeName, new Data.EntityMap(typeName)) }
            return maps[typeName]
        }
    }
}
