#import "ai"
#import "ai.models"
#import "ai.agent"
#import "mcp"
#import "json"
#import "filesystem"

// The mind of the assistant, without its window (docs/ai/assistant.md): what the bubble says and which choices it offers, the model (asked for before
// it is downloaded), the agent that answers, the connection to spark (MCP) and the tips that need no model.
//
//     var brain = new Assistant.Brain("sparky")
//     brain.Start()                      // says hello, or offers the model
//     while (true) { if (brain.Tick()) { show(brain.Text, brain.Choices) } }
//     brain.Choose(0)                    // a choice was clicked
//     brain.Ask("How do I read a file?")
namespace Assistant {
    // What the assistant is doing.
    enum Phase { Idle, Offer, Downloading, Loading, Thinking, Answering, Failed }

    class Brain {
        Assistant.Character Character
        Assistant.Phase Phase = Assistant.Phase.Idle
        // What the bubble shows, and its choices (texts); Changed says that one of them changed since the last Tick.
        string Text = ""
        List Choices = new List()
        // While the model thinks: what it did so far (the tools it called, a line each) - the thought bubble shows it.
        List Activity = new List()
        defined int thinkingTicks = 0
        List actions = new List()
        bool Visible = true
        // The question line is shown (after a poke: a click on the character, or Ctrl+^ in spark).
        bool Asking = false
        // The program should end (spark, which started it, is gone).
        bool Quit = false
        // End with spark (it started the assistant).
        bool ExitWithSpark = false
        Assistant.Settings Settings
        AI.ModelInstaller installer = undefined
        AI.Agent agent = undefined
        Mcp.Client spark = undefined
        Mcp.HttpTransport sparkTransport = undefined
        string sparkFile = ""
        defined int sparkRetry = 0
        // the documentation, when spark does not offer it
        Assistant.Docs docs = undefined
        string pendingQuestion = ""
        string lastError = ""
        // Tips already given (by their key: one is not given twice).
        List given = new List()
        // The conversation and the folder it works in (saved after each answer), and what git says about the folder.
        Assistant.Session Current
        string Repo = ""
        string Branch = ""
        // A change that waits for the user's "Allow" (undefined: none); the question line takes a commit message next (the menu's Commit).
        Assistant.PendingAction Pending = undefined
        bool WantsCommitMessage = false

        construct(string characterId = "") {
            this.Settings = Assistant.Settings.Load()
            if (characterId != "") { this.Settings.Character = characterId }
            this.Character = Assistant.Character.Find(this.Settings.Character)
            // the session it was in last; else a new one in the folder it was started in
            any last = Assistant.Session.Load(this.Settings.Session)
            if (last != undefined) { this.Current = take last }
            else { this.Current = Assistant.Session.New(IO.Directory.GetCurrentDirectory()) }
            this.Settings.Session = this.Current.Id
            this.LookAtFolder()
        }

        // ---- the session and its folder ----

        // The folder the assistant works in (the session's).
        string Folder { get { return this.Current.Folder } }

        // What git says about the folder (its repository and branch) - again after a change of the folder, and now and then (a checkout elsewhere).
        undefined LookAtFolder() {
            this.Repo = Assistant.GitInfo.RootOf(this.Current.Folder)
            this.Branch = Assistant.GitInfo.BranchOf(this.Repo)
        }

        // The conversation goes into the session's file (after each answer).
        undefined KeepSession() {
            if (this.agent != undefined) { this.Current.Keep(this.agent) }
            this.Current.Save()
            this.Settings.Session = this.Current.Id
            this.Settings.Save()
        }

        // The agent takes the conversation of the session (a session that goes on, or another one).
        undefined ReplaySession() {
            if (this.agent == undefined) { return }
            this.agent.Forget()
            foreach (x in this.Current.Messages) {
                Assistant.Message m = x
                this.agent.Remember(m.Role, m.Text)
            }
        }

        // Goes on with the session `id` (the current one is kept first).
        undefined SwitchSession(string id) {
            if (id == this.Current.Id) { return }
            any other = Assistant.Session.Load(id)
            if (other == undefined) { return }
            this.KeepSession()
            this.Current = take other
            this.Settings.Session = this.Current.Id
            this.Settings.Save()
            this.LookAtFolder()
            this.ReplaySession()
            this.Say(this.Current.Title == "New session" ? "A new session. What would you like to know?" : "Back in \"" + this.Current.Title + "\".")
            this.Asking = true
        }

        // A new session in the folder of the current one (or in `folder`).
        undefined NewSession(string folder = "") {
            this.KeepSession()
            this.Current = Assistant.Session.New(folder == "" ? this.Current.Folder : folder)
            this.Current.Save()
            this.Settings.Session = this.Current.Id
            this.Settings.Save()
            this.LookAtFolder()
            if (this.agent != undefined) { this.agent.Forget() }
            this.Say("A new session. What would you like to know?")
            this.Asking = true
        }

        // The session works in `folder` from now on (the user agreed).
        undefined SetFolder(string folder) {
            this.Current.Folder = folder
            this.Current.Save()
            this.LookAtFolder()
            if (this.agent != undefined) { this.agent.Instructions = this.Instructions() }
        }

        destruct() { this.Close() }

        undefined Close() {
            if (this.installer != undefined) { this.installer.Close() }
            if (this.agent != undefined) {
                this.agent.Close()
                this.agent = undefined
            }
            if (this.spark != undefined) {
                try { this.spark.Close() } catch (Exception e) { }
                this.spark = undefined
            }
        }

        // ---- the bubble ----

        undefined Say(string text) {
            this.Asking = false
            this.Text = text
            this.Choices.Clear()
            this.actions.Clear()
            this.Visible = true
        }

        undefined Offer(string text, string action) {
            this.Choices.Add(text)
            this.actions.Add(action)
        }

        // The mood of the character for what it does.
        Assistant.Mood Mood() {
            if (this.Phase == Assistant.Phase.Thinking || this.Phase == Assistant.Phase.Loading || this.Phase == Assistant.Phase.Downloading) { return Assistant.Mood.Think }
            if (this.Phase == Assistant.Phase.Answering) { return Assistant.Mood.Talk }
            if (!this.Visible) { return Assistant.Mood.Sleep }
            return Assistant.Mood.Idle
        }

        // Whether a model can answer now.
        bool Ready { get { return this.agent != undefined } }

        // ---- the start ----

        // Says hello; without a model it offers the one that fits this machine (nothing is downloaded before the user says so).
        undefined Start() {
            bool first = !this.Settings.Existed
            if (first) { this.Settings.Save() }
            string path = AI.Models.Pick(this.Settings.Model)
            if (path != "") { this.Load(path) }
            if (first) { this.Say(this.Character.Hello + "\n\nJust poke me when you have a question: a click on me, or Ctrl+^ in spark.") }
            else {
                // quiet: only the character, until it is poked
                this.Say("")
                this.Visible = false
            }
        }

        // The user poked the character (a click, Ctrl+^): the question line opens - or, without a model, the offer of one. A second poke hides the bubble.
        undefined Poke() {
            if (this.Visible && this.Asking) {
                this.Visible = false
                this.Asking = false
                return
            }
            if (this.Phase == Assistant.Phase.Downloading || this.Phase == Assistant.Phase.Thinking || this.Phase == Assistant.Phase.Answering) {
                this.Visible = true
                return
            }
            if (this.agent == undefined && this.Phase != Assistant.Phase.Loading) {
                this.OfferModel()
                this.Asking = true
                return
            }
            if (this.Text == "" || this.Choices.Count > 0) { this.Say(this.Character.Name + " here - what would you like to know?") }
            this.Choices.Clear()
            this.actions.Clear()
            this.Visible = true
            this.Asking = true
        }

        undefined OfferModel() {
            AI.ModelInfo m = AI.Models.Recommended()
            this.Phase = Assistant.Phase.Offer
            this.Say(this.Character.Hello + "\n\nTo answer questions I need a small AI model on this computer (nothing leaves it): " +
                m.Name + ", " + m.SizeText() + ", " + m.License + ", once from Hugging Face.")
            this.Offer("Download (" + m.SizeText() + ")", "download:" + m.Id)
            any strong = AI.Models.Stronger()
            if (strong != undefined) {
                AI.ModelInfo s = strong
                this.Offer("Larger: " + s.Name + " (" + s.SizeText() + ")", "license:" + s.Id)
            }
            this.Offer("Not now", "later")
        }

        // ---- choices ----

        // A choice of the bubble was clicked.
        undefined Choose(defined int index) {
            if (index < 0 || index >= this.actions.Count) { return }
            string action = this.actions[index]
            this.Do(action)
        }

        undefined Do(string action) {
            int colon = action.IndexOf(":")
            string verb = action
            string arg = ""
            if (colon >= 0) {
                verb = action.Substring(0, colon)
                arg = action.Substring(colon + 1)
            }
            if (verb == "download") { this.Download(arg) }
            else if (verb == "license") {
                AI.ModelInfo m = AI.Models.Find(arg)
                this.Say(m.Name + " is under the " + m.License + ". Details: " + m.LicenseUrl)
                this.Offer("Agree, download", "download:" + m.Id)
                this.Offer("Back", "offer")
            }
            else if (verb == "offer") { this.OfferModel() }
            else if (verb == "later") {
                this.Phase = Assistant.Phase.Idle
                this.Say("All right. I can still give tips; switch me on again with a click on me.")
                this.Visible = false
            }
            else if (verb == "cancel") {
                if (this.installer != undefined) {
                    this.installer.Close()
                    this.installer = undefined
                }
                this.Phase = Assistant.Phase.Idle
                this.Say("Stopped. What came so far is kept: the next download goes on from there.")
                this.Offer("Go on", "offer")
            }
            else if (verb == "ask") { this.Ask(arg) }
            else if (verb == "allow") { this.Decide(true) }
            else if (verb == "deny") { this.Decide(false) }
            else if (verb == "explain") { this.ExplainErrors() }
            else if (verb == "close") { this.Visible = false }
            else if (verb == "stop") {
                if (this.agent != undefined) { this.agent.Cancel() }
                this.Phase = Assistant.Phase.Idle
            }
        }

        undefined Download(string id) {
            AI.ModelInfo m = AI.Models.Find(id)
            this.installer = new AI.ModelInstaller(m)
            this.Phase = Assistant.Phase.Downloading
            this.Say("Downloading " + m.Name + "...")
            this.Offer("Stop", "cancel")
            this.Settings.Model = m.Id
            this.Settings.Save()
        }

        // ---- the model ----

        undefined Load(string path) {
            this.Phase = Assistant.Phase.Loading
            try {
                this.agent = new AI.Agent(path, this.Instructions())
                this.agent.MaxSteps = 4
                this.agent.OnToolCall = func (string name, JsonObject args) on this => ToolCalled(name, args)
                this.agent.Settings.MaxTokens = 400
                this.agent.Settings.Temperature = 0.3
                this.ConnectTools()
                this.ReplaySession()
                this.Phase = Assistant.Phase.Idle
                if (this.pendingQuestion != "") {
                    string q = this.pendingQuestion
                    this.pendingQuestion = ""
                    this.Ask(q)
                }
            }
            catch (Exception e) {
                this.agent = undefined
                this.Phase = Assistant.Phase.Failed
                this.Say("I could not load the model: " + e.message)
            }
        }

        // What the model is told: who it is, what fire looks like (a small model guesses another language otherwise) and how to find out more.
        string Instructions() {
            return this.Character.Voice + " You are the assistant in spark, the editor of the programming language fire. Answer in a few sentences, " +
                "in the language of the question. fire is a new language you do not know well: look things up with search_docs and read_doc (or a sample) " +
                "before you write fire code, and only use what the documentation shows. To look at files use list_files and read_file; to change files, " +
                "run commands, use git or work in another folder use write_file, run_command, git and change_folder - the user is asked first.\n\nYou work in the folder " + this.Current.Folder +
                (this.Branch != "" ? " (a git repository, branch " + this.Branch + ")" : "") + ".\n\n" + Assistant.Brain.CheatSheet()
        }

        // The basics of fire, short enough for a small context.
        static string CheatSheet() {
            return "fire in short:\n" +
                "- no semicolons; comments with //; print(\"a \" + x)\n" +
                "- variables: var x = 5, int n = 3, string s = \"text\", float f = 1.5, bool b = true\n" +
                "- if (a > b) { ... } else { ... }; while (c) { ... }; for (var i = 0; i < 10; i++) { ... }; foreach (item in list) { ... }\n" +
                "- functions: int Add(int a, int b) { return a + b }\n" +
                "- classes: class Point { int X\n  construct(int x) { this.X = x } } - fields always with this.; new Point(3)\n" +
                "- lists: var list = new List(); list.Add(1); list.Count; list[0]; arrays: int a[] = new int[10]; a.length\n" +
                "- lambdas: func (int x) => x * 2\n" +
                "- packages: #import \"filesystem\" (IO.File.ReadAllText, ReadAllLines, WriteAllText), #import \"json\", #import \"http\", #import \"ui\"\n" +
                "- strings: s.Length, s.Substring(a, n), s.IndexOf(t), s.Split(\",\"), s.Trim(), s.ToUpper()"
        }

        // The tools of spark the model may use (reading and looking up; it changes nothing by itself).
        undefined ConnectTools() {
            if (this.agent == undefined) { return }
            this.ActionTools()
            if (this.spark == undefined) {
                this.LocalTools()
                return
            }
            Mcp.Client client = this.spark
            foreach (t in client.Tools()) {
                Mcp.Tool tool = t
                string name = tool.Name
                if (Assistant.Brain.Allowed(name)) {
                    this.agent.ToolWithSchema(name, tool.Description, tool.Schema, func (JsonObject args) on client => CallTool((taking name), args).Text)
                }
            }
        }

        // Without spark: the documentation of fire from its folder (Assistant.Docs.Find) - the same two tools spark offers.
        undefined LocalTools() {
            if (this.docs == undefined) { this.docs = new Assistant.Docs(Assistant.Docs.Find()) }
            if (this.docs.Root == "") { return }
            Assistant.Docs d = this.docs
            this.agent.ToolWithSchema("search_docs", "Searches the documentation of fire (the language, the libraries, the tools) for the words of a question; " +
                "the sections that fit best, each with its file and heading - read one with read_doc.",
                "{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"the words to look for, e.g. 'list sort'\"}},\"required\":[\"query\"]}",
                func (JsonObject args) on d => Search(Assistant.Brain.Arg(args, "query")))
            this.agent.ToolWithSchema("read_doc", "Reads one section of a page of the documentation (the path and heading that search_docs named). " +
                "Without a heading: the headings of the page.",
                "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"the file, e.g. 'language/07-arrays-and-lists.md'\"}," +
                "\"heading\":{\"type\":\"string\",\"description\":\"a heading of the file\"}},\"required\":[\"path\"]}",
                func (JsonObject args) on d => Read(Assistant.Brain.Arg(args, "path"), Assistant.Brain.Arg(args, "heading")))
        }

        // The tools that work in the folder: reading and listing at once; writing, commands, git that changes things and another folder after the user
        // agreed (the tool says so; the user's answer comes as the next message).
        undefined ActionTools() {
            this.agent.ToolWithSchema("list_files", "Lists the files and folders in a folder of the working folder.",
                "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"a folder relative to the working folder; '.' for itself\"}}}",
                func (JsonObject args) on this => ToolList(args))
            this.agent.ToolWithSchema("read_file", "Reads a text file of the working folder.",
                "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"the file, relative to the working folder\"}},\"required\":[\"path\"]}",
                func (JsonObject args) on this => ToolRead(args))
            this.agent.ToolWithSchema("write_file", "Writes a text file in the working folder (the whole content). The user is asked first.",
                "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}},\"required\":[\"path\",\"content\"]}",
                func (JsonObject args) on this => ToolWrite(args))
            this.agent.ToolWithSchema("run_command", "Runs a command line in the working folder (the shell of the system). The user is asked first.",
                "{\"type\":\"object\",\"properties\":{\"command\":{\"type\":\"string\"}},\"required\":[\"command\"]}",
                func (JsonObject args) on this => ToolCommand(args))
            this.agent.ToolWithSchema("git", "Runs git in the working folder, e.g. 'status', 'log --oneline -5', 'diff', 'commit -m \\\"text\\\"'. Reading runs at once; " +
                "what changes the repository is asked first.",
                "{\"type\":\"object\",\"properties\":{\"args\":{\"type\":\"string\",\"description\":\"the arguments of git\"}},\"required\":[\"args\"]}",
                func (JsonObject args) on this => ToolGit(args))
            this.agent.ToolWithSchema("change_folder", "Works in another folder from now on. The user is asked first.",
                "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"the full path of the folder\"}},\"required\":[\"path\"]}",
                func (JsonObject args) on this => ToolFolder(args))
        }

        string ToolList(JsonObject args) { return new Assistant.Actions(this.Current.Folder).List(Assistant.Brain.Arg(args, "path")) }
        string ToolRead(JsonObject args) { return new Assistant.Actions(this.Current.Folder).Read(Assistant.Brain.Arg(args, "path")) }

        // A change the model asks for: it waits for the user; the model hears that it was asked.
        string AskFirst(Assistant.PendingAction action) {
            if (this.Pending != undefined) { return "Another change is waiting for the user's answer: wait for it." }
            action.FromModel = true
            this.Pending = take action
            return "The user was asked to allow it; their answer comes as the next message. Do not call the tool again now."
        }

        string ToolWrite(JsonObject args) {
            string path = Assistant.Brain.Arg(args, "path")
            string content = Assistant.Brain.Arg(args, "content")
            if (new Assistant.Actions(this.Current.Folder).Resolve(path) == "") { return "Error: " + path + " is outside the working folder." }
            var a = new Assistant.PendingAction()
            a.Kind = "write"
            a.Path = path
            a.Content = content
            a.Question = "Write " + new Assistant.Actions(this.Current.Folder).Show(path) + " (" + content.Split("\n").length + " lines)?"
            return this.AskFirst(take a)
        }

        string ToolCommand(JsonObject args) {
            var a = new Assistant.PendingAction()
            a.Kind = "command"
            a.Content = Assistant.Brain.Arg(args, "command")
            a.Question = "Run: " + a.Content + "?"
            return this.AskFirst(take a)
        }

        string ToolGit(JsonObject args) {
            List<string> words = Assistant.Actions.Words(Assistant.Brain.Arg(args, "args"))
            if (words.Count > 0 && words[0] == "git") { words.RemoveAt(0) }
            if (words.Count == 0) { return "Error: which git command?" }
            if (!Assistant.Actions.HasGit()) {
                this.OfferGit()
                return "git is not installed; the user was offered to install it."
            }
            if (Assistant.Actions.ReadsOnly(words[0])) { return new Assistant.Actions(this.Current.Folder).Git(words) }
            var a = new Assistant.PendingAction()
            a.Kind = "git"
            a.Args = take words
            a.Question = "git " + Assistant.Brain.Arg(args, "args") + "?"
            return this.AskFirst(take a)
        }

        string ToolFolder(JsonObject args) {
            string path = Assistant.Brain.Arg(args, "path")
            if (!IO.Directory.Exists(path)) { return "Error: there is no folder " + path + "." }
            var a = new Assistant.PendingAction()
            a.Kind = "folder"
            a.Path = path
            a.Question = "Work in " + path + " from now on?"
            return this.AskFirst(take a)
        }

        // git is missing: the bubble says how to get it (on Windows it offers to install it with winget).
        undefined OfferGit() {
            if (this.Pending != undefined) { return }
            var a = new Assistant.PendingAction()
            a.Kind = "installgit"
            a.Content = Assistant.Actions.GitInstallCommand()
            a.Question = Assistant.Actions.HowToInstallGit()
            this.Pending = take a
        }

        // A git operation of the menu: reading ones at once, the others after "Allow" (commit: the question line takes the message first).
        undefined GitMenu(string what) {
            if (!Assistant.Actions.HasGit()) {
                this.OfferGit()
                this.ShowPending("")
                return
            }
            if (this.Repo == "" && what != "init") {
                this.Say("This folder is no git repository: " + this.Current.Folder)
                return
            }
            if (what == "status") { this.Say(new Assistant.Actions(this.Current.Folder).Git(Assistant.Actions.Words("status --short --branch"))) }
            else if (what == "log") { this.Say(new Assistant.Actions(this.Current.Folder).Git(Assistant.Actions.Words("log --oneline -10"))) }
            else if (what == "commit") {
                this.Say("The message of the commit (all changes are committed):")
                this.WantsCommitMessage = true
                this.Asking = true
            }
            else {
                var a = new Assistant.PendingAction()
                a.Kind = "git"
                a.Args = take Assistant.Actions.Words(what)
                a.Question = "git " + what + "?"
                this.Pending = take a
                this.ShowPending("")
            }
            this.LookAtFolder()
        }

        // The commit message from the question line: git add -A and commit, after "Allow".
        undefined CommitWith(string message) {
            this.WantsCommitMessage = false
            var a = new Assistant.PendingAction()
            a.Kind = "commit"
            a.Content = message
            a.Question = "Commit all changes as \"" + message + "\"?"
            this.Pending = take a
            this.ShowPending("")
        }

        // The bubble asks for the pending change (after `before`, what the model said).
        undefined ShowPending(string before) {
            if (this.Pending == undefined) { return }
            Assistant.PendingAction a = this.Pending
            this.Say((before.Trim() != "" ? before.Trim() + "\n\n" : "") + a.Question)
            if (a.Kind == "installgit") {
                if (a.Content != "") { this.Offer("Install git", "allow") }
                this.Offer("Not now", "deny")
                return
            }
            this.Offer("Allow", "allow")
            this.Offer("Don't", "deny")
        }

        // The user's answer to the pending change.
        undefined Decide(bool allowed) {
            if (this.Pending == undefined) { return }
            Assistant.PendingAction a = this.Pending
            string result = "Not done."
            if (allowed) {
                var act = new Assistant.Actions(this.Current.Folder)
                if (a.Kind == "write") { result = act.Write(a.Path, a.Content) }
                else if (a.Kind == "command") { result = act.Command(a.Content) }
                else if (a.Kind == "git") { result = act.Git(a.Args) }
                else if (a.Kind == "commit") {
                    string added = act.Git(Assistant.Actions.Words("add -A"))
                    var c = new List<string>()
                    c.Add("commit")
                    c.Add("-m")
                    c.Add(a.Content)
                    result = act.Git(c)
                }
                else if (a.Kind == "folder") {
                    this.SetFolder(a.Path)
                    result = "Now working in " + a.Path + "."
                }
                else if (a.Kind == "installgit") {
                    result = act.Command(a.Content)
                    result = (Assistant.Actions.HasGit() ? "git is installed now." : "git could not be installed:") + "\n" + result
                }
                this.LookAtFolder()
            }
            bool fromModel = a.FromModel
            string question = a.Question
            this.Pending = undefined
            if (fromModel && this.agent != undefined) {
                this.agent.Remember("user", (allowed ? "I allowed: " : "I did not allow: ") + question + "\nResult: " + result)
                this.KeepSession()
            }
            this.Say(result)
            this.Asking = true
        }

        static string Arg(JsonObject args, string name) {
            any v = args.Get(name)
            if (v == undefined) { return "" }
            return "" + v
        }

        static bool Allowed(string name) {
            return name == "search_docs" || name == "read_doc" || name == "list_samples" || name == "list_sample_files" || name == "read_sample_file" ||
                name == "get_selection" || name == "get_diagnostics" || name == "spark_state"
        }

        // ---- asking ----

        // A question of the user: the model answers in the bubble (the conversation is kept, but not shown).
        undefined Ask(string question) {
            if (question.Trim() == "") { return }
            if (this.WantsCommitMessage) {
                this.CommitWith(question.Trim())
                return
            }
            if (this.agent == undefined) {
                if (this.Phase == Assistant.Phase.Downloading || this.Phase == Assistant.Phase.Loading) {
                    this.pendingQuestion = question
                    return
                }
                string tip = Assistant.Tips.Answer(question)
                if (tip != "") {
                    this.Say(tip)
                    return
                }
                this.OfferModel()
                return
            }
            this.agent.Start(question)
            this.Phase = Assistant.Phase.Thinking
            this.Activity.Clear()
            this.thinkingTicks = 0
            this.Say(this.ThinkingText())
            this.Offer("Stop", "stop")
        }

        // A tool the model calls: a short line for the thought bubble ("Searching the docs: list sort").
        undefined ToolCalled(string name, JsonObject args) {
            string what = name
            string detail = Assistant.Brain.Arg(args, "query")
            if (detail == "") { detail = Assistant.Brain.Arg(args, "path") }
            if (detail == "") { detail = Assistant.Brain.Arg(args, "command") }
            if (name == "search_docs") { what = "Searching the docs" }
            else if (name == "read_doc") { what = "Reading" }
            else if (name == "read_file") { what = "Reading" }
            else if (name == "list_files") { what = "Looking around" }
            else if (name == "write_file") { what = "Writing" }
            else if (name == "run_command") { what = "Running" }
            else if (name == "change_folder") { what = "Moving to" }
            if (name == "git") { detail = Assistant.Brain.Arg(args, "args") }
            // (a path: its file name)
            if (detail.IndexOf("/") >= 0 || detail.IndexOf("\\") >= 0) { detail = IO.Path.GetFileName(detail.TrimEnd()) }
            if (detail.Length > 40) { detail = detail.Substring(0, 37) + "..." }
            this.Activity.Add(detail == "" ? what : what + ": " + detail)
        }

        // The text of the thought bubble: thinking (with dots that move) and what the model did so far.
        string ThinkingText() {
            string dots = "."
            defined int n = (this.thinkingTicks / 20) % 3
            if (n >= 1) { dots = ".." }
            if (n >= 2) { dots = "..." }
            string text = "Thinking" + dots
            defined int first = this.Activity.Count > 6 ? this.Activity.Count - 6 : 0
            for (int i = first; i < this.Activity.Count; i++) { text += "\n- " + this.Activity[i] }
            return text
        }

        // Forgets the conversation ("new topic").
        undefined Forget() {
            if (this.agent != undefined) { this.agent.Forget() }
        }

        // The conversation so far (role: text per line) - shown only when the user asks for it.
        string History() {
            if (this.agent == undefined) { return "" }
            string text = ""
            for (int i = 0; i < this.agent.HistoryCount; i++) {
                text += (this.agent.HistoryRole(i) == "user" ? "You: " : this.Character.Name + ": ") + this.agent.HistoryText(i) + "\n\n"
            }
            return text.Trim()
        }

        // ---- spark ----

        // Connects to spark's MCP server (its connection file, docs/tools/spark-mcp.md); false when spark does not offer it.
        bool ConnectSpark(string file = "") {
            if (file == "") { file = IO.Path.Combine(AI.Models.DataFolder(), "fire", "spark-mcp.json") }
            this.sparkFile = file
            if (!IO.File.Exists(file)) { return false }
            try {
                any conn = Json.Parse(IO.File.ReadAllText(file))
                this.sparkTransport = new Mcp.HttpTransport(conn.Get("url"))
                this.sparkTransport.Headers.Set("Authorization", "Bearer " + conn.Get("token"))
                this.spark = new Mcp.Client(this.sparkTransport)
                this.spark.Initialize("fire-assistant", "1.0")
                this.spark.Subscribe("spark://state")
                this.sparkTransport.Listen()
                this.ConnectTools()
                return true
            }
            catch (Exception e) {
                this.lastError = e.message
                this.spark = undefined
                return false
            }
        }

        bool Connected { get { return this.spark != undefined } }

        // What spark reported (a build, a run): a tip when something went wrong.
        undefined SparkEvents() {
            if (this.spark == undefined) { return }
            List notes = undefined
            try { notes = this.spark.Notifications() }
            catch (Exception e) {
                // spark went away
                this.spark = undefined
                if (this.ExitWithSpark) { this.Quit = true }
                return
            }
            foreach (n in notes) {
                Mcp.Notification note = n
                if (note.Method == "notifications/message") {
                    any p = Json.Parse(note.Params)
                    any data = p.Get("data")
                    if (data != undefined && data is of JsonObject) { this.OnSparkEvent(data) }
                }
            }
        }

        undefined OnSparkEvent(JsonObject data) {
            any ev = data.Get("event")
            if (ev == "poke") {
                this.Poke()
                return
            }
            if (ev == "closing" && this.ExitWithSpark) {
                this.Quit = true
                return
            }
            if (ev == "build") {
                any ok = data.Get("ok")
                any errors = data.Get("errors")
                if (ok == false && errors != undefined && errors > 0) {
                    if (this.Phase == Assistant.Phase.Thinking || this.Phase == Assistant.Phase.Answering) { return }
                    this.Say(errors == 1 ? "The build has an error." : "The build has " + errors + " errors.")
                    if (this.agent != undefined) { this.Offer("Explain it", "explain") }
                    this.Offer("Not now", "close")
                }
            }
        }

        // The model explains the errors of the build (it reads them with get_diagnostics).
        undefined ExplainErrors() {
            string list = ""
            if (this.spark != undefined) {
                try { list = this.spark.CallTool("get_diagnostics").Text } catch (Exception e) { }
            }
            if (list.Length > 1500) { list = list.Substring(0, 1500) }
            this.Ask("Explain the first error of my build and how to fix it:\n" + list)
        }

        // ---- the cycle ----

        // Does a piece of the work (download, the model's answer, spark's events); true when the bubble changed.
        bool Tick() {
            string before = this.Text
            int choices = this.Choices.Count
            if (this.Phase == Assistant.Phase.Downloading && this.installer != undefined) {
                bool more = this.installer.Step()
                AI.ModelInfo m = this.installer.Model
                if (more) {
                    string what = this.installer.State == AI.InstallState.Checking ? "Checking " : "Downloading "
                    this.Text = what + m.Name + "... " + this.installer.Percent() + "% (" + (this.installer.Received() / 1000000) + " of " + m.SizeText() + ")"
                }
                else {
                    if (this.installer.Ok()) {
                        string path = m.Path()
                        this.installer = undefined
                        this.Say("Done! Loading the model...")
                        this.Load(path)
                        if (this.Phase == Assistant.Phase.Idle && this.agent != undefined && this.Text.StartsWith("Done!")) {
                            this.Say("Ready. Ask me anything about fire.")
                        }
                    }
                    else {
                        this.Phase = Assistant.Phase.Failed
                        this.Say("The download failed: " + this.installer.Error)
                        this.installer = undefined
                        this.Offer("Try again", "offer")
                        this.Offer("Not now", "later")
                    }
                }
            }
            // the model asked for a change: its turn ends here (a small model would ask again and again), the bubble asks the user
            if ((this.Phase == Assistant.Phase.Thinking || this.Phase == Assistant.Phase.Answering) && this.agent != undefined && this.Pending != undefined) {
                Assistant.PendingAction p = this.Pending
                if (p.FromModel) {
                    this.agent.Cancel()
                    if (this.Phase == Assistant.Phase.Thinking) { this.Text = "" }
                    this.Phase = Assistant.Phase.Idle
                    this.KeepSession()
                    this.ShowPending(this.Text)
                }
            }
            if ((this.Phase == Assistant.Phase.Thinking || this.Phase == Assistant.Phase.Answering) && this.agent != undefined) {
                try {
                    string part = this.agent.Update()
                    if (part != "") {
                        // (the first words of the answer: the thought bubble becomes a speech bubble)
                        if (this.Phase == Assistant.Phase.Thinking) { this.Text = "" }
                        this.Phase = Assistant.Phase.Answering
                        this.Text = this.Text + part
                    } else if (this.Phase == Assistant.Phase.Thinking) {
                        this.thinkingTicks++
                        this.Text = this.ThinkingText()
                    }
                    if (!this.agent.Running) {
                        if (this.Phase == Assistant.Phase.Thinking) { this.Text = "" }
                        this.Phase = Assistant.Phase.Idle
                        this.Choices.Clear()
                        this.actions.Clear()
                        if (this.Text.Trim() == "" && this.Pending == undefined) { this.Text = "Hmm, I have no answer to that." }
                        this.KeepSession()
                        if (this.Pending != undefined) { this.ShowPending(this.Text) }
                        // a follow-up question can come right away
                        this.Asking = true
                    }
                }
                catch (Exception e) {
                    this.Phase = Assistant.Phase.Failed
                    this.Say("Something went wrong: " + e.message)
                }
            }
            this.SparkEvents()
            return this.Text != before || this.Choices.Count != choices
        }
    }
}
