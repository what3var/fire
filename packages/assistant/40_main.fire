namespace Assistant {
    class App {
        // The assistant as a program: connects to spark when it runs (its MCP server), says hello or offers the model, and shows its window.
        // `character`: sparky, flint or wick ("" for the last one chosen).
        static undefined Run(string character = "") {
            var brain = new Assistant.Brain(character)
            brain.ConnectSpark()
            brain.Start()
            var view = new Assistant.View(brain)
            view.Run()
        }
    }
}
