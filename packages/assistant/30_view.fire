#import "ui"
#import "dialogs"
#import "time"

// The window of the assistant: the character at the bottom, the bubble above it. The bubble has small buttons at its top right (history, new topic,
// another character, close), the text (as high as there is room), up to four choices, and - after a poke - the question line. The window is transparent
// where the desktop allows it: only the character and its bubble are seen.
//
//     var view = new Assistant.View(new Assistant.Brain())
//     view.Run()
namespace Assistant {
    class View {
        Assistant.Brain Brain
        Framebuffer fb
        Window win
        UI.Root UIRoot
        UI.DrawingCanvas figure
        // while the model thinks: a small flickering flame (black and white) left of "Thinking"
        UI.DrawingCanvas flame
        UI.DrawingCanvas bubble
        UI.TextArea text
        UI.StackPanel choices
        UI.TextBox question
        UI.Button historyButton
        UI.Button sessionsButton
        // the header: the folder the assistant works in, and the branch when it is a git repository
        UI.Label folderLabel
        UI.Label branchLabel
        defined int headerH = 30
        // the pictures of the header (16 x 16, white): folder and branch - as loaded, and tinted in the colour of text on the accent
        // (UIRoot.AccentForeground; headerTint: the 0xRRGGBB they were tinted with, -1: not yet)
        Framebuffer folderWhite
        Framebuffer branchWhite
        Framebuffer folderIcon
        Framebuffer branchIcon
        defined int headerTint = -1
        // the accent and dark/light the bubble was last painted for (FollowLook)
        defined int lookAccent = -1
        bool lookDark = false
        // a session chosen in the popup ("new": a new one), taken in the next cycle
        string pickedSession = ""
        // a row of the context menu that was chosen ("history", "folder", "git:status", "character:flint", "quit"), taken in the next cycle
        string pickedMenu = ""
        List menuRows
        // a menu is open: the window has room for it above the character (and is laid out again when it closes)
        bool menuOpen = false
        UI.Button closeButton
        // the animations go by the clock (milliseconds since the start): `frame` counts 60 a second whatever the cycles are - the character is painted
        // again only when its next picture is due (30 a second while it thinks or talks, fewer while it waits or sleeps), and while nothing happens the
        // view rests between the cycles (see Rest)
        defined int frame = 0
        defined int cycles = 0
        defined int startMs = 0
        defined int nowMs = 0
        defined int nextFigure = 0
        defined int nextFlame = 0
        // the events of the window seen last (UIRoot.Events), and until when the view cycles at full speed after one (or after a change of the brain)
        defined int seenEvents = 0
        defined int activeUntil = 0
        // FIRE_ASSISTANT_FPS=1: once a second the cycles, the pictures of the character and where the time of a cycle went (stdout)
        bool fpsLog = false
        defined int fpsSince = 0
        defined int fpsCycles = 0
        defined int fpsFigures = 0
        defined int fpsTickUs = 0
        defined int fpsRestUs = 0
        defined int fpsOutsideUs = 0
        defined int fpsLeft = 0
        // a press on the character: a click pokes it, a drag moves the window
        bool pressed = false
        defined int pressX = 0
        defined int pressY = 0
        bool placed = false
        bool showHistory = false
        // a choice that was clicked: taken in the next cycle (its button goes when the choices are made anew - not while it handles its own click)
        defined int picked = -1
        string shown = ""
        // the window, the bubble in it (as high as what it shows, between MinBH and MaxBH; 0 while it is closed), the character below it
        defined int W = 240
        defined int BH = 250
        defined int FH = 120
        defined int H = 370
        defined int MinBH = 110
        defined int MaxBH = 480
        // where the bubble starts (the window is as high as the largest bubble and the character: the bubble moves, the window stays)
        defined int O = 0

        construct(Assistant.Brain brain) {
            this.Brain = take brain
            this.H = this.MaxBH + this.FH
            this.O = this.MaxBH - this.BH
            this.fb = new Framebuffer(this.W, this.H)
            this.win = new Window(this.fb, this.Brain.Character.Name)
            // no frame, above the other windows: only the character and its bubble are seen
            this.win.Frameless = true
            this.win.TopMost = true
            this.win.ShowInTaskbar = false   // (a helper, not a program of its own)
            this.win.ClickThrough = true     // (clicks next to the bubble and the character reach the windows below)
            this.PaintIcon()
            this.UIRoot = new UI.Root(this.fb, this.win)
            this.UIRoot.WindowBackdrop = Backdrop.Transparent
            this.UIRoot.WindowBackground = new SolidBrush(UI.Color.Transparent())   // (nothing behind the bubble and the character)
            // double clicks, tooltips and the caret count real milliseconds (the cycles are fewer while the view rests)
            this.startMs = Assistant.Brain.Clock()
            this.UIRoot.clock = func () => { return Assistant.Brain.Clock() }
            any fps = Environment.Get("FIRE_ASSISTANT_FPS")
            this.fpsLog = fps != undefined && fps != "" && fps != "0"
            this.Build()
        }

        // The character as the window's picture (Alt+Tab, where the desktop shows one).
        undefined PaintIcon() {
            var fb = new Framebuffer(64, 64)
            var r = new Renderer(fb)
            r.ClearTo(UI.Color.Transparent())
            this.Brain.Character.Paint(r, 0.0, 0.0, 64.0, 64.0, 0, Assistant.Mood.Idle)
            this.win.SetIcon(fb)
        }

        static UI.Button Small(UI.Geometry icon, defined int x, defined int y) {
            var b = new UI.Button("", x, y, 22, 22)
            b.Icon = icon
            b.IconSize = 12
            return b
        }

        undefined Build() {
            // the bubble: a rounded box with a tail towards the character (behind everything)
            this.bubble = new UI.DrawingCanvas(0, 0, this.W, this.H)
            this.bubble.blendMode = 2
            this.bubble.OnPaint = func (UI.DrawingCanvas c) on this => PaintBubble(c)
            this.UIRoot.Add(this.bubble)
            // the header: folder and branch, the small buttons at the right (history, sessions, close)
            this.folderLabel = new UI.Label("", 34, 15)
            this.folderLabel.FontSize = 13
            this.UIRoot.Add(this.folderLabel)
            this.branchLabel = new UI.Label("", 34, 35)
            this.branchLabel.FontSize = 13
            // the branch in bold (the bold file of the theme's font, where there is one)
            string bold = this.UIRoot.theme.font + " Bold"
            if (this.UIRoot.theme.font != "" && Fonts.Has(bold)) { this.branchLabel.Font = bold }
            this.folderWhite = Framebuffer.FromResource(new Resource("icons/folder16.png"))
            this.branchWhite = Framebuffer.FromResource(new Resource("icons/branch16.png"))
            this.UIRoot.Add(this.branchLabel)
            this.TintHeader()
            defined int bx = this.W - 14 - 3 * 24
            // the folder ends before the small buttons, the branch (below them) before the edge of the band; what is longer is cut with "..."
            this.folderLabel.Width = bx - 4 - 34
            this.branchLabel.Width = this.W - 12 - 34
            this.historyButton = Assistant.View.Small(UI.Geometry.Parse("M 2 4 L 14 4 M 2 8 L 14 8 M 2 12 L 14 12"), bx, 11)
            this.historyButton.OnClick = func () on this => ToggleHistory()
            this.UIRoot.Add(this.historyButton)
            this.sessionsButton = Assistant.View.Small(UI.Geometry.Parse("M 2 5 L 12 5 M 9 2 L 12 5 L 9 8 M 14 11 L 4 11 M 7 8 L 4 11 L 7 14"), bx + 24, 11)
            this.sessionsButton.OnClick = func () on this => ShowSessions()
            this.UIRoot.Add(this.sessionsButton)
            this.closeButton = Assistant.View.Small(UI.Icons.Close(), bx + 48, 11)
            this.closeButton.OnClick = func () on this => HideBubble()
            this.UIRoot.Add(this.closeButton)
            this.text = new UI.TextArea("", 12, 36, this.W - 24, 100)
            this.text.ReadOnly = true
            this.text.WordWrap = true
            this.text.FadeBottom = 28
            this.UIRoot.Add(this.text)
            this.choices = new UI.StackPanel(14, 140, this.W - 28, -1, false, 4, 0)
            // four buttons made once: a choice changes their text (a button made anew would destroy the one the pointer is on - the interface still knows it)
            for (int i = 0; i < 4; i++) {
                var b = new UI.Button("", 0, 0, this.W - 28, -1)
                b.WordWrap = true
                b.Visible = false
                b.OnClick = func () on this => Pick((taking i))
                this.choices.Add(b)
            }
            this.UIRoot.Add(this.choices)
            this.question = new UI.TextBox("", 14, this.BH - 52, this.W - 28, 26)
            this.question.Hint = "Ask me..."
            this.question.OnEnter = func () on this => AskTyped()
            this.UIRoot.Add(this.question)
            // the character (it moves: painted again when its next picture is due, see Animate); a click pokes it
            this.flame = new UI.DrawingCanvas(14, 38, 14, 18)
            this.flame.blendMode = 2
            this.flame.Visible = false
            this.flame.OnPaint = func (UI.DrawingCanvas c) on this => PaintFlame(c)
            this.UIRoot.Add(this.flame)
            this.figure = new UI.DrawingCanvas(4, this.MaxBH, 100, this.FH)
            this.figure.blendMode = 2
            this.figure.OnPaint = func (UI.DrawingCanvas c) on this => PaintFigure(c)
            this.figure.OnMouseDown = func (int x, int y, int b) on this => Press(x, y, b)
            this.figure.OnMouseMove = func (int x, int y) on this => Drag(x, y)
            this.figure.OnMouseUp = func (int x, int y, int b) on this => Release()
            this.UIRoot.Add(this.figure)
            this.UIRoot.onTick = func () on this => Cycle()
        }

        defined int Fill() { return this.UIRoot.Dark ? UI.Color.Rgb(52, 52, 56) : UI.Color.Rgb(255, 253, 240) }
        // the header in the accent colour of the system (UIRoot.Accent: 0xRRGGBB)
        defined int HeaderFill() {
            defined int a = this.UIRoot.Accent
            return UI.Color.Rgb((a >> 16) & 255, (a >> 8) & 255, a & 255)
        }

        // The text and the pictures of the header in the colour of text on the accent (UIRoot.AccentForeground: white, or black on a light accent) -
        // made again when it changes (a new accent of the system or of the program).
        undefined TintHeader() {
            defined int fg = this.UIRoot.AccentForeground
            if (fg == this.headerTint) { return }
            this.headerTint = fg
            defined int color = UI.Color.Rgb((fg >> 16) & 255, (fg >> 8) & 255, fg & 255)
            replace this.folderLabel.Color = new SolidBrush(color)
            replace this.branchLabel.Color = new SolidBrush(color)
            replace this.folderIcon = this.folderWhite.Tinted(color)
            replace this.branchIcon = this.branchWhite.Tinted(color)
        }

        // Every cycle: a new accent or dark/light (of the system or of the program) shows at once - the header's text and pictures tinted anew,
        // the bubble (header band, fill) painted again.
        undefined FollowLook() {
            defined int accent = this.UIRoot.Accent
            bool dark = this.UIRoot.Dark
            if (accent == this.lookAccent && dark == this.lookDark && this.UIRoot.AccentForeground == this.headerTint) { return }
            this.lookAccent = accent
            this.lookDark = dark
            this.TintHeader()
            this.bubble.Invalidate()
            this.UIRoot.Invalidate()
            this.Show()
        }

        // The folder as the header shows it: in a repository its name and the path below it ("/RuhrpottRaser/src"), else the path.
        string FolderText() {
            string folder = this.Brain.Folder
            string text = folder
            if (this.Brain.Repo != "") {
                text = "/" + IO.Path.GetFileName(this.Brain.Repo) + folder.Substring(this.Brain.Repo.Length).Replace("\\", "/")
            }
            return text
        }

        // `text` as `label` shows it in `room` pixels (in its font): whole, or cut with "..." - at the front (`front`: the end of a path is what
        // tells) or at the end.
        string Fit(UI.Label label, string text, defined int room, bool front) {
            if (label.TextWidth(this.UIRoot, text) <= room) { return text }
            string rest = text
            while (rest.Length > 0) {
                rest = front ? rest.Substring(1) : rest.Substring(0, rest.Length - 1)
                string shown = front ? "..." + rest : rest + "..."
                if (label.TextWidth(this.UIRoot, shown) <= room) { return shown }
            }
            return "..."
        }

        // The header band at the top of the bubble (its top corners round, `radius`), with a folder and - in a repository - a branch drawn in the
        // colour of text on the accent (TintHeader).
        undefined PaintHeader(Renderer r, defined int w, defined int radius) {
            var band = new SolidBrush(this.HeaderFill())
            defined int o = this.O
            r.FillRoundRect(4, o + 4, w - 8, this.headerH, radius, band)
            r.FillRect(4, o + 4 + this.headerH - radius, w - 8, radius, band)
            r.Blit(this.folderIcon, 13, o + 15, 2)
            if (this.Brain.Branch != "") { r.Blit(this.branchIcon, 13, o + 35, 2) }
        }

        undefined PaintBubble(UI.DrawingCanvas c) {
            var r = c.renderer
            r.ClearTo(UI.Color.Transparent())
            if (!this.Brain.Visible) { return }
            defined int w = this.W
            // (the bubble from o down to the tail; the window above it is transparent)
            defined int o = this.O
            defined int h = o + this.BH - 12
            defined int fill = this.Fill()
            defined int edge = this.UIRoot.Dark ? UI.Color.Rgb(90, 90, 96) : UI.Color.Rgb(214, 204, 160)
            if (this.Brain.Phase == Assistant.Phase.Thinking) {
                // a thought bubble: rounder, and small circles that rise from the character instead of the tail
                r.DrawShadow(4, o + 4, w - 8, this.BH - 16, 24, 6, 0x30000000, 2)
                r.FillRoundRect(4, o + 4, w - 8, this.BH - 16, 24, new SolidBrush(fill))
                this.PaintHeader(r, w, 24)
                r.DrawRoundRect(4, o + 4, w - 8, this.BH - 16, 24, new Pen(edge, 1))
                r.FillCircle(52, h + 3, 6, new SolidBrush(fill))
                r.DrawCircle(52, h + 3, 6, new Pen(edge, 1))
                r.FillCircle(44, h + 14, 3, new SolidBrush(fill))
                r.DrawCircle(44, h + 14, 3, new Pen(edge, 1))
                return
            }
            r.DrawShadow(4, o + 4, w - 8, this.BH - 16, 12, 6, 0x30000000, 2)
            r.FillRoundRect(4, o + 4, w - 8, this.BH - 16, 12, new SolidBrush(fill))
            this.PaintHeader(r, w, 12)
            r.DrawRoundRect(4, o + 4, w - 8, this.BH - 16, 12, new Pen(edge, 1))
            // the tail towards the character
            float tail[] = [38.0, (h - 1) * 1.0, 66.0, (h - 1) * 1.0, 44.0, (h + 12) * 1.0]
            r.FillPolygon(tail, new SolidBrush(fill))
            r.DrawLine(38, h, 44, h + 12, new Pen(edge, 1))
            r.DrawLine(66, h, 44, h + 12, new Pen(edge, 1))
        }

        // A flame of a few strokes whose tip and sides move a little every frame - white inside, a black edge, a black core.
        undefined PaintFlame(UI.DrawingCanvas c) {
            var r = c.renderer
            r.ClearTo(UI.Color.Transparent())
            float t = this.frame * 0.25
            float sway = Math.Sin(t) * 1.6 + Math.Sin(t * 2.3) * 0.8
            float lean = Math.Sin(t * 1.7) * 0.9
            float tipY = 1.0 + Math.Sin(t * 3.1) * 1.2
            float outer[] = [7.0 + sway, tipY, 11.5 + lean, 8.0, 12.5, 12.0, 11.0, 15.5, 7.0, 17.0, 3.0, 15.5, 1.5, 12.0, 2.5 + lean, 8.0]
            r.FillPolygon(outer, new SolidBrush(0xFFFFFFFF))
            r.DrawPolygon(outer, new Pen(0xFF000000, 1), true)
            float coreTip = 8.0 + Math.Sin(t * 2.6) * 1.0
            float inner[] = [7.0 + sway * 0.5, coreTip, 9.5, 12.5, 7.0, 15.0, 4.5, 12.5]
            r.FillPolygon(inner, new SolidBrush(0xFF000000))
        }

        undefined PaintFigure(UI.DrawingCanvas c) {
            this.fpsFigures++
            var r = c.renderer
            r.ClearTo(UI.Color.Transparent())
            this.Brain.Character.Paint(r, 0.0, 0.0, c.framebuffer.Width() * 1.0, c.framebuffer.Height() * 1.0, this.frame, this.Brain.Mood())
        }

        undefined Press(defined int x, defined int y, defined int button) {
            if (button == 3) {
                this.ShowContextMenu(this.figure.Left + x, this.figure.Top + y)
                return
            }
            this.pressed = true
            this.pressX = x
            this.pressY = y
        }

        // Dragged a few pixels: the desktop moves the window with the mouse (it has no title bar).
        undefined Drag(defined int x, defined int y) {
            if (!this.pressed) { return }
            if (Math.Abs(x - this.pressX) + Math.Abs(y - this.pressY) > 4) {
                this.pressed = false
                this.win.BeginMove()
            }
        }

        undefined Release() {
            if (!this.pressed) { return }
            this.pressed = false
            this.Poke()
        }

        // At the start: the bottom right corner of the desktop (the work area comes with a cycle of the window).
        undefined Place() {
            int area[] = this.win.WorkArea()
            this.win.Position()   // (from now on the window says where it is: the bubble grows upwards from there)
            if (area[2] <= 0) { return }
            this.placed = true
            // the bubble at most as high as the screen leaves room for: Min(screen - 120, 480) (logical pixels)
            this.MaxBH = UI.M.Max(this.MinBH, UI.M.Min(this.UIRoot.ToLogical(area[3]) - this.FH, 480))
            // the window once at its full height (the largest bubble and the character)
            if (this.MaxBH + this.FH != this.H) {
                this.H = this.MaxBH + this.FH
                this.UIRoot.SetSize(this.W, this.H)
                this.bubble.Height = this.H
                this.figure.Top = this.MaxBH
            }
            this.win.SetPosition(area[0] + area[2] - this.fb.Width() - 16, area[1] + area[3] - this.fb.Height() - 8)
            this.Show()
        }

        // The bubble gets the height `bh`: it starts lower or higher above the character (the window stays as it is).
        undefined Resize(defined int bh) {
            this.BH = bh
            this.O = this.MaxBH - bh
        }

        // Every cycle: the brain works a little, the bubble follows it, the character moves when its next picture is due - and while nothing happens
        // the view rests a little.
        undefined Cycle() {
            defined int entered = 0
            if (this.fpsLog) {
                entered = Assistant.View.Micros()
                if (this.fpsLeft > 0) { this.fpsOutsideUs += entered - this.fpsLeft }
            }
            this.CycleWork()
            if (this.fpsLog) { this.FpsCount(entered) }
        }

        // Microseconds of the clock (FIRE_ASSISTANT_FPS).
        static defined int Micros() { return DateTime.UtcNow.Ticks / 10 }

        // FIRE_ASSISTANT_FPS: counts the cycle (its work began at `entered`) and once a second writes "fps: <cycles> cycles, <pictures> pictures, tick <ms>,
        // rest <ms>, outside <ms>" - outside is the time between two cycles that the interface and the window took (events, painting, showing the frame).
        undefined FpsCount(defined int entered) {
            defined int now = Assistant.View.Micros()
            this.fpsCycles++
            this.fpsLeft = now
            if (this.fpsSince == 0) { this.fpsSince = now }
            if (now - this.fpsSince >= 1000000) {
                defined int c = UI.M.Max(1, this.fpsCycles)
                print("fps: " + this.fpsCycles + " cycles, " + this.fpsFigures + " pictures, tick " + (this.fpsTickUs / c / 1000.0) + " ms, rest " +
                    (this.fpsRestUs / c / 1000.0) + " ms, outside " + (this.fpsOutsideUs / c / 1000.0) + " ms, phase " + this.Brain.Phase + ", mood " + this.Brain.Mood())
                this.fpsSince = now
                this.fpsCycles = 0
                this.fpsFigures = 0
                this.fpsTickUs = 0
                this.fpsRestUs = 0
                this.fpsOutsideUs = 0
            }
        }

        undefined CycleWork() {
            this.cycles++
            this.nowMs = Assistant.Brain.Clock() - this.startMs
            if (this.nowMs < 0) {
                // (the clock of the system went back)
                this.startMs = Assistant.Brain.Clock()
                this.nowMs = 0
                this.nextFigure = 0
                this.nextFlame = 0
                this.activeUntil = 0
            }
            this.frame = this.nowMs * 60 / 1000
            if (this.UIRoot.Events != this.seenEvents) {
                this.seenEvents = this.UIRoot.Events
                this.activeUntil = this.nowMs + 1000
            }
            this.FollowLook()
            if (!this.placed && this.frame < 120) { this.Place() }
            if (this.picked >= 0) { this.TakePicked() }
            if (this.pickedSession != "") { this.TakeSession() }
            if (this.pickedMenu != "") { this.TakeMenu() }
            // the menu closed
            if (this.menuOpen && this.UIRoot.popups.Count == 0) {
                this.menuOpen = false
                this.Show()
            }
            defined int tickStart = this.fpsLog ? Assistant.View.Micros() : 0
            bool changed = this.Brain.Tick()
            if (this.fpsLog) { this.fpsTickUs += Assistant.View.Micros() - tickStart }
            if (this.Brain.Quit) {
                this.win.Close()
                return
            }
            if (changed || this.cycles == 1) {
                this.Show()
                this.activeUntil = this.nowMs + 1000
            }
            this.Animate()
            this.Rest()
        }

        // The pictures of the character a second: lively while it thinks or talks, calm while it waits, slow while it sleeps (its breath is slow then).
        defined int FigureRate() {
            Assistant.Mood mood = this.Brain.Mood()
            if (mood == Assistant.Mood.Sleep) { return 4 }
            if (mood == Assistant.Mood.Idle) { return 15 }
            return 30
        }

        // The character (and the small flame while it thinks) painted again when its next picture is due - not in every cycle.
        undefined Animate() {
            defined int now = this.nowMs
            if (now >= this.nextFigure) {
                this.figure.Invalidate()
                defined int step = 1000 / this.FigureRate()
                this.nextFigure = this.nextFigure + step
                if (this.nextFigure <= now) { this.nextFigure = now + step }
            }
            if (this.flame.Visible && now >= this.nextFlame) {
                this.flame.Invalidate()
                this.nextFlame = this.nextFlame + 33
                if (this.nextFlame <= now) { this.nextFlame = now + 33 }
            }
        }

        // While nothing happens - no event for a second, the brain idle, no press, no menu - the view waits until the next picture of the character is due
        // (at most a tenth of a second while the bubble is open, a quarter while it sleeps: a click or a poke is taken within it, and the first event makes
        // it cycle at full speed again). Without the rest the idle assistant would run its whole cycle 60 times a second.
        undefined Rest() {
            if (this.Brain.Busy || this.pressed || this.menuOpen || this.nowMs < this.activeUntil) { return }
            defined int due = this.nextFigure
            if (this.flame.Visible && this.nextFlame < due) { due = this.nextFlame }
            // (the next frame waits for the screen too: about 16 ms)
            defined int wait = UI.M.Clamp(due - this.nowMs - 16, 0, this.Brain.Visible ? 100 : 250)
            if (wait > 0) {
                defined int restStart = this.fpsLog ? Assistant.View.Micros() : 0
                Sleep(wait)
                if (this.fpsLog) { this.fpsRestUs += Assistant.View.Micros() - restStart }
            }
        }

        // Lays the bubble out for what it shows: the text takes the room the choices and the question line leave.
        undefined Show() {
            bool shownNow = this.Brain.Visible
            defined int fill = this.Fill()
            this.text.Background = new SolidBrush(fill)
            this.text.Pen = new Pen(fill, 1)
            this.text.Visible = shownNow
            this.historyButton.Visible = shownNow
            this.sessionsButton.Visible = shownNow
            this.closeButton.Visible = shownNow
            // the header: one line for the folder, a second one for the branch
            this.headerH = this.Brain.Branch != "" ? 54 : 36
            this.folderLabel.Text = this.Fit(this.folderLabel, this.FolderText(), this.folderLabel.Width, true)
            this.folderLabel.Visible = shownNow
            string branch = this.Brain.Branch
            if (branch != "") { branch = this.Fit(this.branchLabel, branch, this.branchLabel.Width, false) }
            this.branchLabel.Text = branch
            this.branchLabel.Visible = shownNow && branch != ""
            defined int top = 4 + this.headerH + 8   // (from the top of the bubble)
            string t = this.showHistory ? this.Brain.History() : this.Brain.Text
            if (t != this.shown) {
                this.text.Text = t
                this.shown = t
            }
            defined int count = 0
            defined int choicesHeight = 0
            for (int i = 0; i < 4; i++) {
                UI.Button b = this.choices.children[i]
                bool used = shownNow && !this.showHistory && i < this.Brain.Choices.Count
                b.Visible = used
                if (used) {
                    // (a long choice breaks into lines)
                    b.Text = this.Brain.Choices[i]
                    b.Measure(this.UIRoot, this.W - 28, -1)
                    choicesHeight = choicesHeight + UI.M.Max(24, b.dh) + 4
                    count++
                }
            }
            bool asking = shownNow && (this.Brain.Asking || this.showHistory) && this.Brain.Choices.Count == 0
            this.question.Visible = asking
            this.choices.Visible = shownNow && count > 0
            // the bubble as high as the text, the choices and the question line need (the text scrolls beyond MaxBH); closed: only the character
            defined int below = 22 + choicesHeight
            if (asking) { below = below + 30 }
            defined int bh = 0
            if (shownNow) { bh = UI.M.Clamp(top + this.text.ContentHeight(this.UIRoot, this.W - 24) + below, this.MinBH, this.MaxBH) }
            this.Resize(bh)
            // everything of the bubble at its place below O
            defined int o = this.O
            this.folderLabel.Top = o + 15
            this.branchLabel.Top = o + 35
            this.historyButton.Top = o + 11
            this.sessionsButton.Top = o + 11
            this.closeButton.Top = o + 11
            defined int bottom = this.BH - 22
            if (asking) { bottom = this.BH - 52 }
            this.question.Top = o + this.BH - 46
            this.choices.Top = o + bottom - choicesHeight + 4
            this.text.Top = o + top
            this.text.Height = UI.M.Max(20, bottom - choicesHeight - top)
            this.flame.Top = o + top + 2
            // thinking: the flame left of the text, the text a little to the right
            bool thinking = shownNow && this.Brain.Phase == Assistant.Phase.Thinking
            this.flame.Visible = thinking
            this.text.Left = thinking ? 30 : 12
            this.text.Width = thinking ? this.W - 42 : this.W - 24
            if (asking) { this.UIRoot.SetFocus(this.question) }
            this.bubble.Invalidate()
            this.UIRoot.Invalidate()
        }

        undefined Pick(defined int i) { this.picked = i }

        // The sessions as a menu at the sessions button: a new one, then the sessions (the current one checked), the one used last first.
        undefined ShowSessions() {
            var items = new List()
            items.Add(new UI.MenuItem("New session", func () on this => ChooseSession("new")))
            items.Add(UI.MenuItem.Separator())
            List ids = Assistant.Session.All()
            defined int shownCount = 0
            foreach (x in ids) {
                string id = x
                any s = Assistant.Session.Load(id)
                if (s == undefined) { continue }
                Assistant.Session session = s
                string title = session.Title
                if (title.Length > 26) { title = title.Substring(0, 23) + "..." }
                var item = new UI.MenuItem(title, func () on this => ChooseSession((taking id)))
                item.Checkable = false
                item.IsChecked = id == this.Brain.Current.Id
                item.Shortcut = IO.Path.GetFileName(session.Folder)
                items.Add(take item)
                shownCount++
                if (shownCount >= 12) { break }
            }
            this.menuRows = take items   // (the menu does not own its rows: they live in the view while it is open)
            this.menuOpen = true
            this.UIRoot.ShowMenu(this.menuRows, this.sessionsButton.Left - 120, this.sessionsButton.Top + 24)
        }

        undefined ChooseSession(string id) { this.pickedSession = id }

        // The menu of a right click on the character: folder, history, git, another character, quit.
        undefined ShowContextMenu(defined int x, defined int y) {
            var items = new List()
            items.Add(new UI.MenuItem("Change folder...", func () on this => ChooseMenu("folder")))
            // the open sparks: the assistant works with one of them (its tools, its folder)
            List sparks = this.Brain.SparkIds()
            if (sparks.Count > 0) {
                var sparkMenu = new UI.MenuItem("spark")
                foreach (x in sparks) {
                    string id = x
                    var row = new UI.MenuItem(this.Brain.SparkTitle(id), func () on this => ChooseMenu("spark:" + (taking id)))
                    row.IsChecked = id == this.Brain.SparkId
                    sparkMenu.Add(take row)
                }
                items.Add(take sparkMenu)
            }
            items.Add(new UI.MenuItem("History", func () on this => ChooseMenu("history")))
            var git = new UI.MenuItem("Git")
            git.Add(new UI.MenuItem("Status", func () on this => ChooseMenu("git:status")))
            git.Add(new UI.MenuItem("Log", func () on this => ChooseMenu("git:log")))
            git.Add(UI.MenuItem.Separator())
            git.Add(new UI.MenuItem("Pull...", func () on this => ChooseMenu("git:pull")))
            git.Add(new UI.MenuItem("Commit all...", func () on this => ChooseMenu("git:commit")))
            git.Add(new UI.MenuItem("Push...", func () on this => ChooseMenu("git:push")))
            items.Add(take git)
            var who = new UI.MenuItem("Assistant")
            foreach (c in Assistant.Character.All()) {
                Assistant.Character ch = c
                string id = ch.Id
                var row = new UI.MenuItem(ch.Name, func () on this => ChooseMenu("character:" + (taking id)))
                row.IsChecked = id == this.Brain.Character.Id
                who.Add(take row)
            }
            items.Add(take who)
            items.Add(UI.MenuItem.Separator())
            items.Add(new UI.MenuItem("Quit", func () on this => ChooseMenu("quit")))
            this.menuRows = take items   // (the menu does not own its rows: they live in the view while it is open)
            // above the character (the window has room for it)
            this.menuOpen = true
            this.UIRoot.ShowMenu(this.menuRows, 4, UI.M.Max(4, this.MaxBH - 150))
        }

        undefined ChooseMenu(string what) { this.pickedMenu = what }

        undefined TakeMenu() {
            string what = this.pickedMenu
            this.pickedMenu = ""
            if (what == "history") {
                this.Brain.Visible = true
                this.showHistory = true
                this.shown = ""
            }
            else if (what == "folder") {
                any chosen = Dialogs.FolderBrowserDialog.Show("The folder the assistant works in", this.Brain.Folder)
                if (chosen != undefined) {
                    this.Brain.SetFolder(chosen)
                    this.Brain.Say("Now working in " + chosen + ".")
                    this.Brain.Asking = true
                }
            }
            else if (what.StartsWith("git:")) {
                this.showHistory = false
                this.Brain.GitMenu(what.Substring(4))
            }
            else if (what.StartsWith("character:")) { this.SetCharacter(what.Substring(10)) }
            else if (what.StartsWith("spark:")) {
                string id = what.Substring(6)
                this.Brain.UseSpark(id, true)
                this.Brain.Say("Now with " + this.Brain.SparkTitle(id) + ".")
                this.Brain.Asking = true
            }
            else if (what == "quit") {
                this.Brain.KeepSession()
                this.Brain.Quit = true
                return
            }
            this.Show()
        }

        undefined TakeSession() {
            string id = this.pickedSession
            this.pickedSession = ""
            this.showHistory = false
            if (id == "new") { this.Brain.NewSession() }
            else { this.Brain.SwitchSession(id) }
            this.Show()
        }

        undefined TakePicked() {
            defined int i = this.picked
            this.picked = -1
            this.showHistory = false
            this.Brain.Choose(i)
            this.Show()
        }

        undefined AskTyped() {
            string q = this.question.Text
            this.question.Text = ""
            this.showHistory = false
            this.Brain.Visible = true
            this.Brain.Ask(q)
            this.Show()
        }

        undefined Poke() {
            this.showHistory = false
            this.Brain.Poke()
            this.Show()
        }

        undefined HideBubble() {
            this.Brain.Visible = false
            this.Brain.Asking = false
            this.Show()
        }

        undefined ToggleHistory() {
            this.showHistory = !this.showHistory
            this.shown = ""
            this.Show()
        }

        undefined NewTopic() {
            this.Brain.Forget()
            this.Brain.Say("New topic. What would you like to know?")
            this.Brain.Asking = true
            this.showHistory = false
            this.Show()
        }

        // Another character (its id); the session stays.
        undefined SetCharacter(string id) {
            if (id == this.Brain.Character.Id) { return }
            Assistant.Character next = Assistant.Character.Find(id)
            this.Brain.Character = next
            this.PaintIcon()
            this.Brain.Settings.Character = next.Id
            this.Brain.Settings.Save()
            this.Brain.Say(next.Hello)
            this.Brain.Asking = true
            this.Show()
        }

        // Shows the window until it is closed.
        undefined Run() {
            this.UIRoot.Run()
            this.Brain.Close()
        }
    }
}
