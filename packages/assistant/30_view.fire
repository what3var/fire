#import "ui"
#import "dialogs"

// The window of the assistant: the character at the bottom, the bubble above it. The bubble has small buttons at its top right (history, new topic,
// another character, close), the text (as high as there is room), up to four choices, and - after a poke - the question line. The window is transparent
// where the desktop allows it: only the character and its bubble are seen.
//
//     var view = new Assistant.View(new Assistant.Brain())
//     view.Run()
namespace Assistant {
    class View {
        Assistant.Brain Brain
        Framebuffer fb
        Window win
        UI.Root ui
        UI.DrawingCanvas figure
        // while the model thinks: a small flickering flame (black and white) left of "Thinking"
        UI.DrawingCanvas flame
        UI.DrawingCanvas bubble
        UI.TextArea text
        UI.StackPanel choices
        UI.TextBox question
        UI.Button historyButton
        UI.Button sessionsButton
        // the header: the folder the assistant works in, and the branch when it is a git repository
        UI.Label folderLabel
        UI.Label branchLabel
        defined int headerH = 30
        // the pictures of the header (16 x 16, white): folder and branch
        Framebuffer folderIcon
        Framebuffer branchIcon
        // a session chosen in the popup ("new": a new one), taken in the next cycle
        string pickedSession = ""
        // a row of the context menu that was chosen ("history", "folder", "git:status", "character:flint", "quit"), taken in the next cycle
        string pickedMenu = ""
        List menuRows
        // a menu is open: the window has room for it above the character (and is laid out again when it closes)
        bool menuOpen = false
        UI.Button closeButton
        defined int frame = 0
        // a press on the character: a click pokes it, a drag moves the window
        bool pressed = false
        defined int pressX = 0
        defined int pressY = 0
        bool placed = false
        bool showHistory = false
        // a choice that was clicked: taken in the next cycle (its button goes when the choices are made anew - not while it handles its own click)
        defined int picked = -1
        string shown = ""
        // the window, the bubble in it (as high as what it shows, between MinBH and MaxBH; 0 while it is closed), the character below it
        defined int W = 240
        defined int BH = 250
        defined int FH = 120
        defined int H = 370
        defined int MinBH = 110
        defined int MaxBH = 480

        construct(Assistant.Brain brain) {
            this.Brain = take brain
            this.H = this.BH + this.FH
            this.fb = new Framebuffer(this.W, this.H)
            this.win = new Window(this.fb, this.Brain.Character.Name)
            // no frame, above the other windows: only the character and its bubble are seen
            this.win.Frameless = true
            this.win.TopMost = true
            this.win.ShowInTaskbar = false   // (a helper, not a program of its own)
            this.win.ClickThrough = true     // (clicks next to the bubble and the character reach the windows below)
            this.PaintIcon()
            this.ui = new UI.Root(this.fb, this.win)
            this.ui.WindowBackdrop = Backdrop.Transparent
            this.ui.WindowBackground = new SolidBrush(UI.Color.Transparent())   // (nothing behind the bubble and the character)
            this.Build()
        }

        // The character as the window's picture (Alt+Tab, where the desktop shows one).
        undefined PaintIcon() {
            var fb = new Framebuffer(64, 64)
            var r = new Renderer(fb)
            r.ClearTo(UI.Color.Transparent())
            this.Brain.Character.Paint(r, 0.0, 0.0, 64.0, 64.0, 0, Assistant.Mood.Idle)
            this.win.SetIcon(fb)
        }

        static UI.Button Small(UI.Geometry icon, defined int x, defined int y) {
            var b = new UI.Button("", x, y, 22, 22)
            b.Icon = icon
            b.IconSize = 12
            return b
        }

        undefined Build() {
            // the bubble: a rounded box with a tail towards the character (behind everything)
            this.bubble = new UI.DrawingCanvas(0, 0, this.W, this.H)
            this.bubble.blendMode = 2
            this.bubble.OnPaint = func (UI.DrawingCanvas c) on this => PaintBubble(c)
            this.ui.Add(this.bubble)
            // the header: folder and branch, the small buttons at the right (history, sessions, close)
            this.folderLabel = new UI.Label("", 34, 15)
            this.folderLabel.Color = new SolidBrush(UI.Color.Rgb(255, 255, 255))
            this.folderLabel.FontSize = 13
            this.ui.Add(this.folderLabel)
            this.branchLabel = new UI.Label("", 34, 35)
            this.branchLabel.Color = new SolidBrush(UI.Color.Rgb(255, 255, 255))
            this.branchLabel.FontSize = 13
            // the branch in bold (the bold file of the theme's font, where there is one)
            string bold = this.ui.theme.font + " Bold"
            if (this.ui.theme.font != "" && Fonts.Has(bold)) { this.branchLabel.Font = bold }
            this.folderIcon = Framebuffer.FromResource(new Resource("icons/folder16.png"))
            this.branchIcon = Framebuffer.FromResource(new Resource("icons/branch16.png"))
            this.ui.Add(this.branchLabel)
            defined int bx = this.W - 14 - 3 * 24
            this.historyButton = Assistant.View.Small(UI.Geometry.Parse("M 2 4 L 14 4 M 2 8 L 14 8 M 2 12 L 14 12"), bx, 11)
            this.historyButton.OnClick = func () on this => ToggleHistory()
            this.ui.Add(this.historyButton)
            this.sessionsButton = Assistant.View.Small(UI.Geometry.Parse("M 2 5 L 12 5 M 9 2 L 12 5 L 9 8 M 14 11 L 4 11 M 7 8 L 4 11 L 7 14"), bx + 24, 11)
            this.sessionsButton.OnClick = func () on this => ShowSessions()
            this.ui.Add(this.sessionsButton)
            this.closeButton = Assistant.View.Small(UI.Icons.Close(), bx + 48, 11)
            this.closeButton.OnClick = func () on this => HideBubble()
            this.ui.Add(this.closeButton)
            this.text = new UI.TextArea("", 12, 36, this.W - 24, 100)
            this.text.ReadOnly = true
            this.text.WordWrap = true
            this.text.FadeBottom = 28
            this.ui.Add(this.text)
            this.choices = new UI.StackPanel(14, 140, this.W - 28, -1, false, 4, 0)
            // four buttons made once: a choice changes their text (a button made anew would destroy the one the pointer is on - the interface still knows it)
            for (int i = 0; i < 4; i++) {
                var b = new UI.Button("", 0, 0, this.W - 28, -1)
                b.WordWrap = true
                b.Visible = false
                b.OnClick = func () on this => Pick((taking i))
                this.choices.Add(b)
            }
            this.ui.Add(this.choices)
            this.question = new UI.TextBox("", 14, this.BH - 52, this.W - 28, 26)
            this.question.Hint = "Ask me..."
            this.question.OnEnter = func () on this => AskTyped()
            this.ui.Add(this.question)
            // the character (it moves: painted every frame); a click pokes it
            this.flame = new UI.DrawingCanvas(14, 38, 14, 18)
            this.flame.Continuous = true
            this.flame.blendMode = 2
            this.flame.Visible = false
            this.flame.OnPaint = func (UI.DrawingCanvas c) on this => PaintFlame(c)
            this.ui.Add(this.flame)
            this.figure = new UI.DrawingCanvas(4, this.BH, 100, this.FH)
            this.figure.Continuous = true
            this.figure.blendMode = 2
            this.figure.OnPaint = func (UI.DrawingCanvas c) on this => PaintFigure(c)
            this.figure.OnMouseDown = func (int x, int y, int b) on this => Press(x, y, b)
            this.figure.OnMouseMove = func (int x, int y) on this => Drag(x, y)
            this.figure.OnMouseUp = func (int x, int y, int b) on this => Release()
            this.ui.Add(this.figure)
            this.ui.onTick = func () on this => Cycle()
        }

        defined int Fill() { return this.ui.Dark ? UI.Color.Rgb(52, 52, 56) : UI.Color.Rgb(255, 253, 240) }
        // the header in the accent colour of the system (ui.Accent: 0xRRGGBB)
        defined int HeaderFill() {
            defined int a = this.ui.Accent
            return UI.Color.Rgb((a >> 16) & 255, (a >> 8) & 255, a & 255)
        }

        // The folder as the header shows it: in a repository its name and the path below it ("/RuhrpottRaser/src"), else the path - cut at the front
        // when it is longer than `room` characters.
        string FolderText(defined int room) {
            string folder = this.Brain.Folder
            string text = folder
            if (this.Brain.Repo != "") {
                text = "/" + IO.Path.GetFileName(this.Brain.Repo) + folder.Substring(this.Brain.Repo.Length).Replace("\\", "/")
            }
            if (text.Length > room) { text = "..." + text.Substring(text.Length - room + 3) }
            return text
        }

        // The header band at the top of the bubble (its top corners round, `radius`), with a folder and - in a repository - a branch drawn in white.
        undefined PaintHeader(Renderer r, defined int w, defined int radius) {
            var band = new SolidBrush(this.HeaderFill())
            r.FillRoundRect(4, 4, w - 8, this.headerH, radius, band)
            r.FillRect(4, 4 + this.headerH - radius, w - 8, radius, band)
            r.Blit(this.folderIcon, 13, 15, 2)
            if (this.Brain.Branch != "") { r.Blit(this.branchIcon, 13, 35, 2) }
        }

        undefined PaintBubble(UI.DrawingCanvas c) {
            var r = c.renderer
            r.ClearTo(UI.Color.Transparent())
            if (!this.Brain.Visible) { return }
            defined int w = this.W
            defined int h = this.BH - 12
            defined int fill = this.Fill()
            defined int edge = this.ui.Dark ? UI.Color.Rgb(90, 90, 96) : UI.Color.Rgb(214, 204, 160)
            if (this.Brain.Phase == Assistant.Phase.Thinking) {
                // a thought bubble: rounder, and small circles that rise from the character instead of the tail
                r.DrawShadow(4, 4, w - 8, h - 4, 24, 6, 0x30000000, 2)
                r.FillRoundRect(4, 4, w - 8, h - 4, 24, new SolidBrush(fill))
                this.PaintHeader(r, w, 24)
                r.DrawRoundRect(4, 4, w - 8, h - 4, 24, new Pen(edge, 1))
                r.FillCircle(52, h + 3, 6, new SolidBrush(fill))
                r.DrawCircle(52, h + 3, 6, new Pen(edge, 1))
                r.FillCircle(44, h + 14, 3, new SolidBrush(fill))
                r.DrawCircle(44, h + 14, 3, new Pen(edge, 1))
                return
            }
            r.DrawShadow(4, 4, w - 8, h - 4, 12, 6, 0x30000000, 2)
            r.FillRoundRect(4, 4, w - 8, h - 4, 12, new SolidBrush(fill))
            this.PaintHeader(r, w, 12)
            r.DrawRoundRect(4, 4, w - 8, h - 4, 12, new Pen(edge, 1))
            // the tail towards the character
            float tail[] = [38.0, (h - 1) * 1.0, 66.0, (h - 1) * 1.0, 44.0, (h + 12) * 1.0]
            r.FillPolygon(tail, new SolidBrush(fill))
            r.DrawLine(38, h, 44, h + 12, new Pen(edge, 1))
            r.DrawLine(66, h, 44, h + 12, new Pen(edge, 1))
        }

        // A flame of a few strokes whose tip and sides move a little every frame - white inside, a black edge, a black core.
        undefined PaintFlame(UI.DrawingCanvas c) {
            var r = c.renderer
            r.ClearTo(UI.Color.Transparent())
            float t = this.frame * 0.25
            float sway = Math.Sin(t) * 1.6 + Math.Sin(t * 2.3) * 0.8
            float lean = Math.Sin(t * 1.7) * 0.9
            float tipY = 1.0 + Math.Sin(t * 3.1) * 1.2
            float outer[] = [7.0 + sway, tipY, 11.5 + lean, 8.0, 12.5, 12.0, 11.0, 15.5, 7.0, 17.0, 3.0, 15.5, 1.5, 12.0, 2.5 + lean, 8.0]
            r.FillPolygon(outer, new SolidBrush(0xFFFFFFFF))
            r.DrawPolygon(outer, new Pen(0xFF000000, 1), true)
            float coreTip = 8.0 + Math.Sin(t * 2.6) * 1.0
            float inner[] = [7.0 + sway * 0.5, coreTip, 9.5, 12.5, 7.0, 15.0, 4.5, 12.5]
            r.FillPolygon(inner, new SolidBrush(0xFF000000))
        }

        undefined PaintFigure(UI.DrawingCanvas c) {
            var r = c.renderer
            r.ClearTo(UI.Color.Transparent())
            this.Brain.Character.Paint(r, 0.0, 0.0, c.framebuffer.Width() * 1.0, c.framebuffer.Height() * 1.0, this.frame, this.Brain.Mood())
        }

        undefined Press(defined int x, defined int y, defined int button) {
            if (button == 3) {
                this.ShowContextMenu(this.figure.Left + x, this.figure.Top + y)
                return
            }
            this.pressed = true
            this.pressX = x
            this.pressY = y
        }

        // Dragged a few pixels: the desktop moves the window with the mouse (it has no title bar).
        undefined Drag(defined int x, defined int y) {
            if (!this.pressed) { return }
            if (Math.Abs(x - this.pressX) + Math.Abs(y - this.pressY) > 4) {
                this.pressed = false
                this.win.BeginMove()
            }
        }

        undefined Release() {
            if (!this.pressed) { return }
            this.pressed = false
            this.Poke()
        }

        // At the start: the bottom right corner of the desktop (the work area comes with a cycle of the window).
        undefined Place() {
            int area[] = this.win.WorkArea()
            this.win.Position()   // (from now on the window says where it is: the bubble grows upwards from there)
            if (area[2] <= 0) { return }
            this.placed = true
            // the bubble at most as high as the screen leaves room for: Min(screen - 120, 480) (logical pixels)
            this.MaxBH = UI.M.Max(this.MinBH, UI.M.Min(this.ui.ToLogical(area[3]) - this.FH, 480))
            this.win.SetPosition(area[0] + area[2] - this.fb.Width() - 16, area[1] + area[3] - this.fb.Height() - 8)
            this.Show()
        }

        // The bubble gets the height `bh`: the window grows or shrinks upwards - its bottom (the character) stays where it is.
        undefined Resize(defined int bh) {
            if (bh == this.BH) { return }
            int at[] = this.win.Position()
            defined int before = this.fb.Height()
            this.BH = bh
            this.H = bh + this.FH
            this.ui.SetSize(this.W, this.H)
            if (at[0] >= 0) { this.win.SetPosition(at[0], at[1] + before - this.fb.Height()) }
            this.bubble.Height = this.H
            this.figure.Top = this.BH
        }

        // Every frame: the brain works a little, the bubble follows it.
        undefined Cycle() {
            this.frame++
            if (!this.placed && this.frame < 120) { this.Place() }
            if (this.picked >= 0) { this.TakePicked() }
            if (this.pickedSession != "") { this.TakeSession() }
            if (this.pickedMenu != "") { this.TakeMenu() }
            // the menu closed: the window goes back to the size of the bubble
            if (this.menuOpen && this.ui.popups.Count == 0) {
                this.menuOpen = false
                this.Show()
            }
            bool changed = this.Brain.Tick()
            if (this.Brain.Quit) {
                this.win.Close()
                return
            }
            if (changed || this.frame == 1) { this.Show() }
        }

        // Lays the bubble out for what it shows: the text takes the room the choices and the question line leave.
        undefined Show() {
            bool shownNow = this.Brain.Visible
            defined int fill = this.Fill()
            this.text.Background = new SolidBrush(fill)
            this.text.Pen = new Pen(fill, 1)
            this.text.Visible = shownNow
            this.historyButton.Visible = shownNow
            this.sessionsButton.Visible = shownNow
            this.closeButton.Visible = shownNow
            // the header: one line for the folder, a second one for the branch
            this.headerH = this.Brain.Branch != "" ? 54 : 36
            this.folderLabel.Text = this.FolderText(19)
            this.folderLabel.Visible = shownNow
            string branch = this.Brain.Branch
            if (branch.Length > 26) { branch = branch.Substring(0, 23) + "..." }
            this.branchLabel.Text = branch
            this.branchLabel.Visible = shownNow && branch != ""
            defined int top = 4 + this.headerH + 8
            string t = this.showHistory ? this.Brain.History() : this.Brain.Text
            if (t != this.shown) {
                this.text.Text = t
                this.shown = t
            }
            defined int count = 0
            defined int choicesHeight = 0
            for (int i = 0; i < 4; i++) {
                UI.Button b = this.choices.children[i]
                bool used = shownNow && !this.showHistory && i < this.Brain.Choices.Count
                b.Visible = used
                if (used) {
                    // (a long choice breaks into lines)
                    b.Text = this.Brain.Choices[i]
                    b.Measure(this.ui, this.W - 28, -1)
                    choicesHeight = choicesHeight + UI.M.Max(24, b.dh) + 4
                    count++
                }
            }
            bool asking = shownNow && (this.Brain.Asking || this.showHistory) && this.Brain.Choices.Count == 0
            this.question.Visible = asking
            this.choices.Visible = shownNow && count > 0
            // the bubble as high as the text, the choices and the question line need (the text scrolls beyond MaxBH); closed: only the character
            defined int below = 22 + choicesHeight
            if (asking) { below = below + 30 }
            defined int bh = 0
            if (shownNow) { bh = UI.M.Clamp(top + this.text.ContentHeight(this.ui, this.W - 24) + below, this.MinBH, this.MaxBH) }
            if (this.menuOpen) { bh = UI.M.Max(bh, UI.M.Min(220, this.MaxBH)) }
            this.Resize(bh)
            defined int bottom = this.BH - 22
            if (asking) { bottom = this.BH - 52 }
            this.question.Top = this.BH - 46
            this.choices.Top = bottom - choicesHeight + 4
            this.text.Top = top
            this.text.Height = UI.M.Max(20, bottom - choicesHeight - top)
            this.flame.Top = top + 2
            // thinking: the flame left of the text, the text a little to the right
            bool thinking = shownNow && this.Brain.Phase == Assistant.Phase.Thinking
            this.flame.Visible = thinking
            this.text.Left = thinking ? 30 : 12
            this.text.Width = thinking ? this.W - 42 : this.W - 24
            if (asking) { this.ui.SetFocus(this.question) }
            this.bubble.Invalidate()
            this.ui.Invalidate()
        }

        undefined Pick(defined int i) { this.picked = i }

        // The sessions as a menu at the sessions button: a new one, then the sessions (the current one checked), the one used last first.
        undefined ShowSessions() {
            var items = new List()
            items.Add(new UI.MenuItem("New session", func () on this => ChooseSession("new")))
            items.Add(UI.MenuItem.Separator())
            List ids = Assistant.Session.All()
            defined int shownCount = 0
            foreach (x in ids) {
                string id = x
                any s = Assistant.Session.Load(id)
                if (s == undefined) { continue }
                Assistant.Session session = s
                string title = session.Title
                if (title.Length > 26) { title = title.Substring(0, 23) + "..." }
                var item = new UI.MenuItem(title, func () on this => ChooseSession((taking id)))
                item.Checkable = false
                item.IsChecked = id == this.Brain.Current.Id
                item.Shortcut = IO.Path.GetFileName(session.Folder)
                items.Add(take item)
                shownCount++
                if (shownCount >= 12) { break }
            }
            this.menuRows = take items   // (the menu does not own its rows: they live in the view while it is open)
            this.menuOpen = true
            this.ui.ShowMenu(this.menuRows, this.sessionsButton.Left - 120, this.sessionsButton.Top + 24)
        }

        undefined ChooseSession(string id) { this.pickedSession = id }

        // The menu of a right click on the character: folder, history, git, another character, quit.
        undefined ShowContextMenu(defined int x, defined int y) {
            var items = new List()
            items.Add(new UI.MenuItem("Change folder...", func () on this => ChooseMenu("folder")))
            // the open sparks: the assistant works with one of them (its tools, its folder)
            List sparks = this.Brain.SparkIds()
            if (sparks.Count > 0) {
                var sparkMenu = new UI.MenuItem("spark")
                foreach (x in sparks) {
                    string id = x
                    var row = new UI.MenuItem(this.Brain.SparkTitle(id), func () on this => ChooseMenu("spark:" + (taking id)))
                    row.IsChecked = id == this.Brain.SparkId
                    sparkMenu.Add(take row)
                }
                items.Add(take sparkMenu)
            }
            items.Add(new UI.MenuItem("History", func () on this => ChooseMenu("history")))
            var git = new UI.MenuItem("Git")
            git.Add(new UI.MenuItem("Status", func () on this => ChooseMenu("git:status")))
            git.Add(new UI.MenuItem("Log", func () on this => ChooseMenu("git:log")))
            git.Add(UI.MenuItem.Separator())
            git.Add(new UI.MenuItem("Pull...", func () on this => ChooseMenu("git:pull")))
            git.Add(new UI.MenuItem("Commit all...", func () on this => ChooseMenu("git:commit")))
            git.Add(new UI.MenuItem("Push...", func () on this => ChooseMenu("git:push")))
            items.Add(take git)
            var who = new UI.MenuItem("Assistant")
            foreach (c in Assistant.Character.All()) {
                Assistant.Character ch = c
                string id = ch.Id
                var row = new UI.MenuItem(ch.Name, func () on this => ChooseMenu("character:" + (taking id)))
                row.IsChecked = id == this.Brain.Character.Id
                who.Add(take row)
            }
            items.Add(take who)
            items.Add(UI.MenuItem.Separator())
            items.Add(new UI.MenuItem("Quit", func () on this => ChooseMenu("quit")))
            this.menuRows = take items   // (the menu does not own its rows: they live in the view while it is open)
            // room above the character for the menu and its submenus
            this.menuOpen = true
            this.Show()
            this.ui.ShowMenu(this.menuRows, 4, UI.M.Max(4, this.BH - 150))
        }

        undefined ChooseMenu(string what) { this.pickedMenu = what }

        undefined TakeMenu() {
            string what = this.pickedMenu
            this.pickedMenu = ""
            if (what == "history") {
                this.Brain.Visible = true
                this.showHistory = true
                this.shown = ""
            }
            else if (what == "folder") {
                any chosen = Dialogs.FolderBrowserDialog.Show("The folder the assistant works in", this.Brain.Folder)
                if (chosen != undefined) {
                    this.Brain.SetFolder(chosen)
                    this.Brain.Say("Now working in " + chosen + ".")
                    this.Brain.Asking = true
                }
            }
            else if (what.StartsWith("git:")) {
                this.showHistory = false
                this.Brain.GitMenu(what.Substring(4))
            }
            else if (what.StartsWith("character:")) { this.SetCharacter(what.Substring(10)) }
            else if (what.StartsWith("spark:")) {
                string id = what.Substring(6)
                this.Brain.UseSpark(id, true)
                this.Brain.Say("Now with " + this.Brain.SparkTitle(id) + ".")
                this.Brain.Asking = true
            }
            else if (what == "quit") {
                this.Brain.KeepSession()
                this.Brain.Quit = true
                return
            }
            this.Show()
        }

        undefined TakeSession() {
            string id = this.pickedSession
            this.pickedSession = ""
            this.showHistory = false
            if (id == "new") { this.Brain.NewSession() }
            else { this.Brain.SwitchSession(id) }
            this.Show()
        }

        undefined TakePicked() {
            defined int i = this.picked
            this.picked = -1
            this.showHistory = false
            this.Brain.Choose(i)
            this.Show()
        }

        undefined AskTyped() {
            string q = this.question.Text
            this.question.Text = ""
            this.showHistory = false
            this.Brain.Visible = true
            this.Brain.Ask(q)
            this.Show()
        }

        undefined Poke() {
            this.showHistory = false
            this.Brain.Poke()
            this.Show()
        }

        undefined HideBubble() {
            this.Brain.Visible = false
            this.Brain.Asking = false
            this.Show()
        }

        undefined ToggleHistory() {
            this.showHistory = !this.showHistory
            this.shown = ""
            this.Show()
        }

        undefined NewTopic() {
            this.Brain.Forget()
            this.Brain.Say("New topic. What would you like to know?")
            this.Brain.Asking = true
            this.showHistory = false
            this.Show()
        }

        // Another character (its id); the session stays.
        undefined SetCharacter(string id) {
            if (id == this.Brain.Character.Id) { return }
            Assistant.Character next = Assistant.Character.Find(id)
            this.Brain.Character = next
            this.PaintIcon()
            this.Brain.Settings.Character = next.Id
            this.Brain.Settings.Save()
            this.Brain.Say(next.Hello)
            this.Brain.Asking = true
            this.Show()
        }

        // Shows the window until it is closed.
        undefined Run() {
            this.ui.Run()
            this.Brain.Close()
        }
    }
}
