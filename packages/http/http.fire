#import "net"
#import "tls"
#import "io"
#import "time"
#import "filesystem"
#import "hash"

namespace Http {
    // 1 bad URL, 2 bad message (a malformed request or response), 3 too many redirects, 4 too large, 5 not supported
    class HttpException : Exception {
        string message
        int code

        construct(string message, int code = 2) {
            this.message = message
            this.code = code
        }
    }

    // Numbers in text.
    class Num {
        // A whole number in decimal digits, -1 if there are none or something else is in the text.
        static int Parse(string text) {
            any t = text.Trim()
            if (t.Length == 0 || t.Length > 15) { return -1 }
            var n = 0
            for (var i = 0; i < t.Length; i++) {
                any d = t.CharAt(i).ToInt() - 48
                if (d < 0 || d > 9) { return -1 }
                n = n * 10 + d
            }
            return n
        }

        // The value of a hexadecimal digit (character code), -1 if it is none.
        static int HexDigit(int c) {
            if (c >= 48 && c <= 57) { return c - 48 }
            if (c >= 97 && c <= 102) { return c - 87 }
            if (c >= 65 && c <= 70) { return c - 55 }
            return -1
        }

        // A number in hexadecimal digits (the size of a chunk; a ";extension" after it is ignored), -1 if it is not one.
        static int ParseHex(string text) {
            any t = text.Trim()
            any semi = t.IndexOf(";")
            if (semi >= 0) { t = t.Substring(0, semi).Trim() }
            if (t.Length == 0 || t.Length > 8) { return -1 }
            var n = 0
            for (var i = 0; i < t.Length; i++) {
                var d = Http.Num.HexDigit(t.CharAt(i).ToInt())
                if (d < 0) { return -1 }
                n = n * 16 + d
            }
            return n
        }
    }

    // Percent encoding of URLs (UTF-8).
    class Uri {
        static string Digit(int d) {
            if (d < 10) { return "" + d }
            if (d == 10) { return "A" }
            if (d == 11) { return "B" }
            if (d == 12) { return "C" }
            if (d == 13) { return "D" }
            if (d == 14) { return "E" }
            return "F"
        }

        // The text for use in a URL: letters, digits and - _ . ~ stay, everything else becomes %XX (a space becomes %20).
        static string Encode(string text) {
            var bytes = IO.Utf8.GetBytes(text)
            var result = ""
            for (var i = 0; i < bytes.length; i++) {
                var b = bytes[i]
                var keep = (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 45 || b == 95 || b == 46 || b == 126
                if (keep) { result = result + b.ToChar() }
                else { result = result + "%" + Http.Uri.Digit(b / 16) + Http.Uri.Digit(b % 16) }
            }
            return result
        }

        // The text of a percent encoded one (`+` is a space with `plus = true`, as in a query); a malformed %XX stays as it is.
        static string Decode(string text, bool plus = false) {
            var sink = new IO.MemoryStream()
            var i = 0
            while (i < text.Length) {
                any c = text.CharAt(i).ToInt()
                var hi = -1
                var lo = -1
                if (c == 37 && i + 2 < text.Length) {
                    hi = Http.Num.HexDigit(text.CharAt(i + 1).ToInt())
                    lo = Http.Num.HexDigit(text.CharAt(i + 2).ToInt())
                }
                if (hi >= 0 && lo >= 0) {
                    sink.WriteByte(hi * 16 + lo)
                    i = i + 3
                } else if (c == 43 && plus) {
                    sink.WriteByte(32)
                    i = i + 1
                } else {
                    var one = IO.Utf8.GetBytes(text.Substring(i, 1))
                    sink.Write(one, 0, one.length)
                    i = i + 1
                }
            }
            var bytes = sink.ToBuffer()
            sink.Close()
            return IO.Utf8.GetString(bytes, 0, bytes.length)
        }
    }

    // scheme://host:port/path?query
    class Url {
        string scheme
        string host
        int port
        string path

        construct(string scheme, string host, int port, string path) {
            this.scheme = scheme
            this.host = host
            this.port = port
            this.path = path
        }

        // Reads an absolute http:// or https:// URL; Http.HttpException (code 1) for anything else.
        static Http.Url Parse(string text) {
            any t = text.Trim()
            any sep = t.IndexOf("://")
            if (sep <= 0) { throw new Http.HttpException("Not an absolute URL: '" + text + "'.", 1) }
            any scheme = t.Substring(0, sep).ToLower()
            if (scheme != "http" && scheme != "https") { throw new Http.HttpException("Unsupported URL scheme '" + scheme + "'.", 1) }
            any rest = t.Substring(sep + 3)
            any hash = rest.IndexOf("#")
            if (hash >= 0) { rest = rest.Substring(0, hash) }
            any slash = rest.IndexOf("/")
            any question = rest.IndexOf("?")
            if (question >= 0 && (slash < 0 || question < slash)) { slash = question }
            any authority = rest
            var path = "/"
            if (slash >= 0) {
                authority = rest.Substring(0, slash)
                path = rest.Substring(slash)
                if (path.StartsWith("?")) { path = "/" + path }
            }
            if (authority.IndexOf("@") >= 0) { authority = authority.Substring(authority.IndexOf("@") + 1) }
            var port = 80
            if (scheme == "https") { port = 443 }
            any host = authority
            if (authority.StartsWith("[")) {
                any close = authority.IndexOf("]")
                if (close < 0) { throw new Http.HttpException("Bad host in '" + text + "'.", 1) }
                host = authority.Substring(1, close - 1)
                any after = authority.Substring(close + 1)
                if (after.StartsWith(":")) { port = Http.Num.Parse(after.Substring(1)) }
            } else {
                any colon = authority.LastIndexOf(":")
                if (colon >= 0) {
                    host = authority.Substring(0, colon)
                    port = Http.Num.Parse(authority.Substring(colon + 1))
                }
            }
            if (host.Length == 0 || port < 1 || port > 65535) { throw new Http.HttpException("Bad host or port in '" + text + "'.", 1) }
            return new Http.Url(scheme, host, port, path)
        }

        // The value of the Host header.
        string HostHeader() {
            var h = this.host
            if (h.IndexOf(":") >= 0) { h = "[" + h + "]" }
            var standard = 80
            if (this.scheme == "https") { standard = 443 }
            if (this.port != standard) { h = h + ":" + this.port }
            return h
        }

        // The URL a `Location` header points to, seen from this one (absolute, `//host/...`, `/path` or relative).
        string Resolve(string location) {
            if (location.StartsWith("http://") || location.StartsWith("https://")) { return location }
            var origin = this.scheme + "://" + this.HostHeader()
            if (location.StartsWith("//")) { return this.scheme + ":" + location }
            if (location.StartsWith("/")) { return origin + location }
            var dir = this.path
            any q = dir.IndexOf("?")
            if (q >= 0) { dir = dir.Substring(0, q) }
            any last = dir.LastIndexOf("/")
            if (last >= 0) { dir = dir.Substring(0, last + 1) } else { dir = "/" }
            return origin + dir + location
        }

        string ToString() { return this.scheme + "://" + this.HostHeader() + this.path }
    }

    // The header fields of a message: names are compared without regard to case, the order is kept.
    class Headers {
        List names
        List values

        construct() {
            this.names = new List()
            this.values = new List()
        }

        int Count { get { return this.names.Count } }

        int IndexOf(string name) {
            any lower = name.ToLower()
            for (var i = 0; i < this.names.Count; i++) {
                if (this.names[i].ToLower() == lower) { return i }
            }
            return -1
        }

        bool Has(string name) { return this.IndexOf(name) >= 0 }

        // The first value of the field, undefined if there is none.
        string Get(string name) {
            var i = this.IndexOf(name)
            if (i < 0) { return undefined }
            return this.values[i]
        }

        // Sets the field (replaces the others of that name); returns the headers for chaining.
        Http.Headers Set(string name, string value) {
            this.Remove(name)
            this.names.Add(name)
            this.values.Add(value)
            return this
        }

        // Adds a field (a name can appear several times).
        Http.Headers Add(string name, string value) {
            this.names.Add(name)
            this.values.Add(value)
            return this
        }

        undefined Remove(string name) {
            any lower = name.ToLower()
            var i = this.names.Count - 1
            while (i >= 0) {
                if (this.names[i].ToLower() == lower) {
                    this.names.RemoveAt(i)
                    this.values.RemoveAt(i)
                }
                i = i - 1
            }
        }

        // Name and value of field i (0 .. Count - 1) as "Name: value".
        string Line(int i) { return this.names[i] + ": " + this.values[i] }

        // All fields as "Name: value\r\n" lines.
        string ToString() {
            var text = ""
            for (var i = 0; i < this.names.Count; i++) { text = text + this.names[i] + ": " + this.values[i] + "\r\n" }
            return text
        }
    }

    class Status {
        // The standard reason phrase of a status code.
        static string Reason(int code) {
            if (code == 100) { return "Continue" }
            if (code == 200) { return "OK" }
            if (code == 201) { return "Created" }
            if (code == 202) { return "Accepted" }
            if (code == 204) { return "No Content" }
            if (code == 206) { return "Partial Content" }
            if (code == 301) { return "Moved Permanently" }
            if (code == 302) { return "Found" }
            if (code == 303) { return "See Other" }
            if (code == 304) { return "Not Modified" }
            if (code == 307) { return "Temporary Redirect" }
            if (code == 308) { return "Permanent Redirect" }
            if (code == 400) { return "Bad Request" }
            if (code == 401) { return "Unauthorized" }
            if (code == 403) { return "Forbidden" }
            if (code == 404) { return "Not Found" }
            if (code == 405) { return "Method Not Allowed" }
            if (code == 408) { return "Request Timeout" }
            if (code == 409) { return "Conflict" }
            if (code == 411) { return "Length Required" }
            if (code == 413) { return "Payload Too Large" }
            if (code == 414) { return "URI Too Long" }
            if (code == 415) { return "Unsupported Media Type" }
            if (code == 431) { return "Request Header Fields Too Large" }
            if (code == 500) { return "Internal Server Error" }
            if (code == 501) { return "Not Implemented" }
            if (code == 502) { return "Bad Gateway" }
            if (code == 503) { return "Service Unavailable" }
            if (code == 505) { return "HTTP Version Not Supported" }
            return "Status " + code
        }

        // true for the codes whose message has no body (1xx, 204, 304).
        static bool NoBody(int code) { return code < 200 || code == 204 || code == 304 }
    }

    // A response: what the client got, and what a route returns.
    class Response {
        int status
        string reason
        Headers headers
        byte body[]
        string url
        // A body that is read from a stream while it is sent (Http.AppServer; instead of `body`): `streamLength` bytes, or chunked when it is -1.
        IO.IStream stream
        int streamLength
        // A 101 answer of a WebSocket handshake: after it the task of the connection gives the connection to this handler (Http.WebSockets).
        Http.IWebSocketHandler upgrade
        // ... and what the handler gets of the request: its header fields and its target (path and query)
        Http.Headers upgradeHeaders
        string upgradeTarget

        construct(int status = 200, any body = undefined) {
            this.status = status
            this.reason = Http.Status.Reason(status)
            this.headers = new Http.Headers()
            this.url = ""
            this.body = Http.Response.Bytes(body)
            this.stream = undefined
            this.streamLength = -1
            this.upgrade = undefined
            this.upgradeHeaders = undefined
            this.upgradeTarget = undefined
        }

        // A response whose body is read from `stream` while it is sent (a file, a pipe); the response owns the stream and the server closes it. Without a
        // `length` the body goes chunked.
        static Http.Response FromStream(IO.IStream stream, string contentType = "application/octet-stream", int length = -1, int status = 200) {
            var r = new Http.Response(status)
            r.stream = take stream
            r.streamLength = length
            r.headers.Set("Content-Type", contentType)
            return r
        }

        // The body as bytes: a text becomes UTF-8, a buffer stays, undefined is empty.
        static byte[] Bytes(any body) {
            if (body == undefined) { return new byte[0] }
            if (body is of string) { return IO.Utf8.GetBytes(body) }
            return body
        }

        // A text response (default `text/plain; charset=utf-8`).
        static Http.Response FromText(string text, int status = 200, string contentType = "text/plain; charset=utf-8") {
            var r = new Http.Response(status, text)
            r.headers.Set("Content-Type", contentType)
            return r
        }

        static Http.Response FromHtml(string html, int status = 200) { return Http.Response.FromText(html, status, "text/html; charset=utf-8") }

        static Http.Response FromJson(string json, int status = 200) { return Http.Response.FromText(json, status, "application/json") }

        // A response with only a status line and an explanation as text.
        static Http.Response Error(int status, string message = undefined) {
            if (message == undefined) { message = Http.Status.Reason(status) }
            return Http.Response.FromText(message, status)
        }

        // 303/302 to another address.
        static Http.Response Redirect(string location, int status = 302) {
            var r = new Http.Response(status)
            r.headers.Set("Location", location)
            return r
        }

        bool Ok { get { return this.status >= 200 && this.status < 300 } }

        int Length { get { return this.body.length } }

        // The body as text (UTF-8).
        string Text() { return IO.Utf8.GetString(this.body, 0, this.body.length) }

        // The value of a header field, undefined if it is not there.
        string Header(string name) { return this.headers.Get(name) }
    }

    // A request as the server gets it.
    class Request {
        string method
        string target
        string path
        string queryText
        string version
        Headers headers
        byte body[]
        string remoteHost

        construct(string method, string target) {
            this.method = method
            this.target = target
            this.version = "HTTP/1.1"
            this.headers = new Http.Headers()
            this.body = new byte[0]
            this.remoteHost = ""
            any q = target.IndexOf("?")
            if (q < 0) {
                this.path = Http.Uri.Decode(target)
                this.queryText = ""
            } else {
                this.path = Http.Uri.Decode(target.Substring(0, q))
                this.queryText = target.Substring(q + 1)
            }
        }

        // The value of a query parameter (`?name=value&...`, percent decoded), `fallback` if it is not there.
        any Query(string name, any fallback = undefined) {
            if (this.queryText.Length == 0) { return fallback }
            any pairs = this.queryText.Split("&")
            for (var i = 0; i < pairs.length; i++) {
                any pair = pairs[i]
                any eq = pair.IndexOf("=")
                any key = pair
                var value = ""
                if (eq >= 0) {
                    key = pair.Substring(0, eq)
                    value = pair.Substring(eq + 1)
                }
                if (Http.Uri.Decode(key, true) == name) { return Http.Uri.Decode(value, true) }
            }
            return fallback
        }

        // The body as text (UTF-8).
        string Text() { return IO.Utf8.GetString(this.body, 0, this.body.length) }

        string Header(string name) { return this.headers.Get(name) }
    }

    // Reads from a stream with a buffer of its own: lines, exact numbers of bytes, the rest.
    class Reader {
        IO.IStream source
        byte chunk[]
        int pos
        int len
        bool eof

        construct(IO.IStream source) {
            this.source = source
            this.chunk = new byte[4096]
            this.pos = 0
            this.len = 0
            this.eof = false
        }

        // Makes sure chunk[pos..len) has data; false at the end of the stream.
        bool Fill() {
            if (this.pos < this.len) { return true }
            if (this.eof) { return false }
            var n = this.source.Read(this.chunk, 0, 4096)
            if (n <= 0) {
                this.eof = true
                this.pos = 0
                this.len = 0
                return false
            }
            this.pos = 0
            this.len = n
            return true
        }

        // The next line without its line break, undefined at the end of the stream (a line longer than `limit` bytes is an error, code 4).
        string ReadLine(int limit = 8192) {
            IO.MemoryStream pending = undefined
            var total = 0
            while (this.Fill()) {
                var nl = __IOBufferIndexOf(this.chunk, this.pos, this.len - this.pos, 10)
                var upto = this.len
                if (nl >= 0) { upto = nl }
                total = total + (upto - this.pos)
                if (total > limit) { throw new Http.HttpException("A line is longer than " + limit + " bytes.", 4) }
                if (nl >= 0) {
                    string text = undefined
                    if (pending == undefined) {
                        any count = nl - this.pos
                        if (count > 0 && this.chunk[nl - 1] == 13) { count = count - 1 }
                        text = IO.Utf8.GetString(this.chunk, this.pos, count)
                    } else {
                        pending.Write(this.chunk, this.pos, nl - this.pos)
                        any bytes = pending.ToBuffer()
                        any count2 = bytes.length
                        if (count2 > 0 && bytes[count2 - 1] == 13) { count2 = count2 - 1 }
                        text = IO.Utf8.GetString(bytes, 0, count2)
                        pending.Close()
                    }
                    this.pos = nl + 1
                    return text
                }
                if (pending == undefined) { pending = new IO.MemoryStream() }
                pending.Write(this.chunk, this.pos, this.len - this.pos)
                this.pos = this.len
            }
            if (pending == undefined) { return undefined }
            var rest = pending.ToBuffer()
            pending.Close()
            if (rest.length == 0) { return undefined }
            return IO.Utf8.GetString(rest, 0, rest.length)
        }

        // Exactly `count` bytes; Http.HttpException (code 2) if the stream ends first.
        byte[] ReadExact(int count) {
            var result = new byte[count]
            var done = 0
            while (done < count && this.pos < this.len) {
                result[done] = this.chunk[this.pos]
                done = done + 1
                this.pos = this.pos + 1
            }
            while (done < count) {
                var n = this.source.Read(result, done, count - done)
                if (n <= 0) { throw new Http.HttpException("The connection ended before the whole message arrived.", 2) }
                done = done + n
            }
            return result
        }

        // Everything up to the end of the stream (an error of code 4 beyond `limit` bytes).
        byte[] ReadToEnd(int limit) {
            var sink = new IO.MemoryStream()
            if (this.pos < this.len) {
                sink.Write(this.chunk, this.pos, this.len - this.pos)
                this.pos = this.len
            }
            var tmp = new byte[4096]
            while (!this.eof) {
                var n = this.source.Read(tmp, 0, 4096)
                if (n <= 0) { this.eof = true }
                else {
                    sink.Write(tmp, 0, n)
                    if (sink.Length > limit) { throw new Http.HttpException("The message is larger than " + limit + " bytes.", 4) }
                }
            }
            var bytes = sink.ToBuffer()
            sink.Close()
            return bytes
        }
    }

    // The message format on the wire.
    class Wire {
        // The header fields up to the empty line.
        static undefined ReadHeaders(Reader reader, Headers headers) {
            var count = 0
            while (true) {
                var line = reader.ReadLine(8192)
                if (line == undefined) { throw new Http.HttpException("The connection ended inside the header.", 2) }
                if (line.Length == 0) { return }
                count = count + 1
                if (count > 100) { throw new Http.HttpException("Too many header fields.", 4) }
                any colon = line.IndexOf(":")
                if (colon <= 0) { throw new Http.HttpException("A header field without a name: '" + line + "'.", 2) }
                headers.Add(line.Substring(0, colon).Trim(), line.Substring(colon + 1).Trim())
            }
        }

        // The body of a message: chunked, with a Content-Length, or (a response only: `untilClose`) up to the end of the connection.
        static byte[] ReadBody(Reader reader, Headers headers, bool untilClose, int limit) {
            var te = headers.Get("Transfer-Encoding")
            if (te != undefined && te.ToLower().IndexOf("chunked") >= 0) {
                var sink = new IO.MemoryStream()
                while (true) {
                    var sizeLine = reader.ReadLine(8192)
                    if (sizeLine == undefined) { throw new Http.HttpException("The connection ended inside a chunked body.", 2) }
                    var size = Http.Num.ParseHex(sizeLine)
                    if (size < 0) { throw new Http.HttpException("A bad chunk size: '" + sizeLine + "'.", 2) }
                    if (size == 0) {
                        // the trailer fields, then the empty line
                        var trailer = reader.ReadLine(8192)
                        while (trailer != undefined && trailer.Length > 0) { trailer = reader.ReadLine(8192) }
                        break
                    }
                    if (sink.Length + size > limit) { throw new Http.HttpException("The message is larger than " + limit + " bytes.", 4) }
                    var data = reader.ReadExact(size)
                    sink.Write(data, 0, data.length)
                    reader.ReadLine(8192)
                }
                var all = sink.ToBuffer()
                sink.Close()
                return all
            }
            var cl = headers.Get("Content-Length")
            if (cl != undefined) {
                var n = Http.Num.Parse(cl)
                if (n < 0) { throw new Http.HttpException("A bad Content-Length: '" + cl + "'.", 2) }
                if (n > limit) { throw new Http.HttpException("The message is larger than " + limit + " bytes.", 4) }
                return reader.ReadExact(n)
            }
            if (untilClose) { return reader.ReadToEnd(limit) }
            return new byte[0]
        }

        // Writes the start line, the header fields, the empty line and the body.
        static undefined Write(IO.IStream stream, string startLine, Headers headers, any body) {
            var head = IO.Utf8.GetBytes(startLine + "\r\n" + headers.ToString() + "\r\n")
            stream.Write(head, 0, head.length)
            if (body != undefined && body.length > 0) { stream.Write(body, 0, body.length) }
        }
    }

    // Opens the connection to a URL (the scheme decides: http is a TCP connection, https a TLS connection over it).
    class Transport {
        static Net.IConnection Open(Url url, int timeout, Tls.Options tls = undefined) {
            if (url.scheme == "http") {
                var tcp = new Net.TcpClient(url.host, url.port, timeout)
                tcp.NoDelay = true
                return tcp
            }
            if (url.scheme == "https") { return Tls.Stream.Connect(url.host, url.port, tls, timeout) }
            throw new Http.HttpException("The scheme '" + url.scheme + "' is not supported.", 5)
        }
    }

    class Client {
        int timeout
        int maxRedirects
        bool followRedirects
        int maxBodyBytes
        string userAgent
        Headers headers
        // The Tls.Options for https:// URLs (undefined: verify against the system's certificates).
        Tls.Options tls

        construct() {
            this.tls = undefined
            this.timeout = 30000
            this.maxRedirects = 5
            this.followRedirects = true
            this.maxBodyBytes = 16777216
            this.userAgent = "fire-http/1"
            this.headers = new Http.Headers()
        }

        // GET, POST, PUT, DELETE, HEAD: `headers` is an Http.Headers (or undefined); a body is a text (UTF-8) or a byte buffer.
        Http.Response Get(string url, Headers headers = undefined) { return this.Request("GET", url, undefined, headers) }
        Http.Response Head(string url, Headers headers = undefined) { return this.Request("HEAD", url, undefined, headers) }
        Http.Response Delete(string url, Headers headers = undefined) { return this.Request("DELETE", url, undefined, headers) }

        Http.Response Post(string url, any body, string contentType = undefined, Headers headers = undefined) {
            return this.WithType("POST", url, body, contentType, headers)
        }

        Http.Response Put(string url, any body, string contentType = undefined, Headers headers = undefined) {
            return this.WithType("PUT", url, body, contentType, headers)
        }

        Http.Response WithType(string method, string url, any body, string contentType, Headers headers) {
            var h = new Http.Headers()
            if (headers != undefined) {
                for (var i = 0; i < headers.Count; i++) { h.Add(headers.names[i], headers.values[i]) }
            }
            if (contentType != undefined) { h.Set("Content-Type", contentType) }
            else if (!h.Has("Content-Type")) {
                if (body is of string) { h.Set("Content-Type", "text/plain; charset=utf-8") }
                else { h.Set("Content-Type", "application/octet-stream") }
            }
            return this.Request(method, url, body, h)
        }

        // Sends the request and returns the Http.Response (redirects are followed unless `followRedirects` is false).
        Http.Response Request(string method, string url, any body, Headers headers) {
            var current = url
            var verb = method
            any payload = body
            var redirects = 0
            while (true) {
                var parsed = Http.Url.Parse(current)
                var response = this.Once(verb, parsed, payload, headers)
                var location = response.headers.Get("Location")
                var s = response.status
                var redirect = s == 301 || s == 302 || s == 303 || s == 307 || s == 308
                if (this.followRedirects && redirect && location != undefined) {
                    redirects = redirects + 1
                    if (redirects > this.maxRedirects) { throw new Http.HttpException("More than " + this.maxRedirects + " redirects.", 3) }
                    current = parsed.Resolve(location)
                    if ((s == 301 || s == 302 || s == 303) && verb != "HEAD") {
                        verb = "GET"
                        payload = undefined
                    }
                    continue
                }
                response.url = current
                return response
            }
        }

        // One request and its response over a connection of its own.
        Http.Response Once(string method, Url url, any body, Headers headers) {
            byte bytes[] = undefined
            if (body != undefined) { bytes = Http.Response.Bytes(body) }
            var h = new Http.Headers()
            h.Set("Host", url.HostHeader())
            h.Set("User-Agent", this.userAgent)
            h.Set("Accept", "*/*")
            h.Set("Connection", "close")
            for (var i = 0; i < this.headers.Count; i++) { h.Set(this.headers.names[i], this.headers.values[i]) }
            if (headers != undefined) {
                for (var j = 0; j < headers.Count; j++) { h.Set(headers.names[j], headers.values[j]) }
            }
            if (bytes != undefined) { h.Set("Content-Length", "" + bytes.length) }
            else if (method == "POST" || method == "PUT") { h.Set("Content-Length", "0") }
            var stream = Http.Transport.Open(url, this.timeout, this.tls)
            try {
                stream.ReadTimeout = this.timeout
                stream.WriteTimeout = this.timeout
                Http.Wire.Write(stream, method + " " + url.path + " HTTP/1.1", h, bytes)
                var reader = new Http.Reader(stream)
                var line = reader.ReadLine(8192)
                while (line != undefined && line.Length == 0) { line = reader.ReadLine(8192) }
                if (line == undefined) { throw new Http.HttpException("The server closed the connection without an answer.", 2) }
                any parts = line.Split(" ")
                if (parts.length < 2 || !parts[0].StartsWith("HTTP/")) { throw new Http.HttpException("Not an HTTP answer: '" + line + "'.", 2) }
                var status = Http.Num.Parse(parts[1])
                if (status < 100 || status > 599) { throw new Http.HttpException("A bad status code: '" + parts[1] + "'.", 2) }
                var response = new Http.Response(status)
                var reason = ""
                for (var k = 2; k < parts.length; k++) {
                    if (k > 2) { reason = reason + " " }
                    reason = reason + parts[k]
                }
                if (reason.Length > 0) { response.reason = reason }
                Http.Wire.ReadHeaders(reader, response.headers)
                if (method != "HEAD" && !Http.Status.NoBody(status)) {
                    response.body = Http.Wire.ReadBody(reader, response.headers, true, this.maxBodyBytes)
                }
                stream.Close()
                return response
            } catch (Http.HttpException e) {
                stream.Close()
                throw e
            } catch (Net.NetException e) {
                stream.Close()
                throw e
            }
        }
    }

    // A route: method ("*" = any), path (a trailing "*" matches every path that starts with the text before it) and the lambda that answers.
    class RouteEntry {
        string method
        string path
        lambda<any> handler   // (lambda<Http.Request> for the routes of the server, lambda<Http.Context> for Http.Routes)

        construct(string method, string path, lambda<any> handler) {
            this.method = method
            this.path = path
            this.handler = take handler   // (the route owns its handler - a lambda belongs to its owner like an object)
        }

        bool Matches(string requestMethod, string requestPath) {
            // (a HEAD request is answered by the route for GET, without the body)
            if (this.method != "*" && this.method != requestMethod && !(this.method == "GET" && requestMethod == "HEAD")) { return false }
            if (this.path.EndsWith("*")) { return requestPath.StartsWith(this.path.Substring(0, this.path.Length - 1)) }
            return this.path == requestPath
        }
    }

    // A small HTTP server: one connection after the other. `Route(method, path, lambda)` where the lambda gets the Http.Request and returns an Http.Response (a text becomes a
    // 200 text response, undefined a 204).
    class Server {
        Net.TcpListener listener
        List routes
        lambda<Http.Request> fallback
        lambda<any> onError
        Tls.Server tlsServer
        int readTimeout
        int maxBodyBytes
        bool stopped

        // new Http.Server("127.0.0.1", 8080) - host "" listens on every interface, port 0 takes a free port (see Port).
        construct(string host, int port, int backlog = 16) {
            this.routes = new List()
            this.fallback = undefined
            this.onError = undefined
            this.tlsServer = undefined
            this.readTimeout = 10000
            this.maxBodyBytes = 1048576
            this.stopped = false
            this.listener = new Net.TcpListener(host, port, backlog)
        }

        int Port { get { return this.listener.Port } }

        undefined Route(string method, string path, lambda<Http.Request> handler) {
            var entry = new Http.RouteEntry(method, path, handler)
            entry.TakeTo(this)
            this.routes.Add(entry)
        }

        // The answer to every request that no route matches (default: 404).
        undefined Fallback(lambda<Http.Request> handler) { this.fallback = take handler }

        // Called with the exception when a route's lambda throws (the client gets a 500).
        undefined OnError(lambda<any> handler) { this.onError = take handler }

        // Serves HTTPS: the certificate (with its chain) and the private key as PEM text. Needs the tls package's support in this build (Tls.Support.Available()).
        undefined UseTls(string certPem, string keyPem) { this.tlsServer = new Tls.Server(certPem, keyPem) }

        undefined Stop() { this.stopped = true }

        // Waits up to `timeout` for a connection and answers it; true if one was served, false when the time ran out.
        bool ServeOne(any timeout = undefined) {
            var tcp = this.listener.TryAccept(timeout)
            if (tcp == undefined) { return false }
            Net.IConnection connection = tcp
            if (this.tlsServer != undefined) {
                try {
                    connection = this.tlsServer.Accept(tcp, this.readTimeout)
                } catch (Net.NetException e) {
                    return true   // a client that did not complete the handshake: nothing to answer
                }
            }
            this.Handle(connection)
            return true
        }

        // Serves until Stop() is called (from a route, or from another fire thread through its own channel - there is no shared state).
        undefined Run() {
            while (!this.stopped) { this.ServeOne(250) }
        }

        // Answers one request on a connection (a Net.TcpClient, a Tls.Stream) and closes it.
        undefined Handle(Net.IConnection connection) {
            try {
                connection.ReadTimeout = this.readTimeout
                connection.WriteTimeout = this.readTimeout
                Http.Response response = undefined
                var head = false
                try {
                    var request = this.ReadRequest(connection)
                    if (request == undefined) { connection.Close(); return }
                    head = request.method == "HEAD"
                    response = this.Dispatch(request)
                } catch (Http.HttpException e) {
                    var status = 400
                    if (e.code == 4) { status = 413 }
                    response = Http.Response.Error(status, e.message)
                } catch (Net.TimeoutException e) {
                    response = Http.Response.Error(408)
                }
                this.Send(connection, response, head)
            } catch (Net.NetException e) {
                // the client went away
            }
            connection.Close()
        }

        // The request, or undefined if the client closed without sending one.
        Http.Request ReadRequest(Net.IConnection connection) {
            var reader = new Http.Reader(connection)
            var line = reader.ReadLine(8192)
            while (line != undefined && line.Length == 0) { line = reader.ReadLine(8192) }
            if (line == undefined) { return undefined }
            any parts = line.Split(" ")
            if (parts.length != 3 || !parts[2].StartsWith("HTTP/")) { throw new Http.HttpException("A bad request line: '" + line + "'.", 2) }
            var request = new Http.Request(parts[0], parts[1])
            request.version = parts[2]
            request.remoteHost = connection.RemoteHost
            Http.Wire.ReadHeaders(reader, request.headers)
            request.body = Http.Wire.ReadBody(reader, request.headers, false, this.maxBodyBytes)
            return request
        }

        Http.Response Dispatch(Http.Request request) {
            any result = undefined
            try {
                var handler = this.fallback
                for (var i = 0; i < this.routes.Count; i++) {
                    any route = this.routes[i]
                    if (route.Matches(request.method, request.path)) {
                        handler = route.handler
                        break
                    }
                }
                if (handler == undefined) { return Http.Response.Error(404) }
                result = handler(request)
            } catch (e) {
                var report = this.onError
                if (report != undefined) { report(e) }
                return Http.Response.Error(500)
            }
            if (result == undefined) { return new Http.Response(204) }
            if (result is of string) { return Http.Response.FromText(result) }
            return result
        }

        undefined Send(IO.IStream connection, Http.Response response, bool head) {
            var h = new Http.Headers()
            for (var i = 0; i < response.headers.Count; i++) { h.Add(response.headers.names[i], response.headers.values[i]) }
            h.Set("Content-Length", "" + response.body.length)
            h.Set("Connection", "close")
            if (!h.Has("Server")) { h.Set("Server", "fire-http/1") }
            var body = response.body
            if (head || Http.Status.NoBody(response.status)) { body = undefined }
            Http.Wire.Write(connection, "HTTP/1.1 " + response.status + " " + response.reason, h, body)
        }

        undefined Close() {
            this.listener.Close()
            if (this.tlsServer != undefined) { this.tlsServer.Close() }
        }
    }

    // ---- the application server (docs/ROADMAP_HTTP.md step 1): a task per connection, keep-alive, a chain of routers -------------------------------------

    // A link of the chain: answers the request itself, or hands it on with `next.Invoke(ctx)` - and may work on the answer of the rest of the chain.
    interface IRouter {
        Http.Response Handle(Http.Context ctx, Http.Next next)
    }

    // The rest of the chain behind a router.
    class Next {
        List chain
        int index

        construct(List chain, int index) {
            this.chain = chain
            this.index = index
        }

        // The answer of the rest of the chain (404 when nothing is left).
        Http.Response Invoke(Http.Context ctx) {
            if (this.index >= this.chain.Count) { return Http.Response.Error(404) }
            Http.IRouter router = this.chain[this.index]
            var rest = new Http.Next(this.chain, this.index + 1)
            return router.Handle(ctx, rest)
        }
    }

    // What a request carries through the chain: the request, and what the routers note for the ones behind them (`Items`, e.g. the user, the session).
    class Context {
        Http.Request request
        Dictionary<string, any> items
        int number

        construct(Http.Request request, int number) {
            this.request = take request
            this.items = new Dictionary<string, any>()
            this.number = number
        }

        Http.Request Request { get { return this.request } }
        // The number of the request on its connection (1 for the first).
        int Number { get { return this.number } }

        any Item(string name, any fallback = undefined) {
            if (this.items.ContainsKey(name)) { return this.items[name] }
            return fallback
        }
        undefined SetItem(string name, any value) { this.items[name] = value }
    }

    // A router from a lambda: func (Http.Context ctx, Http.Next next) => ... returns the Http.Response.
    class LambdaRouter : IRouter {
        lambda<Http.Context, Http.Next> handler

        construct(lambda<Http.Context, Http.Next> handler) { this.handler = take handler }

        Http.Response Handle(Http.Context ctx, Http.Next next) {
            var h = this.handler
            any result = h(ctx, next)
            return Http.AppServer.AsResponse(result)
        }
    }

    // The explicit routes as a link of the chain: method and path to a lambda that gets the Http.Context (a text becomes a 200 text response, undefined a
    // 204); a request that no route matches goes on to the next link.
    class Routes : IRouter {
        List entries

        construct() { this.entries = new List() }

        Http.Routes Map(string method, string path, lambda<Http.Context> handler) {
            var entry = new Http.RouteEntry(method, path, handler)
            entry.TakeTo(this)
            this.entries.Add(entry)
            return this
        }

        Http.Response Handle(Http.Context ctx, Http.Next next) {
            for (var i = 0; i < this.entries.Count; i++) {
                Http.RouteEntry route = this.entries[i]
                if (route.Matches(ctx.request.method, ctx.request.path)) {
                    var h = route.handler
                    any result = h(ctx)
                    return Http.AppServer.AsResponse(result)
                }
            }
            return next.Invoke(ctx)
        }
    }

    // The settings of an application server (copied to every connection).
    class ServerSettings {
        int readTimeout = 10000          // ms for every read and write inside a request
        int keepAlive = 5000             // ms an idle connection waits for its next request
        int maxRequests = 1000           // requests per connection, then it is closed
        int maxBodyBytes = 1048576       // of a request
        string serverName = "fire-http/1"
        bool showErrors = false          // a 500 tells the class and message of what a router threw (for development)
    }

    // An application server: every connection is a task of its own (natively light tasks on all cores), it serves request after request (keep-alive) and
    // every request runs through the chain of routers. Every connection gets a copy of the chain when it starts: routers are configuration - what they share
    // (counters, caches, sessions) lives in an actor they ask with `await`.
    //
    //     var server = new Http.AppServer("127.0.0.1", 8080)
    //     server.PushTo(new Http.LambdaRouter(func (Http.Context ctx, Http.Next next) => next.Invoke(ctx)))
    //           .PushTo((new Http.Routes()).Map("GET", "/hello", func (Http.Context ctx) => "hello"))
    //     server.Run()                       // until Stop() or the task's token is cancelled (await server.Run() until source.Token)
    class AppServer {
        Net.TcpListener listener
        List chain
        Http.ServerSettings settings
        Tls.Server tlsServer
        bool stopped
        int served

        construct(string host, int port, int backlog = 128) {
            this.chain = new List()
            this.settings = new Http.ServerSettings()
            this.tlsServer = undefined
            this.stopped = false
            this.served = 0
            this.listener = new Net.TcpListener(host, port, backlog)
        }

        int Port { get { return this.listener.Port } }
        Http.ServerSettings Settings { get { return this.settings } }
        // The connections accepted so far.
        int Connections { get { return this.served } }

        // Adds a router at the end of the chain (the server owns it); returns the server, so the calls can be chained.
        Http.AppServer PushTo(Http.IRouter router) {
            router.TakeTo(this)
            this.chain.Add(router)
            return this
        }

        // A router from a lambda (see LambdaRouter).
        Http.AppServer Use(lambda<Http.Context, Http.Next> handler) { return this.PushTo(new Http.LambdaRouter(take handler)) }

        // Serves HTTPS: the certificate (with its chain) and the private key as PEM text. The handshake runs in the accepting task.
        undefined UseTls(string certPem, string keyPem) { this.tlsServer = new Tls.Server(certPem, keyPem) }

        undefined Stop() { this.stopped = true }

        // Waits up to `timeout` for a connection and starts its task; true if one came.
        bool AcceptOne(any timeout = undefined) {
            var tcp = this.listener.TryAccept(timeout)
            if (tcp == undefined) { return false }
            this.served = this.served + 1
            tcp.NoDelay = true
            Net.IConnection connection = tcp
            if (this.tlsServer != undefined) {
                try { connection = this.tlsServer.Accept(tcp, this.settings.readTimeout) }
                catch (Net.NetException e) { return true }   // (a client that did not complete the handshake)
            }
            if (!Http.AppServer.Spawn(connection, this.chain, this.settings)) {
                // (a chain that cannot be copied for a task - a [NoCopy] object in a router: the connection is served here, one request without
                // keep-alive)
                Http.AppServer.Serve(connection, this.chain, this.settings, false)
            }
            return true
        }

        // The task of a connection: it owns the connection and serves it with copies of the chain and the settings. False when the chain cannot be copied
        // (nothing moved then).
        static bool Spawn(Net.IConnection connection, List chain, Http.ServerSettings settings) {
            try {
                fire handover connection taking chain taking settings {
                    Http.AppServer.Serve(connection, chain, settings, true)
                }
            } catch (ArgumentException e) {
                return false
            }
            return true
        }

        // Accepts connections until Stop() or until the token of the running task is cancelled.
        undefined Run() {
            var token = CancellationToken.Current()
            while (!this.stopped && !token.IsCancelled) { this.AcceptOne(250) }
        }

        // Stops listening and closes the routers that hold something (Http.IClosable: the home of the sessions).
        undefined Close() {
            this.listener.Close()
            if (this.tlsServer != undefined) { this.tlsServer.Close() }
            for (var i = 0; i < this.chain.Count; i++) {
                any router = this.chain[i]
                if (router is of Http.IClosable) {
                    Http.IClosable c = router
                    c.Close()
                }
            }
        }

        // ---- inside the task of a connection ----

        // Serves the requests of one connection until the client closes it, asks to close it, stays idle longer than `keepAlive` or `maxRequests` are done.
        static undefined Serve(Net.IConnection connection, List chain, Http.ServerSettings settings, bool keepAlive) {
            try {
                connection.WriteTimeout = settings.readTimeout
                var reader = new Http.Reader(connection)
                var number = 0
                var open = true
                while (open) {
                    number = number + 1
                    Http.Response response = undefined
                    var head = false
                    var keep = false
                    try {
                        connection.ReadTimeout = settings.keepAlive
                        var request = Http.AppServer.ReadRequest(reader, connection, settings)
                        if (request == undefined) { break }
                        head = request.method == "HEAD"
                        keep = keepAlive && number < settings.maxRequests && Http.AppServer.WantsKeepAlive(request)
                        var ctx = new Http.Context(take request, number)
                        response = Http.AppServer.Dispatch(chain, ctx, settings)
                    } catch (Net.TimeoutException e) {
                        if (number == 1 || reader.pos < reader.len) { response = Http.Response.Error(408) } else { break }   // (idle: just close)
                    } catch (Http.HttpException e) {
                        var status = 400
                        if (e.code == 4) { status = 413 }
                        response = Http.Response.Error(status, e.message)
                    }
                    if (response.upgrade != undefined) {
                        // (a WebSocket: the 101 goes out, then the handler has the connection until it ends)
                        Http.AppServer.Send(connection, response, false, true, settings)
                        connection.ReadTimeout = undefined
                        var ws = new Http.WebSocket(connection, reader, false)
                        ws.headers = response.upgradeHeaders
                        ws.target = response.upgradeTarget
                        try { response.upgrade.Serve(ws) } catch (Net.NetException e) { }
                        ws.CloseQuietly()
                        break
                    }
                    Http.AppServer.Send(connection, response, head, keep, settings)
                    open = keep
                }
            } catch (Net.NetException e) {
                // the client went away
            }
            connection.Close()
        }

        // The next request of the connection (the first line waits up to keepAlive, the rest up to readTimeout); undefined when the client closed.
        static Http.Request ReadRequest(Http.Reader reader, Net.IConnection connection, Http.ServerSettings settings) {
            var line = reader.ReadLine(8192)
            while (line != undefined && line.Length == 0) { line = reader.ReadLine(8192) }
            if (line == undefined) { return undefined }
            connection.ReadTimeout = settings.readTimeout
            any parts = line.Split(" ")
            if (parts.length != 3 || !parts[2].StartsWith("HTTP/")) { throw new Http.HttpException("A bad request line: '" + line + "'.", 2) }
            var request = new Http.Request(parts[0], parts[1])
            request.version = parts[2]
            request.remoteHost = connection.RemoteHost
            Http.Wire.ReadHeaders(reader, request.headers)
            request.body = Http.Wire.ReadBody(reader, request.headers, false, settings.maxBodyBytes)
            return request
        }

        static bool WantsKeepAlive(Http.Request request) {
            var c = request.headers.Get("Connection")
            if (c != undefined) {
                string lower = c.ToLower()
                if (lower.IndexOf("close") >= 0) { return false }
                if (lower.IndexOf("keep-alive") >= 0) { return true }
            }
            return request.version == "HTTP/1.1"
        }

        // The answer of the chain; an exception of a router is a 500.
        static Http.Response Dispatch(List chain, Http.Context ctx, Http.ServerSettings settings) {
            try {
                var first = new Http.Next(chain, 0)
                return first.Invoke(ctx)
            } catch (e) {
                if (settings.showErrors) { return Http.Response.Error(500, "" + e.message) }
                return Http.Response.Error(500)
            }
        }

        // What a lambda returned as a response: a text is a 200 text response, undefined a 204.
        static Http.Response AsResponse(any result) {
            if (result == undefined) { return new Http.Response(204) }
            if (result is of string) { return Http.Response.FromText(result) }
            return result
        }

        static undefined Send(IO.IStream connection, Http.Response response, bool head, bool keep, Http.ServerSettings settings) {
            var h = new Http.Headers()
            for (var i = 0; i < response.headers.Count; i++) { h.Add(response.headers.names[i], response.headers.values[i]) }
            var noBody = head || Http.Status.NoBody(response.status)
            var chunked = false
            if (response.stream != undefined) {
                if (response.streamLength >= 0) { h.Set("Content-Length", "" + response.streamLength) }
                else if (!noBody) { h.Set("Transfer-Encoding", "chunked"); chunked = true }
            } else {
                h.Set("Content-Length", "" + response.body.length)
            }
            if (response.status == 101) { h.Remove("Content-Length") }
            else if (keep) { h.Set("Connection", "keep-alive") } else { h.Set("Connection", "close") }
            if (!h.Has("Server")) { h.Set("Server", settings.serverName) }
            if (response.stream == undefined) {
                var body = response.body
                if (noBody) { body = undefined }
                Http.Wire.Write(connection, "HTTP/1.1 " + response.status + " " + response.reason, h, body)
                return
            }
            Http.Wire.Write(connection, "HTTP/1.1 " + response.status + " " + response.reason, h, undefined)
            if (!noBody) {
                var buf = new byte[16384]
                while (true) {
                    var n = response.stream.Read(buf, 0, buf.length)
                    if (n <= 0) { break }
                    if (chunked) {
                        var size = IO.Utf8.GetBytes(Http.AppServer.Hex(n) + "\r\n")
                        connection.Write(size, 0, size.length)
                    }
                    connection.Write(buf, 0, n)
                    if (chunked) {
                        var crlf = IO.Utf8.GetBytes("\r\n")
                        connection.Write(crlf, 0, 2)
                    }
                }
                if (chunked) {
                    var last = IO.Utf8.GetBytes("0\r\n\r\n")
                    connection.Write(last, 0, last.length)
                }
            }
            response.stream.Close()
        }

        static string Hex(int n) {
            var digits = "0123456789abcdef"
            if (n == 0) { return "0" }
            var t = ""
            while (n > 0) {
                t = digits.CharAt(n % 16) + t
                n = n / 16
            }
            return t
        }
    }

    // ---- files (docs/ROADMAP_HTTP.md step 2) ---------------------------------------------------------------------------------------------------------

    // At most `count` bytes of another stream (a range of a file); closing it closes the other one.
    class LimitedStream : IO.Stream {
        IO.IStream inner
        int left

        construct(IO.IStream inner, int count) {
            this.inner = take inner
            this.left = count
        }

        override bool CanRead { get { return true } }

        override int Read(byte buffer[], int offset, int count) {
            if (this.left <= 0) { return 0 }
            if (count > this.left) { count = this.left }
            var n = this.inner.Read(buffer, offset, count)
            if (n > 0) { this.left = this.left - n }
            return n
        }

        override undefined Close() { this.inner.Close() }
    }

    // The media types of the usual extensions, and the dates of HTTP.
    class Mime {
        static string Of(string path) {
            string ext = IO.Path.GetExtension(path).ToLower()
            if (ext == ".html" || ext == ".htm") { return "text/html; charset=utf-8" }
            if (ext == ".css") { return "text/css; charset=utf-8" }
            if (ext == ".js" || ext == ".mjs") { return "text/javascript; charset=utf-8" }
            if (ext == ".json" || ext == ".map") { return "application/json" }
            if (ext == ".txt" || ext == ".md") { return "text/plain; charset=utf-8" }
            if (ext == ".xml") { return "application/xml" }
            if (ext == ".svg") { return "image/svg+xml" }
            if (ext == ".png") { return "image/png" }
            if (ext == ".jpg" || ext == ".jpeg") { return "image/jpeg" }
            if (ext == ".gif") { return "image/gif" }
            if (ext == ".webp") { return "image/webp" }
            if (ext == ".ico") { return "image/x-icon" }
            if (ext == ".wasm") { return "application/wasm" }
            if (ext == ".pdf") { return "application/pdf" }
            if (ext == ".zip") { return "application/zip" }
            if (ext == ".woff") { return "font/woff" }
            if (ext == ".woff2") { return "font/woff2" }
            if (ext == ".ttf") { return "font/ttf" }
            if (ext == ".mp4") { return "video/mp4" }
            if (ext == ".webm") { return "video/webm" }
            if (ext == ".mp3") { return "audio/mpeg" }
            if (ext == ".wav") { return "audio/wav" }
            return "application/octet-stream"
        }

        // "Tue, 15 Nov 1994 08:12:31 GMT" (RFC 9110) of a point in time in UTC.
        static string Date(DateTime utc) {
            var days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
            var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
            return days[utc.DayOfWeek] + ", " + Http.Mime.Two(utc.Day) + " " + months[utc.Month - 1] + " " + utc.Year + " " + Http.Mime.Two(utc.Hour) + ":" + Http.Mime.Two(utc.Minute) + ":" + Http.Mime.Two(utc.Second) + " GMT"
        }

        static string Two(int n) {
            if (n < 10) { return "0" + n }
            return "" + n
        }
    }

    // Static files from a folder (by convention `wwwroot`) as a link of the chain: the path of the request maps 1:1 to a file under the folder; what is
    // not there goes on to the next link. Only GET and HEAD. Never served: a path with `..` or a part that starts with a dot (.git, .env), the sources of
    // fire (.fire, .fxml, .fireproj, .firesln), anything outside the folder. ETag and Last-Modified (304 for If-None-Match / If-Modified-Since), one range
    // (206), the body streamed from the file.
    class Files : IRouter {
        string root
        string prefix
        List defaults
        bool omitExtensions
        int maxAge

        // `root` the folder, `prefix` the part of the path that maps to it ("/" or e.g. "/static"); `omitExtensions`: "/about" also finds about.html.
        construct(string root, string prefix = "/", bool omitExtensions = false) {
            this.root = IO.Path.GetFullPath(root)
            this.prefix = prefix
            if (!this.prefix.EndsWith("/")) { this.prefix = this.prefix + "/" }
            this.defaults = new List()
            this.defaults.Add("index.html")
            this.defaults.Add("index.htm")
            this.omitExtensions = omitExtensions
            this.maxAge = -1
        }

        // Cache-Control: max-age for every file (seconds; -1: none).
        Http.Files CacheFor(int seconds) {
            this.maxAge = seconds
            return this
        }

        Http.Response Handle(Http.Context ctx, Http.Next next) {
            var request = ctx.Request
            if (request.method != "GET" && request.method != "HEAD") { return next.Invoke(ctx) }
            var file = this.Resolve(request.path)
            if (file == undefined) { return next.Invoke(ctx) }
            return Http.Files.Serve(file, request, this.maxAge)
        }

        // The file of a request path, undefined when it is not one that may be served (or not there).
        string Resolve(string path) {
            var p = path
            if (p + "/" == this.prefix) { p = this.prefix }
            if (!p.StartsWith(this.prefix)) { return undefined }
            string rel = p.Substring(this.prefix.Length)
            if (rel.IndexOf("\\") >= 0 || rel.IndexOf(":") >= 0 || rel.IndexOf("\0") >= 0) { return undefined }
            any parts = rel.Split("/")
            for (var i = 0; i < parts.length; i++) {
                string part = parts[i]
                if (part == ".." || part.StartsWith(".")) { return undefined }
            }
            var full = IO.Path.GetFullPath(IO.Path.Combine(this.root, rel))
            var inside = this.root
            if (!inside.EndsWith(IO.Path.DirectorySeparatorChar)) { inside = inside + IO.Path.DirectorySeparatorChar }
            if (full != this.root && !full.StartsWith(inside)) { return undefined }
            if (IO.Directory.Exists(full)) {
                for (var d = 0; d < this.defaults.Count; d++) {
                    var candidate = IO.Path.Combine(full, this.defaults[d])
                    if (IO.File.Exists(candidate)) { return candidate }
                }
                return undefined
            }
            if (Http.Files.Hidden(full)) { return undefined }
            if (IO.File.Exists(full)) { return full }
            if (this.omitExtensions && !IO.Path.HasExtension(full)) {
                var html = full + ".html"
                if (IO.File.Exists(html)) { return html }
                var htm = full + ".htm"
                if (IO.File.Exists(htm)) { return htm }
            }
            return undefined
        }

        // The sources of fire are never served.
        static bool Hidden(string file) {
            string ext = IO.Path.GetExtension(file).ToLower()
            return ext == ".fire" || ext == ".fxml" || ext == ".fireproj" || ext == ".firesln"
        }

        // The answer for a file: 200 (or 206 for a range, 304 when the client has it, 416 for a range outside the file).
        static Http.Response Serve(string file, Http.Request request, int maxAge = -1) {
            int size = IO.File.Size(file)
            DateTime modified = IO.File.GetLastWriteTimeUtc(file)
            var tag = "\"" + size + "-" + modified.Ticks + "\""
            var lastModified = Http.Mime.Date(modified)
            var type = Http.Mime.Of(file)
            var inm = request.headers.Get("If-None-Match")
            var ims = request.headers.Get("If-Modified-Since")
            if ((inm != undefined && (inm == tag || inm == "*")) || (inm == undefined && ims != undefined && ims == lastModified)) {
                var nm = new Http.Response(304)
                Http.Files.Stamp(nm, tag, lastModified, maxAge)
                return nm
            }
            int first = 0
            int upto = size - 1
            bool partial = false
            var range = request.headers.Get("Range")
            if (range != undefined && range.StartsWith("bytes=") && range.IndexOf(",") < 0) {
                string spec = range.Substring(6).Trim()
                any dash = spec.IndexOf("-")
                if (dash >= 0) {
                    string a = spec.Substring(0, dash).Trim()
                    string b = spec.Substring(dash + 1).Trim()
                    if (a.Length == 0) {
                        // the last b bytes
                        var last = Http.Num.Parse(b)
                        if (last > 0) { first = size - last; if (first < 0) { first = 0 }; partial = true }
                    } else {
                        first = Http.Num.Parse(a)
                        if (b.Length > 0) { upto = Http.Num.Parse(b) }
                        if (upto >= size) { upto = size - 1 }
                        partial = first >= 0
                    }
                    if (partial && (first > upto || first >= size || first < 0)) {
                        var bad = Http.Response.Error(416)
                        bad.headers.Set("Content-Range", "bytes */" + size)
                        return bad
                    }
                }
            }
            var stream = new IO.FileStream(file, IO.FileMode.Open, IO.FileAccess.Read)
            Http.Response r = undefined
            if (partial) {
                stream.Seek(first)
                var part = new Http.LimitedStream(take stream, upto - first + 1)
                r = Http.Response.FromStream(take part, type, upto - first + 1, 206)
                r.headers.Set("Content-Range", "bytes " + first + "-" + upto + "/" + size)
            } else {
                r = Http.Response.FromStream(take stream, type, size)
            }
            r.headers.Set("Accept-Ranges", "bytes")
            Http.Files.Stamp(r, tag, lastModified, maxAge)
            return r
        }

        static undefined Stamp(Http.Response r, string tag, string lastModified, int maxAge) {
            r.headers.Set("ETag", tag)
            r.headers.Set("Last-Modified", lastModified)
            if (maxAge >= 0) { r.headers.Set("Cache-Control", "max-age=" + maxAge) }
        }
    }

    // ---- sessions (docs/ROADMAP_HTTP.md step 3) ------------------------------------------------------------------------------------------------------

    // A router that holds something beyond the requests (a thread, a file): Http.AppServer.Close() closes it - the server's own router, never the copies of
    // the connections.
    interface IClosable {
        undefined Close()
    }

    // Where sessions are kept beyond the memory of the program: the text of a session (its values, encoded) by its id. The calls come from the home of
    // the sessions, one after the other.
    interface ISessionStore {
        string Load(string id)
        undefined Save(string id, string data)
        undefined Delete(string id)
    }

    // Sessions only in memory: they end with the program.
    class MemorySessionStore : ISessionStore {
        string Load(string id) { return undefined }
        undefined Save(string id, string data) { }
        undefined Delete(string id) { }
    }

    // Sessions in files: one file `<id>.session` per session in a folder (a restart of the program finds them again).
    class FileSessionStore : ISessionStore {
        string folder

        construct(string folder) {
            this.folder = folder
            IO.Directory.CreateDirectory(folder)
        }

        string Load(string id) {
            var path = IO.Path.Combine(this.folder, id + ".session")
            if (!IO.File.Exists(path)) { return undefined }
            return IO.File.ReadAllText(path)
        }

        undefined Save(string id, string data) { IO.File.WriteAllText(IO.Path.Combine(this.folder, id + ".session"), data) }

        undefined Delete(string id) { IO.File.Delete(IO.Path.Combine(this.folder, id + ".session")) }
    }

    // The values of one session at its home.
    class SessionEntry {
        string id
        Dictionary<string, string> values
        int touched

        construct(string id) {
            this.id = id
            this.values = new Dictionary<string, string>()
            this.touched = DateTime.UtcNow.Ticks
        }

        // name=value&... (percent encoded) - what a store keeps.
        string Encode() {
            var t = ""
            foreach (var pair in this.values) {
                if (t.Length > 0) { t = t + "&" }
                t = t + Http.Uri.Encode(pair.Key) + "=" + Http.Uri.Encode(pair.Value)
            }
            return t
        }

        undefined Decode(string data) {
            if (data == undefined || data.Length == 0) { return }
            any pairs = data.Split("&")
            for (var i = 0; i < pairs.length; i++) {
                string pair = pairs[i]
                any eq = pair.IndexOf("=")
                if (eq > 0) { this.values[Http.Uri.Decode(pair.Substring(0, eq))] = Http.Uri.Decode(pair.Substring(eq + 1)) }
            }
        }
    }

    // The sessions of a server and what is done with them (the home of the sessions owns one: a method of an actor that calls another method of the
    // same actor would only post a message, so the work is done here).
    class SessionTable {
        Dictionary<string, Http.SessionEntry> entries
        Http.ISessionStore store
        int timeoutTicks
        int lastSweep

        construct(Http.ISessionStore store, int timeoutMs) {
            this.entries = new Dictionary<string, Http.SessionEntry>()
            this.store = take store
            this.timeoutTicks = timeoutMs * 10000
            this.lastSweep = DateTime.UtcNow.Ticks
        }

        // The id of a living session: `id` when it is one (touched now; from the store when it is not in memory), otherwise a new one.
        string Open(string id) {
            this.Sweep()
            var now = DateTime.UtcNow.Ticks
            if (id != undefined && Http.SessionTable.ValidId(id)) {
                if (this.entries.ContainsKey(id)) {
                    Http.SessionEntry e = this.entries[id]
                    if (now - e.touched <= this.timeoutTicks) {
                        e.touched = now
                        return id
                    }
                    this.End(id)
                } else {
                    var saved = this.store.Load(id)
                    if (saved != undefined) {
                        var back = new Http.SessionEntry(id)
                        back.Decode(saved)
                        this.entries.Add(id, take back)
                        return id
                    }
                }
            }
            var fresh = Net.SecureRandom.Hex(16)
            this.entries.Add(fresh, new Http.SessionEntry(fresh))
            return fresh
        }

        string Get(string id, string name) {
            if (!this.entries.ContainsKey(id)) { return undefined }
            Http.SessionEntry e = this.entries[id]
            if (!e.values.ContainsKey(name)) { return undefined }
            return e.values[name]
        }

        bool Set(string id, string name, string value) {
            if (!this.entries.ContainsKey(id)) { return false }
            Http.SessionEntry e = this.entries[id]
            if (value == undefined) { e.values.Remove(name) } else { e.values[name] = value }
            this.store.Save(id, e.Encode())
            return true
        }

        // A new id for the same values (after a login: an id someone else may have seen is no longer good); the new id.
        string Renew(string id) {
            if (!this.entries.ContainsKey(id)) { return this.Open(undefined) }
            Http.SessionEntry old = this.entries[id]
            var fresh = Net.SecureRandom.Hex(16)
            var moved = new Http.SessionEntry(fresh)
            foreach (var pair in old.values) { moved.values[pair.Key] = pair.Value }
            this.End(id)
            this.store.Save(fresh, moved.Encode())
            this.entries.Add(fresh, take moved)
            return fresh
        }

        bool End(string id) {
            if (!this.entries.ContainsKey(id)) { return false }
            this.entries.Remove(id)
            this.store.Delete(id)
            return true
        }

        int Count() { return this.entries.Count }

        // (sessions that ran out, at most once a second)
        undefined Sweep() {
            var now = DateTime.UtcNow.Ticks
            if (now - this.lastSweep < 10000000) { return }
            this.lastSweep = now
            var gone = new List()
            foreach (var pair in this.entries) {
                Http.SessionEntry e = pair.Value
                if (now - e.touched > this.timeoutTicks) { gone.Add(pair.Key) }
            }
            for (var i = 0; i < gone.Count; i++) { this.End(gone[i]) }
        }

        static bool ValidId(string id) {
            if (id.Length != 32) { return false }
            for (var i = 0; i < 32; i++) {
                int c = id.CharAt(i).ToInt()
                if (!((c >= 48 && c <= 57) || (c >= 97 && c <= 102))) { return false }
            }
            return true
        }
    }

    // The home of the sessions of a server: an actor on a thread of its own. Every access to a session is a message to it (`await home.Get(id, name)`), so
    // they run one after the other and the state of a session is always the same for every connection. A session that nobody touches for `timeout`
    // ms ends (and is deleted from the store).
    actor SessionHome {
        Http.SessionTable table
        bool stopped

        construct(Http.ISessionStore store, int timeoutMs) {
            this.table = new Http.SessionTable(take store, timeoutMs)
            this.stopped = false
        }

        string Open(string id) { return this.table.Open(id) }
        string Get(string id, string name) { return this.table.Get(id, name) }
        bool Set(string id, string name, string value) { return this.table.Set(id, name, value) }
        string Renew(string id) { return this.table.Renew(id) }
        bool End(string id) { return this.table.End(id) }
        int Count() { return this.table.Count() }
        undefined Stop() { this.stopped = true }
    }

    // A session as a router sees it (ctx.Item("session")): every call is a message to the home of the sessions.
    class Session {
        Http.SessionHome home
        string id
        bool renewed
        bool fresh

        construct(Http.SessionHome home, string id, bool fresh = false) {
            this.home = home
            this.id = id
            this.renewed = false
            this.fresh = fresh
        }

        string Id { get { return this.id } }
        // True when the session began with this request (the client sent no cookie of a living session).
        bool IsNew { get { return this.fresh } }

        string Get(string name, string fallback = undefined) {
            var h = this.home
            string v = await h.Get(this.id, name)
            if (v == undefined) { return fallback }
            return v
        }

        undefined Set(string name, any value) {
            var h = this.home
            string text = undefined
            if (value != undefined) { text = "" + value }
            bool ok = await h.Set(this.id, name, text)
        }

        undefined Remove(string name) { this.Set(name, undefined) }

        // A new id for the same values - after a login (the cookie is set again).
        undefined Renew() {
            var h = this.home
            string fresh = await h.Renew(this.id)
            this.id = fresh
            this.renewed = true
        }

        // Ends the session (the cookie is cleared).
        undefined End() {
            var h = this.home
            bool ok = await h.End(this.id)
            this.id = ""
            this.renewed = true
        }
    }

    // The session resolver as a link of the chain: finds the session of the request by its cookie (or starts one), puts an Http.Session into the context
    // (`ctx.Item("session")`) and sets the cookie on the answer when the session is new or got a new id. The home of the sessions is an actor on a thread
    // of its own (Http.AppServer.Close() ends it).
    class Sessions : IRouter, IClosable {
        Http.SessionHome home
        string cookie
        bool secure
        int timeoutMs

        // `timeoutMs` without a request until a session ends (default 20 min), `store` where they are kept (default: in memory).
        construct(int timeoutMs = 1200000, Http.ISessionStore store = undefined, string cookie = "fire-session", bool secure = false) {
            this.cookie = cookie
            this.secure = secure
            this.timeoutMs = timeoutMs
            if (store == undefined) { store = new Http.MemorySessionStore() }
            var ready = new Completion()
            var back = ready.Share()
            Http.Sessions.StartHome(take store, timeoutMs, take back)
            this.home = ready.Wait(10s)
        }

        // (the thread of the home: makes the actor, hands its reference back, then serves its messages until Stop)
        static undefined StartHome(Http.ISessionStore store, int timeoutMs, Completion back) {
            fire handover store handover back taking timeoutMs {
                var home = new Http.SessionHome(take store, timeoutMs)
                back.Set(home)
                while (!home.stopped) { process home }
            }
        }

        Http.Response Handle(Http.Context ctx, Http.Next next) {
            var asked = Http.Sessions.CookieOf(ctx.request.headers.Get("Cookie"), this.cookie)
            var h = this.home
            string id = await h.Open(asked)
            var session = new Http.Session(h, id, id != asked)
            ctx.SetItem("session", session)
            Http.Response r = next.Invoke(ctx)
            if (session.id != asked || session.renewed) {
                var attrs = "; Path=/; HttpOnly; SameSite=Lax"
                if (this.secure) { attrs = attrs + "; Secure" }
                if (session.id.Length == 0) { r.headers.Add("Set-Cookie", this.cookie + "=; Path=/; Max-Age=0") }
                else { r.headers.Add("Set-Cookie", this.cookie + "=" + session.id + attrs) }
            }
            return r
        }

        // The number of living sessions.
        int Count() {
            var h = this.home
            int n = await h.Count()
            return n
        }

        undefined Close() {
            var h = this.home
            h.Stop()
        }

        // The value of a cookie in a Cookie header, undefined when it is not there.
        static string CookieOf(string header, string name) {
            if (header == undefined) { return undefined }
            any parts = header.Split(";")
            for (var i = 0; i < parts.length; i++) {
                string part = parts[i].Trim()
                any eq = part.IndexOf("=")
                if (eq > 0 && part.Substring(0, eq).Trim() == name) { return part.Substring(eq + 1).Trim() }
            }
            return undefined
        }
    }

    // ---- WebSocket (RFC 6455; docs/ROADMAP_HTTP.md step 5) -------------------------------------------------------------------------------------------

    class Base64 {
        static string Encode(byte data[]) {
            var table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            var t = ""
            var i = 0
            while (i + 2 < data.length) {
                int n = data[i] * 65536 + data[i + 1] * 256 + data[i + 2]
                t = t + table.CharAt(n / 262144) + table.CharAt((n / 4096) % 64) + table.CharAt((n / 64) % 64) + table.CharAt(n % 64)
                i = i + 3
            }
            var rest = data.length - i
            if (rest == 1) {
                int a = data[i] * 65536
                t = t + table.CharAt(a / 262144) + table.CharAt((a / 4096) % 64) + "=="
            } else if (rest == 2) {
                int b = data[i] * 65536 + data[i + 1] * 256
                t = t + table.CharAt(b / 262144) + table.CharAt((b / 4096) % 64) + table.CharAt((b / 64) % 64) + "="
            }
            return t
        }
    }

    // What a WebSocket server does with one connection: Serve(ws) runs in the task of the connection, as long as it wants (`ws.Receive()` until undefined).
    interface IWebSocketHandler {
        undefined Serve(Http.WebSocket ws)
    }

    // One message of a WebSocket: a text or bytes.
    class WebSocketMessage {
        bool binary
        byte data[]

        construct(bool binary, byte data[]) {
            this.binary = binary
            this.data = take data
        }

        bool IsText { get { return !this.binary } }
        string Text() { return IO.Utf8.GetString(this.data, 0, this.data.length) }
    }

    // A WebSocket connection (either side): `Send(text)`, `SendBytes(bytes)`, `Receive(timeout)` (the next message - pings are answered, a close is
    // answered and ends it: undefined), `ReceiveText(timeout)`, `Close(code, reason)`, `IsOpen`.
    class WebSocket {
        Net.IConnection connection
        Http.Reader reader
        bool client
        bool open
        int closeCode
        int maxMessageBytes
        // (the server side: the header fields and the target of the request that opened it)
        Http.Headers headers
        string target

        // (the WebSocket uses the connection and the reader; Connect hands them to it, the server's task keeps them)
        construct(Net.IConnection connection, Http.Reader reader, bool client) {
            this.connection = connection
            this.reader = reader
            this.client = client
            this.open = true
            this.closeCode = 0
            this.maxMessageBytes = 16777216
        }

        bool IsOpen { get { return this.open } }
        // A header field of the request that opened the WebSocket (the server side; undefined on the client).
        string Header(string name) { return this.headers?.Get(name) }
        // A query parameter of the request that opened it (`/ws?page=7`).
        any Query(string name, any fallback = undefined) {
            if (this.target == undefined) { return fallback }
            var r = new Http.Request("GET", this.target)
            return r.Query(name, fallback)
        }
        // The code of the close frame of the other side (1000 normal, 1001 going away, ...; 1006 when the connection just ended), 0 while it is open.
        int CloseCode { get { return this.closeCode } }

        // ws://host:port/path (wss:// over TLS): the handshake as a client.
        static Http.WebSocket Connect(string url, int timeout = 10000, Http.Headers headers = undefined) {
            var u = Http.Url.Parse(url.Replace("ws://", "http://").Replace("wss://", "https://"))
            Net.IConnection c = Http.Transport.Open(u, timeout)
            c.ReadTimeout = timeout
            c.WriteTimeout = timeout
            var key = Http.Base64.Encode(Net.SecureRandom.Bytes(16))
            var h = new Http.Headers()
            h.Set("Host", u.HostHeader())
            h.Set("Upgrade", "websocket")
            h.Set("Connection", "Upgrade")
            h.Set("Sec-WebSocket-Key", key)
            h.Set("Sec-WebSocket-Version", "13")
            if (headers != undefined) { for (var i = 0; i < headers.Count; i++) { h.Set(headers.names[i], headers.values[i]) } }
            Http.Wire.Write(c, "GET " + u.path + " HTTP/1.1", h, undefined)
            var reader = new Http.Reader(c)
            var line = reader.ReadLine(8192)
            if (line == undefined || line.IndexOf(" 101") < 0) { c.Close(); throw new Http.HttpException("The server did not switch to WebSocket: '" + line + "'.", 2) }
            var rh = new Http.Headers()
            Http.Wire.ReadHeaders(reader, rh)
            if (rh.Get("Sec-WebSocket-Accept") != Http.WebSocket.AcceptOf(key)) { c.Close(); throw new Http.HttpException("A wrong Sec-WebSocket-Accept.", 2) }
            c.ReadTimeout = undefined
            var ws = new Http.WebSocket(c, reader, true)
            c.TakeTo(ws)
            reader.TakeTo(ws)
            return ws
        }

        // The answer to a key (Sec-WebSocket-Accept).
        static string AcceptOf(string key) { return Http.Base64.Encode(Hash.Sha1.Of(key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11")) }

        undefined Send(string text) { this.Frame(1, IO.Utf8.GetBytes(text)) }
        undefined SendBytes(byte data[]) { this.Frame(2, data) }
        undefined Ping(byte data[] = undefined) {
            if (data == undefined) { data = new byte[0] }
            this.Frame(9, data)
        }

        // The next message, undefined when the connection is closed (or `timeout` ms ran out: then IsOpen is still true).
        Http.WebSocketMessage Receive(int timeout = -1) {
            if (!this.open) { return undefined }
            if (timeout < 0) { this.connection.ReadTimeout = undefined } else { this.connection.ReadTimeout = timeout }
            IO.MemoryStream parts = undefined
            var opcodeOfMessage = 0
            while (true) {
                int b0 = 0
                try { b0 = this.ReadByte() } catch (Net.TimeoutException e) { return undefined }
                if (b0 < 0) { this.Ended(1006); return undefined }
                this.connection.ReadTimeout = 30000
                int b1 = this.ReadByte()
                if (b1 < 0) { this.Ended(1006); return undefined }
                var fin = b0 >= 128
                int opcode = b0 % 16
                var masked = b1 >= 128
                int len = b1 % 128
                if (len == 126) { len = this.ReadByte() * 256 + this.ReadByte() }
                else if (len == 127) {
                    len = 0
                    for (var k = 0; k < 8; k++) { len = len * 256 + this.ReadByte() }
                }
                if (len > this.maxMessageBytes) { this.Close(1009, "too big"); return undefined }
                byte mask[] = undefined
                if (masked) { mask = this.reader.ReadExact(4) }
                var payload = this.reader.ReadExact(len)
                if (masked) { for (var j = 0; j < len; j++) { payload[j] = payload[j] # mask[j % 4] } }
                if (opcode == 8) {
                    var code = 1005
                    if (len >= 2) { code = payload[0] * 256 + payload[1] }
                    if (this.open) { this.Frame(8, payload) }
                    this.Ended(code)
                    return undefined
                }
                if (opcode == 9) { this.Frame(10, payload); continue }
                if (opcode == 10) { continue }
                if (opcode == 1 || opcode == 2) { opcodeOfMessage = opcode }
                if (fin && parts == undefined) { return new Http.WebSocketMessage(opcode == 2 || (opcode == 0 && opcodeOfMessage == 2), take payload) }
                if (parts == undefined) { parts = new IO.MemoryStream() }
                parts.Write(payload, 0, payload.length)
                if (parts.Length > this.maxMessageBytes) { this.Close(1009, "too big"); return undefined }
                if (fin) {
                    var all = parts.ToBuffer()
                    parts.Close()
                    return new Http.WebSocketMessage(opcodeOfMessage == 2, take all)
                }
            }
        }

        // The next text message (a binary one as UTF-8), undefined when the connection is closed or the time ran out.
        string ReceiveText(int timeout = -1) {
            var m = this.Receive(timeout)
            if (m == undefined) { return undefined }
            return m.Text()
        }

        // Ends the connection with a close frame (1000 normal) and waits briefly for the answer.
        undefined Close(int code = 1000, string reason = "") {
            if (!this.open) { return }
            var r = IO.Utf8.GetBytes(reason)
            var payload = new byte[2 + r.length]
            payload[0] = code / 256
            payload[1] = code % 256
            for (var i = 0; i < r.length; i++) { payload[2 + i] = r[i] }
            try {
                this.Frame(8, payload)
                this.open = false
                this.connection.ReadTimeout = 2000
                // (the answer of the other side; what comes before it is dropped)
                while (true) {
                    int b0 = this.ReadByte()
                    if (b0 < 0) { break }
                    int b1 = this.ReadByte()
                    int len = b1 % 128
                    if (len == 126) { len = this.ReadByte() * 256 + this.ReadByte() }
                    if (b1 >= 128) { this.reader.ReadExact(4) }
                    this.reader.ReadExact(len)
                    if (b0 % 16 == 8) { break }
                }
            } catch (Net.NetException e) {
            } catch (Http.HttpException e) {
            }
            this.Ended(code)
        }

        // (the end without a word, when the server's task leaves the handler)
        undefined CloseQuietly() {
            if (this.open) { this.Close(1001, "") }
            this.connection.Close()
        }

        undefined Ended(int code) {
            this.open = false
            if (this.closeCode == 0) { this.closeCode = code }
        }

        int ReadByte() {
            if (!this.reader.Fill()) { return -1 }
            int b = this.reader.chunk[this.reader.pos]
            this.reader.pos = this.reader.pos + 1
            return b
        }

        // One frame: a client masks it (RFC 6455 5.3), a server does not.
        undefined Frame(int opcode, byte data[]) {
            var n = data.length
            var headLen = 2
            if (n >= 126 && n < 65536) { headLen = 4 } else if (n >= 65536) { headLen = 10 }
            if (this.client) { headLen = headLen + 4 }
            var frame = new byte[headLen + n]
            frame[0] = 128 + opcode
            var maskBit = 0
            if (this.client) { maskBit = 128 }
            var at = 2
            if (n < 126) { frame[1] = maskBit + n }
            else if (n < 65536) {
                frame[1] = maskBit + 126
                frame[2] = n / 256
                frame[3] = n % 256
                at = 4
            } else {
                frame[1] = maskBit + 127
                var v = n
                for (var k = 9; k >= 2; k--) { frame[k] = v % 256; v = v / 256 }
                at = 10
            }
            if (this.client) {
                var mask = Net.SecureRandom.Bytes(4)
                for (var m = 0; m < 4; m++) { frame[at + m] = mask[m] }
                at = at + 4
                for (var i = 0; i < n; i++) { frame[at + i] = data[i] # mask[i % 4] }
            } else {
                for (var i = 0; i < n; i++) { frame[at + i] = data[i] }
            }
            this.connection.Write(frame, 0, frame.length)
        }
    }

    // WebSocket endpoints as a link of the chain: a GET with `Upgrade: websocket` on `path` is switched over (101) and the handler serves the connection in
    // its task; the rest goes on. `origins`: the allowed values of the Origin header (empty: any) - a check against pages of other sites (CSRF).
    class WebSockets : IRouter {
        string path
        Http.IWebSocketHandler handler
        List origins

        construct(string path, Http.IWebSocketHandler handler) {
            this.path = path
            this.handler = take handler
            this.origins = new List()
        }

        Http.WebSockets AllowOrigin(string origin) {
            this.origins.Add(origin)
            return this
        }

        Http.Response Handle(Http.Context ctx, Http.Next next) {
            var request = ctx.Request
            if (request.path != this.path) { return next.Invoke(ctx) }
            var up = request.headers.Get("Upgrade")
            if (up == undefined || up.ToLower() != "websocket") { return Http.Response.Error(426, "This is a WebSocket endpoint.") }
            var key = request.headers.Get("Sec-WebSocket-Key")
            if (request.method != "GET" || key == undefined || request.headers.Get("Sec-WebSocket-Version") != "13") { return Http.Response.Error(400, "A bad WebSocket handshake.") }
            if (this.origins.Count > 0) {
                var origin = request.headers.Get("Origin")
                var allowed = false
                for (var i = 0; i < this.origins.Count; i++) { if (this.origins[i] == origin) { allowed = true } }
                if (!allowed) { return Http.Response.Error(403, "This origin may not open the WebSocket.") }
            }
            var r = new Http.Response(101)
            r.headers.Set("Upgrade", "websocket")
            r.headers.Set("Connection", "Upgrade")
            r.headers.Set("Sec-WebSocket-Accept", Http.WebSocket.AcceptOf(key))
            r.upgrade = this.handler
            var copied = new Http.Headers()
            for (var i = 0; i < request.headers.Count; i++) { copied.Add(request.headers.names[i], request.headers.values[i]) }
            r.upgradeHeaders = take copied
            r.upgradeTarget = request.target
            return r
        }
    }
}