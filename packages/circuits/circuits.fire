// Circuit simulation (docs/CIRCUITS.md), after the model of Paul Falstad's circuit simulator: parts with ports, ports connected into nodes, a modified nodal
// analysis solved every time step (trapezoidal rule for capacitors and inductors), instruments that record what happens (Scope, Multimeter, Fft).
// The units of electricity are declared here: V, A, Ohm, F, H, Hz (with prefixes: 4.7kOhm, 10uF, 1mH, 2kHz) and dB. Every value may also be given as a plain number in SI units.

prefixed unit Volt: V
prefixed unit Ampere: A
prefixed unit Ohm: Ohm { coerce V/A => 1 }
prefixed unit Farad: F { coerce A*s/V => 1 }
prefixed unit Henry: H { coerce V*s/A => 1 }
prefixed unit Hertz: Hz
// A ratio of amplitudes in decibels: 6dB is a factor of about 2, 20dB of 10 (-3dB: 1/sqrt 2). Multiplied with a value it is that factor (`1V * 6dB` is
// 2V), decibels add (`3dB + 3dB` is 6dB), a declaration without a unit takes the factor (`float k : unitless = 20dB` and `20dB:unitless` are 10).
unit Decibel: dB {
    coerce to unitless => 10 ^ (value / 20)
    coerce from unitless => 20 * Math.Log10(value)
}

namespace Circuits {
    /// <summary>Values with a unit (or plain SI numbers) as plain numbers for the solver.</summary>
    class Units {
        static float Volts(float v : any) {
            if (v is in V) { return v / 1V }
            if (v is in unitless) { return v }
            throw new ArgumentException("Expected a voltage (V), not " + v + ".")
        }
        static float Amps(float v : any) {
            if (v is in A) { return v / 1A }
            if (v is in unitless) { return v }
            throw new ArgumentException("Expected a current (A), not " + v + ".")
        }
        static float Ohms(float v : any) {
            if (v is in Ohm) { return v / 1Ohm }
            if (v is in unitless) { return v }
            throw new ArgumentException("Expected a resistance (Ohm), not " + v + ".")
        }
        static float Farads(float v : any) {
            if (v is in F) { return v / 1F }
            if (v is in unitless) { return v }
            throw new ArgumentException("Expected a capacitance (F), not " + v + ".")
        }
        static float Henries(float v : any) {
            if (v is in H) { return v / 1H }
            if (v is in unitless) { return v }
            throw new ArgumentException("Expected an inductance (H), not " + v + ".")
        }
        static float Hertz(float v : any) {
            if (v is in Hz) { return v / 1Hz }
            if (v is in unitless) { return v }
            throw new ArgumentException("Expected a frequency (Hz), not " + v + ".")
        }
        /// <summary>The number of a value in the SI unit of its dimension (4.7kOhm is 4700, 10us is 0.00001); a plain number stays as it is.</summary>
        static float Raw(float v : any) {
            if (v is in V) { return v / 1V }
            if (v is in A) { return v / 1A }
            if (v is in Ohm) { return v / 1Ohm }
            if (v is in F) { return v / 1F }
            if (v is in H) { return v / 1H }
            if (v is in Hz) { return v / 1Hz }
            if (v is in s) { return v / 1s }
            return v!float
        }
        static float Seconds(float v : any) {
            if (v is in s) { return v / 1s }
            if (v is in unitless) { return v }
            throw new ArgumentException("Expected a time (s), not " + v + ".")
        }
    }

    /// <summary>A connection point of a part or of a circuit. Connected ports form one node; after a step every port knows the voltage of its node.</summary>
    class Port {
        string name
        Part part
        Port link
        // the node of the plan (-1: ground, -2: none yet) and the voltage the node had when the circuit last changed (in volts)
        int node = -2
        float v = 0.0

        construct(string name, Part part) {
            this.name = name
            this.part = part
            this.link = undefined
        }

        string Name { get { return this.name } }
        Part Part() { return this.part }

        // the port that stands for the whole node
        Port Root() {
            var p = this
            while (p.link != undefined) { p = p.link }
            return p
        }

        /// <summary>Connects this port with another (a wire): both are one node from now on. Returns this port.</summary>
        Port Connect(Port other) {
            // (the circuits keep the voltages of their nodes first: the nodes change now)
            var owner = this.Circuit()
            if (owner != undefined) { owner.Invalidate() }
            var otherOwner = other.Circuit()
            if (otherOwner != undefined) { otherOwner.Invalidate() }
            var a = this.Root()
            var b = other.Root()
            // the port of a circuit stays the root of its node: a drawing connects such ports again (it drops their links), and what the circuit
            // connected inside must stay hanging on them
            if (b.part is of Circuit && !(a.part is of Circuit)) {
                var swap = a
                a = b
                b = swap
            }
            if (a != b) {
                b.link = a
                if (a.v == 0.0) { a.v = b.v }
            }
            return this
        }

        Circuit Circuit() {
            var p = this.part
            if (p == undefined) { return undefined }
            if (p is of Circuit) { return p!Circuit }
            return p.owner
        }

        /// <summary>Is it on the same node as the other port?</summary>
        bool IsConnected(Port other) { return this.Root() == other.Root() }

        /// <summary>The voltage of its node against ground after the last step.</summary>
        float:V Voltage { get { return this.Raw() * 1V } }

        float Raw() {
            var root = this.Root()
            var c = this.Circuit()
            if (c != undefined && root.node >= -1) {
                var top = c.Top()
                if (!top.dirty && top.solver != undefined) { return top.solver.NodeVoltage(root.node) }
            }
            return root.v
        }
    }

    /// <summary>A part of a circuit: it has ports and puts itself into the equations of the solver. The parts of the package are compiled into the plan of the
    /// circuit and stepped by its kernel. Derive from Part (or TwoTerminal) for parts of your own: Stamp for what stays the same while the circuit does not
    /// change, StampStep for what changes from step to step, Commit to keep the state after a step - these run in fire every step.</summary>
    class Part {
        string name
        List ports
        Circuit owner
        // false once the methods of Part ran: the part has nothing to do in a step (the circuit stops calling them)
        bool stepsInFire = true
        bool commitsInFire = true

        construct(string name) {
            this.name = name
            this.ports = new List()
            this.owner = undefined
        }

        string Name { get { return this.name } }

        Port AddPort(string name) {
            var p = new Port(name, this)
            p.TakeTo(this)
            this.ports.Add(p)
            return p
        }

        /// <summary>The port with this name (or number).</summary>
        Port PortAt(any key) {
            if (key is of int) { return this.ports[key] }
            foreach (p in this.ports) {
                if (p.name == key) { return p }
            }
            throw new ArgumentException("The part '" + this.name + "' has no port '" + key + "'.")
        }

        List Ports() { return this.ports }

        // ---- the solver interface (plain SI numbers) ----
        /// <summary>How many extra unknowns (branch currents) the part needs: 1 for a voltage source.</summary>
        int Branches() { return 0 }
        /// <summary>Puts the part into the plan. The parts of the package give their tables to the kernel and return true; the default calls Stamp and returns
        /// false: the part steps in fire (StampStep, Commit).</summary>
        bool Compile(Circuits.Solver solver) {
            this.Stamp(solver)
            this.stepsInFire = true
            this.commitsInFire = true
            return false
        }
        undefined Stamp(Circuits.Solver solver) { }
        undefined StampStep(Circuits.Solver solver) { this.stepsInFire = false }
        undefined Commit(Circuits.Solver solver) { this.commitsInFire = false }
        /// <summary>Keeps its state from the plan before the circuit is compiled again (a capacitor its voltage and current).</summary>
        undefined Save(Circuits.Solver solver) { }
        /// <summary>A probe of a scope for its current in the kernel; false: the scope asks CurrentRaw every step.</summary>
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return false }
        /// <summary>Back to the state at time 0.</summary>
        undefined Reset() { }
        /// <summary>The current through the part (from its first port to its second), in amperes.</summary>
        float CurrentRaw() { return 0.0 }

        float:A Current { get { return this.CurrentRaw() * 1A } }

        /// <summary>Something changed that the plan depends on (a switch, a value): the circuit is compiled again before the next step.</summary>
        undefined Invalidate() {
            if (this.owner != undefined) { this.owner.Invalidate() }
        }

        /// <summary>Like Invalidate, but in the middle of a step (in StampStep or Commit) the circuit is compiled again only after the step.</summary>
        undefined InvalidateSoon() {
            if (this.owner == undefined) { return }
            var top = this.owner.Top()
            if (top.stepping) { top.rebuild = true } else { top.Invalidate() }
        }

        // the plan of the circuit (undefined while it is not compiled)
        Circuits.Solver Plan() {
            if (this.owner == undefined) { return undefined }
            var top = this.owner.Top()
            if (top.dirty) { return undefined }
            return top.solver
        }
    }

    /// <summary>A part with two ports, A and B (the positive side is A).</summary>
    class TwoTerminal : Part {
        int branch = -1
        // its index in the tables of the kernel
        int index = -1

        construct(string name) : base(name) {
            this.AddPort("a")
            this.AddPort("b")
        }

        Port A { get { return this.ports[0] } }
        Port B { get { return this.ports[1] } }

        /// <summary>The voltage from A to B.</summary>
        float:V Voltage { get { return this.VoltageRaw() * 1V } }
        float VoltageRaw() { return this.A.Raw() - this.B.Raw() }

        /// <summary>The power the part takes (positive) or gives (negative), in watts.</summary>
        float PowerRaw() { return this.VoltageRaw() * this.CurrentRaw() }
    }

    class Resistor : TwoTerminal {
        float r

        construct(float resistance : any) : base("R") { this.r = Circuits.Units.Ohms(resistance) }

        float:any Resistance {
            get { return this.r * 1Ohm }
            set {
                this.r = Circuits.Units.Ohms(value)
                this.Invalidate()
            }
        }

        bool Compile(Circuits.Solver solver) {
            solver.Conductance(this.A, this.B, 1.0 / this.r)
            return true
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 4, solver.Node(this.A), solver.Node(this.B), 1.0 / this.r) }
        float CurrentRaw() { return this.VoltageRaw() / this.r }
    }

    /// <summary>A capacitor (trapezoidal rule). `initial`: its voltage at time 0.</summary>
    class Capacitor : TwoTerminal {
        float c
        float initial
        float vPrev = 0.0
        float iPrev = 0.0

        construct(float capacitance : any, float initial : any = 0) : base("C") {
            this.c = Circuits.Units.Farads(capacitance)
            this.initial = Circuits.Units.Volts(initial)
            this.vPrev = this.initial
        }

        float:any Capacitance {
            get { return this.c * 1F }
            set {
                this.c = Circuits.Units.Farads(value)
                this.Invalidate()
            }
        }

        undefined Reset() {
            this.vPrev = this.initial
            this.iPrev = 0.0
        }

        bool Compile(Circuits.Solver solver) {
            this.index = solver.AddReactive(0, this.A, this.B, this.c, this.vPrev, this.iPrev)
            return true
        }
        undefined Save(Circuits.Solver solver) {
            this.vPrev = solver.State(0, this.index, 0)
            this.iPrev = solver.State(0, this.index, 1)
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 1, this.index, 0, 0.0) }
        float CurrentRaw() {
            var plan = this.Plan()
            if (plan == undefined) { return this.iPrev }
            return plan.State(0, this.index, 1)
        }
    }

    /// <summary>An inductor (trapezoidal rule). `initial`: its current at time 0.</summary>
    class Inductor : TwoTerminal {
        float l
        float initial
        float vPrev = 0.0
        float iPrev = 0.0

        construct(float inductance : any, float initial : any = 0) : base("L") {
            this.l = Circuits.Units.Henries(inductance)
            this.initial = Circuits.Units.Amps(initial)
            this.iPrev = this.initial
        }

        float:any Inductance {
            get { return this.l * 1H }
            set {
                this.l = Circuits.Units.Henries(value)
                this.Invalidate()
            }
        }

        undefined Reset() {
            this.iPrev = this.initial
            this.vPrev = 0.0
        }

        bool Compile(Circuits.Solver solver) {
            this.index = solver.AddReactive(1, this.A, this.B, this.l, this.vPrev, this.iPrev)
            return true
        }
        undefined Save(Circuits.Solver solver) {
            this.vPrev = solver.State(1, this.index, 0)
            this.iPrev = solver.State(1, this.index, 1)
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 2, this.index, 0, 0.0) }
        float CurrentRaw() {
            var plan = this.Plan()
            if (plan == undefined) { return this.iPrev }
            return plan.State(1, this.index, 1)
        }
    }

    /// <summary>A voltage source: A is the positive pole; its current is the current it drives out of A. VoltageSource is DC; SineSource and SquareSource
    /// change with time; FunctionSource takes any function of the time.</summary>
    class VoltageSource : TwoTerminal {
        float volts
        float current = 0.0
        // the curve for the kernel: 0 DC, 1 sine, 2 square, and its numbers
        int wave = 0
        float p0 = 0.0
        float p1 = 0.0
        float p2 = 0.0
        float p3 = 0.0

        construct(float voltage : any = 0) : base("V") {
            this.volts = Circuits.Units.Volts(voltage)
            this.p0 = this.volts
        }

        /// <summary>The (DC) voltage.</summary>
        float:any Level {
            get { return this.volts * 1V }
            set {
                this.volts = Circuits.Units.Volts(value)
                if (this.wave == 0) { this.p0 = this.volts }
                this.Update()
            }
        }

        // new numbers for the curve: the plan takes them without being compiled again
        undefined Update() {
            var plan = this.Plan()
            if (plan != undefined && this.index >= 0) { plan.SetSource(this.index, this.p0, this.p1, this.p2, this.p3) }
        }

        /// <summary>The voltage at time t (seconds).</summary>
        float Value(float t) { return this.volts }

        int Branches() { return 1 }
        bool Compile(Circuits.Solver solver) {
            solver.VoltageBranch(this.branch, this.A, this.B)
            this.index = solver.AddSource(this.A, this.B, this.branch, this.wave, this.p0, this.p1, this.p2, this.p3)
            return true
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 3, this.branch, 0, 0.0) }
        float CurrentRaw() {
            var plan = this.Plan()
            if (plan == undefined) { return this.current }
            return -plan.BranchCurrent(this.branch)
        }
        undefined Save(Circuits.Solver solver) { this.current = -solver.BranchCurrent(this.branch) }
    }

    /// <summary>A sine voltage: offset + amplitude * sin(2 pi f t + phase).</summary>
    class SineSource : VoltageSource {
        float amplitude
        float frequency
        float offset
        float phase

        construct(float amplitude : any, float frequency : any, float offset : any = 0, float phase = 0.0) : base(0) {
            this.amplitude = Circuits.Units.Volts(amplitude)
            this.frequency = Circuits.Units.Hertz(frequency)
            this.offset = Circuits.Units.Volts(offset)
            this.phase = phase
            this.wave = 1
            this.Numbers()
        }

        undefined Numbers() {
            this.p0 = this.amplitude
            this.p1 = this.frequency
            this.p2 = this.offset
            this.p3 = this.phase
        }

        float:any Amplitude {
            get { return this.amplitude * 1V }
            set {
                this.amplitude = Circuits.Units.Volts(value)
                this.Numbers()
                this.Update()
            }
        }
        float:any Frequency {
            get { return this.frequency * 1Hz }
            set {
                this.frequency = Circuits.Units.Hertz(value)
                this.Numbers()
                this.Update()
            }
        }

        float Value(float t) { return this.offset + this.amplitude * Math.Sin(2.0 * Math.PI * this.frequency * t + this.phase) }
    }

    /// <summary>A square voltage between `low` and `high`: high for `duty` of every period.</summary>
    class SquareSource : VoltageSource {
        float high
        float low
        float frequency
        float duty

        construct(float high : any, float frequency : any, float low : any = 0, float duty = 0.5) : base(0) {
            this.high = Circuits.Units.Volts(high)
            this.low = Circuits.Units.Volts(low)
            this.frequency = Circuits.Units.Hertz(frequency)
            this.duty = duty
            this.wave = 2
            this.Numbers()
        }

        undefined Numbers() {
            this.p0 = this.high
            this.p1 = this.frequency
            this.p2 = this.low
            this.p3 = this.duty
        }

        float:any Frequency {
            get { return this.frequency * 1Hz }
            set {
                this.frequency = Circuits.Units.Hertz(value)
                this.Numbers()
                this.Update()
            }
        }

        float Value(float t) {
            var cycles = t * this.frequency
            var part = cycles - Math.Floor(cycles)
            if (part < this.duty) { return this.high }
            return this.low
        }
    }

    /// <summary>The input of sound into a circuit: a voltage source that Circuit.ProcessAudio drives with the samples (a full-scale sample is `amplitude`).</summary>
    class AudioInput : VoltageSource {
        float amplitude

        construct(float amplitude : any = 1) : base(0) { this.amplitude = Circuits.Units.Volts(amplitude) }

        float:any Amplitude {
            get { return this.amplitude * 1V }
            set { this.amplitude = Circuits.Units.Volts(value) }
        }
    }

    /// <summary>A voltage given by a function of the time (seconds -> volts). It is computed in fire every step: a circuit with it runs step by step.</summary>
    class FunctionSource : VoltageSource {
        any function

        construct(any function) : base(0) { this.function = function }

        float Value(float t) {
            var f = this.function
            return Circuits.Units.Volts(f(t))
        }

        bool Compile(Circuits.Solver solver) {
            solver.VoltageBranch(this.branch, this.A, this.B)
            this.stepsInFire = true
            return false
        }
        undefined StampStep(Circuits.Solver solver) { solver.BranchValue(this.branch, this.Value(solver.time + solver.dt)) }
    }

    /// <summary>A current source: drives `current` from A through the source to B (out of B into the circuit).</summary>
    class CurrentSource : TwoTerminal {
        float amps

        construct(float current : any) : base("I") { this.amps = Circuits.Units.Amps(current) }

        float:any Level {
            get { return this.amps * 1A }
            set {
                this.amps = Circuits.Units.Amps(value)
                var plan = this.Plan()
                if (plan != undefined && this.index >= 0) { plan.SetSource(this.index, this.amps, 0.0, 0.0, 0.0) }
            }
        }

        float Value(float t) { return this.amps }

        bool Compile(Circuits.Solver solver) {
            this.index = solver.AddSource(this.A, this.B, -1, 0, this.amps, 0.0, 0.0, 0.0)
            return true
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 5, this.index, 0, 0.0) }
        float CurrentRaw() { return this.amps }
    }

    /// <summary>A switch: closed it is a wire (a tiny resistance), open it is not there.</summary>
    class Switch : TwoTerminal {
        bool closed

        construct(bool closed = false) : base("S") { this.closed = closed }

        bool Closed {
            get { return this.closed }
            set {
                if (this.closed == value) { return }
                this.closed = value
                this.Invalidate()
            }
        }

        undefined Toggle() { this.Closed = !this.closed }

        bool Compile(Circuits.Solver solver) {
            if (this.closed) { solver.Conductance(this.A, this.B, 1000000.0) }
            return true
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) {
            var g = 0.0
            if (this.closed) { g = 1000000.0 }
            return solver.AddProbe(recorder, channel, 4, solver.Node(this.A), solver.Node(this.B), g)
        }
        float CurrentRaw() {
            if (this.closed) { return this.VoltageRaw() * 1000000.0 }
            return 0.0
        }
    }

    /// <summary>Ties its port to ground (0 V). Circuit.Ground is such a port already.</summary>
    class Ground : Part {
        construct() : base("GND") { this.AddPort("g") }
        Port G { get { return this.ports[0] } }
        bool Compile(Circuits.Solver solver) { return true }
    }

    /// <summary>The numbers of a kind of part, like a .model line of SPICE: `kind` is "D" (diode), "NPN", "PNP", "NMOS", "PMOS" or "OPAMP".
    /// Diode: Is (saturation current, A), N (emission coefficient), BV (breakdown voltage, 0: none), IBV (the current at -BV, default 1 mA). Bipolar: Is, BF, BR (current gains forward and reverse).
    /// MOSFET: VTO (threshold, V; positive also for PMOS), KP (beta, A/V^2), LAMBDA (1/V). Op amp: GAIN, VMIN and VMAX (the output range), ROUT (Ohm).
    /// "FORMULA" and "FORMULA3": formulas for the currents (Model.Formula, Model.Formula3).</summary>
    class Model {
        string name
        string kind
        float p0 = 0.0
        float p1 = 0.0
        float p2 = 0.0
        float p3 = 0.0
        // a model of kind "FORMULA" or "FORMULA3": the formulas of the currents and their parameters ("name=value ...")
        string current1 = ""
        string current2 = ""
        string parameters = ""
        // more numbers by name: the capacitances (CJO VJ M TT of a diode, CJE CJC VJ M TF TR of a bipolar transistor, CGS CGD of a MOSFET)
        List extraNames
        List extraValues

        construct(string name, string kind, float p0, float p1, float p2 = 0.0, float p3 = 0.0) {
            this.name = name
            this.kind = kind.ToUpper()
            this.p0 = p0
            this.p1 = p1
            this.p2 = p2
            this.p3 = p3
            this.extraNames = new List()
            this.extraValues = new List()
        }

        /// <summary>Sets a number by name (`Model.Get("1N4148").With("mine", 0, 3e-9).Set("CJO", 2e-12)`); returns the model.</summary>
        Circuits.Model Set(string name, float value : any) {
            var raw = Circuits.Units.Raw(value)
            var key = name.ToUpper()
            var i = this.extraNames.IndexOf(key)
            if (i < 0) {
                this.extraNames.Add(key)
                this.extraValues.Add(raw)
            } else { this.extraValues[i] = raw }
            return this
        }

        /// <summary>A number by name (or `fallback` when the model does not have it).</summary>
        float Param(string name, float fallback = 0.0) {
            var i = this.extraNames.IndexOf(name.ToUpper())
            if (i < 0) { return fallback }
            return this.extraValues[i]
        }

        string Name { get { return this.name } }
        string Kind { get { return this.kind } }

        /// <summary>A model of a part with two terminals given by a formula: the current from A through the part to B as a function of V (V(A) - V(B)).
        /// `parameters` are its names and values ("Is=1e-12 n=1.5"); a part can change them.</summary>
        static Circuits.Model Formula(string name, string current, string parameters = "") {
            Circuits.Model.Check(current, parameters, false)
            var m = new Circuits.Model(name, "FORMULA", 0.0, 0.0)
            m.current1 = current
            m.parameters = parameters
            return m
        }

        /// <summary>A model of a part with three terminals given by formulas: the currents into its first and second terminal as functions of V1 and V2 (the
        /// voltages of the first and the second terminal against the third).</summary>
        static Circuits.Model Formula3(string name, string current1, string current2, string parameters = "") {
            Circuits.Model.Check(current1, parameters, true)
            if (current2 != "") { Circuits.Model.Check(current2, parameters, true) }
            var m = new Circuits.Model(name, "FORMULA3", 0.0, 0.0)
            m.current1 = current1
            m.current2 = current2
            m.parameters = parameters
            return m
        }

        static undefined Check(string formula, string parameters, bool threeTerminals) {
            string error = __CirCheckFormula(formula, parameters, threeTerminals)
            if (error != "") { throw new ArgumentException(error) }
        }

        /// <summary>The value of the formula of the model at a voltage (V, or V1 and V2): to look at the curve of a model.</summary>
        float Evaluate(float v1, float v2 = 0.0) { return __CirEvalFormula(this.current1, this.parameters, v1, v2) }

        /// <summary>A copy with another name and changed numbers (`Model.Get("1N4148").With("mine", 0, 3e-9)` - the index of the number and its value).</summary>
        Circuits.Model With(string name, int index, float value) {
            var m = new Circuits.Model(name, this.kind, this.p0, this.p1, this.p2, this.p3)
            for (int i = 0; i < this.extraNames.count; i++) { m.Set(this.extraNames[i], this.extraValues[i]) }
            m.current1 = this.current1
            m.current2 = this.current2
            m.parameters = this.parameters
            if (index == 0) { m.p0 = value }
            if (index == 1) { m.p1 = value }
            if (index == 2) { m.p2 = value }
            if (index == 3) { m.p3 = value }
            return m
        }
    }

    /// <summary>The library of models: the ones of the package (common diodes, LEDs, transistors, MOSFETs and op amps) and the ones a program adds.</summary>
    class Models {
        static List all

        static undefined Fill() {
            if (Circuits.Models.all != undefined) { return }
            var l = new List()
            l.TakeGlobal()
            Circuits.Models.all = l
            // diodes: Is, N, BV, IBV
            Circuits.Models.Put(new Circuits.Model("diode", "D", 0.00000000000001, 1.0))
            Circuits.Models.Put(new Circuits.Model("1N4148", "D", 0.00000000252, 1.752, 100.0).Set("CJO", 4pF).Set("M", 0.333).Set("VJ", 0.5).Set("TT", 11.5ns))
            Circuits.Models.Put(new Circuits.Model("1N4001", "D", 0.00000001411, 1.984, 50.0).Set("CJO", 25.9pF).Set("M", 0.44).Set("TT", 5.7us))
            Circuits.Models.Put(new Circuits.Model("1N5817", "D", 0.0000317, 1.373, 20.0).Set("CJO", 190pF).Set("M", 0.5))
            Circuits.Models.Put(new Circuits.Model("zener", "D", 0.00000000000001, 1.0, 5.6))
            Circuits.Models.Put(new Circuits.Model("1N4733", "D", 0.00000000000001, 1.0, 5.1))
            Circuits.Models.Put(new Circuits.Model("1N4742", "D", 0.00000000000001, 1.0, 12.0))
            // LEDs (about 1.9 V red, 2.0 V yellow, 2.1 V green, 3.1 V blue and white at 20 mA)
            Circuits.Models.Put(new Circuits.Model("led", "D", 0.0000000000000000022, 2.0).Set("CJO", 40pF).Set("M", 0.33))
            Circuits.Models.Put(new Circuits.Model("red", "D", 0.0000000000000000022, 2.0).Set("CJO", 40pF).Set("M", 0.33))
            Circuits.Models.Put(new Circuits.Model("yellow", "D", 0.00000000000000000032, 2.0).Set("CJO", 40pF).Set("M", 0.33))
            Circuits.Models.Put(new Circuits.Model("green", "D", 0.000000000000000000045, 2.0).Set("CJO", 40pF).Set("M", 0.33))
            Circuits.Models.Put(new Circuits.Model("blue", "D", 0.00000000000000000000000000017, 2.0).Set("CJO", 40pF).Set("M", 0.33))
            Circuits.Models.Put(new Circuits.Model("white", "D", 0.00000000000000000000000000017, 2.0).Set("CJO", 40pF).Set("M", 0.33))
            // bipolar transistors: Is, BF, BR
            Circuits.Models.Put(new Circuits.Model("npn", "NPN", 0.00000000000001, 100.0, 1.0))
            Circuits.Models.Put(new Circuits.Model("pnp", "PNP", 0.00000000000001, 100.0, 1.0))
            Circuits.Models.Put(new Circuits.Model("2N3904", "NPN", 0.000000000000006734, 416.4, 0.7371).Set("CJE", 4.5pF).Set("CJC", 3.6pF).Set("M", 0.3).Set("VJ", 0.75).Set("TF", 301ps).Set("TR", 239.5ns))
            Circuits.Models.Put(new Circuits.Model("2N3906", "PNP", 0.00000000000000141, 180.7, 4.977).Set("CJE", 8.1pF).Set("CJC", 9.7pF).Set("M", 0.33).Set("VJ", 0.75).Set("TF", 513ps).Set("TR", 33.4ns))
            Circuits.Models.Put(new Circuits.Model("BC547", "NPN", 0.000000000000007049, 374.5, 1.0).Set("CJE", 11.5pF).Set("CJC", 5.25pF).Set("M", 0.33).Set("VJ", 0.75).Set("TF", 410ps).Set("TR", 10ns))
            Circuits.Models.Put(new Circuits.Model("BC557", "PNP", 0.000000000000003834, 344.4, 1.0).Set("CJE", 12pF).Set("CJC", 9.8pF).Set("M", 0.33).Set("VJ", 0.75).Set("TF", 600ps).Set("TR", 10ns))
            Circuits.Models.Put(new Circuits.Model("2N2222", "NPN", 0.0000000000000143, 255.9, 6.092).Set("CJE", 22pF).Set("CJC", 7.3pF).Set("M", 0.33).Set("VJ", 0.75).Set("TF", 411ps).Set("TR", 46.9ns))
            // MOSFETs: VTO, KP, LAMBDA
            Circuits.Models.Put(new Circuits.Model("nmos", "NMOS", 1.5, 0.02, 0.02))
            Circuits.Models.Put(new Circuits.Model("pmos", "PMOS", 1.5, 0.02, 0.02))
            Circuits.Models.Put(new Circuits.Model("2N7000", "NMOS", 2.1, 0.27, 0.01).Set("CGS", 20pF).Set("CGD", 5pF))
            Circuits.Models.Put(new Circuits.Model("BS250", "PMOS", 2.0, 0.2, 0.01).Set("CGS", 50pF).Set("CGD", 10pF))
            Circuits.Models.Put(new Circuits.Model("IRF540", "NMOS", 3.5, 20.0, 0.01).Set("CGS", 1.7nF).Set("CGD", 100pF))
            Circuits.Models.Put(new Circuits.Model("IRF9540", "PMOS", 3.5, 10.0, 0.01).Set("CGS", 1.3nF).Set("CGD", 140pF))
            // parts given by formulas
            Circuits.Models.Put(Circuits.Model.Formula("tunnel", "Ip*(V/Vp)*exp(1-V/Vp) + Is*(exp(V/(n*Vt))-1)", "Ip=5m Vp=0.1 Is=1e-12 n=1.5"))
            Circuits.Models.Put(Circuits.Model.Formula("varistor", "I0*(V/V0)*pow(abs(V/V0), a-1)", "I0=1m V0=200 a=30"))
            Circuits.Models.Put(Circuits.Model.Formula("lamp", "V/(R0*(1+k*sqrt(abs(V))))", "R0=10 k=0.5"))
            // op amps: GAIN, VMIN, VMAX, ROUT
            Circuits.Models.Put(new Circuits.Model("opamp", "OPAMP", 100000.0, -15.0, 15.0, 1.0))
            Circuits.Models.Put(new Circuits.Model("LM358", "OPAMP", 100000.0, 0.0, 3.5, 10.0))
            Circuits.Models.Put(new Circuits.Model("TL072", "OPAMP", 200000.0, -13.5, 13.5, 10.0))
            Circuits.Models.Put(new Circuits.Model("LM741", "OPAMP", 200000.0, -13.0, 13.0, 75.0))
        }

        static undefined Put(Circuits.Model model) {
            // a model of the same name is replaced
            for (int i = 0; i < Circuits.Models.all.count; i++) {
                if (Circuits.Models.all[i].name.ToUpper() == model.name.ToUpper()) {
                    Circuits.Models.all.RemoveAt(i)
                    break
                }
            }
            Circuits.Models.all.Add(take model)
        }

        /// <summary>Adds a model of the program (or replaces the one of the same name). Returns it.</summary>
        static Circuits.Model Add(Circuits.Model model) {
            Circuits.Models.Fill()
            model.TakeGlobal()
            Circuits.Models.Put(model)
            return model
        }

        /// <summary>The model of this name (not case sensitive).</summary>
        static Circuits.Model Get(string name) {
            Circuits.Models.Fill()
            foreach (m in Circuits.Models.all) {
                if (m.name.ToUpper() == name.ToUpper()) { return m }
            }
            throw new ArgumentException("There is no model '" + name + "'.")
        }

        static bool Has(string name) {
            Circuits.Models.Fill()
            foreach (m in Circuits.Models.all) {
                if (m.name.ToUpper() == name.ToUpper()) { return true }
            }
            return false
        }

        /// <summary>The names of the models of a kind ("D", "NPN", ...; "" for all).</summary>
        static List Names(string kind = "") {
            Circuits.Models.Fill()
            var names = new List()
            foreach (m in Circuits.Models.all) {
                if (kind == "" || m.kind == kind.ToUpper()) { names.Add(m.name) }
            }
            return names
        }

        // a model given by name or as a Model, checked against the kinds the part takes
        static Circuits.Model Of(any model, string kinds) {
            Circuits.Model m = undefined
            if (model is of string) { m = Circuits.Models.Get(model) } else { m = model!Circuits.Model }
            if (!("," + kinds + ",").Contains("," + m.kind + ",")) { throw new ArgumentException("The model '" + m.name + "' is a " + m.kind + ", not a " + kinds + ".") }
            return m
        }
    }

    /// <summary>A diode: A is the anode, B the cathode. `model`: a name of the library ("1N4148", "zener", "red", ...) or a Model.</summary>
    class Diode : TwoTerminal {
        Circuits.Model model

        construct(any model = "diode") : base("D") {
            this.model = Circuits.Models.Of(model, "D")
        }

        Circuits.Model Model { get { return this.model } }

        bool Compile(Circuits.Solver solver) {
            this.index = solver.AddNonlinear(0, this.A, this.B, this.B, this.model.p0, this.model.p1, this.model.p2, this.model.p3)
            var m = this.model
            solver.SetCaps(this.index, m.Param("CJO"), 0.0, m.Param("VJ", 0.7), m.Param("M", 0.5), m.Param("TT"))
            return true
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 6, this.index, 0, 0.0) }
        float CurrentRaw() {
            var plan = this.Plan()
            if (plan == undefined) { return 0.0 }
            return plan.NlState(this.index, 0)
        }
    }

    /// <summary>A Zener diode: conducts backwards above `voltage` (B to A).</summary>
    class Zener : Diode {
        construct(float voltage : any = 5.6) : base(Circuits.Models.Get("zener").With("zener", 2, Circuits.Units.Volts(voltage))) { }
    }

    /// <summary>A light emitting diode: `color` is "red", "yellow", "green", "blue", "white" (or a model). Brightness is its current against `ratedCurrent`.</summary>
    class Led : Diode {
        float rated

        construct(any color = "red", float ratedCurrent : any = 0.02) : base(color) { this.rated = Circuits.Units.Amps(ratedCurrent) }

        /// <summary>0 (off) to 1 (at the rated current or more).</summary>
        float Brightness {
            get {
                var b = this.CurrentRaw() / this.rated
                if (b < 0.0) { return 0.0 }
                if (b > 1.0) { return 1.0 }
                return b
            }
        }

        bool IsOn { get { return this.CurrentRaw() > this.rated * 0.05 } }
    }

    /// <summary>A bipolar transistor (Ebers-Moll): ports C, B, E. `model`: "npn", "pnp", "2N3904", "2N3906", "BC547", ... or a Model.</summary>
    class Transistor : Part {
        Circuits.Model model
        int index = -1

        construct(any model = "npn") : base("Q") {
            this.model = Circuits.Models.Of(model, "NPN,PNP")
            this.AddPort("c")
            this.AddPort("b")
            this.AddPort("e")
        }

        Port C { get { return this.ports[0] } }
        Port B { get { return this.ports[1] } }
        Port E { get { return this.ports[2] } }
        Circuits.Model Model { get { return this.model } }
        bool IsPnp { get { return this.model.kind == "PNP" } }

        bool Compile(Circuits.Solver solver) {
            var kind = 1
            if (this.IsPnp) { kind = 2 }
            this.index = solver.AddNonlinear(kind, this.C, this.B, this.E, this.model.p0, this.model.p1, this.model.p2, 0.0)
            var m = this.model
            solver.SetCaps(this.index, m.Param("CJE"), m.Param("CJC"), m.Param("VJ", 0.75), m.Param("M", 0.33), m.Param("TF"), m.Param("TR"))
            return true
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 6, this.index, 0, 0.0) }

        float Terminal(int t) {
            var plan = this.Plan()
            if (plan == undefined) { return 0.0 }
            return plan.NlState(this.index, t)
        }
        /// <summary>The currents flowing into the collector, the base and the emitter.</summary>
        float:A CollectorCurrent { get { return this.Terminal(0) * 1A } }
        float:A BaseCurrent { get { return this.Terminal(1) * 1A } }
        float:A EmitterCurrent { get { return this.Terminal(2) * 1A } }
        float CurrentRaw() { return this.Terminal(0) }
    }

    /// <summary>A MOSFET (level 1): ports D, G, S. `model`: "nmos", "pmos", "2N7000", "BS250", "IRF540", ... or a Model.</summary>
    class Mosfet : Part {
        Circuits.Model model
        int index = -1

        construct(any model = "nmos") : base("M") {
            this.model = Circuits.Models.Of(model, "NMOS,PMOS")
            this.AddPort("d")
            this.AddPort("g")
            this.AddPort("s")
        }

        Port D { get { return this.ports[0] } }
        Port G { get { return this.ports[1] } }
        Port S { get { return this.ports[2] } }
        Circuits.Model Model { get { return this.model } }
        bool IsPChannel { get { return this.model.kind == "PMOS" } }

        bool Compile(Circuits.Solver solver) {
            var kind = 3
            if (this.IsPChannel) { kind = 4 }
            this.index = solver.AddNonlinear(kind, this.D, this.G, this.S, this.model.p0, this.model.p1, this.model.p2, 0.0)
            var m = this.model
            solver.SetCaps(this.index, m.Param("CGS"), m.Param("CGD"), 0.7, 0.0, 0.0)
            return true
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 6, this.index, 0, 0.0) }

        /// <summary>The current flowing into the drain.</summary>
        float:A DrainCurrent { get { return this.CurrentRaw() * 1A } }
        float CurrentRaw() {
            var plan = this.Plan()
            if (plan == undefined) { return 0.0 }
            return plan.NlState(this.index, 0)
        }
    }

    /// <summary>An operational amplifier: ports Plus, Minus, Out. The output is gain * (plus - minus), limited to the output range of the model and driven
    /// through its output resistance (the supply is not modelled: the range is given against ground). `model`: "opamp" (+-15 V), "LM358", "TL072", "LM741".</summary>
    class OpAmp : Part {
        Circuits.Model model
        int index = -1

        construct(any model = "opamp") : base("U") {
            this.model = Circuits.Models.Of(model, "OPAMP")
            this.AddPort("plus")
            this.AddPort("minus")
            this.AddPort("out")
        }

        Port Plus { get { return this.ports[0] } }
        Port Minus { get { return this.ports[1] } }
        Port Out { get { return this.ports[2] } }
        Circuits.Model Model { get { return this.model } }

        bool Compile(Circuits.Solver solver) {
            this.index = solver.AddNonlinear(5, this.Plus, this.Minus, this.Out, this.model.p0, this.model.p1, this.model.p2, this.model.p3)
            if (this.index < 0) { throw new ArgumentException(solver.Error()) }
            return true
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 6, this.index, 2, 0.0) }

        /// <summary>The current flowing into the output (negative: the op amp drives current out).</summary>
        float CurrentRaw() {
            var plan = this.Plan()
            if (plan == undefined) { return 0.0 }
            return plan.NlState(this.index, 2)
        }
    }

    /// <summary>A part with two terminals given by a formula: the current from A through the part to B as a function of V = V(A) - V(B), with the names
    /// and values of `parameters` ("Is=1e-12 n=1.5"), Vt (the thermal voltage), t (the time), pi and e. Functions: exp, log, sqrt, abs, sin, cos, tanh, atan,
    /// min, max, pow, if(c, a, b) (a when c > 0), limit(x, lo, hi); operators + - * / ^. The kernel compiles it and derives it by itself.
    /// `formula` may also be the name of a model of kind "FORMULA"; `parameters` then change the ones of the model.</summary>
    class Formula : TwoTerminal {
        string current
        string parameters

        construct(string formula, string parameters = "") : base("F") {
            if (Circuits.Models.Has(formula)) {
                var m = Circuits.Models.Of(formula, "FORMULA")
                this.current = m.current1
                this.parameters = m.parameters + " " + parameters
            } else {
                this.current = formula
                this.parameters = parameters
            }
            Circuits.Model.Check(this.current, this.parameters, false)
        }

        string Text { get { return this.current } }

        /// <summary>Changes parameters ("n=2"): the circuit compiles again.</summary>
        undefined Set(string parameters) {
            this.parameters = this.parameters + " " + parameters
            Circuits.Model.Check(this.current, this.parameters, false)
            this.Invalidate()
        }

        bool Compile(Circuits.Solver solver) {
            this.index = solver.AddFormula(this.A, this.B, undefined, this.current, "", this.parameters)
            return true
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 6, this.index, 0, 0.0) }
        float CurrentRaw() {
            var plan = this.Plan()
            if (plan == undefined) { return 0.0 }
            return plan.NlState(this.index, 0)
        }
    }

    /// <summary>A part with three terminals given by formulas: the currents into X and Y as functions of V1 = V(X) - V(Ref) and V2 = V(Y) - V(Ref); the
    /// current into Ref is what X and Y give. Names, functions and models (kind "FORMULA3") as for Formula.</summary>
    class Formula3 : Part {
        string current1
        string current2
        string parameters
        int index = -1

        construct(string formula1, string formula2 = "", string parameters = "") : base("F3") {
            if (Circuits.Models.Has(formula1)) {
                var m = Circuits.Models.Of(formula1, "FORMULA3")
                this.current1 = m.current1
                this.current2 = m.current2
                this.parameters = m.parameters + " " + parameters
            } else {
                this.current1 = formula1
                this.current2 = formula2
                this.parameters = parameters
            }
            Circuits.Model.Check(this.current1, this.parameters, true)
            if (this.current2 != "") { Circuits.Model.Check(this.current2, this.parameters, true) }
            this.AddPort("x")
            this.AddPort("y")
            this.AddPort("ref")
        }

        Port X { get { return this.ports[0] } }
        Port Y { get { return this.ports[1] } }
        Port Ref { get { return this.ports[2] } }

        undefined Set(string parameters) {
            this.parameters = this.parameters + " " + parameters
            this.Invalidate()
        }

        bool Compile(Circuits.Solver solver) {
            this.index = solver.AddFormula(this.X, this.Y, this.Ref, this.current1, this.current2, this.parameters)
            return true
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 6, this.index, 0, 0.0) }

        float Terminal(int t) {
            var plan = this.Plan()
            if (plan == undefined) { return 0.0 }
            return plan.NlState(this.index, t)
        }
        /// <summary>The currents into X and Y.</summary>
        float:A CurrentX { get { return this.Terminal(0) * 1A } }
        float:A CurrentY { get { return this.Terminal(1) * 1A } }
        float CurrentRaw() { return this.Terminal(0) }
    }

    /// <summary>A logic gate (or a D flip-flop): reads its inputs after every step (high above half the supply) and drives its output through a small resistance
    /// in the next one (high: `supply`, low: 0 V). Kinds: "AND", "OR", "XOR", "NAND", "NOR", "XNOR", "NOT", "BUFFER".</summary>
    class Gate : Part {
        int kind
        int inputCount
        float supply
        float rout
        int index = -1

        construct(string kind, int inputs = 2, float supply : any = 5, float outputResistance : any = 10) : base(kind.ToUpper()) {
            var names = ["AND", "OR", "XOR", "NAND", "NOR", "XNOR", "NOT", "BUFFER"]
            this.kind = -1
            for (int i = 0; i < names.length; i++) {
                if (names[i] == kind.ToUpper()) { this.kind = i }
            }
            if (this.kind < 0) { throw new ArgumentException("There is no gate '" + kind + "'.") }
            if (this.kind >= 6) { inputs = 1 }
            if (inputs < 1) { throw new ArgumentException("A gate needs an input.") }
            this.inputCount = inputs
            this.supply = Circuits.Units.Volts(supply)
            this.rout = Circuits.Units.Ohms(outputResistance)
            for (int i = 0; i < inputs; i++) { this.AddPort("in" + i) }
            this.AddPort("out")
        }

        /// <summary>The input i (0, 1, ...).</summary>
        Port In(int i) { return this.ports[i] }
        Port Out { get { return this.ports[this.inputCount] } }

        bool Compile(Circuits.Solver solver) {
            var nodes = new int[this.inputCount]
            for (int i = 0; i < this.inputCount; i++) { nodes[i] = solver.Node(this.ports[i]) }
            this.index = solver.AddGate(this.kind, nodes, solver.Node(this.Out), -1, this.supply, this.supply / 2, this.rout)
            return true
        }

        /// <summary>Is the output high?</summary>
        bool State {
            get {
                var plan = this.Plan()
                if (plan == undefined) { return false }
                return plan.GateState(this.index)
            }
        }
    }

    /// <summary>A D flip-flop: takes D on the rising edge of Clock; outputs Q and NotQ.</summary>
    class FlipFlop : Part {
        float supply
        float rout
        int index = -1

        construct(float supply : any = 5, float outputResistance : any = 10) : base("DFF") {
            this.supply = Circuits.Units.Volts(supply)
            this.rout = Circuits.Units.Ohms(outputResistance)
            this.AddPort("d")
            this.AddPort("clk")
            this.AddPort("q")
            this.AddPort("nq")
        }

        Port D { get { return this.ports[0] } }
        Port Clock { get { return this.ports[1] } }
        Port Q { get { return this.ports[2] } }
        Port NotQ { get { return this.ports[3] } }

        bool Compile(Circuits.Solver solver) {
            var nodes = new int[2]
            nodes[0] = solver.Node(this.D)
            nodes[1] = solver.Node(this.Clock)
            this.index = solver.AddGate(8, nodes, solver.Node(this.Q), solver.Node(this.NotQ), this.supply, this.supply / 2, this.rout)
            return true
        }

        bool State {
            get {
                var plan = this.Plan()
                if (plan == undefined) { return false }
                return plan.GateState(this.index)
            }
        }
    }

    /// <summary>A comparator: Out is high (`supply`) while Plus is above Minus, else 0 V - read after every step, driven in the next one.</summary>
    class Comparator : Part {
        float supply
        float rout
        int index = -1

        construct(float supply : any = 5, float outputResistance : any = 10) : base("CMP") {
            this.supply = Circuits.Units.Volts(supply)
            this.rout = Circuits.Units.Ohms(outputResistance)
            this.AddPort("plus")
            this.AddPort("minus")
            this.AddPort("out")
        }

        Port Plus { get { return this.ports[0] } }
        Port Minus { get { return this.ports[1] } }
        Port Out { get { return this.ports[2] } }

        bool Compile(Circuits.Solver solver) {
            var nodes = new int[2]
            nodes[0] = solver.Node(this.Plus)
            nodes[1] = solver.Node(this.Minus)
            this.index = solver.AddGate(9, nodes, solver.Node(this.Out), -1, this.supply, this.supply / 2, this.rout)
            return true
        }

        bool State {
            get {
                var plan = this.Plan()
                if (plan == undefined) { return false }
                return plan.GateState(this.index)
            }
        }
    }

    /// <summary>An SR latch: S high sets Q, R high clears it (R wins), Reset low clears it too (leave it high or open... it has no pull-up: tie it to the
    /// supply when it is not used, or pass `withReset = false`).</summary>
    class SRLatch : Part {
        float supply
        float rout
        bool withReset
        int index = -1

        construct(float supply : any = 5, bool withReset = false, float outputResistance : any = 10) : base("SR") {
            this.supply = Circuits.Units.Volts(supply)
            this.rout = Circuits.Units.Ohms(outputResistance)
            this.withReset = withReset
            this.AddPort("s")
            this.AddPort("r")
            this.AddPort("q")
            this.AddPort("nq")
            this.AddPort("reset")
        }

        Port S { get { return this.ports[0] } }
        Port R { get { return this.ports[1] } }
        Port Q { get { return this.ports[2] } }
        Port NotQ { get { return this.ports[3] } }
        Port Reset { get { return this.ports[4] } }

        bool Compile(Circuits.Solver solver) {
            var count = 2
            if (this.withReset) { count = 3 }
            var nodes = new int[count]
            nodes[0] = solver.Node(this.S)
            nodes[1] = solver.Node(this.R)
            if (this.withReset) { nodes[2] = solver.Node(this.Reset) }
            this.index = solver.AddGate(10, nodes, solver.Node(this.Q), solver.Node(this.NotQ), this.supply, this.supply / 2, this.rout)
            return true
        }

        bool State {
            get {
                var plan = this.Plan()
                if (plan == undefined) { return false }
                return plan.GateState(this.index)
            }
        }
    }

    /// <summary>A potentiometer: a resistance between A and B with a wiper on it. `position` 0 puts the wiper at A, 1 at B (the resistance from A to the
    /// wiper is position * resistance).</summary>
    class Potentiometer : Part {
        float r
        float position

        construct(float resistance : any = 1000, float position = 0.5) : base("POT") {
            this.r = Circuits.Units.Ohms(resistance)
            this.position = Circuits.Potentiometer.Clamp(position)
            this.AddPort("a")
            this.AddPort("b")
            this.AddPort("wiper")
        }

        Port A { get { return this.ports[0] } }
        Port B { get { return this.ports[1] } }
        Port Wiper { get { return this.ports[2] } }

        static float Clamp(float p) {
            if (p < 0.0) { return 0.0 }
            if (p > 1.0) { return 1.0 }
            return p
        }

        float:any Resistance {
            get { return this.r * 1Ohm }
            set {
                this.r = Circuits.Units.Ohms(value)
                this.Invalidate()
            }
        }

        /// <summary>Where the wiper is: 0 at A, 1 at B.</summary>
        float Position {
            get { return this.position }
            set {
                var p = Circuits.Potentiometer.Clamp(value)
                if (p == this.position) { return }
                this.position = p
                this.Invalidate()
            }
        }

        // the two halves (never quite zero: a wire would short the node)
        float Upper() { return Math.Max(this.r * this.position, 0.001) }
        float Lower() { return Math.Max(this.r * (1.0 - this.position), 0.001) }

        bool Compile(Circuits.Solver solver) {
            solver.Conductance(this.A, this.Wiper, 1.0 / this.Upper())
            solver.Conductance(this.Wiper, this.B, 1.0 / this.Lower())
            return true
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 4, solver.Node(this.A), solver.Node(this.Wiper), 1.0 / this.Upper()) }
        /// <summary>The current from A into the wiper.</summary>
        float CurrentRaw() { return (this.A.Raw() - this.Wiper.Raw()) / this.Upper() }
        /// <summary>The current from the wiper to B.</summary>
        float:A LowerCurrent { get { return (this.Wiper.Raw() - this.B.Raw()) / this.Lower() * 1A } }
    }

    /// <summary>A transformer: two coupled windings, the primary from P1 to P2 (inductance `inductance`) and the secondary from S1 to S2 (`inductance` *
    /// `ratio`^2, so the voltage is about `ratio` times the primary's). `coupling` below 1 (0.999 is a good transformer); the dots are at P1 and S1.</summary>
    class Transformer : Part {
        float l1
        float ratio
        float k
        int index = -1
        float i1 = 0.0
        float i2 = 0.0
        float v1 = 0.0
        float v2 = 0.0

        construct(float inductance : any = 4, float ratio = 1.0, float coupling = 0.999) : base("T") {
            this.l1 = Circuits.Units.Henries(inductance)
            if (ratio <= 0.0) { throw new ArgumentException("The ratio of a transformer must be more than 0.") }
            this.ratio = ratio
            this.k = coupling
            this.AddPort("p1")
            this.AddPort("p2")
            this.AddPort("s1")
            this.AddPort("s2")
        }

        Port P1 { get { return this.ports[0] } }
        Port P2 { get { return this.ports[1] } }
        Port S1 { get { return this.ports[2] } }
        Port S2 { get { return this.ports[3] } }

        float:any Inductance {
            get { return this.l1 * 1H }
            set {
                this.l1 = Circuits.Units.Henries(value)
                this.Invalidate()
            }
        }
        /// <summary>Secondary to primary turns (voltage) ratio.</summary>
        float Ratio {
            get { return this.ratio }
            set {
                this.ratio = value
                this.Invalidate()
            }
        }
        float Coupling {
            get { return this.k }
            set {
                this.k = value
                this.Invalidate()
            }
        }

        undefined Reset() {
            this.i1 = 0.0
            this.i2 = 0.0
            this.v1 = 0.0
            this.v2 = 0.0
        }

        bool Compile(Circuits.Solver solver) {
            this.index = solver.AddCoupled(this.P1, this.P2, this.S1, this.S2, this.l1, this.l1 * this.ratio * this.ratio, this.k, this.i1, this.i2, this.v1, this.v2)
            return true
        }
        undefined Save(Circuits.Solver solver) {
            this.v1 = solver.State(2, this.index, 0)
            this.i1 = solver.State(2, this.index, 1)
            this.v2 = solver.State(2, this.index, 2)
            this.i2 = solver.State(2, this.index, 3)
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 7, this.index, 0, 0.0) }

        float Winding(int what, float saved) {
            var plan = this.Plan()
            if (plan == undefined) { return saved }
            return plan.State(2, this.index, what)
        }
        /// <summary>The current of the primary (from P1 through the winding to P2).</summary>
        float CurrentRaw() { return this.Winding(1, this.i1) }
        /// <summary>The current of the secondary (from S1 through the winding to S2).</summary>
        float:A SecondaryCurrent { get { return this.Winding(3, this.i2) * 1A } }
    }

    /// <summary>A JK flip-flop: on the rising edge of Clock (the falling one with `fallingEdge`) J and K high toggle it, J sets it, K clears it. With
    /// `withReset` a high Reset clears it at any time.</summary>
    class JKFlipFlop : Part {
        float supply
        float rout
        bool falling
        bool withReset
        int index = -1

        construct(float supply : any = 5, bool fallingEdge = false, bool withReset = false, float outputResistance : any = 10) : base("JK") {
            this.supply = Circuits.Units.Volts(supply)
            this.rout = Circuits.Units.Ohms(outputResistance)
            this.falling = fallingEdge
            this.withReset = withReset
            this.AddPort("j")
            this.AddPort("clk")
            this.AddPort("k")
            this.AddPort("q")
            this.AddPort("nq")
            this.AddPort("reset")
        }

        Port J { get { return this.ports[0] } }
        Port Clock { get { return this.ports[1] } }
        Port K { get { return this.ports[2] } }
        Port Q { get { return this.ports[3] } }
        Port NotQ { get { return this.ports[4] } }
        Port Reset { get { return this.ports[5] } }

        bool Compile(Circuits.Solver solver) {
            var count = 3
            if (this.withReset) { count = 4 }
            var nodes = new int[count]
            nodes[0] = solver.Node(this.J)
            nodes[1] = solver.Node(this.Clock)
            nodes[2] = solver.Node(this.K)
            if (this.withReset) { nodes[3] = solver.Node(this.Reset) }
            this.index = solver.AddGate(11, nodes, solver.Node(this.Q), solver.Node(this.NotQ), this.supply, this.supply / 2, this.rout)
            solver.GateExtra(this.index, 0.0, this.falling)
            return true
        }

        bool State {
            get {
                var plan = this.Plan()
                if (plan == undefined) { return false }
                return plan.GateState(this.index)
            }
        }
    }

    /// <summary>A Schmitt trigger: Out goes high (`supply`) when In rises above `upper` and low when it falls below `lower`; in between it keeps its state.
    /// `inverting` swaps high and low.</summary>
    class SchmittTrigger : Part {
        float lower
        float upper
        float supply
        float rout
        bool inverting
        int index = -1

        construct(float lower : any = 1.66, float upper : any = 3.33, float supply : any = 5, bool inverting = false, float outputResistance : any = 10) : base("ST") {
            this.lower = Circuits.Units.Volts(lower)
            this.upper = Circuits.Units.Volts(upper)
            if (this.lower > this.upper) { throw new ArgumentException("The lower threshold of a Schmitt trigger must not be above the upper one.") }
            this.supply = Circuits.Units.Volts(supply)
            this.inverting = inverting
            this.rout = Circuits.Units.Ohms(outputResistance)
            this.AddPort("in")
            this.AddPort("out")
        }

        Port In { get { return this.ports[0] } }
        Port Out { get { return this.ports[1] } }

        bool Compile(Circuits.Solver solver) {
            var nodes = new int[1]
            nodes[0] = solver.Node(this.In)
            var kind = 12
            if (this.inverting) { kind = 13 }
            this.index = solver.AddGate(kind, nodes, solver.Node(this.Out), -1, this.supply, this.upper, this.rout)
            solver.GateExtra(this.index, this.lower, false)
            return true
        }

        bool State {
            get {
                var plan = this.Plan()
                if (plan == undefined) { return false }
                return plan.GateState(this.index)
            }
        }
    }

    /// <summary>The switch of a relay: Common is connected to NormallyClosed while the coil current is below `onCurrent`, to NormallyOpen once it reaches
    /// it, and back when it falls below `offCurrent`. It checks the coil after every step (the circuit then steps in fire) and compiles the circuit
    /// again when it switches.</summary>
    class RelayContact : Part {
        Circuits.Inductor coil
        float onCurrent
        float offCurrent
        float ron
        bool pulled = false

        construct(Circuits.Inductor coil, float onCurrent, float offCurrent, float onResistance) : base("K") {
            this.coil = coil
            this.onCurrent = onCurrent
            this.offCurrent = offCurrent
            this.ron = onResistance
            this.AddPort("com")
            this.AddPort("nc")
            this.AddPort("no")
        }

        bool Compile(Circuits.Solver solver) {
            var to = this.ports[1]
            if (this.pulled) { to = this.ports[2] }
            solver.Conductance(this.ports[0], to, 1.0 / this.ron)
            this.commitsInFire = true
            return false
        }
        undefined StampStep(Circuits.Solver solver) { this.stepsInFire = false }
        undefined Commit(Circuits.Solver solver) {
            var i = Math.Abs(this.coil.CurrentRaw())
            if (!this.pulled && i >= this.onCurrent) {
                this.pulled = true
                this.InvalidateSoon()
            } else if (this.pulled && i < this.offCurrent) {
                this.pulled = false
                this.InvalidateSoon()
            }
        }
        undefined Reset() { this.pulled = false }
        float CurrentRaw() {
            var to = this.ports[1]
            if (this.pulled) { to = this.ports[2] }
            return (this.ports[0].Raw() - to.Raw()) / this.ron
        }
    }

    /// <summary>A voltage that is a triangle (`sawtooth` false) or a sawtooth between offset - amplitude and offset + amplitude, as in Falstad's simulator.</summary>
    class TriangleSource : VoltageSource {
        construct(float amplitude : any, float frequency : any, float offset : any = 0, float phase = 0.0, bool sawtooth = false) : base(0) {
            this.wave = 3
            if (sawtooth) { this.wave = 4 }
            this.p0 = Circuits.Units.Volts(amplitude)
            this.p1 = Circuits.Units.Hertz(frequency)
            this.p2 = Circuits.Units.Volts(offset)
            this.p3 = phase
        }

        float:any Frequency {
            get { return this.p1 * 1Hz }
            set {
                this.p1 = Circuits.Units.Hertz(value)
                this.Update()
            }
        }
    }

    /// <summary>White noise: a new random voltage between offset - amplitude and offset + amplitude every step.</summary>
    class NoiseSource : VoltageSource {
        construct(float amplitude : any = 5, float offset : any = 0) : base(0) {
            this.wave = 5
            this.p0 = Circuits.Units.Volts(amplitude)
            this.p2 = Circuits.Units.Volts(offset)
        }
    }

    /// <summary>A sine whose frequency sweeps from `minFrequency` to `maxFrequency` in `sweepTime` (logarithmic or linear), then back down
    /// (`bidirectional`) or from the start again - Falstad's sweep.</summary>
    class SweepSource : VoltageSource {
        construct(float amplitude : any = 5, float minFrequency : any = 20, float maxFrequency : any = 4000, float sweepTime : any = 0.1,
                  bool logarithmic = false, bool bidirectional = true) : base(0) {
            this.wave = 6
            if (logarithmic) { this.wave = this.wave + 1 }
            if (bidirectional) { this.wave = this.wave + 2 }
            this.p0 = Circuits.Units.Volts(amplitude)
            this.p1 = Circuits.Units.Hertz(minFrequency)
            this.p2 = Circuits.Units.Hertz(maxFrequency)
            this.p3 = Circuits.Units.Seconds(sweepTime)
            if (this.p1 <= 0.0 || this.p2 <= this.p1 || this.p3 <= 0.0) { throw new ArgumentException("A sweep needs 0 < min frequency < max frequency and a sweep time.") }
        }
    }

    /// <summary>A switch with one common contact and two (or three) throws: Common is connected to throw `Position` (0, 1, 2); with `centerOff` a
    /// two-way switch has a middle position (2) that connects nothing.</summary>
    class Switch2 : Part {
        int throws
        int position
        bool centerOff

        construct(int position = 0, int throws = 2, bool centerOff = false) : base("S") {
            if (throws < 2 || throws > 8) { throw new ArgumentException("A switch has 2 to 8 throws.") }
            this.throws = throws
            this.centerOff = centerOff && throws == 2
            this.position = 0
            this.AddPort("com")
            for (int i = 0; i < throws; i++) { this.AddPort("t" + i) }
            this.Position = position
        }

        Port Common { get { return this.ports[0] } }
        /// <summary>The throw i (0, 1, ...).</summary>
        Port Throw(int i) { return this.ports[i + 1] }

        /// <summary>How many positions it has (the throws, and the middle one of a center-off switch).</summary>
        int Positions {
            get {
                if (this.centerOff) { return 3 }
                return this.throws
            }
        }

        int Position {
            get { return this.position }
            set {
                var p = value
                if (p < 0) { p = 0 }
                if (p >= this.Positions) { p = this.Positions - 1 }
                if (p == this.position) { return }
                this.position = p
                this.Invalidate()
            }
        }

        /// <summary>To the next position (after the last one back to the first).</summary>
        undefined Toggle() { this.Position = (this.position + 1) % this.Positions }

        bool Compile(Circuits.Solver solver) {
            if (this.position < this.throws) { solver.Conductance(this.ports[0], this.ports[this.position + 1], 1000000.0) }
            return true
        }
        float CurrentRaw() {
            if (this.position >= this.throws) { return 0.0 }
            return (this.ports[0].Raw() - this.ports[this.position + 1].Raw()) * 1000000.0
        }
    }

    /// <summary>A resistance that follows a state the kernel moves on after every step, from the current and voltage of the step before (the base of
    /// Lamp, Fuse, Memristor and SparkGap).</summary>
    class StateResistor : TwoTerminal {
        int kind
        float p0
        float p1
        float p2
        float p3
        // the state kept while the circuit is compiled again
        float s0 = 0.0
        float s1 = 0.0
        bool saved = false

        construct(string name, int kind, float p0, float p1, float p2, float p3) : base(name) {
            this.kind = kind
            this.p0 = p0
            this.p1 = p1
            this.p2 = p2
            this.p3 = p3
        }

        bool Compile(Circuits.Solver solver) {
            this.index = solver.AddNonlinear(this.kind, this.A, this.B, this.B, this.p0, this.p1, this.p2, this.p3)
            if (this.saved) {
                solver.NlSet(this.index, 4, this.s0)
                solver.NlSet(this.index, 5, this.s1)
            }
            return true
        }
        undefined Save(Circuits.Solver solver) {
            this.s0 = solver.NlState(this.index, 4)
            this.s1 = solver.NlState(this.index, 5)
            this.saved = true
        }
        undefined Reset() { this.saved = false }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 6, this.index, 0, 0.0) }

        // the state (0 or 1) now; undefined before the first step
        any StateOf(int what) {
            var plan = this.Plan()
            if (plan != undefined && this.index >= 0) { return plan.NlState(this.index, 4 + what) }
            if (!this.saved) { return undefined }
            if (what == 0) { return this.s0 }
            return this.s1
        }

        float CurrentRaw() {
            var plan = this.Plan()
            if (plan == undefined) { return 0.0 }
            return plan.NlState(this.index, 0)
        }
    }

    /// <summary>An incandescent lamp: its filament heats up with the power it takes (`warmTime`) and cools down (`coolTime`); its resistance grows with
    /// the temperature - cold it is about a twentieth of the hot one (`nominalVoltage`^2 / `nominalPower`). Falstad's lamp.</summary>
    class Lamp : StateResistor {
        construct(float nominalPower : any = 100, float nominalVoltage : any = 120, float warmTime : any = 0.4, float coolTime : any = 0.4) : base("LAMP", 7,
                  Circuits.Units.Raw(nominalPower), Circuits.Units.Volts(nominalVoltage), Circuits.Units.Seconds(warmTime), Circuits.Units.Seconds(coolTime)) {
            if (this.p0 <= 0.0 || this.p1 <= 0.0) { throw new ArgumentException("A lamp needs a nominal power and voltage above zero.") }
        }

        /// <summary>The temperature of the filament in kelvin (300 cold).</summary>
        float Temperature {
            get {
                var t = this.StateOf(0)
                if (t == undefined) { return 300.0 }
                return t
            }
        }

        /// <summary>0 (dark, below 800 K) to 1 (white hot, 2400 K and more).</summary>
        float Brightness {
            get {
                var b = (this.Temperature - 800.0) / 1600.0
                if (b < 0.0) { return 0.0 }
                if (b > 1.0) { return 1.0 }
                return b
            }
        }
    }

    /// <summary>A fuse: the heat i^2 t of its current builds up (and goes away within 3 seconds); when it reaches `i2t` (A^2 s) the fuse blows and stays
    /// open (1 GOhm) until Repair. Falstad's fuse.</summary>
    class Fuse : StateResistor {
        construct(float resistance : any = 0.0613, float i2t = 6.73) : base("F", 8, Circuits.Units.Ohms(resistance), i2t, 0.0, 0.0) {
            if (i2t <= 0.0) { throw new ArgumentException("A fuse needs an i2t above zero.") }
        }

        bool Blown {
            get {
                var b = this.StateOf(1)
                return b != undefined && b != 0.0
            }
        }

        /// <summary>How far it is to blowing: 0 cold, 1 blown.</summary>
        float Heat {
            get {
                var h = this.StateOf(0)
                if (h == undefined) { return 0.0 }
                if (this.Blown) { return 1.0 }
                return h / this.p1
            }
        }

        /// <summary>A new fuse.</summary>
        undefined Repair() {
            this.saved = false
            this.Invalidate()
        }
    }

    /// <summary>A memristor (HP's model): its resistance goes from `offResistance` to `onResistance` as charge flows through it (the doped layer of
    /// `width` grows with the `mobility` of the dopants) and back with the other direction. Falstad's memristor.</summary>
    class Memristor : StateResistor {
        construct(float onResistance : any = 100, float offResistance : any = 16000, float width = 0.00000001, float mobility = 0.0000000001) : base("M", 9,
                  Circuits.Units.Ohms(onResistance), Circuits.Units.Ohms(offResistance), width, mobility) { }

        /// <summary>The resistance now.</summary>
        float:any Resistance {
            get {
                var r = this.StateOf(1)
                if (r == undefined) { return this.p1 * 1Ohm }
                return r * 1Ohm
            }
        }
    }

    /// <summary>A spark gap: it fires when the voltage across it exceeds `breakdown` (then `onResistance`) and goes out when the current falls below
    /// `holdCurrent` (then `offResistance`). Falstad's spark gap.</summary>
    class SparkGap : StateResistor {
        construct(float breakdown : any = 1000, float holdCurrent : any = 0.001, float onResistance : any = 1000, float offResistance : any = 1000000000) : base("SG", 10,
                  Circuits.Units.Ohms(onResistance), Circuits.Units.Ohms(offResistance), Circuits.Units.Volts(breakdown), Circuits.Units.Amps(holdCurrent)) { }

        bool IsOn {
            get {
                var s = this.StateOf(0)
                return s != undefined && s != 0.0
            }
        }
    }

    /// <summary>An analog switch: A and B are connected (`onResistance`) while Control is at or above `threshold` (below it when `inverting`), else
    /// `offResistance` lies between them. Control takes no current.</summary>
    class AnalogSwitch : Part {
        float ron
        float roff
        float threshold
        bool inverting
        int index = -1

        construct(float threshold : any = 2.5, bool inverting = false, float onResistance : any = 20, float offResistance : any = 10000000000) : base("SW") {
            this.threshold = Circuits.Units.Volts(threshold)
            this.inverting = inverting
            this.ron = Circuits.Units.Ohms(onResistance)
            this.roff = Circuits.Units.Ohms(offResistance)
            this.AddPort("a")
            this.AddPort("b")
            this.AddPort("control")
        }

        Port A { get { return this.ports[0] } }
        Port B { get { return this.ports[1] } }
        Port Control { get { return this.ports[2] } }

        bool Compile(Circuits.Solver solver) {
            var inv = 0.0
            if (this.inverting) { inv = 1.0 }
            this.index = solver.AddNonlinear(11, this.A, this.B, this.Control, this.ron, this.roff, this.threshold, inv)
            return true
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 6, this.index, 0, 0.0) }

        bool IsOn {
            get {
                var plan = this.Plan()
                if (plan == undefined) { return false }
                return plan.NlState(this.index, 4) != 0.0
            }
        }
        float CurrentRaw() {
            var plan = this.Plan()
            if (plan == undefined) { return 0.0 }
            return plan.NlState(this.index, 0)
        }
    }

    /// <summary>An analog switch with two throws: Common is on NormallyOpen while Control is at or above `threshold` and on NormallyClosed below it.</summary>
    class AnalogSwitch2 : Circuit {
        Circuits.AnalogSwitch closer

        construct(float threshold : any = 2.5, float onResistance : any = 20, float offResistance : any = 10000000000, bool swap = false) : base("switch2") {
            var com = this.AddPort("com")
            var no = this.AddPort("no")
            var nc = this.AddPort("nc")
            var control = this.AddPort("control")
            // (`swap`: NormallyOpen is on below the threshold, NormallyClosed above it)
            var a = this.Add(new Circuits.AnalogSwitch(threshold, swap, onResistance, offResistance))
            var b = this.Add(new Circuits.AnalogSwitch(threshold, !swap, onResistance, offResistance))
            com.Connect(a.A)
            com.Connect(b.A)
            no.Connect(a.B)
            nc.Connect(b.B)
            control.Connect(a.Control)
            control.Connect(b.Control)
            this.closer = a
        }

        Port Common { get { return this.ports[0] } }
        Port NormallyOpen { get { return this.ports[1] } }
        Port NormallyClosed { get { return this.ports[2] } }
        Port Control { get { return this.ports[3] } }
        /// <summary>Is Common on NormallyOpen?</summary>
        bool IsOn { get { return this.closer.IsOn } }
    }

    /// <summary>The switch of a thyristor (`kind` 12) or a triac (13) in the kernel: between A and B, decided before every step from the gate current
    /// (Gate against B, or against Aux for a thyristor) and its own current. Part of Thyristor and Triac.</summary>
    class GateSwitch : Part {
        int kind
        float trigger
        float holding
        float gateResistance
        int index = -1
        float s0 = 0.0
        bool saved = false

        construct(int kind, float trigger, float holding, float gateResistance) : base("gs") {
            this.kind = kind
            this.trigger = trigger
            this.holding = holding
            this.gateResistance = gateResistance
            this.AddPort("a")
            this.AddPort("b")
            this.AddPort("gate")
            this.AddPort("aux")
        }

        bool Compile(Circuits.Solver solver) {
            this.index = solver.AddNonlinear(this.kind, this.ports[0], this.ports[1], this.ports[2], this.trigger, this.holding, this.gateResistance, 0.0)
            if (this.kind == 12) { solver.NlSet(this.index, 6, solver.Node(this.ports[3])) }
            if (this.saved) { solver.NlSet(this.index, 4, this.s0) }
            return true
        }
        undefined Save(Circuits.Solver solver) {
            this.s0 = solver.NlState(this.index, 4)
            this.saved = true
        }
        undefined Reset() { this.saved = false }

        bool IsOn {
            get {
                var plan = this.Plan()
                if (plan != undefined && this.index >= 0) { return plan.NlState(this.index, 4) != 0.0 }
                return this.saved && this.s0 != 0.0
            }
        }
        float CurrentRaw() {
            var plan = this.Plan()
            if (plan == undefined) { return 0.0 }
            return plan.NlState(this.index, 0)
        }
    }

    /// <summary>A thyristor (SCR), as Falstad's: it fires when the gate current reaches `triggerCurrent` and conducts from Anode to Cathode (a diode drop)
    /// until its current falls below `holdingCurrent`. The gate has `gateResistance` to the cathode.</summary>
    class Thyristor : Circuit {
        Circuits.GateSwitch sw

        construct(float triggerCurrent : any = 0.01, float holdingCurrent : any = 0.0082, float gateResistance : any = 50) : base("scr") {
            var anode = this.AddPort("anode")
            var gate = this.AddPort("gate")
            var cathode = this.AddPort("cathode")
            var s = this.Add(new Circuits.GateSwitch(12, Circuits.Units.Amps(triggerCurrent), Circuits.Units.Amps(holdingCurrent), Circuits.Units.Ohms(gateResistance)))
            var d = this.Add(new Circuits.Diode())
            var rg = this.Add(new Circuits.Resistor(gateResistance))
            anode.Connect(s.ports[0])
            s.ports[1].Connect(d.A)
            d.B.Connect(cathode)
            gate.Connect(s.ports[2])
            gate.Connect(rg.A)
            rg.B.Connect(cathode)
            cathode.Connect(s.ports[3])
            this.sw = s
        }

        Port Anode { get { return this.ports[0] } }
        Port Gate { get { return this.ports[1] } }
        Port Cathode { get { return this.ports[2] } }
        bool IsOn { get { return this.sw.IsOn } }
        float CurrentRaw() { return this.sw.CurrentRaw() }
    }

    /// <summary>A triac, as Falstad's: fires in both directions when the gate current (gate to MT1) exceeds `triggerCurrent`, goes out when the current
    /// falls below `holdingCurrent`.</summary>
    class Triac : Circuit {
        Circuits.GateSwitch sw

        construct(float triggerCurrent : any = 0.01, float holdingCurrent : any = 0.0082, float gateResistance : any = 100) : base("triac") {
            var mt1 = this.AddPort("mt1")
            var mt2 = this.AddPort("mt2")
            var gate = this.AddPort("gate")
            var s = this.Add(new Circuits.GateSwitch(13, Circuits.Units.Amps(triggerCurrent), Circuits.Units.Amps(holdingCurrent), Circuits.Units.Ohms(gateResistance)))
            var d1 = this.Add(new Circuits.Diode())
            var d2 = this.Add(new Circuits.Diode())
            var rg = this.Add(new Circuits.Resistor(gateResistance))
            mt2.Connect(d1.A)
            d1.B.Connect(s.ports[0])
            s.ports[0].Connect(d2.A)
            d2.B.Connect(mt2)
            s.ports[1].Connect(mt1)
            gate.Connect(s.ports[2])
            gate.Connect(rg.A)
            rg.B.Connect(mt1)
            mt1.Connect(s.ports[3])
            this.sw = s
        }

        Port MT1 { get { return this.ports[0] } }
        Port MT2 { get { return this.ports[1] } }
        Port Gate { get { return this.ports[2] } }
        bool IsOn { get { return this.sw.IsOn } }
        float CurrentRaw() { return this.sw.CurrentRaw() }
    }

    /// <summary>A diac: conducts in both directions once the voltage across it exceeds `breakdown`, until the current falls below `holdCurrent` (a spark gap
    /// with a diode drop each way).</summary>
    class Diac : Circuit {
        Circuits.SparkGap gap

        construct(float breakdown : any = 30, float holdCurrent : any = 0.01, float onResistance : any = 500, float offResistance : any = 100000000) : base("diac") {
            var a = this.AddPort("a")
            var b = this.AddPort("b")
            var g = this.Add(new Circuits.SparkGap(breakdown, holdCurrent, onResistance, offResistance))
            var d1 = this.Add(new Circuits.Diode())
            var d2 = this.Add(new Circuits.Diode())
            a.Connect(g.A)
            g.B.Connect(d1.A)
            d1.B.Connect(b)
            b.Connect(d2.A)
            d2.B.Connect(g.B)
            this.gap = g
        }

        Port A { get { return this.ports[0] } }
        Port B { get { return this.ports[1] } }
        bool IsOn { get { return this.gap.IsOn } }
        float CurrentRaw() { return this.gap.CurrentRaw() }
    }

    /// <summary>A junction FET (Falstad's): a depletion MOSFET (`threshold` -4 V, `beta` 1.25 mA/V^2) with the gate junction to the source; ports D, G, S.</summary>
    class Jfet : Circuit {
        Circuits.Mosfet fet

        construct(bool pChannel = false, float threshold : any = -4, float beta = 0.00125) : base("jfet") {
            var d = this.AddPort("d")
            var g = this.AddPort("g")
            var s = this.AddPort("s")
            var kind = "NMOS"
            if (pChannel) { kind = "PMOS" }
            // the model goes into the library (an argument alone would die after the call)
            var vt = Circuits.Units.Volts(threshold)
            var name = "jfet " + kind + " " + vt + " " + beta
            if (!Circuits.Models.Has(name)) { Circuits.Models.Put(new Circuits.Model(name, kind, vt, beta, 0.0)) }
            var m = this.Add(new Circuits.Mosfet(name))
            var diode = this.Add(new Circuits.Diode())
            d.Connect(m.D)
            g.Connect(m.G)
            s.Connect(m.S)
            if (pChannel) {
                s.Connect(diode.A)
                diode.B.Connect(g)
            } else {
                g.Connect(diode.A)
                diode.B.Connect(s)
            }
            this.fet = m
        }

        Port D { get { return this.ports[0] } }
        Port G { get { return this.ports[1] } }
        Port S { get { return this.ports[2] } }
        float:A DrainCurrent { get { return this.fet.DrainCurrent } }
        float CurrentRaw() { return this.fet.CurrentRaw() }
    }

    /// <summary>A Darlington pair: two transistors of `model`, the emitter of the first on the base of the second; ports C, B, E.</summary>
    class Darlington : Circuit {
        Circuits.Transistor q1
        Circuits.Transistor q2

        construct(any model = "npn") : base("darlington") {
            var c = this.AddPort("c")
            var b = this.AddPort("b")
            var e = this.AddPort("e")
            var a = this.Add(new Circuits.Transistor(model))
            var z = this.Add(new Circuits.Transistor(model))
            c.Connect(a.C)
            c.Connect(z.C)
            b.Connect(a.B)
            a.E.Connect(z.B)
            z.E.Connect(e)
            this.q1 = a
            this.q2 = z
        }

        Port C { get { return this.ports[0] } }
        Port B { get { return this.ports[1] } }
        Port E { get { return this.ports[2] } }
        float CurrentRaw() { return this.q1.CurrentRaw() + this.q2.CurrentRaw() }
    }

    /// <summary>A varactor: a diode whose junction capacitance is `capacitance` at 0 V and falls with the reverse voltage.</summary>
    class Varactor : Diode {
        construct(float capacitance : any = 0.000000000004) : base(Circuits.Varactor.ModelFor(Circuits.Units.Farads(capacitance))) { }

        // the name of a model in the library with this capacitance
        static string ModelFor(float farads) {
            var name = "varactor " + farads
            if (!Circuits.Models.Has(name)) { Circuits.Models.Put(new Circuits.Model(name, "D", 0.00000000000001, 1.0).Set("CJO", farads).Set("VJ", 0.6).Set("M", 0.5)) }
            return name
        }
    }

    /// <summary>A tunnel diode (Falstad's model): A is the anode; the current rises to 4.7 mA at 0.1 V, falls to a valley near 0.37 V, then rises
    /// again like a diode.</summary>
    class TunnelDiode : Formula {
        construct() : base("ip*exp(-vpp/vtd)*(exp(V/vtd)-1) + ip*(V/vp)*exp(1-V/vp) + iv*exp(V-vv) - iv*exp(-vv)",
                           "ip=0.0047 vp=0.1 vv=0.37 vtd=0.026 vpp=0.525 iv=0.00037") { }
    }

    /// <summary>An operational transconductance amplifier as Falstad's (LM13700 style, built from transistors): the output current is about
    /// Iabc / (2 Vt) * (V(InPlus) - V(InMinus)); `Bias` feeds the linearizing diodes. Supplies `negative` and `positive` volts inside.</summary>
    class Ota : Circuit {
        List nodes

        construct(float positive : any = 9, float negative : any = -9) : base("ota") {
            var inPlus = this.AddPort("inplus")
            var inMinus = this.AddPort("inminus")
            var bias = this.AddPort("bias")
            var iabc = this.AddPort("iabc")
            var output = this.AddPort("out")
            this.nodes = new List()
            for (int i = 0; i < 16; i++) { this.nodes.Add(undefined) }
            this.nodes[7] = inPlus
            this.nodes[5] = inMinus
            this.nodes[15] = bias
            this.nodes[1] = iabc
            this.nodes[13] = output
            var vn = this.Add(new Circuits.VoltageSource(negative))
            vn.B.Connect(this.Ground)
            this.Join(4, vn.A)
            var vp = this.Add(new Circuits.VoltageSource(positive))
            vp.B.Connect(this.Ground)
            this.Join(10, vp.A)
            // Falstad's netlist: base, collector, emitter
            var npn = [1, 2, 3, 3, 1, 4, 3, 3, 4, 5, 6, 2, 7, 8, 2, 14, 14, 4, 14, 12, 4, 12, 13, 14, 15, 15, 5, 15, 15, 7]
            var pnp = [9, 6, 10, 9, 9, 10, 6, 12, 9, 11, 8, 10, 11, 11, 10, 8, 13, 11]
            for (int i = 0; i < npn.length; i = i + 3) { this.Transistor("npn", npn[i], npn[i + 1], npn[i + 2]) }
            for (int i = 0; i < pnp.length; i = i + 3) { this.Transistor("pnp", pnp[i], pnp[i + 1], pnp[i + 2]) }
        }

        undefined Transistor(string model, int b, int c, int e) {
            var q = this.Add(new Circuits.Transistor(model))
            this.Join(b, q.B)
            this.Join(c, q.C)
            this.Join(e, q.E)
        }

        // a port on node n of the netlist: the first one names the node, the others join it
        undefined Join(int n, Port p) {
            if (this.nodes[n] == undefined) { this.nodes[n] = p } else {
                Port first = this.nodes[n]
                first.Connect(p)
            }
        }

        Port InPlus { get { return this.ports[0] } }
        Port InMinus { get { return this.ports[1] } }
        Port Bias { get { return this.ports[2] } }
        Port Iabc { get { return this.ports[3] } }
        Port Out { get { return this.ports[4] } }
    }

    /// <summary>An optocoupler as Falstad's: an LED from Anode to Cathode, its current drives the base of an NPN transistor (Collector, Emitter); the
    /// collector current is about `ctr` times the LED current.</summary>
    class Optocoupler : Circuit {
        construct(float ctr = 1.0) : base("opto") {
            var anode = this.AddPort("anode")
            var cathode = this.AddPort("cathode")
            var collector = this.AddPort("collector")
            var emitter = this.AddPort("emitter")
            if (!Circuits.Models.Has("opto-led")) { Circuits.Models.Put(new Circuits.Model("opto-led", "D", 0.0000001714, 4.077)) }
            if (!Circuits.Models.Has("opto-npn")) { Circuits.Models.Put(new Circuits.Model("opto-npn", "NPN", 0.00000000000001, 700.0, 1.0)) }
            var led = this.Add(new Circuits.Diode("opto-led"))
            var sense = this.Add(new Circuits.CCCS(ctr / 700.0))
            var q = this.Add(new Circuits.Transistor("opto-npn"))
            anode.Connect(led.A)
            led.B.Connect(sense.InPlus)
            sense.InMinus.Connect(cathode)
            // the photo current: out of the collector into the base
            sense.A.Connect(collector)
            sense.B.Connect(q.B)
            q.C.Connect(collector)
            q.E.Connect(emitter)
        }

        Port Anode { get { return this.ports[0] } }
        Port Cathode { get { return this.ports[1] } }
        Port Collector { get { return this.ports[2] } }
        Port Emitter { get { return this.ports[3] } }
    }

    /// <summary>A unijunction transistor as Falstad's (a 2N2646): the emitter diode feeds the lower base region, whose conductance grows with the emitter
    /// current; the interbase resistance is about 2.5 kOhm. Ports E, B1, B2. (Falstad's 35 pF inside are left out: far too fast for the time steps.)</summary>
    class Unijunction : Circuit {
        construct() : base("ujt") {
            var e = this.AddPort("e")
            var b1 = this.AddPort("b1")
            var b2 = this.AddPort("b2")
            if (!Circuits.Models.Has("ujt-emitter")) { Circuits.Models.Put(new Circuits.Model("ujt-emitter", "D", 0.0000000000213, 1.8)) }
            // as Falstad's netlist: the emitter diode into the inner node x, its current sensed (1000 V per ampere on the node ctl against ref), and
            // the conductance from x to ref (the foot of B1) growing with it
            var d = this.Add(new Circuits.Diode("ujt-emitter"))
            var sense = this.Add(new Circuits.CCVS(1000))
            var core = this.Add(new Circuits.Formula3("(g0 + k*V2)*V1", "0", "g0=0.00028 k=0.00575"))
            var rb1 = this.Add(new Circuits.Resistor(38.15Ohm))
            var rb2 = this.Add(new Circuits.Resistor(2518Ohm))
            e.Connect(d.A)
            d.B.Connect(sense.InPlus)
            sense.InMinus.Connect(core.ports[0])
            sense.A.Connect(core.ports[1])
            sense.B.Connect(core.ports[2])
            b2.Connect(rb2.A)
            rb2.B.Connect(core.ports[0])
            core.ports[2].Connect(rb1.A)
            rb1.B.Connect(b1)
        }

        Port E { get { return this.ports[0] } }
        Port B1 { get { return this.ports[1] } }
        Port B2 { get { return this.ports[2] } }
    }

    /// <summary>A vacuum triode (Falstad's): the plate current (mu `mu`, kg1 `kg1`) and the grid current, against the cathode; ports Plate, Grid, Cathode.</summary>
    class Triode : Formula3 {
        construct(float mu = 93.0, float kg1 = 680.0) : base("if(V2 + V1/mu, pow(max(V2 + V1/mu, 0), 1.5)/kg1, 0.00000001*V1)", "if(V2 - 0.01, V2/6000, 0.00000001*V2)",
                                                       "mu=" + mu + " kg1=" + kg1) { }

        Port Plate { get { return this.ports[0] } }
        Port Grid { get { return this.ports[1] } }
        Port Cathode { get { return this.ports[2] } }
    }

    /// <summary>A voltage-controlled voltage source: V(A) - V(B) = `gain` * (V(InPlus) - V(InMinus)).</summary>
    class VCVS : TwoTerminal {
        float gain

        construct(float gain = 1.0) : base("E") {
            this.gain = gain
            this.AddPort("inplus")
            this.AddPort("inminus")
        }

        Port InPlus { get { return this.ports[2] } }
        Port InMinus { get { return this.ports[3] } }
        int Branches() { return 1 }
        bool Compile(Circuits.Solver solver) {
            solver.VoltageBranch(this.branch, this.A, this.B)
            solver.Entry(this.branch, solver.Node(this.InPlus), -this.gain)
            solver.Entry(this.branch, solver.Node(this.InMinus), this.gain)
            return true
        }
        float CurrentRaw() {
            var plan = this.Plan()
            if (plan == undefined) { return 0.0 }
            return -plan.BranchCurrent(this.branch)
        }
    }

    /// <summary>A voltage-controlled current source: drives `gain` * (V(InPlus) - V(InMinus)) amperes from A through itself to B (out of B into the
    /// circuit), like a CurrentSource.</summary>
    class VCCS : TwoTerminal {
        float gain

        construct(float gain : any = 0.001) : base("G") {
            this.gain = Circuits.Units.Raw(gain)
            this.AddPort("inplus")
            this.AddPort("inminus")
        }

        Port InPlus { get { return this.ports[2] } }
        Port InMinus { get { return this.ports[3] } }
        bool Compile(Circuits.Solver solver) {
            var a = solver.Node(this.A)
            var b = solver.Node(this.B)
            var p = solver.Node(this.InPlus)
            var n = solver.Node(this.InMinus)
            solver.Entry(a, p, this.gain)
            solver.Entry(a, n, -this.gain)
            solver.Entry(b, p, -this.gain)
            solver.Entry(b, n, this.gain)
            return true
        }
        float CurrentRaw() { return this.gain * (this.InPlus.Raw() - this.InMinus.Raw()) }
    }

    /// <summary>A current-controlled current source: the current that flows from InPlus to InMinus (through a short) times `gain` is driven from A
    /// through itself to B.</summary>
    class CCCS : TwoTerminal {
        float gain

        construct(float gain = 1.0) : base("F") {
            this.gain = gain
            this.AddPort("inplus")
            this.AddPort("inminus")
        }

        Port InPlus { get { return this.ports[2] } }
        Port InMinus { get { return this.ports[3] } }
        int Branches() { return 1 }
        bool Compile(Circuits.Solver solver) {
            // the sense: a voltage source of 0 V from InPlus to InMinus; its branch current is the current into InPlus
            solver.VoltageBranch(this.branch, this.InPlus, this.InMinus)
            solver.Entry(solver.Node(this.A), this.branch, this.gain)
            solver.Entry(solver.Node(this.B), this.branch, -this.gain)
            return true
        }
        float CurrentRaw() {
            var plan = this.Plan()
            if (plan == undefined) { return 0.0 }
            return this.gain * plan.BranchCurrent(this.branch)
        }
    }

    /// <summary>A current-controlled voltage source: V(A) - V(B) = `gain` (ohms) * the current that flows from InPlus to InMinus (through a short).</summary>
    class CCVS : TwoTerminal {
        float gain

        construct(float gain : any = 1000) : base("H") {
            this.gain = Circuits.Units.Raw(gain)
            this.AddPort("inplus")
            this.AddPort("inminus")
        }

        Port InPlus { get { return this.ports[2] } }
        Port InMinus { get { return this.ports[3] } }
        int Branches() { return 2 }
        bool Compile(Circuits.Solver solver) {
            var sense = this.branch + 1
            solver.VoltageBranch(sense, this.InPlus, this.InMinus)
            solver.VoltageBranch(this.branch, this.A, this.B)
            solver.Entry(this.branch, sense, -this.gain)
            return true
        }
        float CurrentRaw() {
            var plan = this.Plan()
            if (plan == undefined) { return 0.0 }
            return -plan.BranchCurrent(this.branch)
        }
    }

    /// <summary>A current conveyor (CCII, Falstad's CC2): X follows the voltage of Y (Y takes no current), the current into Z is `gain` times the current
    /// into X (+1: CCII+, -1: CCII-).</summary>
    class CurrentConveyor : TwoTerminal {
        float gain

        construct(float gain = 1.0) : base("CC2") {
            this.gain = gain
            this.AddPort("z")
        }

        /// <summary>X is A, Y is B.</summary>
        Port X { get { return this.ports[0] } }
        Port Y { get { return this.ports[1] } }
        Port Z { get { return this.ports[2] } }
        int Branches() { return 1 }
        bool Compile(Circuits.Solver solver) {
            // V(X) - V(Y) = 0 as a branch from X to ground; its current flows out of X into the circuit
            var k = this.branch
            var x = solver.Node(this.X)
            solver.Entry(x, k, 1.0)
            solver.Entry(k, x, 1.0)
            solver.Entry(k, solver.Node(this.Y), -1.0)
            // the current into Z is gain times the current into X (the branch current)
            solver.Entry(solver.Node(this.Z), k, this.gain)
            return true
        }
        float CurrentRaw() {
            var plan = this.Plan()
            if (plan == undefined) { return 0.0 }
            return plan.BranchCurrent(this.branch)
        }
    }

    /// <summary>A light dependent resistor: `resistance10` at 10 lux, falling with the light as lux^-gamma (`gamma` about 0.7), at most `dark`.</summary>
    class LightResistor : TwoTerminal {
        float lux
        float r10
        float gamma
        float dark

        construct(float lux = 100.0, float resistance10 : any = 10000, float gamma = 0.7, float dark : any = 1000000) : base("LDR") {
            this.lux = lux
            this.r10 = Circuits.Units.Ohms(resistance10)
            this.gamma = gamma
            this.dark = Circuits.Units.Ohms(dark)
        }

        /// <summary>The light on it (lux).</summary>
        float Lux {
            get { return this.lux }
            set {
                if (value == this.lux) { return }
                this.lux = value
                this.Invalidate()
            }
        }

        float ResistanceRaw() {
            if (this.lux <= 0.0) { return this.dark }
            var r = this.r10 * Math.Exp(-this.gamma * Math.Log(this.lux / 10.0))
            if (r > this.dark) { return this.dark }
            return r
        }
        float:any Resistance { get { return this.ResistanceRaw() * 1Ohm } }

        bool Compile(Circuits.Solver solver) {
            solver.Conductance(this.A, this.B, 1.0 / this.ResistanceRaw())
            return true
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 4, solver.Node(this.A), solver.Node(this.B), 1.0 / this.ResistanceRaw()) }
        float CurrentRaw() { return this.VoltageRaw() / this.ResistanceRaw() }
    }

    /// <summary>An NTC thermistor: `resistance25` at 25 °C, R = R25 exp(B (1/T - 1/298.15 K)) at `Temperature` (°C).</summary>
    class Thermistor : TwoTerminal {
        float temperature
        float r25
        float beta

        construct(float temperature = 25.0, float resistance25 : any = 10000, float beta = 3950.0) : base("TH") {
            this.temperature = temperature
            this.r25 = Circuits.Units.Ohms(resistance25)
            this.beta = beta
        }

        /// <summary>Its temperature in °C.</summary>
        float Temperature {
            get { return this.temperature }
            set {
                if (value == this.temperature) { return }
                this.temperature = value
                this.Invalidate()
            }
        }

        float ResistanceRaw() { return this.r25 * Math.Exp(this.beta * (1.0 / (this.temperature + 273.15) - 1.0 / 298.15)) }
        float:any Resistance { get { return this.ResistanceRaw() * 1Ohm } }

        bool Compile(Circuits.Solver solver) {
            solver.Conductance(this.A, this.B, 1.0 / this.ResistanceRaw())
            return true
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 4, solver.Node(this.A), solver.Node(this.B), 1.0 / this.ResistanceRaw()) }
        float CurrentRaw() { return this.VoltageRaw() / this.ResistanceRaw() }
    }

    /// <summary>A lossless transmission line of `impedance` that delays a wave by `delay`: one end between A1 (the conductor) and B1 (its return), the
    /// other between A2 and B2. A wave that comes to an end not matched by `impedance` is reflected.</summary>
    class TransmissionLine : Part {
        float z
        float delay
        int index = -1

        construct(float impedance : any = 75, float delay : any = 0.000001) : base("TL") {
            this.z = Circuits.Units.Ohms(impedance)
            this.delay = Circuits.Units.Seconds(delay)
            this.AddPort("a1")
            this.AddPort("b1")
            this.AddPort("a2")
            this.AddPort("b2")
        }

        Port A1 { get { return this.ports[0] } }
        Port B1 { get { return this.ports[1] } }
        Port A2 { get { return this.ports[2] } }
        Port B2 { get { return this.ports[3] } }

        float:any Impedance { get { return this.z * 1Ohm } }
        float:any Delay { get { return this.delay * 1s } }

        bool Compile(Circuits.Solver solver) {
            this.index = solver.AddLine(this.A1, this.B1, this.A2, this.B2, this.z, this.delay)
            return true
        }
        /// <summary>The current into the line at A1.</summary>
        float CurrentRaw() {
            var plan = this.Plan()
            if (plan == undefined) { return 0.0 }
            return plan.State(3, this.index, 0)
        }
        /// <summary>The current into the line at A2.</summary>
        float:A Current2 {
            get {
                var plan = this.Plan()
                if (plan == undefined) { return 0A }
                return plan.State(3, this.index, 1) * 1A
            }
        }
    }

    /// <summary>A logic input: a voltage source that is 0 V or `supply` (High, Toggle()).</summary>
    class LogicInput : VoltageSource {
        float supply

        construct(bool high = false, float supply : any = 5) : base(0) {
            this.supply = Circuits.Units.Volts(supply)
            this.High = high
        }

        bool High {
            get { return this.volts > this.supply / 2 }
            set {
                if (value) { this.Level = this.supply } else { this.Level = 0 }
            }
        }

        undefined Toggle() { this.High = !this.High }
    }

    /// <summary>A circuit: parts and nested circuits, its own ports (to use it as a part of a larger one) and a ground. Run/Step simulate it in time steps.
    /// The first step after a change compiles the circuit into a plan for the kernel of the package.</summary>
    class Circuit : Part {
        List parts
        List instruments
        Port ground
        float dt = 0.00001
        float time = 0.0
        Circuits.Solver solver
        bool dirty = true
        // the parts that step in fire, and whether a step needs fire at all (parts, instruments or channels of scopes in fire)
        List external
        bool fireSteps = false
        // in a step in fire, and whether the circuit is compiled again after it (Part.InvalidateSoon)
        bool stepping = false
        bool rebuild = false
        int clipped = 0
        // the parameters of the circuit (names and values in SI units) and the bindings that set the parts from them
        List paramNames
        List paramValues
        List bindings
        // the drawing the circuit is made from (undefined: a circuit built in code)
        Circuits.Schematic schematic

        construct(string name = "circuit") : base(name) {
            this.parts = new List()
            this.instruments = new List()
            this.external = new List()
            this.paramNames = new List()
            this.paramValues = new List()
            this.bindings = new List()
            var g = new Port("gnd", this)
            g.TakeTo(this)
            this.ground = g
            this.solver = undefined
            this.schematic = undefined
        }

        /// <summary>The drawing of the circuit (made on first use): elements on a grid that make the parts and their connections (docs/CIRCUITS.md).</summary>
        Circuits.Schematic Schematic {
            get {
                if (this.schematic == undefined) {
                    var s = new Circuits.Schematic(this)
                    s.TakeTo(this)
                    this.schematic = s
                }
                return this.schematic
            }
        }

        /// <summary>Is the circuit made from a drawing?</summary>
        bool HasSchematic { get { return this.schematic != undefined } }

        /// <summary>Makes the circuit from the text of a `.biscuit` file.</summary>
        undefined LoadSchematic(string text) { this.Schematic.Load(text) }

        /// <summary>Called after the drawing made or connected the parts again (the class generated from a `.biscuit` file sets its fields here).</summary>
        undefined OnBuilt() { }

        /// <summary>Takes a part out of the circuit (its ports keep their connections to other ports: connect them again).</summary>
        undefined RemovePart(Part part) {
            var i = this.parts.IndexOf(part)
            if (i < 0) { return }
            this.Invalidate()
            this.parts.RemoveAt(i)
            part.owner = undefined
            delete part
        }

        /// <summary>Stops recording with an instrument.</summary>
        undefined Detach(any instrument) {
            var i = this.instruments.IndexOf(instrument)
            if (i < 0) { return }
            this.instruments.RemoveAt(i)
            this.Invalidate()
        }

        /// <summary>The ground (0 V) of the circuit; nested circuits share the ground of the outermost one.</summary>
        Port Ground { get { return this.ground } }

        /// <summary>Adds a part (or a nested circuit); it belongs to the circuit from now on. Returns it.</summary>
        any Add(Part part) {
            this.Invalidate()
            part.TakeTo(this)
            part.owner = this
            this.parts.Add(part)
            return part
        }

        List Parts() { return this.parts }

        bool Compile(Circuits.Solver solver) { return true }

        // ---- parameters ----
        /// <summary>Sets a parameter of the circuit (a value with a unit or a plain number): the bindings of this circuit and of the circuits in it run again.
        /// A circuit in it sees the parameters of the circuits around it unless it has its own of the same name.</summary>
        undefined Parameter(string name, float value : any) {
            var raw = Circuits.Units.Raw(value)
            var i = this.paramNames.IndexOf(name)
            if (i < 0) {
                this.paramNames.Add(name)
                this.paramValues.Add(raw)
            } else { this.paramValues[i] = raw }
            this.ApplyBindings()
        }

        /// <summary>The value of a parameter (plain SI number), from this circuit or the nearest circuit around it that has it.</summary>
        float Get(string name) {
            Circuits.Circuit c = this
            while (c != undefined) {
                var i = c.paramNames.IndexOf(name)
                if (i >= 0) { return c.paramValues[i] }
                c = c.owner
            }
            throw new ArgumentException("The circuit '" + this.name + "' has no parameter '" + name + "'.")
        }

        bool HasParameter(string name) {
            Circuits.Circuit c = this
            while (c != undefined) {
                if (c.paramNames.IndexOf(name) >= 0) { return true }
                c = c.owner
            }
            return false
        }

        /// <summary>An expression of the parameters ("2*R + 1k", with the functions of Formula): its value.</summary>
        float Value(string expression) {
            var text = ""
            var seen = new List()
            Circuits.Circuit c = this
            while (c != undefined) {
                for (int i = 0; i < c.paramNames.count; i++) {
                    if (seen.IndexOf(c.paramNames[i]) < 0) {
                        seen.Add(c.paramNames[i])
                        text = text + " " + c.paramNames[i] + "=" + c.paramValues[i]
                    }
                }
                c = c.owner
            }
            string error = __CirCheckFormula(expression, text, false)
            if (error != "") { throw new ArgumentException(error) }
            return __CirEvalFormula(expression, text, 0.0, 0.0)
        }

        /// <summary>Binds parts to the parameters: `action(circuit)` runs now and whenever a parameter of this circuit or of a circuit around it changes
        /// (`c.Bind(c => r.Resistance = c.Get("R") * 2)`).</summary>
        undefined Bind(any action) {
            this.bindings.Add(action)
            var f = action
            f(this)
        }

        undefined ApplyBindings() {
            foreach (b in this.bindings) {
                var f = b
                f(this)
            }
            if (this.schematic != undefined) { this.schematic.ParametersChanged() }
            foreach (p in this.parts) {
                if (p is of Circuit) {
                    Circuit c = p!Circuit
                    c.ApplyBindings()
                }
            }
        }

        /// <summary>The time step of the simulation (default 10 us).</summary>
        float:any TimeStep {
            get { return this.dt * 1s }
            set {
                this.dt = Circuits.Units.Seconds(value)
                this.Invalidate()
            }
        }

        /// <summary>The time of the simulation.</summary>
        float:s Time { get { return this.time * 1s } }
        float TimeRaw() { return this.time }

        /// <summary>Is the circuit compiled (since its last change)?</summary>
        bool IsCompiled { get { return !this.Top().dirty } }

        undefined Invalidate() {
            var top = this.Top()
            if (top.dirty) { return }
            top.Release()
        }

        // the outermost circuit: keeps the state of the parts and the voltages of the nodes, and drops the plan
        undefined Release() {
            this.dirty = true
            var s = this.solver
            if (s == undefined) { return }
            this.time = s.Time()
            var leaves = new List()
            this.Collect(leaves)
            foreach (p in leaves) { p.Save(s) }
            foreach (port in this.AllPorts(leaves)) {
                var root = port.Root()
                if (root.node >= -1) { root.v = s.NodeVoltage(root.node) }
            }
            this.solver = undefined
            delete s
        }

        /// <summary>Records every step: a Scope (in the kernel), or any object with Record(circuit) (in fire, every step).</summary>
        undefined Attach(any instrument) {
            this.instruments.Add(instrument)
            this.Invalidate()
        }

        // the outermost circuit runs the simulation
        Circuits.Circuit Top() {
            var c = this
            while (c.owner != undefined) { c = c.owner }
            return c
        }

        /// <summary>Lets the circuit run alongside the program in real time (`speed` times as fast): whenever the program uses a simulated device (the GPIO chip,
        /// the I2C bus or the SPI device "sim"), the circuit is first simulated up to now. A circuit that cannot keep up skips what it is behind by more than
        /// `maxLag`. Only one circuit runs alongside at a time.</summary>
        undefined RunAlongside(float speed = 1.0, float maxLag : any = 0.1) {
            if (speed <= 0.0) { throw new ArgumentException("The speed must be more than 0.") }
            var a = new Circuits.Alongside(this.Top(), speed, Circuits.Units.Seconds(maxLag))
            a.TakeGlobal()
            Simulation.Start(a)
        }

        /// <summary>Is this circuit the one that runs alongside the program?</summary>
        bool IsAlongside {
            get {
                var s = Simulation.Current()
                if (s == undefined || !(s is of Circuits.Alongside)) { return false }
                Circuits.Alongside a = s!Circuits.Alongside
                return a.circuit == this.Top()
            }
        }

        /// <summary>Stops running alongside the program.</summary>
        undefined StopAlongside() {
            if (this.IsAlongside) { Simulation.Stop() }
        }

        /// <summary>Back to time 0 (the parts take their initial state).</summary>
        undefined Reset() {
            var top = this.Top()
            top.Invalidate()
            top.time = 0.0
            var leaves = new List()
            top.Collect(leaves)
            foreach (p in leaves) { p.Reset() }
            foreach (port in top.AllPorts(leaves)) { port.Root().v = 0.0 }
        }

        // the parts that are not circuits, of the circuit and the nested ones
        undefined Collect(List into) {
            foreach (p in this.parts) {
                if (p is of Circuit) {
                    Circuit c = p!Circuit
                    c.Collect(into)
                } else { into.Add(p) }
            }
        }

        // the ports of the parts, of the circuits and their grounds
        List AllPorts(List leaves) {
            var all = new List()
            foreach (p in leaves) {
                foreach (port in p.Ports()) { all.Add(port) }
            }
            this.CircuitPorts(all)
            return all
        }

        undefined CircuitPorts(List into) {
            into.Add(this.ground)
            foreach (port in this.ports) { into.Add(port) }
            foreach (p in this.parts) {
                if (p is of Circuit) {
                    Circuit c = p!Circuit
                    c.CircuitPorts(into)
                }
            }
        }

        undefined GroundAll(Port top) {
            var a = top.Root()
            var b = this.ground.Root()
            if (a != b) { b.link = a }
            foreach (p in this.parts) {
                if (p is of Circuit) {
                    Circuit c = p!Circuit
                    c.GroundAll(top)
                }
                if (p is of Ground) {
                    Ground g = p!Ground
                    var r = g.G.Root()
                    if (r != a) { r.link = a }
                }
            }
        }

        // compiles the circuit into a plan: nodes, branches, the parts in the kernel, the probes of the scopes
        undefined Build() {
            var leaves = new List()
            this.Collect(leaves)
            this.GroundAll(this.ground)
            var ports = this.AllPorts(leaves)
            var groundRoot = this.ground.Root()
            foreach (port in ports) { port.Root().node = -2 }
            groundRoot.node = -1
            var nodes = 0
            foreach (port in ports) {
                var root = port.Root()
                if (root.node == -2) {
                    root.node = nodes
                    nodes = nodes + 1
                }
            }
            var branches = 0
            foreach (p in leaves) {
                if (p.Branches() > 0) {
                    TwoTerminal t = p!TwoTerminal
                    t.branch = nodes + branches
                    branches = branches + p.Branches()
                }
            }
            var s = new Circuits.Solver(nodes, branches, this.dt)
            s.TakeTo(this)
            s.time = this.time
            this.external.Clear()
            foreach (p in leaves) {
                if (!p.Compile(s)) { this.external.Add(p) }
            }
            var fireInstruments = false
            foreach (inst in this.instruments) {
                if (inst is of Scope) {
                    Scope scope = inst!Scope
                    if (!scope.Compile(s)) { fireInstruments = true }
                } else { fireInstruments = true }
            }
            this.fireSteps = this.external.count > 0 || fireInstruments
            if (!s.Compile(this.time)) {
                var message = s.Error()
                delete s
                throw new ArgumentException(message)
            }
            // the voltages the nodes had before the change are where the new plan starts
            foreach (port in ports) {
                var root = port.Root()
                if (root.node >= 0 && root.v != 0.0) { s.SetNode(root.node, root.v) }
            }
            this.solver = s
            this.dirty = false
        }

        /// <summary>One time step.</summary>
        undefined Step() {
            var top = this.Top()
            if (top != this) {
                top.Step()
                return
            }
            if (this.dirty || this.solver == undefined) { this.Build() }
            if (this.fireSteps) { this.FireStep() } else { this.solver.Run(1) }
            // (a part may have asked for the circuit to be compiled again: then Release kept the time)
            if (this.solver != undefined) { this.time = this.solver.Time() }
        }

        // a step with parts or instruments in fire
        undefined FireStep() {
            var s = this.solver
            s.time = s.Time()
            this.stepping = true
            try {
                s.Begin()
                foreach (p in this.external) { p.StampStep(s) }
                s.Finish()
                foreach (p in this.external) { p.Commit(s) }
            } finally { this.stepping = false }
            this.time = s.Time()
            foreach (inst in this.instruments) { inst.Record(this) }
            // parts whose StampStep and Commit are those of Part have nothing to do in a step
            var i = 0
            while (i < this.external.count) {
                var p = this.external[i]
                if (!p.stepsInFire && !p.commitsInFire) { this.external.RemoveAt(i) } else { i = i + 1 }
            }
            if (this.external.count == 0) {
                var fireInstruments = false
                foreach (inst in this.instruments) {
                    if (inst is of Scope) {
                        Scope scope = inst!Scope
                        if (scope.fireChannels > 0) { fireInstruments = true }
                    } else { fireInstruments = true }
                }
                this.fireSteps = fireInstruments
            }
            if (this.rebuild) {
                this.rebuild = false
                this.Invalidate()
            }
        }

        /// <summary>Simulates for `duration` (a time like 10ms, or seconds). Without parts or instruments in fire, the kernel runs all steps in one go.</summary>
        undefined Run(float duration : any) {
            var top = this.Top()
            if (top != this) {
                top.Run(duration)
                return
            }
            var steps = Math.Round(Circuits.Units.Seconds(duration) / this.dt)!int
            var done = 0
            while (done < steps) {
                if (this.dirty || this.solver == undefined) { this.Build() }
                if (this.fireSteps) {
                    this.FireStep()
                    done = done + 1
                } else {
                    this.solver.Run(steps - done)
                    done = steps
                }
            }
            if (this.solver != undefined) { this.time = this.solver.Time() }
        }

        // ---- sound ----
        /// <summary>Sends sound through the circuit: the 16 bit samples (`frames` frames of `channels` interleaved, from `offset` of `data`; stereo is
        /// mixed) drive `input`, the voltage at `output` (against ground or `reference`) is the sound that comes out - mono, 16 bit, as many frames, a
        /// full-scale sample at `outputScale` (default: the amplitude of the input). The time step becomes 1 / (rate * oversample). The circuit keeps its
        /// state: a long sound can go through in pieces. Without parts in fire the kernel does it in one call.</summary>
        byte[] ProcessSamples(Circuits.AudioInput input, Circuits.Port output, byte data[], int offset, int frames, int channels, int rate,
                              Circuits.Port reference = undefined, float outputScale : any = 0, int oversample = 4) {
            if (rate < 1000 || oversample < 1) { throw new ArgumentException("A rate of 1000 Hz or more and an oversample of 1 or more.") }
            var top = this.Top()
            var dt = 1.0 / (rate * oversample)
            if (Math.Abs(top.dt - dt) > dt * 0.000001) { top.TimeStep = dt }
            var scale = Circuits.Units.Volts(outputScale)
            if (scale == 0.0) { scale = input.amplitude }
            var result = new byte[frames * 2]
            if (top.dirty || top.solver == undefined) { top.Build() }
            if (!top.fireSteps) {
                var refNode = -1
                if (reference != undefined) { refNode = reference.Root().node }
                var clipped = __CirProcess(top.solver.handle, input.index, data, offset, frames, channels, input.amplitude, oversample, output.Root().node, refNode,
                                           scale, result, 0)
                if (clipped < 0) { throw new ArgumentException(top.solver.Error()) }
                this.clipped = clipped
                top.time = top.solver.Time()
                return result
            }
            // with parts in fire: step by step
            this.clipped = 0
            var previous = Circuits.Circuit.SampleAt(data, offset, 0, channels)
            for (int i = 0; i < frames; i++) {
                var next = Circuits.Circuit.SampleAt(data, offset, i, channels)
                for (int k = 1; k <= oversample; k++) {
                    input.Level = input.amplitude * (previous + (next - previous) * k / oversample)
                    top.Step()
                }
                previous = next
                var y = output.Raw()
                if (reference != undefined) { y = y - reference.Raw() }
                y = y / scale
                if (y > 1.0) {
                    y = 1.0
                    this.clipped = this.clipped + 1
                }
                if (y < -1.0) {
                    y = -1.0
                    this.clipped = this.clipped + 1
                }
                var v = Math.Round(y * 32767)!int
                result[i * 2] = v & 255
                result[i * 2 + 1] = (v >> 8) & 255
            }
            return result
        }

        static float SampleAt(byte data[], int offset, int frame, int channels) {
            var sum = 0.0
            for (int c = 0; c < channels; c++) {
                var at = offset + (frame * channels + c) * 2
                var v = data[at] + (data[at + 1] << 8)
                if (v >= 32768) { v = v - 65536 }
                sum = sum + v / 32768.0
            }
            return sum / channels
        }

        /// <summary>Sends a sound (an Audio.Sound of `#import "audio"`, or anything with Data, Offset, Frames, Channels and Rate) through the circuit; the
        /// samples that come out (mono, 16 bit) - `new Audio.Sound(sound.Rate, 1, result)` plays them or saves them (ToWav).</summary>
        byte[] ProcessAudio(any sound, Circuits.AudioInput input, Circuits.Port output, Circuits.Port reference = undefined, float outputScale : any = 0,
                            int oversample = 4) {
            return this.ProcessSamples(input, output, sound.Data, sound.Offset, sound.Frames, sound.Channels, sound.Rate, reference, outputScale, oversample)
        }

        /// <summary>How many samples of the last ProcessSamples/ProcessAudio were clipped (louder than full scale).</summary>
        int Clipped { get { return this.clipped } }

        /// <summary>Numbers of the compiled plan (for tests and tools): 0 unknowns, 1 entries of the factorized matrix, 2 update operations of a factorization,
        /// 3 capacitors and inductors, 4 sources, 5 parts that step in fire, 6 parts that are not linear (and logic parts), 7 iterations of Newton's method
        /// so far, 8 steps in which it did not converge.</summary>
        int PlanInfo(int what) {
            var top = this.Top()
            if (top.dirty || top.solver == undefined) { top.Build() }
            if (what == 5) { return top.external.count }
            return top.solver.Info(what)
        }
    }

    /// <summary>The plan of a circuit in the kernel of the package (modified nodal analysis: A x = b with the node voltages and the branch currents as x).
    /// Parts written in fire use it in Stamp, StampStep and Commit.</summary>
    class Solver {
        int handle
        int n
        int size
        float dt
        float time = 0.0

        construct(int nodes, int branches, float dt) {
            this.n = nodes
            this.size = nodes + branches
            this.dt = dt
            this.handle = __CirNew(nodes, branches, dt)
        }

        destruct() { __CirFree(this.handle) }

        /// <summary>The node of a port in the plan (-1: ground).</summary>
        int Node(Port p) { return p.Root().node }

        /// <summary>A conductance g between two ports (Stamp).</summary>
        undefined Conductance(Port p, Port q, float g) { __CirConductance(this.handle, p.Root().node, q.Root().node, g) }

        /// <summary>A voltage source between plus and minus with the branch k (Stamp).</summary>
        undefined VoltageBranch(int k, Port plus, Port minus) { __CirVoltageBranch(this.handle, k, plus.Root().node, minus.Root().node) }

        /// <summary>A current flowing into the node of the port (StampStep).</summary>
        undefined CurrentInto(Port p, float amps) {
            var i = p.Root().node
            if (i >= 0) { __CirRhsAdd(this.handle, i, amps) }
        }

        /// <summary>The voltage of the branch k (StampStep of a voltage source).</summary>
        undefined BranchValue(int k, float volts) { __CirRhsSet(this.handle, k, volts) }
        float BranchCurrent(int k) { return __CirUnknown(this.handle, k) }

        float NodeVoltage(int node) {
            if (node < 0) { return 0.0 }
            return __CirNode(this.handle, node)
        }

        // the tables of the kernel
        int AddReactive(int kind, Port a, Port b, float value, float vPrev, float iPrev) { return __CirAddReactive(this.handle, kind, a.Root().node, b.Root().node, value, vPrev, iPrev) }
        int AddSource(Port a, Port b, int branch, int wave, float p0, float p1, float p2, float p3) {
            return __CirAddSource(this.handle, a.Root().node, b.Root().node, branch, wave, p0, p1, p2, p3)
        }
        undefined SetSource(int index, float p0, float p1, float p2, float p3) { __CirSetSource(this.handle, index, p0, p1, p2, p3) }
        float State(int kind, int index, int what) { return __CirState(this.handle, kind, index, what) }
        bool AddProbe(int recorder, int channel, int kind, int a, int b, float g) { return __CirAddProbe(this.handle, recorder, channel, kind, a, b, g) }
        undefined SetNode(int node, float volts) { __CirSetNode(this.handle, node, volts) }

        int AddNonlinear(int kind, Port n0, Port n1, Port n2, float p0, float p1, float p2, float p3) {
            return __CirAddNonlinear(this.handle, kind, n0.Root().node, n1.Root().node, n2.Root().node, p0, p1, p2, p3)
        }
        float NlState(int index, int what) { return __CirNlState(this.handle, index, what) }
        undefined NlSet(int index, int what, float value) { __CirNlSet(this.handle, index, what, value) }
        /// <summary>Adds a number to an entry of the matrix (row and column: nodes or branches; -1, ground, is left out) - for controlled sources (Stamp).</summary>
        undefined Entry(int row, int col, float value) {
            if (row >= 0 && col >= 0) { __CirEntry(this.handle, row, col, value) }
        }
        int AddLine(Port a1, Port b1, Port a2, Port b2, float z, float delay) {
            var index = __CirAddLine(this.handle, a1.Root().node, b1.Root().node, a2.Root().node, b2.Root().node, z, delay)
            if (index < 0) { throw new ArgumentException(this.Error()) }
            return index
        }
        undefined SetCaps(int index, float cjA, float cjB, float vj, float m, float tt, float tr = 0.0) { __CirSetCaps(this.handle, index, cjA, cjB, vj, m, tt, tr) }
        int AddFormula(Port a, Port b, Port c, string current1, string current2, string parameters) {
            var n2 = -2
            if (c != undefined) { n2 = c.Root().node }
            var index = __CirAddFormula(this.handle, a.Root().node, b.Root().node, n2, current1, current2, parameters)
            if (index < 0) { throw new ArgumentException(this.Error()) }
            return index
        }
        int AddGate(int kind, int inputs[], int out, int outNot, float high, float threshold, float rout) {
            return __CirAddGate(this.handle, kind, inputs, out, outNot, high, threshold, rout)
        }
        bool GateState(int index) { return __CirGateState(this.handle, index) }
        undefined GateExtra(int index, float low, bool falling) { __CirGateExtra(this.handle, index, low, falling) }
        int AddCoupled(Port a1, Port b1, Port a2, Port b2, float l1, float l2, float k, float i1, float i2, float v1, float v2) {
            var index = __CirAddCoupled(this.handle, a1.Root().node, b1.Root().node, a2.Root().node, b2.Root().node, l1, l2, k, i1, i2, v1, v2)
            if (index < 0) { throw new ArgumentException(this.Error()) }
            return index
        }
        bool Compile(float time) { return __CirCompile(this.handle, time) }
        string Error() { return __CirLastError() }
        undefined Begin() { __CirBegin(this.handle) }
        undefined Finish() { __CirFinish(this.handle) }
        undefined Run(int steps) { __CirRun(this.handle, steps) }
        float Time() { return __CirTime(this.handle) }
        int Info(int what) { return __CirInfo(this.handle, what) }
    }

    /// <summary>The timer 555 as a circuit: the divider of three 5 kOhm resistors (Control is its 2/3 tap), two comparators, an SR latch with Reset (active
    /// low, pulled up inside), the output stage and the discharge transistor. It is powered inside at `supply` (the outputs are 0 V or `supply`);
    /// Trigger below 1/3 sets the output, Threshold above 2/3 clears it and opens Discharge to ground.</summary>
    class Timer555 : Circuit {
        construct(float supply : any = 5) : base("555") {
            var s = Circuits.Units.Volts(supply)
            this.Parameter("supply", s)
            var trigger = this.AddPort("trigger")
            var threshold = this.AddPort("threshold")
            var discharge = this.AddPort("discharge")
            var output = this.AddPort("output")
            var control = this.AddPort("control")
            var reset = this.AddPort("reset")
            var vcc = this.Add(new Circuits.VoltageSource(s))
            vcc.B.Connect(this.Ground)
            var r1 = this.Add(new Circuits.Resistor(5kOhm))
            var r2 = this.Add(new Circuits.Resistor(5kOhm))
            var r3 = this.Add(new Circuits.Resistor(5kOhm))
            vcc.A.Connect(r1.A)
            r1.B.Connect(r2.A)
            r2.B.Connect(r3.A)
            r3.B.Connect(this.Ground)
            control.Connect(r1.B)
            var high = this.Add(new Circuits.Comparator(s))
            var low = this.Add(new Circuits.Comparator(s))
            threshold.Connect(high.Plus)
            high.Minus.Connect(r1.B)
            low.Plus.Connect(r2.B)
            low.Minus.Connect(trigger)
            var latch = this.Add(new Circuits.SRLatch(s, true))
            low.Out.Connect(latch.S)
            high.Out.Connect(latch.R)
            var pull = this.Add(new Circuits.Resistor(100kOhm))
            vcc.A.Connect(pull.A)
            pull.B.Connect(latch.Reset)
            reset.Connect(latch.Reset)
            output.Connect(latch.Q)
            var dis = this.Add(new Circuits.Mosfet(Circuits.Timer555.DischargeModel()))
            latch.NotQ.Connect(dis.G)
            dis.D.Connect(discharge)
            dis.S.Connect(this.Ground)
        }

        static Circuits.Model DischargeModel() {
            if (!Circuits.Models.Has("555-discharge")) { Circuits.Models.Add(new Circuits.Model("555-discharge", "NMOS", 1.0, 1.0, 0.0)) }
            return Circuits.Models.Get("555-discharge")
        }

        Port Trigger { get { return this.ports[0] } }
        Port Threshold { get { return this.ports[1] } }
        Port Discharge { get { return this.ports[2] } }
        Port Output { get { return this.ports[3] } }
        Port Control { get { return this.ports[4] } }
        Port Reset { get { return this.ports[5] } }
    }

    /// <summary>A binary counter of `bits` D flip-flops (ripple): it counts the rising edges of Clock; Q(i) are the bits, Count the number.</summary>
    class Counter : Circuit {
        int bits
        List flops

        construct(int bits = 4, float supply : any = 5) : base("counter") {
            if (bits < 1) { throw new ArgumentException("A counter needs a bit.") }
            this.bits = bits
            this.flops = new List()
            var clock = this.AddPort("clock")
            for (int i = 0; i < bits; i++) { this.AddPort("q" + i) }
            Port previous = clock
            for (int i = 0; i < bits; i++) {
                var ff = this.Add(new Circuits.FlipFlop(supply))
                this.flops.Add(ff)
                ff.NotQ.Connect(ff.D)
                previous.Connect(ff.Clock)
                this.ports[i + 1].Connect(ff.Q)
                previous = ff.NotQ
            }
        }

        Port Clock { get { return this.ports[0] } }
        /// <summary>The bit i (0: the lowest).</summary>
        Port Q(int i) { return this.ports[i + 1] }

        /// <summary>The number the counter holds now.</summary>
        int Count {
            get {
                var n = 0
                for (int i = this.bits - 1; i >= 0; i--) {
                    n = n * 2
                    if (this.flops[i].State) { n = n + 1 }
                }
                return n
            }
        }
    }

    /// <summary>A relay: a coil (inductance and resistance in series, from Coil1 to Coil2) and a changeover contact (Common, NormallyClosed,
    /// NormallyOpen). The contact switches over when the coil current reaches `onCurrent` and back below `offCurrent` (default 20 mA and 15 mA).</summary>
    class Relay : Circuit {
        Circuits.Inductor coil
        Circuits.RelayContact contact

        construct(float inductance : any = 0.2, float coilResistance : any = 20, float onCurrent : any = 0.02, float offCurrent : any = 0.015,
                  float onResistance : any = 0.05) : base("relay") {
            var c1 = this.AddPort("coil1")
            var c2 = this.AddPort("coil2")
            var com = this.AddPort("com")
            var nc = this.AddPort("nc")
            var no = this.AddPort("no")
            var l = this.Add(new Circuits.Inductor(inductance))
            var r = this.Add(new Circuits.Resistor(coilResistance))
            c1.Connect(l.A)
            l.B.Connect(r.A)
            r.B.Connect(c2)
            this.coil = l
            var k = this.Add(new Circuits.RelayContact(l, Circuits.Units.Amps(onCurrent), Circuits.Units.Amps(offCurrent), Circuits.Units.Ohms(onResistance)))
            com.Connect(k.ports[0])
            nc.Connect(k.ports[1])
            no.Connect(k.ports[2])
            this.contact = k
        }

        Port Coil1 { get { return this.ports[0] } }
        Port Coil2 { get { return this.ports[1] } }
        Port Common { get { return this.ports[2] } }
        Port NormallyClosed { get { return this.ports[3] } }
        Port NormallyOpen { get { return this.ports[4] } }

        /// <summary>Is the relay pulled in (Common on NormallyOpen)?</summary>
        bool Energized { get { return this.contact.pulled } }
        /// <summary>The current through the coil.</summary>
        float:A CoilCurrent { get { return this.coil.CurrentRaw() * 1A } }
        float CurrentRaw() { return this.coil.CurrentRaw() }
    }

    /// <summary>A quartz crystal: its motional arm (resistance, inductance and series capacitance) from A to B with the capacitance of its holder in
    /// parallel - Falstad's crystal (about 10 MHz with the defaults).</summary>
    class Crystal : Circuit {
        construct(float seriesCapacitance : any = 0.0000000000001, float parallelCapacitance : any = 0.0000000000287, float inductance : any = 0.0025,
                  float resistance : any = 6.4) : base("crystal") {
            var a = this.AddPort("a")
            var b = this.AddPort("b")
            var cp = this.Add(new Circuits.Capacitor(parallelCapacitance))
            a.Connect(cp.A)
            cp.B.Connect(b)
            var r = this.Add(new Circuits.Resistor(resistance))
            var l = this.Add(new Circuits.Inductor(inductance))
            var cs = this.Add(new Circuits.Capacitor(seriesCapacitance))
            a.Connect(r.A)
            r.B.Connect(l.A)
            l.B.Connect(cs.A)
            cs.B.Connect(b)
        }

        Port A { get { return this.ports[0] } }
        Port B { get { return this.ports[1] } }
    }

    /// <summary>The switching logic of a RelayCoil (it steps in fire): follows the coil current (smoothed over about 1 ms) like Falstad's relay coil -
    /// pulls in above `onCurrent` (after the delay of an on-delay coil), drops out below `offCurrent` (after the delay of an off-delay coil); a latching
    /// coil toggles, a set coil switches on, a reset coil off.</summary>
    class RelayCoilState : Part {
        Circuits.RelayCoil coil
        float avg = 0.0
        int state = 0
        float since = 0.0

        construct(Circuits.RelayCoil coil) : base("coilstate") { this.coil = coil }

        bool Compile(Circuits.Solver solver) {
            this.commitsInFire = true
            return false
        }
        undefined StampStep(Circuits.Solver solver) { this.stepsInFire = false }
        undefined Reset() {
            this.avg = 0.0
            this.state = 0
            this.coil.position = 0
        }
        undefined Commit(Circuits.Solver solver) {
            var k = this.coil
            var a = Math.Exp(-solver.dt * 1000.0)
            this.avg = a * this.avg + (1.0 - a) * Math.Abs(k.inductor.CurrentRaw())
            var t = solver.Time()
            var onDelay = 0.0
            var offDelay = 0.0
            if (k.mode == 1) { onDelay = k.delay }
            if (k.mode == 2) { offDelay = k.delay }
            if (this.state == 0) {
                if (this.avg > k.onCurrent) {
                    this.state = 1
                    this.since = t
                }
            } else if (this.state == 1) {
                if (this.avg < k.offCurrent) { this.state = 0 }
                else if (t - this.since >= onDelay) {
                    this.state = 2
                    if (k.mode == 3) { k.Switch(1 - k.Leader().position) }
                    else if (k.mode == 5) { k.Switch(0) }
                    else { k.Switch(1) }
                }
            } else if (this.state == 2) {
                if (this.avg < k.offCurrent) {
                    this.state = 3
                    this.since = t
                }
            } else if (this.state == 3) {
                if (this.avg > k.onCurrent) { this.state = 2 }
                else if (t - this.since >= offDelay) {
                    this.state = 0
                    if (k.mode <= 2) { k.Switch(0) }
                }
            }
        }
    }

    /// <summary>The coil of a relay whose contacts are drawn apart from it (CoilContact): an inductance and a resistance from Coil1 to Coil2. `mode`:
    /// 0 normal, 1 on-delay, 2 off-delay (by `delay`), 3 latching (every pull-in toggles), 4 set, 5 reset. Coils and contacts of the same label work
    /// together (Join).</summary>
    class RelayCoil : Circuit {
        Circuits.Inductor inductor
        float onCurrent
        float offCurrent
        int mode
        float delay
        // 1: pulled in (the contacts of the label switch over); the coils of a label share the position of the first one
        int position = 0
        Circuits.RelayCoil leader
        List contacts

        construct(float inductance : any = 0.2, float coilResistance : any = 20, float onCurrent : any = 0.02, float offCurrent : any = 0.015, int mode = 0,
                  float delay : any = 0) : base("coil") {
            var c1 = this.AddPort("coil1")
            var c2 = this.AddPort("coil2")
            var l = this.Add(new Circuits.Inductor(inductance))
            var r = this.Add(new Circuits.Resistor(coilResistance))
            c1.Connect(l.A)
            l.B.Connect(r.A)
            r.B.Connect(c2)
            this.inductor = l
            this.onCurrent = Circuits.Units.Amps(onCurrent)
            this.offCurrent = Circuits.Units.Amps(offCurrent)
            this.mode = mode
            this.delay = Circuits.Units.Seconds(delay)
            this.leader = undefined
            this.contacts = new List()
            this.Add(new Circuits.RelayCoilState(this))
        }

        Port Coil1 { get { return this.ports[0] } }
        Port Coil2 { get { return this.ports[1] } }

        Circuits.RelayCoil Leader() {
            if (this.leader == undefined) { return this }
            return this.leader
        }

        /// <summary>Makes this coil work the contacts of `leader` (the coils of one label).</summary>
        undefined Join(Circuits.RelayCoil leader) {
            if (leader == this) { this.leader = undefined } else { this.leader = leader }
        }

        /// <summary>Is it pulled in (the contacts of its label switched over)?</summary>
        bool Energized { get { return this.Leader().position == 1 } }
        float:A CoilCurrent { get { return this.inductor.CurrentRaw() * 1A } }
        float CurrentRaw() { return this.inductor.CurrentRaw() }

        undefined Switch(int position) {
            var lead = this.Leader()
            if (lead.position == position) { return }
            lead.position = position
            this.InvalidateSoon()
        }
    }

    /// <summary>A contact of a RelayCoil: closed (`onResistance`) while the coil is pulled in, else open (`offResistance`) - the other way round when
    /// `normallyClosed`. Attach it to the coil with Attach (a schematic does it by the label).</summary>
    class CoilContact : TwoTerminal {
        Circuits.RelayCoil coil
        bool normallyClosed
        float ron
        float roff

        construct(bool normallyClosed = false, float onResistance : any = 0.05, float offResistance : any = 1000000) : base("contact") {
            this.normallyClosed = normallyClosed
            this.ron = Circuits.Units.Ohms(onResistance)
            this.roff = Circuits.Units.Ohms(offResistance)
            this.coil = undefined
        }

        undefined Attach(Circuits.RelayCoil coil) {
            this.coil = coil
            this.Invalidate()
        }

        bool Closed {
            get {
                var pulled = this.coil != undefined && this.coil.Energized
                return pulled != this.normallyClosed
            }
        }

        float ResistanceRaw() {
            if (this.Closed) { return this.ron }
            return this.roff
        }

        bool Compile(Circuits.Solver solver) {
            solver.Conductance(this.A, this.B, 1.0 / this.ResistanceRaw())
            return true
        }
        bool Probe(Circuits.Solver solver, int recorder, int channel) { return solver.AddProbe(recorder, channel, 4, solver.Node(this.A), solver.Node(this.B), 1.0 / this.ResistanceRaw()) }
        float CurrentRaw() { return this.VoltageRaw() / this.ResistanceRaw() }
    }

    /// <summary>A virtual oscilloscope: channels (the voltage of a port, between two ports, or the current of a part) recorded every step of the circuit.
    /// The kernel records them; the samples stay when the circuit is compiled again.</summary>
    class Scope {
        List names
        List sources
        int recorder
        // channels the kernel cannot record (the current of a part written in fire): the scope records them in fire
        int fireChannels = 0
        List inFire
        bool kernelChannels = false

        construct(Circuit circuit, int capacity = 100000) {
            this.names = new List()
            this.sources = new List()
            this.inFire = new List()
            this.recorder = __CirRecNew(capacity)
            circuit.Attach(this)
        }

        destruct() { __CirRecFree(this.recorder) }

        /// <summary>A channel for the voltage of a port (against ground, or against `reference`).</summary>
        undefined Voltage(string name, Port port, Port reference = undefined) {
            var pair = new List()
            pair.Add(port)
            pair.Add(reference)
            // (the channel list keeps the pair: `pair` belongs to this call, a list only keeps what is handed over to it)
            pair.TakeTo(this)
            this.AddChannel(name, pair)
        }

        /// <summary>A channel for the current through a part.</summary>
        undefined Current(string name, Part part) { this.AddChannel(name, part) }

        undefined AddChannel(string name, any source) {
            this.names.Add(name)
            this.sources.Add(source)
            __CirRecChannel(this.recorder)
            var c = Circuits.Scope.CircuitOf(source)
            if (c != undefined) { c.Invalidate() }
        }

        static Circuit CircuitOf(any source) {
            if (source is of List) { return source[0].Circuit() }
            Part part = source!Part
            return part.owner
        }

        // the probes of the channels in the plan; false if some channel is recorded in fire
        bool Compile(Circuits.Solver solver) {
            this.inFire.Clear()
            this.fireChannels = 0
            this.kernelChannels = false
            for (int i = 0; i < this.sources.count; i++) {
                var src = this.sources[i]
                var done = false
                if (src is of List) {
                    var b = -1
                    if (src[1] != undefined) { b = solver.Node(src[1]) }
                    done = solver.AddProbe(this.recorder, i, 0, solver.Node(src[0]), b, 0.0)
                } else {
                    Part part = src!Part
                    done = part.Probe(solver, this.recorder, i)
                }
                if (done) { this.kernelChannels = true } else {
                    this.inFire.Add(i)
                    this.fireChannels = this.fireChannels + 1
                }
            }
            return this.fireChannels == 0
        }

        undefined Record(Circuit circuit) {
            if (this.fireChannels == 0) { return }
            if (!this.kernelChannels) { __CirRecTime(this.recorder, circuit.TimeRaw()) }
            foreach (i in this.inFire) {
                Part part = this.sources[i]!Part
                __CirRecPut(this.recorder, i, part.CurrentRaw())
            }
        }

        int Count { get { return __CirRecCount(this.recorder) } }

        int ChannelOf(string name) {
            for (int i = 0; i < this.names.count; i++) {
                if (this.names[i] == name) { return i }
            }
            throw new ArgumentException("The scope has no channel '" + name + "'.")
        }

        /// <summary>The times of the samples (seconds).</summary>
        float[] Times() { return __CirRecSamples(this.recorder, -1) }

        /// <summary>The samples of a channel (volts or amperes).</summary>
        float[] Samples(string name) { return __CirRecSamples(this.recorder, this.ChannelOf(name)) }

        /// <summary>The last sample of a channel.</summary>
        float Last(string name) { return __CirRecLast(this.recorder, this.ChannelOf(name)) }

        undefined Clear() { __CirRecClear(this.recorder) }
    }

    /// <summary>A virtual multimeter.</summary>
    class Multimeter {
        /// <summary>The voltage between two ports (b: ground when left out).</summary>
        static float:V Volts(Port a, Port b = undefined) {
            var v = a.Raw()
            if (b != undefined) { v = v - b.Raw() }
            return v * 1V
        }

        /// <summary>The current through a part.</summary>
        static float:A Amps(Part part) { return part.CurrentRaw() * 1A }

        /// <summary>The root mean square of samples (an AC voltage or current from a Scope).</summary>
        static float Rms(float samples[]) {
            if (samples.length == 0) { return 0.0 }
            var sum = 0.0
            for (int i = 0; i < samples.length; i++) { sum = sum + samples[i] * samples[i] }
            return Math.Sqrt(sum / samples.length)
        }
    }

    /// <summary>Frequency analysis of samples (from a Scope): a fast Fourier transform.</summary>
    class Fft {
        /// <summary>The amplitudes of the frequencies 0 .. sampleRate/2 (the samples are padded with zeros to a power of two; bin k is k * sampleRate / n).</summary>
        static float[] Magnitudes(float samples[]) {
            var n = 1
            while (n < samples.length) { n = n * 2 }
            var re = new float[n]
            var im = new float[n]
            for (int i = 0; i < n; i++) {
                re[i] = 0.0
                im[i] = 0.0
                if (i < samples.length) { re[i] = samples[i] }
            }
            // bit reversal
            var j = 0
            for (int i = 1; i < n; i++) {
                var bit = n >> 1
                while ((j & bit) != 0) {
                    j = j # bit
                    bit = bit >> 1
                }
                j = j # bit
                if (i < j) {
                    var tr = re[i]
                    re[i] = re[j]
                    re[j] = tr
                    var ti = im[i]
                    im[i] = im[j]
                    im[j] = ti
                }
            }
            var len = 2
            while (len <= n) {
                var angle = -2.0 * Math.PI / len
                var wr = Math.Cos(angle)
                var wi = Math.Sin(angle)
                for (int start = 0; start < n; start = start + len) {
                    var cr = 1.0
                    var ci = 0.0
                    for (int k = 0; k < len / 2; k++) {
                        var ar = re[start + k]
                        var ai = im[start + k]
                        var br = re[start + k + len / 2] * cr - im[start + k + len / 2] * ci
                        var bi = re[start + k + len / 2] * ci + im[start + k + len / 2] * cr
                        re[start + k] = ar + br
                        im[start + k] = ai + bi
                        re[start + k + len / 2] = ar - br
                        im[start + k + len / 2] = ai - bi
                        var ncr = cr * wr - ci * wi
                        ci = cr * wi + ci * wr
                        cr = ncr
                    }
                }
                len = len * 2
            }
            var half = n / 2 + 1
            var mags = new float[half]
            for (int k = 0; k < half; k++) {
                var m = Math.Sqrt(re[k] * re[k] + im[k] * im[k]) / samples.length
                if (k > 0 && k < n / 2) { m = m * 2.0 }
                mags[k] = m
            }
            return mags
        }

        /// <summary>The frequency of the strongest component other than DC (Hz).</summary>
        static float:Hz Dominant(float samples[], float sampleRate : any) {
            var rate = Circuits.Units.Hertz(sampleRate)
            var mags = Circuits.Fft.Magnitudes(samples)
            var n = (mags.length - 1) * 2
            var best = 1
            for (int k = 2; k < mags.length; k++) {
                if (mags[k] > mags[best]) { best = k }
            }
            return best * rate / n * 1Hz
        }
    }
}
