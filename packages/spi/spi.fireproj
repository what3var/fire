{
  "format": 1,
  "name": "fire-spi",
  "type": "library",
  "import": "spi",
  "standard": true,
  "drivers": [
    "SpiDriver"
  ],
  "settings": {
    "version": "1.0.0",
    "author": "fire",
    "license": "fire",
    "description": "The standard library 'spi' of fire: prelude and C sources."
  },
  "native": {
    "sources": [
      "native/fire_bridge_spi.h"
    ],
    "discover": false,
    "functions": [
      {
        "name": "__SpiLastError",
        "returns": "int",
        "arguments": 0,
        "c": "fire_spi_LastError"
      },
      {
        "name": "__SpiLastErrorMessage",
        "returns": "string",
        "arguments": 0,
        "needsList": true,
        "returnsReference": true,
        "c": "fire_spi_LastErrorMessage"
      },
      {
        "name": "__SpiOpenCount",
        "returns": "int",
        "arguments": 0,
        "c": "fire_spi_OpenCount"
      },
      {
        "name": "__SpiSupported",
        "returns": "int",
        "arguments": 0,
        "c": "fire_spi_Supported"
      },
      {
        "name": "__SpiDevices",
        "returns": "any[]",
        "arguments": 0,
        "needsList": true,
        "returnsReference": true,
        "c": "fire_spi_Devices"
      },
      {
        "name": "__SpiOpen",
        "returns": "int",
        "arguments": 4,
        "c": "fire_spi_Open"
      },
      {
        "name": "__SpiConfigure",
        "returns": "bool",
        "arguments": 4,
        "c": "fire_spi_Configure"
      },
      {
        "name": "__SpiTransfer",
        "returns": "int",
        "arguments": 6,
        "c": "fire_spi_Transfer"
      },
      {
        "name": "__SpiWrite",
        "returns": "int",
        "arguments": 4,
        "c": "fire_spi_Write"
      },
      {
        "name": "__SpiRead",
        "returns": "int",
        "arguments": 4,
        "c": "fire_spi_Read"
      },
      {
        "name": "__SpiClose",
        "returns": "bool",
        "arguments": 1,
        "c": "fire_spi_Close"
      },
      {
        "name": "__SpiSimReply",
        "returns": "bool",
        "arguments": 3,
        "c": "fire_spi_SimReply"
      },
      {
        "name": "__SpiSimSetReply",
        "returns": "bool",
        "arguments": 3,
        "c": "fire_spi_SimSetReply"
      },
      {
        "name": "__SpiSimLoopback",
        "returns": "bool",
        "arguments": 0,
        "c": "fire_spi_SimLoopback"
      },
      {
        "name": "__SpiSimSentCount",
        "returns": "int",
        "arguments": 0,
        "c": "fire_spi_SimSentCount"
      },
      {
        "name": "__SpiSimSentByte",
        "returns": "int",
        "arguments": 1,
        "c": "fire_spi_SimSentByte"
      },
      {
        "name": "__SpiSimInfo",
        "returns": "int",
        "arguments": 1,
        "c": "fire_spi_SimInfo"
      },
      {
        "name": "__SpiSimClear",
        "returns": "bool",
        "arguments": 0,
        "c": "fire_spi_SimClear"
      }
    ],
    "reset": "fire_spi_reset",
    "language": "c",
    "platformSources": {
      "posix": [
        "native/fire_spi_desktop.h"
      ],
      "windows": [
        "native/fire_spi_desktop.h"
      ],
      "wasm": [
        "native/fire_spi_none.h"
      ],
      "dos16": [
        "native/fire_spi_none.h"
      ],
      "esp32": [
        "native/fire_spi_esp32.h"
      ],
      "freertos": [
        "native/fire_spi_none.h"
      ],
      "default": [
        "native/fire_spi_none.h"
      ]
    },
    "headers": [
      "native/fire_spi_c.h",
      "native/fire_spi_desktop.h",
      "native/fire_spi_esp32.h",
      "native/fire_spi_linux.h",
      "native/fire_spi_none.h"
    ]
  }
}
