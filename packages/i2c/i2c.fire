#import "devices"
namespace I2c {
    class I2cException : Exception {
        string message
        int code

        construct(string message, int code = 7) {
            this.message = message
            this.code = code
        }
    }

    // No such bus (code 3).
    class NotFoundException : I2cException {
        construct(string message) : base(message, 3) { }
    }

    // The bus is used by somebody else (code 4).
    class BusyException : I2cException {
        construct(string message) : base(message, 4) { }
    }

    // No permission to use the bus (code 5; on Linux the user must be in the group i2c).
    class PermissionException : I2cException {
        construct(string message) : base(message, 5) { }
    }

    // This platform cannot do it (code 6).
    class UnsupportedException : I2cException {
        construct(string message) : base(message, 6) { }
    }

    // Nobody answered at the address (code 8): no such device, not powered, wrong wiring.
    class NoAckException : I2cException {
        construct(string message) : base(message, 8) { }
    }

    // The transfer took too long (code 9): a device holds the clock line low.
    class TimeoutException : I2cException {
        construct(string message) : base(message, 9) { }
    }

    class Errors {
        // Throws the exception that fits the last error of a native function.
        static undefined Throw() {
            var code = __I2cLastError()
            var message = __I2cLastErrorMessage()
            if (code == 3) { throw new NotFoundException(message) }
            if (code == 4) { throw new BusyException(message) }
            if (code == 5) { throw new PermissionException(message) }
            if (code == 6) { throw new UnsupportedException(message) }
            if (code == 8) { throw new NoAckException(message) }
            if (code == 9) { throw new TimeoutException(message) }
            throw new I2cException(message, code)
        }

        static int Handle(int handle) {
            if (handle < 0) { Throw() }
            return handle
        }
    }

    // The buses of this machine.
    class Board {
        // true if this machine has I2C hardware (the bus "sim" is always there).
        static bool Available() { return __I2cSupported() == 1 }

        // The names of the buses: "sim" first, then the real ones ("i2c-1", ... on Linux, "i2c-0" on an ESP32).
        static List Buses() {
            var all = __I2cBuses()
            if (all == undefined) { I2c.Errors.Throw() }
            var list = new List()
            for (var i = 0; i < all.length; i++) { list.Add(all[i]) }
            return list
        }
    }

    // One bus.
    class Bus {
        int handle
        bool closed
        string name
        int speed

        // `bus`: a number (1 is "i2c-1"), a name ("i2c-1", "sim") or the text of a number; `speed` in Hz (the ESP32 uses it; Linux leaves it to the device tree).
        construct(any bus, int speed = 100000) {
            this.handle = -1
            this.closed = false
            this.speed = speed
            var text = "" + bus
            if (text != "sim" && !text.StartsWith("i2c-")) { text = "i2c-" + text }
            this.name = text
            this.handle = I2c.Errors.Handle(__I2cOpen(text, speed))
        }

        destruct() { try { this.Close() } catch (I2cException e) { } }

        string Name { get { return this.name } }
        bool IsClosed { get { return this.closed } }

        int Speed {
            get { return this.speed }
            set {
                this.Check()
                if (!__I2cSetSpeed(this.handle, value)) { I2c.Errors.Throw() }
                this.speed = value
            }
        }

        undefined Check() {
            if (this.closed) { throw new I2cException("The bus is closed.", 2) }
        }

        // Writes `count` bytes of the buffer (all of it from `offset` on without a count) to the device.
        undefined Write(int address, byte buffer[], int offset = 0, int count = -1) {
            this.Check()
            if (count < 0) { count = buffer.length - offset }
            if (__I2cWrite(this.handle, address, buffer, offset, count) < 0) { I2c.Errors.Throw() }
        }

        undefined WriteByte(int address, int value) {
            var b = new byte[1]
            b[0] = value & 255
            this.Write(address, b)
        }

        // Reads `count` bytes from the device into the buffer.
        undefined ReadInto(int address, byte buffer[], int offset, int count) {
            this.Check()
            if (__I2cRead(this.handle, address, buffer, offset, count) < 0) { I2c.Errors.Throw() }
        }

        // Reads `count` bytes from the device.
        byte[] Read(int address, int count) {
            var data = new byte[count]
            this.ReadInto(address, data, 0, count)
            return data
        }

        // Writes `outCount` bytes (without: all), then reads `inCount` bytes with a repeated start in between (no other master can step in); returns the bytes read.
        byte[] WriteRead(int address, byte buffer[], int inCount, int outCount = -1) {
            this.Check()
            if (outCount < 0) { outCount = buffer.length }
            var data = new byte[inCount]
            if (__I2cWriteRead(this.handle, address, buffer, 0, outCount, data, 0, inCount) < 0) { I2c.Errors.Throw() }
            return data
        }

        // One byte of a register: writes the register number, reads the value.
        int ReadRegister(int address, int register) {
            var r = new byte[1]
            r[0] = register & 255
            var data = this.WriteRead(address, r, 1)
            return data[0]
        }

        // `count` bytes from the register on (the device counts the register up).
        byte[] ReadRegisters(int address, int register, int count) {
            var r = new byte[1]
            r[0] = register & 255
            return this.WriteRead(address, r, count)
        }

        undefined WriteRegister(int address, int register, int value) {
            var b = new byte[2]
            b[0] = register & 255
            b[1] = value & 255
            this.Write(address, b)
        }

        // Writes the bytes into the registers from `register` on.
        undefined WriteRegisters(int address, int register, byte data[]) {
            var b = new byte[data.length + 1]
            b[0] = register & 255
            for (var i = 0; i < data.length; i++) { b[i + 1] = data[i] }
            this.Write(address, b)
        }

        // true if a device answers at the address.
        bool Probe(int address) {
            this.Check()
            var r = __I2cProbe(this.handle, address)
            if (r < 0) { I2c.Errors.Throw() }
            return r == 1
        }

        // The addresses (a list of numbers) that answer: 0x08 .. 0x77 are the addresses of devices, the rest is reserved.
        List Scan() {
            var found = new List()
            for (var a = 8; a < 120; a++) {
                if (this.Probe(a)) { found.Add(a) }
            }
            return found
        }

        undefined Close() {
            if (this.closed) { return }
            this.closed = true
            if (this.handle >= 0) { __I2cClose(this.handle) }
        }
    }

    // The simulated bus "sim" from the outside: the devices on it (for tests, and to try a program without the hardware).
    class Sim {
        // Puts a device with 256 registers (all 0) at the address; an existing one is replaced.
        static undefined Add(int address) {
            if (!__I2cSimAdd(address)) { I2c.Errors.Throw() }
        }

        static undefined Remove(int address) {
            if (!__I2cSimRemove(address)) { I2c.Errors.Throw() }
        }

        // Sets a register of a device (what a sensor measures).
        static undefined SetRegister(int address, int register, int value) {
            if (!__I2cSimSetRegister(address, register, value)) { I2c.Errors.Throw() }
        }

        // A register of a device (what a program wrote there).
        static int GetRegister(int address, int register) {
            var v = __I2cSimGetRegister(address, register)
            if (v < 0) { I2c.Errors.Throw() }
            return v
        }

        // Takes all devices off the bus.
        static undefined Reset() { __I2cSimReset() }
    }
}

namespace I2c {
    /// <summary>An I2C bus as a device of the device framework (`i2c:i2c-1`, `i2c:sim`). A bus has no data of its own (Read/Write throw NotSupportedException):
    /// its devices are `At(address)` - each an I2c.Target with its own identifier (`i2c:i2c-1/0x48`).</summary>
    class BusDevice : Device {
        int speed
        I2c.Bus bus

        construct(Driver driver, string name, int speed = 100000) : base(driver, name) {
            this.speed = speed
            this.bus = undefined
        }

        /// <summary>The bus of the I2C library (opened on first use).</summary>
        I2c.Bus Bus {
            get {
                if (this.bus == undefined || this.bus.IsClosed) {
                    var opened = new I2c.Bus(this.name, this.speed)
                    opened.TakeTo(this)
                    this.bus = opened
                }
                return this.bus
            }
        }

        bool Connected() { return this.bus != undefined && !this.bus.IsClosed }

        bool Connect() {
            try {
                var b = this.Bus
                return true
            } catch (I2cException e) {
                return false
            }
        }

        undefined Disconnect() {
            if (this.bus != undefined) { this.bus.Close() }
        }

        /// <summary>The device at this address on the bus (the same object for the same address).</summary>
        I2c.Target At(int address) {
            var name = this.name + "/0x" + I2c.Target.Hex(address)
            var owner = this.owner
            if (owner != undefined) {
                foreach (d in owner.Devices()) {
                    if (d.Name == name) { return d }
                }
            }
            var target = new I2c.Target(owner, this, address)
            if (owner != undefined) { owner.Add(target) } else { target.TakeTo(this) }
            return target
        }
    }

    /// <summary>A device at an address of an I2C bus (`i2c:i2c-1/0x48`): Read gives `ReadSize` bytes (Read(n): n bytes), Write sends a byte buffer; text and
    /// waiting (WriteString, ReadString, WaitFor) work on them like on every device.</summary>
    class Target : Device {
        I2c.BusDevice busDevice
        int address
        // how many bytes Read() reads
        int ReadSize = 1

        construct(Driver driver, I2c.BusDevice bus, int address) : base(driver, bus.Name + "/0x" + I2c.Target.Hex(address)) {
            this.busDevice = bus
            this.address = address
        }

        int Address { get { return this.address } }
        I2c.BusDevice OnBus { get { return this.busDevice } }

        bool Connected() { return this.busDevice.Connected() }
        bool Connect() { return this.busDevice.Connect() }

        any Read() { return this.Read(this.ReadSize) }

        byte[] Read(int count) {
            var data = this.busDevice.Bus.Read(this.address, count)
            DeviceManager.Host.Trace(this, false, data)
            return data
        }

        bool Write(any data) {
            this.busDevice.Bus.Write(this.address, data)
            DeviceManager.Host.Trace(this, true, data)
            return true
        }

        /// <summary>Writes the bytes, then reads `inCount` bytes with a repeated start in between.</summary>
        byte[] WriteRead(byte data[], int inCount) {
            DeviceManager.Host.Trace(this, true, data)
            var result = this.busDevice.Bus.WriteRead(this.address, data, inCount)
            DeviceManager.Host.Trace(this, false, result)
            return result
        }

        int ReadRegister(int register) { return this.busDevice.Bus.ReadRegister(this.address, register) }
        undefined WriteRegister(int register, int value) { this.busDevice.Bus.WriteRegister(this.address, register, value) }

        // two hex digits (the address in an identifier)
        static string Hex(int value) {
            var digits = "0123456789abcdef"
            return digits.Substring((value >> 4) & 15, 1) + digits.Substring(value & 15, 1)
        }
    }
}

/// <summary>The I2C buses of this machine for the device framework: `DeviceManager.AddDriver(new I2cDriver())`. Buses are `i2c:i2c-1`, `i2c:sim`; a device at an
/// address is found by its identifier (`DeviceManager.Get("i2c:i2c-1/0x48")`) or made with `bus.At(0x48)`.</summary>
class I2cDriver : Driver {
    int speed

    construct(int speed = 100000) : base("i2c") {
        this.speed = speed
    }

    undefined Refresh(bool fastScan = true) {
        foreach (name in I2c.Board.Buses()) {
            if (this.Find(name) == undefined) { this.Add(new I2c.BusDevice(this, name, this.speed)) }
        }
    }

    /// <summary>A bus by its name, or a device `bus/0x48` (also `bus/72`).</summary>
    Device Find(string name) {
        var slash = name.IndexOf("/")
        if (slash < 0) {
            foreach (d in this.devices) {
                if (d.Name == name) { return d }
            }
            return undefined
        }
        var bus = this.Find(name.Substring(0, slash))
        if (bus == undefined || !(bus is of I2c.BusDevice)) { return undefined }
        var text = name.Substring(slash + 1)
        var address = 0
        var start = 0
        var radix = 10
        if (text.StartsWith("0x") || text.StartsWith("0X")) {
            radix = 16
            start = 2
        }
        if (start >= text.Length) { return undefined }
        for (int i = start; i < text.Length; i++) {
            var digit = "0123456789abcdef".IndexOf(text.Substring(i, 1).ToLower())
            if (digit < 0 || digit >= radix) { return undefined }
            address = address * radix + digit
        }
        I2c.BusDevice b = bus!I2c.BusDevice
        return b.At(address)
    }
}
