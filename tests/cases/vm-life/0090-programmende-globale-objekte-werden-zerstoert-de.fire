class Item {
    int n
    construct(int n) { this.n = n }
    destruct() { print("~I" + this.n) }
}
class Box {
    string name
    Item item
    Item extra
    construct(string name) { this.name = name }
    destruct() { print("~B" + this.name) }
}
var a = new Box("a")
a.item = new Item(1)
var b = new Item(2)
print("ende")
//# note: ---- normal program end cleans up the global scope
//# name: Programmende: globale Objekte werden zerstoert (destruct laeuft)
