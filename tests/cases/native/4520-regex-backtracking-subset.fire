#import "regex"
var date = new Regex("(?<year>\\d{4})-(\\d\\d)-(\\d\\d)")
var m = date.Match("released on 2026-11-23, patched 2026-12-01")
print(m.Success + " " + m.Index + " " + m.Length + " " + m.Value + " " + m.Group("year") + " " + m.Group(2) + " " + m.GroupCount)
foreach (x in date.Matches("released on 2026-11-23, patched 2026-12-01")) { print(x.Value + " at " + x.Index) }
print(date.Replace("2026-11-23", "$3.$2.${year}"))
print(new Regex("a|b").Replace("abcab", "[$&]") + " " + new Regex("x").Replace("axbxc", "$$"))
// names of packages (ember's pattern), anchors
var name = new Regex("^[A-Za-z0-9][A-Za-z0-9._-]*$")
print(name.IsMatch("sensor-kit_1.2") + " " + name.IsMatch("-kit") + " " + name.IsMatch("kit!") + " " + name.IsMatch(""))
print(Regex.Test("#include \"x.h\"", "^\\s*#\\s*include\\s+[\"<]([^\">]+)[\">]"))
print(Regex.Find("  #include <stdio.h>", "#\\s*include\\s+[\"<]([^\">]+)[\">]").Group(1))
// a SHA-256 in a text
var sha = Regex.Find("SHA256 (kit.fpk) = 9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08\n", "\\b[0-9a-fA-F]{64}\\b")
print(sha.Value.Length + " " + sha.Value.Substring(0, 8))
// greedy and lazy, backtracking
print(Regex.Find("<a><b>", "<.+>").Value + " " + Regex.Find("<a><b>", "<.+?>").Value)
print(Regex.Find("aaab", "a*ab").Value + " " + Regex.Find("xyz", "a*").Success + " " + Regex.Find("xyz", "a*").Length)
print(Regex.Find("abcabc", "(abc){2}").Success + " " + Regex.Find("abab", "(ab){3}").Success + " " + Regex.Find("aaaa", "a{1,3}").Value + " " + Regex.Find("aaaa", "a{2,}?").Value)
print(Regex.Find("aaa", "(a*)*b").Success + " " + Regex.Find("", "(a*)*").Success + " " + Regex.Find("ab", "(a|ab)(c|bcd)?$").Value)
// back references, look-ahead, word boundaries, options
print(Regex.Find("hello wwworld", "(\\w)\\1").Value + " " + Regex.Find("say the the word", "\\b(\\w+) \\1\\b").Group(1))
print(Regex.Find("price: 100 EUR", "\\d+(?= EUR)").Value + " " + Regex.Find("100 USD 200 EUR", "\\d+(?! USD)\\b").Value)
print(new Regex("HELLO", Regex.IgnoreCase).IsMatch("say hello") + " " + new Regex("[a-c]+", Regex.IgnoreCase).Match("xxABCabcd").Value)
print(new Regex("^b", Regex.Multiline).Matches("a\nb\nb").Count + " " + new Regex("^b").Matches("a\nb\nb").Count + " " + new Regex("a.b").IsMatch("a\nb") + " " + new Regex("a.b", Regex.Singleline).IsMatch("a\nb"))
print(new Regex("end$").IsMatch("the end\n") + " " + new Regex("end\\z").IsMatch("the end\n") + " " + new Regex("\\Athe").IsMatch("xthe"))
// classes
print(Regex.Find("a-b_c d", "[\\w-]+").Value + " " + Regex.Find("x]y", "[]x]+").Value + " " + Regex.Find("tab\there", "[^\\S]").Index + " " + Regex.Find("ÄÖü!", "\\w+").Value)
print(Regex.Find("café", "\\u00e9").Index + " " + Regex.Find("A+B", "\\x2B").Index + " " + Regex.Escape("1+1=2? (yes)"))
// split
print("|".Join(new Regex(",\\s*").Split("a, b,c,,  d")) + " " + "|".Join(new Regex("(-)").Split("1-2-3")))
// errors
string bad[] = ["(ab", "ab)", "[a-", "a**", "*a", "x{3,1}", "\\q", "(?<n>a)\\k<m>", "a\\"]
foreach (p in bad) { try { new Regex(p) } catch (RegexException e) { print(e.message) } }
Regex.MaxSteps = 100000
try { Regex.Test("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!", "(a|aa)*$x") } catch (RegexException e) { print(e.message.Substring(0, 30)) }
//# name: regex: Regex (a backtracking subset of .NET's syntax): groups (named, non-capturing), classes, quantifiers greedy and lazy, {n,m}, anchors, \b, back references, look-ahead, IgnoreCase/Multiline/Singleline, Matches, Replace ($1, ${name}, $&, $$), Split, Escape, errors
