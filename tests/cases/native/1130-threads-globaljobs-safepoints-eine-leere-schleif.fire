var n = 0
fire { fire global { n = n + 1 } }
while (n == 0) { }
print("after loop " + n)
print("synced " + (sync globals))
fire { sync global { n = n + 10 } }
while (n < 11) { }
print("section " + n)
fire {
    fire global { print("job a") }
    fire global { print("job b") }
}
