    #import "time"
    actor Counter {
        int n = 0
        undefined Add(int k) { this.n = this.n + k }
        int Get() { return this.n }
    }
    actor Log {
        string text = ""
        undefined Put(string s) { this.text = this.text + s }
        string Text() { return this.text }
    }
    var c = new Counter()
    var l = new Log()
    var step = 2
    var done = false
    fire taking step with c, l {
        c.Add(3)
        l.Put("a")
        c.Add(step)
        l.Put("b")
        print("thread " + (await c.Get()) + " " + (await l.Text()))
        done = true
    }
    // (try process: a `process` that waits would wait for ever when the thread ends between the check of `done` and the next message)
    while (!done) { try process c; try process l; Sleep(1ms) }
    print("main " + c.n + " " + l.text)
//# name: Threads: fire with a, b - mehrere Actors fuer einen Thread, zusammen mit taking
