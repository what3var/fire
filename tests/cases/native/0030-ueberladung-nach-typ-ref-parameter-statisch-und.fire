class Inc {
    static string Bump(ref int x) { x = x + 1; return "ref int" }
    static string Bump(string s) { return "string " + s }
    string Twice(ref float f) { f = f * 2.0; return "ref float" }
    string Twice(int i) { return "int" }
    construct() { }
    construct(ref int n) { n = n + 10 }
    construct(string s) { }
}
int a = 1
print(Inc.Bump(a) + " " + a)
print(Inc.Bump("q"))
float g = 1.5
var inc = new Inc()
print(inc.Twice(g) + " " + g)
print(inc.Twice(3))
int k = 5
var made = new Inc(k)
print(k)

class Mixed {
    static string Go(int x) { return "static int" }
    static string Go(string s) { return "static string" }
    string Run(int x) { return "instance int" }
    string Run(string s) { return "instance string" }
}
print(Mixed.Go(1))
print(Mixed.Go("s"))
print(new Mixed().Run(1))
print(new Mixed().Run("s"))

class extends string {
    string Tag(int n) { return this + "#" + n }
    string Tag(string s) { return this + "/" + s }
    string Tag<T>(T x) { return this + "?" }
}
print("a".Tag(1))
print("b".Tag("c"))
print("d".Tag(2.5))

class Thing { }
class Prio {
    static string P(class c) { return "class" }
    static string P<T>(T x) { return "generic" }
    static string Q(class c) { return "class" }
    static string Q(any x) { return "any" }
}
print(Prio.P(new Thing()))
print(Prio.Q(new Thing()))
print(Prio.Q(3))
//# name: Ueberladung nach Typ: ref-Parameter, gleiche Parameterzahl statisch und fuer Instanzen (nicht gemischt: E4076), Basistyp-Erweiterung, generic vor class vor any
