#intwidth 32
#floatwidth 32
class P {
    defined int x
    defined int y
    defined float : m len
    Step(defined int dx) { this.x = this.x + dx; this.y = this.y + this.x % 7; this.len = this.len + 1cm }
    static defined int Sum(P p) { return p.x + p.y }
}
var p = new P()
for (int i = 0; i < 1000; i++) { p.Step(i) }
print(p.x + " " + p.y + " " + p.len + " " + P.Sum(p))
//# name: Felder als C-Typen, #intwidth 32 / #floatwidth 32: schmale Haelften direkt gelesen und geschrieben
