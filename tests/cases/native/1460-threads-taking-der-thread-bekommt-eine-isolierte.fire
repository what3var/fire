class Item {
    int n
    construct(int n) { this.n = n }
    destruct() { print("~I" + this.n) }
}
class Box {
    string name
    Item item
    Item extra
    construct(string name) { this.name = name }
    destruct() { print("~B" + this.name) }
}
var b = new Box("orig")
b.item = new Item(5)
fire taking b {
    print("thread sieht " + b.name + " " + b.item.n)
    b.name = "geaendert"
    b.item.n = 6
}
var i = 0
while (i < 3000000) { i = i + 1 }
print("main " + b.name + " " + b.item.n)
//# name: Threads: taking: der Thread bekommt eine isolierte Kopie, die Zerstoerung ruft keinen Destruktor
