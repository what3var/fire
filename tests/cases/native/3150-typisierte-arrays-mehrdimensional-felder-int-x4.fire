#import "json"
class U { static Set(ref int x, int v) { x = v } }
class Sensor {
    int[16] samples[]
    float:cm sizes[]
    construct() { this.samples = new int[4]; this.sizes = new float[2]; this.samples[0] = 70000 }
}
int m[2][3]
m[1][2] = 7
try { m[1][0] = "s" } catch (ArgumentException e) { print("A: " + e.message) }
int[8] m8[2][2]
m8[0][1] = 200
print(m[1][2] + " " + m8[0][1])
var s = new Sensor()
s.samples[1] = 40000
s.sizes[0] = 2m
print(s.samples[0] + " " + s.samples[1] + " " + s.sizes[0])
s.samples = new int[2]
s.samples[0] = 70000
var t = copy s
t.samples[1] = 70000
print(s.samples[0] + " " + t.samples[1])
int[8] a[4]
U.Set(a[1], 1000)
print(a[1])
a[0] = -128
a[2] = 5
var sum = 0
foreach (x in a) { if (x != undefined) { sum += x } }
print(sum)
print(Json.Serialize(a))
class Holder {
    int[8] x[4]
    int y[]
    float m[2][3]
    static int s[3]
}
var h1 = new Holder()
print(h1.x.length + " " + h1.x[0] + " " + h1.y + " " + h1.m[1].length + " " + Holder.s.length)
h1.x[0] = 300
var h2 = new Holder()
h2.x[0] = 1
print(h1.x[0] + " " + h2.x[0])
delete h1
print(h2.m[0][2])
int g[3]
fire taking g { g[0] = 300; print("thread " + g[0]) }
//# name: Typisierte Arrays: mehrdimensional, Felder (int x[4] legt das Array mit dem Objekt an), copy, ref auf Elemente, foreach, Json, Threads (taking)
