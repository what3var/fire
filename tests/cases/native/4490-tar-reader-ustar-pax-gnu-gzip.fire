#import "compression"
#import "hash"
#import "filesystem"
var gz = Hash.Hex.Decode("")
var a = Tar.Archive.FromBytes(gz)
print(a.Count)
foreach (e in a.Entries) { print(e.Type + " " + e.FullName.Length + " " + e.Name + " " + e.Length + " " + e.Mode + " " + e.LinkName) }
print(a.GetEntry("repo-abc/README.md").ReadAllText().Trim())
print(a.Entries[0].LastWriteTime.Year + " " + a.Entries[0].UnixTime)
var plain = Tar.Archive.FromBytes(Compression.GZip.Decompress(gz))
print(plain.Count + " " + plain.Entries[5].ReadAllText().Trim())
var dir = IO.Path.Combine(IO.Path.GetTempPath(), "fire-case-tar-4490")
if (IO.Directory.Exists(dir)) { IO.Directory.Delete(dir, true) }
a.ExtractTo(dir)
print(IO.File.ReadAllText(IO.Path.Combine(dir, "repo-abc/src/kit.fire")).Trim())
print(IO.File.Exists(IO.Path.Combine(dir, "repo-abc/link")))
IO.Directory.Delete(dir, true)
var bad = Compression.GZip.Decompress(gz)
bad[148] = 49
try { Tar.Archive.FromBytes(bad) } catch (Tar.TarException e) { print(e.message) }
try { Tar.Archive.FromBytes(Compression.GZip.Decompress(gz).Slice(0, 512 + 515)) } catch (Tar.TarException e) { print(e.message) }
try { Tar.Archive.FromBytes(gz.Slice(0, 100)) } catch (Compression.InvalidDataException e) { print("gzip: " + e.message) }
//# name: compression: Tar.Archive reads ustar (prefix), pax (path), GNU long names, folders and symbolic links, plain or gzipped; ExtractTo writes files and folders (not links); a wrong check sum, an archive cut off, broken gzip
