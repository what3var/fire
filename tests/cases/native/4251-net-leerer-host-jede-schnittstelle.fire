#import "net"
#import "http"
// Host "" listens on every interface: IPv6 with IPv4 in it (dual stack) where the system has IPv6, else IPv4 (0.0.0.0) - also UDP. FIRE_NET_NO_IPV6=1 makes the IPv6 attempt
// fail as on a machine without IPv6 (a container): the listener is on 0.0.0.0 and takes connections over 127.0.0.1.
var l = new Net.TcpListener("", 0)
print("listener " + (l.Port > 0) + " " + (l.Host == "0.0.0.0" || l.Host == "::"))
var c = new Net.TcpClient("127.0.0.1", l.Port)
var s = l.Accept(2000)
c.WriteString("hi")
var buf = new byte[8]
print("got " + s.Read(buf, 0, 8))
s.Close()
c.Close()
l.Close()
var u = new Net.UdpSocket("", 0)
var v = new Net.UdpSocket("127.0.0.1", 0)
v.SendString("ping", "127.0.0.1", u.Port)
print("udp " + u.ReceiveFrom(buf, 0, 8, 2000) + " " + u.FromHost)
u.Close()
v.Close()
var server = new Http.Server("", 0)
print("http " + (server.Port > 0))
server.Close()
//# name: Net: leerer Host lauscht auf jeder Schnittstelle - mit IPv6 dual stack, ohne auf 0.0.0.0 (TcpListener, UdpSocket, Http.Server)
