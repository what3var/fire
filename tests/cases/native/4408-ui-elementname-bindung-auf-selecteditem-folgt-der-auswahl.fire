// The code-behind: a label bound to the selected element of the list (ElementName) follows the selection - Select before the first drawing
// (the view is built at the first use), Select again, SelectedIndex from outside, a click, rows that change under the selection, no selection (Select(-1)): the label is empty.
class Person {
    string name
    construct(string name) { this.name = name }
}
class Model {
    List people = new List()
    construct() {
        this.people.Add(new Person("Carol"))
        this.people.Add(new Person("Alice"))
        this.people.Add(new Person("Bob"))
    }
}
class PickWindow : PickBase { }

var window = new PickWindow()
var model = new Model()
window.SetDataContext(model)
window.list.Select(0)
print("Select(0): " + window.list.SelectedIndex + " " + window.shown.Text)
window.list.Select(2)
print("Select(2): " + window.shown.Text)
window.UIRoot.Draw()
window.list.SelectedIndex = 1
window.UIRoot.Draw()
print("SelectedIndex = 1: " + window.shown.Text)
var lb = window.list
window.UIRoot.Dispatch([9, lb.ax + 20, lb.ay + 6])
window.UIRoot.Dispatch([8, 1, lb.ax + 20, lb.ay + 6])
window.UIRoot.Dispatch([11, 1, lb.ax + 20, lb.ay + 6])
window.UIRoot.Draw()
print("click on the first row: " + window.list.SelectedIndex + " " + window.shown.Text)
model.people.Add(new Person("Aaron"))      // sorts before Alice: the selection follows its element
window.UIRoot.Draw()
print("after Add: " + window.list.SelectedIndex + " " + window.shown.Text)
window.list.Select(-1)                      // nothing selected: selectedItem is undefined, the label gets the empty text
print("Select(-1): " + window.list.SelectedIndex + " [" + window.shown.Text + "]")
window.list.Select(0)
print("Select(0) again: " + window.shown.Text)
//# name: UI: eine Bindung mit ElementName auf selectedItem folgt der Auswahl (Select vor dem ersten Zeichnen, SelectedIndex, Klick, neue Zeilen, Select(-1) leert)
