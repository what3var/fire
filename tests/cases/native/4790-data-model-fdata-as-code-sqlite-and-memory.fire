#import "data"

namespace Shop {
    /// <summary>How important a customer is</summary>
    enum Level { Low, Mid, High }

    record Address {
        string city
        string zipCode
        construct(string city, string zipCode) {
            this.city = city
            this.zipCode = zipCode
        }
    }

    /// <summary>Someone who buys</summary>
    [Table "customers"]
    class Customer : Data.Entity {
        [Key] int id
        [Column "full_name"] [Required] [Length 100] string fullName
        [Length 200] [Unique] string email
        Level level
        DateTime born
        [Json] Address address
        [Version] int version
        [HasMany "customerId"] List<Purchase> purchases
        construct() { }
    }

    [Table "purchases"]
    class Purchase : Data.Entity {
        [Key] int id
        [Required] float total
        // free text
        string note
        [Column "customer_id"] [Index] int customerId
        [BelongsTo "customerId"] Customer customer
        [ManyToMany "purchase_category", "purchaseId", "categoryId"] List<Category> categories
        construct() { }
    }

    [Table "categories"]
    class Category : Data.Entity {
        [Key] [Length 20] string code
        string label
        byte picture[]
        [ManyToMany "purchase_category", "categoryId", "purchaseId"] List<Purchase> purchases
        construct() { }
    }

    /// <summary>The data model Shop: its entities and their tables.</summary>
    class Model {
        static any Types() { return ["Shop.Customer", "Shop.Purchase", "Shop.Category"] }
        static any Tables() { return ["customers", "purchases", "categories"] }
    }

    /// <summary>A database through the model Shop: a query per entity, sessions, the schema.</summary>
    class Context {
        Data.Connection db
        construct(Data.Connection db) { this.db = db }
        Data.Connection Connection { get { return this.db } }
        Data.Query<Customer> Customers { get { return this.db.From<Customer>() } }
        Data.Query<Purchase> Purchases { get { return this.db.From<Purchase>() } }
        Data.Query<Category> Categories { get { return this.db.From<Category>() } }
        Data.Session Session() { return this.db.Session() }
        // (the tables of the model: made when they are not there, missing columns and indexes added - never dropped)
        undefined Ensure() {
            this.db.Ensure("Shop.Customer")
            this.db.Ensure("Shop.Purchase")
            this.db.Ensure("Shop.Category")
        }
        int Migrate() { return this.db.Migrate() }
        // (the SQL that makes the tables of the model in an empty database, in the dialect of the connection)
        string Script() { return this.db.CreateScriptOf(Shop.Model.Types()) }
    }
}
#import "data.sqlite"
#import "data.memory"
class App {
    static undefined Run(string url) {
        print("== " + url)
        var db = new Data.Connection(url)
        var ctx = new Shop.Context(db)
        print(ctx.Script())
        ctx.Ensure()
        var s = ctx.Session()
        var ada = new Shop.Customer()
        ada.fullName = "Ada"
        ada.email = "ada@x.org"
        ada.level = Shop.Level.High
        ada.address = new Shop.Address("London", "W1")
        var p = new Shop.Purchase()
        p.total = 12.5
        p.customer = ada
        var c = new Shop.Category()
        c.code = "books"
        c.label = "Books"
        p.categories = new List<Shop.Category>()
        p.categories.Add(c)
        s.Add(ada)
        s.Add(p)
        print("saved " + s.Save())
        Shop.Customer back = ctx.Customers.Where(x => x.fullName == "Ada").Include(x => x.purchases).First()
        print(back.fullName + " " + back.level + " " + back.address.city + " " + back.address.zipCode + " purchases " + back.purchases.Count + " version " + back.version)
        print("raw " + db.Scalar("select full_name from customers") + " " + db.Scalar("select customer_id from purchases"))
        int who = back.id
        print("books " + ctx.Purchases.Where(x => x.categories.Any(k => k.code == "books")).Count() + " by " + ctx.Purchases.Where(x => x.customerId == taking who).Count() + " via " + ctx.Purchases.Where(x => x.customer.fullName == "Ada").Count())
        print("model " + Shop.Model.Types().length + " " + Shop.Model.Tables()[0] + " " + Shop.Model.Types()[2])
        db.Close()
    }
}
App.Run("sqlite::memory:")
App.Run("memory:")
