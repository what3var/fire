gdb.Insert(new Pupil("Ada"))
gdb.Insert(new Pupil("Grace"))
List<Pupil> pupils = gdb.All<Pupil>()
print(pupils.Count + " " + pupils[1].name)
Pupil pp = gdb.Find<Pupil>(2)
print(pp.name)
