any x = 5m
byte c = x
byte d = 7
d = x
int[8] i8 = x
print(c + " " + d + " " + x!byte + " " + i8 + " " + (c + 1))
class R { byte v
 static string Show(byte p) { return "" + p } }
var r = new R()
r.v = x
print(r.v + " " + R.Show(x))
//# name: Bytes: byte ist ohne Einheit - ein gespeicherter Wert verliert sie (Deklaration, Zuweisung, Parameter, Feld, !byte); int[8] behaelt sie
