int[8] small = 3
float[32] f = 1.5
byte bb = 2
char c = 'a'
bool t = true
int n = 7
print(int.Bits + " " + int[16].Bits + " " + int[64].Bits + " " + float.Bits + " " + float[32].Bits + " " + byte.Bits + " " + char.Bits + " " + bool.Bits + " " + (word.Bits == Word.Bits))
print(small.Bits + " " + f.Bits + " " + bb.Bits + " " + c.Bits + " " + t.Bits + " " + n.Bits + " " + (n + 1).Bits)
