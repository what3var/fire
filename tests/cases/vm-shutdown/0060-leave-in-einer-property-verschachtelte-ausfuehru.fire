class Item {
    int n
    construct(int n) { this.n = n }
    destruct() { print("~I" + this.n) }
}
class Box {
    string name
    Item item
    Item extra
    construct(string name) { this.name = name }
    destruct() { print("~B" + this.name) }
}
class P {
    int v {
        get {
            leave
            print("nie getter")
            return 5
        }
    }
}
var g = new Item(1)
var p = new P()
var x = p.v
print("nie")
//# name: leave in einer Property (verschachtelte Ausfuehrung) haelt sofort an
