var i = 0
while (i < 10) {
    i = i + 1
    if (i == 3) {
        continue
    }
    if (i == 6) {
        break
    }
    print(i)
}
print("done")
//# note: what the test program said to expect (for a reader, it was not checked): 1 / 2 / 4 / 5 / done
//# name: Bytecode-Test: break/continue in while
