class Counter {
    static int Total { get; set }
    static int Twice {
        get { return _twice }
        set { _twice = value * 2 }
    }
    static int _twice

    static Init() { Total = 5 }
    static Bump() {
        Total = Total + 10
        return Total
    }
}

Counter.Init()
print(Counter.Bump())
Counter.Total = 7
print(Counter.Total)
Counter.Twice = 4
print(Counter.Twice)
var chained = (Counter.Total = 9)
print(chained)
