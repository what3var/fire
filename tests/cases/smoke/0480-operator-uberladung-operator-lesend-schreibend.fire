class Pair {
    class first
    class second

    construct(class first, class second) {
        this.first = first
        this.second = second
    }

    operator[](int index) {
        if (index == 0) { return this.first }
        return this.second
    }

    operator[](int index, class value) {
        if (index == 0) { this.first = value }
        else { this.second = value }
    }
}

var p = new Pair(10, 20)
print("p[0] = " + p[0])
print("p[1] = " + p[1])
p[0] = 99
print("nach p[0] = 99: p[0] = " + p[0])
//# note: what the test program said to expect (for a reader, it was not checked): 10 / 20 / 99
//# name: Operator-Überladung: 'operator[]' (lesend + schreibend)
