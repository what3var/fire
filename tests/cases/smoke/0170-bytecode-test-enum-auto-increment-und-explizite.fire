enum Color {
    Red,
    Green,
    Blue
}

enum Status {
    Active = 10,
    Inactive,
    Paused = 20,
    Done
}

print(Color.Red)
print(Color.Green)
print(Color.Blue)

print(Status.Active)
print(Status.Inactive)
print(Status.Paused)
print(Status.Done)

var c = Color.Green
if (c is of Color && !(c is of int)) {
    print("Color.Green ist (wie erwartet) ein Color, kein int")
}
//# note: what the test program said to expect (for a reader, it was not checked): Red/Green/Blue/Active/Inactive/Paused/Done/\"Color.Green ist (wie erwartet) ein Color, kein int\"
//# name: Bytecode-Test: enum (Auto-Increment und explizite Werte)
