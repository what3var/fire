for (var i = 0; i < 3; i = i + 1) {
    for (var j = 0; j < 3; j = j + 1) {
        if (j == 1) {
            break
        }
        print(i * 10 + j)
    }
}
print("nested done")
//# note: what the test program said to expect (for a reader, it was not checked): 0 / 10 / 20 / nested done
//# name: Bytecode-Test: break in verschachtelten Schleifen (nur die innerste)
