interface IAnimal { string Name() }
interface IPet { }
interface IRobot { }
class Animal { }
class Dog : Animal, IAnimal { string Name() { return "Rex" } }
class Puppy : Dog, IPet { }
class Cat : Animal { }
class Car { }
Car car = undefined
print(car!IAnimal)
IAnimal a = undefined
print(a!Cat)
print(a!Car)
