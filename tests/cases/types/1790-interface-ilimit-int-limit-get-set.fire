interface ILimit { int Limit { get; set; }
 string Name { get; }
 float Delay : ms { get; } }
class Lim : ILimit { int Limit { get; set; }
 string Name { get; }
 float Delay : ms { get; } }
ILimit l = new Lim()
l.Limit = "x"
float : kg w = l.Delay
