class Item {
    int n
    construct(int n) { this.n = n }
    destruct() { print("~I" + this.n) }
}
class Box {
    string name
    int size
    Item item
    Box other
    Item list[]
    int Extra { get; set; }
    construct(string name) { this.name = name; this.size = 1 }
    destruct() { print("~B" + this.name) }
}
var Touch = func (b) => { b.name = "geaendert"; b.item.n = 77; return b.name }
var a = new Box("a")
a.item = new Item(1)
print(Touch(flat a))
print(a.name + " " + a.item.n)
a.name = "a"
a.item.n = 1
print(Touch(copy a))
print(a.name + " " + a.item.n)
//# name: Parameter: die Funktion arbeitet auf einer Kopie
