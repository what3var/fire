class Item {
    int n
    construct(int n) { this.n = n }
    destruct() { print("~I" + this.n) }
}
class Box {
    string name
    int size
    Item item
    Box other
    Item list[]
    int Extra { get; set; }
    construct(string name) { this.name = name; this.size = 1 }
    destruct() { print("~B" + this.name) }
}
var a = new Box("a")
a.item = new Item(1)
var d = copy a
d.item.n = 99
d.name = "d"
print(a.item.n + " " + d.item.n)
print(d.item == a.item)
print(a.name)
//# name: copy: Tiefenkopie, Kopie ist unabhaengig
