class Item {
    int n
    construct(int n) { this.n = n }
    destruct() { print("~I" + this.n) }
}
class Box {
    string name
    int size
    Item item
    Box other
    Item list[]
    int Extra { get; set; }
    construct(string name) { this.name = name; this.size = 1 }
    destruct() { print("~B" + this.name) }
}
{
    var a = new Box("a")
    a.item = new Item(1)
    var f = flat a
    f.name = "f"
    var d = copy a
    d.name = "d"
    print("|")
}
print("danach")
//# name: Owner: Kopie gehoert dem Scope und wird mit ihm zerstoert (Besitz bleibt erhalten)
