class Item {
    int n
    construct(int n) { this.n = n }
    destruct() { print("~I" + this.n) }
}
class Box {
    string name
    int size
    Item item
    Box other
    Item list[]
    int Extra { get; set; }
    construct(string name) { this.name = name; this.size = 1 }
    destruct() { print("~B" + this.name) }
}
var a = new Box("a")
a.item = new Item(1)
a.Extra = 5
var f = flat a
f.name = "f"
f.size = 7
f.Extra = 6
print(a.name + a.size + a.Extra)
print(f.name + f.size + f.Extra)
print(f.item == a.item)
print(f == a)
f.item.n = 9
print(a.item.n)
//# name: flat: Objekt selbst und Werte kopiert, Referenzen bleiben
