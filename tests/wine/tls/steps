title: Tls.Engine auf SChannel (MinGW, Wine): Handshake ueber Puffer, Daten in mehreren Records, Zertifikat geprueft
# (LinkageTests.TlsEngineBackends, the part for Windows)
needs: wine mingw openssl
env FIRE_NATIVE_CACHE=$OUT/cache
sh openssl req -x509 -newkey rsa:2048 -nodes -keyout $OUT/key.pem -out $OUT/cert.pem -days 3650 -subj /CN=localhost -addext "subjectAltName=DNS:localhost,IP:127.0.0.1" -addext "basicConstraints=critical,CA:FALSE" 2>/dev/null && { printf '#import "tls"\n#import "time"\nvar certPem = "%s"\nvar keyPem = "%s"\n' "$(awk '{printf "%s\\n", $0}' $OUT/cert.pem)" "$(awk '{printf "%s\\n", $0}' $OUT/key.pem)"; cat ../../linkage/tls-engine/engine.body; } > $OUT/engine.fire
forge build $OUT/engine.fire --engine native -t windows --config $CASE/../mingw.json --toolchain mingw -o $OUT/engine.exe
wine $OUT/engine.exe
expect ../../linkage/tls-engine/engine.expected
