#import "testing"

class Calc {
    static int Add(int a, int b) { return a + b }
}

class CalcTests {
    [Test "Adds two numbers", "2 + 2 is 4"]
    undefined Adds() {
        Testing.Assert.AreEqual(4, Calc.Add(2, 2))
    }

    [Test]
    [Parameters 1..3, 10]
    undefined Commutes(int a, int b) {
        Testing.Assert.AreEqual(Calc.Add(a, b), Calc.Add(b, a))
    }
}
