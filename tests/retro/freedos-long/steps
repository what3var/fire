title: FreeDOS unter QEMU: x86 - eine 64-Bit-Routine im Long Mode aus einem fire-Programm (EFER: LME und LMA, ein 64-Bit-Register) und zurueck im Real Mode
needs: watcom qemu-system-x86_64 mcopy mtype env:FIRE_FREEDOS_IMAGE
timeout 1800
forge build -t dos16 prog.fire -o $OUT/PROG.EXE
timeout 300
sh $CASE/../tools/freedos.sh $OUT
expect prog.expected
