var v = Dos.Version()
print("dos " + v[0] + "." + v[1])
var seg = Dos.Alloc(100)
print("alloc " + (seg > 0) + " " + (Dos.LargestFree() > 1000))
Dos.Free(seg)
try { Dos.Alloc(65000) } catch (e) { print("too big") }
