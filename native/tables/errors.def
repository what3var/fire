/* The messages of the compiler with a code (docs/tools/errors.md): FIRE_ERROR(code, area, template) - {*} in a template is a part that varies.
 * First the general code of each area, then the messages in the order of the catalogue. Written by `forge tables` from ErrorCatalog; do not edit. */
FIRE_ERROR(E1000, LEXER, "Another error in the text of the program (characters, literals, comments)")
FIRE_ERROR(E2000, PREPROCESSOR, "Another error in a directive (#include, #if, #import, ...)")
FIRE_ERROR(E3000, PARSER, "Another syntax error")
FIRE_ERROR(E4000, RESOLVER, "Another error in names, types or declarations")
FIRE_ERROR(E5000, COMPILER, "Another error while the bytecode is made")
FIRE_ERROR(E6000, LINKER, "Another error while the program and its libraries are put together")
FIRE_ERROR(E7000, NATIVE, "Another error of the native build")
FIRE_ERROR(E7001, NATIVE, "The native generator cannot translate this program")
FIRE_ERROR(E7002, NATIVE, "The C++ compiler of the native build reported errors")
FIRE_ERROR(E7003, NATIVE, "The configuration of the native build cannot be used")
FIRE_ERROR(E1001, LEXER, "Unterminated block comment")
