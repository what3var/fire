FIRE_ERROR(E4063, RESOLVER, "{*} '{*}' of class '{*}' implements interface '{*}' and must be public, not {*} (a member of an interface is public)")
FIRE_ERROR(E4064, RESOLVER, "Class '{*}' does not implement interface '{*}' completely (missing property '{*}' with '{*}')")
FIRE_ERROR(E4065, RESOLVER, "'{*}' of class '{*}' is a field - interface '{*}' wants a property '{*}' with '{*}'")
FIRE_ERROR(E4066, RESOLVER, "Property '{*}' of class '{*}' is {*}, interface '{*}' declares it as {*}")
FIRE_ERROR(E4067, RESOLVER, "'{*}' of interface '{*}' is not a known interface (an interface can only extend interfaces)")
FIRE_ERROR(E4068, RESOLVER, "Interface '{*}' extends itself ({*})")
FIRE_ERROR(E4058, RESOLVER, "'var {*}' needs an initializer: the type of a 'var' comes from its value (or declare it with a type: 'int {*}')")
FIRE_ERROR(E4069, RESOLVER, "The parameter '{*}' of the inline C function '{*}' cannot be 'ref' (take a pointer)")
FIRE_ERROR(E4070, RESOLVER, "The parameter '{*}' of the inline C function '{*}' needs a type (int, float, bool, char, string, byte[], any or a pointer)")
FIRE_ERROR(E4071, RESOLVER, "The parameter '{*}' of the inline C function '{*}' has a type C cannot take (int, float, bool, char, string, byte[], any or a pointer)")
FIRE_ERROR(E4072, RESOLVER, "The inline C function '{*}' has a result type C cannot give (int, float, bool, char, string, any, a pointer or undefined)")
FIRE_ERROR(E4073, RESOLVER, "The initialiser of the static field '{*}' reads the field itself - it is still undefined there")
FIRE_ERROR(E4074, RESOLVER, "The initialiser of the static field '{*}' reads '{*}', whose initialiser only runs later (static fields are initialised once at program start: class by class in the order of the program, in a class from the top down) - declare '{*}' first")
FIRE_ERROR(E4075, RESOLVER, "'{*}' is in several imported libraries ({*}) - write the full name")
FIRE_ERROR(E4076, RESOLVER, "'{*}' of class '{*}' is both a static {*} and an instance {*} (the other one: line {*}) - a use through the class name and one through an object would mean different members; give one of them another name")
FIRE_ERROR(E4077, RESOLVER, "'{*}' is declared twice in class '{*}' (the other one: line {*}) - a field or a property has one declaration; remove one or give it another name")
FIRE_ERROR(E4078, RESOLVER, "The initialisers of static fields need each other in a cycle: {*} - each one needs the value of the next one first; break the cycle (set one of them later, e.g. in a static method)")
FIRE_ERROR(E4079, RESOLVER, "The initialiser of the static field '{*}' reads the top-level variable '{*}' - static fields are initialised before the top-level code runs, so it is still undefined there (make it a static field, or set the static field in the top-level code)")
FIRE_ERROR(E4080, RESOLVER, "'replace' assigns a field - '{*}' is a variable (its old value goes with its scope; to destroy it now: 'delete {*}' and then the assignment)")
FIRE_ERROR(E5001, COMPILER, "Only the first 16 parameters of a method can be 'ref'.")
FIRE_ERROR(E5002, COMPILER, "Internal error: 'class extends {*}' was not merged (the program must be produced by Parser.Parse()/ParseMultiple()).")
FIRE_ERROR(E5003, COMPILER, "Statement {*} is not supported.")
FIRE_ERROR(E5004, COMPILER, "'base' is only valid as 'base.Method(...)', not as a standalone value.")
FIRE_ERROR(E5005, COMPILER, "TryCallExpr without a resolved TryableNative reference - the resolver should have caught this.")
FIRE_ERROR(E5006, COMPILER, "Expression type {*} is not supported.")
FIRE_ERROR(E5007, COMPILER, "A lambda can capture at most 255 outer variables.")
FIRE_ERROR(E5008, COMPILER, "A 'ref' argument is only possible for the first 16 arguments of a call.")
FIRE_ERROR(E5009, COMPILER, "`flat`/`copy` as an argument is only possible for the first 16 arguments of a call.")
FIRE_ERROR(E5010, COMPILER, "'resume' expects at most one argument (the resume value).")
FIRE_ERROR(E5011, COMPILER, "'base.Method(...)' outside of a class with a base class - the resolver should have caught this.")
FIRE_ERROR(E5012, COMPILER, "'{*}' is a native function and can only be called directly ({*}(...)), not used as a value.")
FIRE_ERROR(E5013, COMPILER, "'{*}' is a function declared extern and can only be called directly, not used as a value.")
FIRE_ERROR(E5014, COMPILER, "Invalid assignment target for the bytecode compiler.")
FIRE_ERROR(E5015, COMPILER, "Cannot assign to '{*}' - it is a native function.")
FIRE_ERROR(E5016, COMPILER, "Cannot assign to '{*}' - it is a function declared extern.")
FIRE_ERROR(E5017, COMPILER, "'take' needs a holder: '{*}' is not a variable or a field.")
FIRE_ERROR(E5018, COMPILER, "Invalid target for '++'/'--' in the bytecode compiler.")
FIRE_ERROR(E5019, COMPILER, "'++'/'--' on '{*}' is not possible.")
FIRE_ERROR(E5020, COMPILER, "'&' can only be applied to local/global variables or object fields.")
FIRE_ERROR(E5021, COMPILER, "'&' can only be applied to variables or object fields (not a valid address target).")
FIRE_ERROR(E5022, COMPILER, "Coercion target {*} is not supported.")
FIRE_ERROR(E6001, LINKER, "The library '{*}' is not available on the target '{*}' (available: {*}).")
FIRE_ERROR(E6002, LINKER, "The native function '{*}' of a package is written in C++: it is only available in a native build (`fire native`), not in the virtual machine.")
