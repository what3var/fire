<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The window bridge (`#import "windows"`): the SDL window for a framebuffer of the graphics bridge (fire.Terminal.Bridge). A project of its own, so that
    `graphics` alone needs neither SDL nor fire.Terminal.Windows (embedded targets include a display instead of a window).
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>fire.Windows.Bridge</RootNamespace>
    <AssemblyName>fire.Windows.Bridge</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\fire\fire.csproj" />
    <ProjectReference Include="..\fire.Terminal\fire.Terminal.csproj" />
    <ProjectReference Include="..\fire.Terminal.Windows\fire.Terminal.Windows.csproj" />
  </ItemGroup>

</Project>
