<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Die Fenster-Brücke (`#import "windows"`): das SDL-Fenster für einen Framebuffer der Grafik-Brücke (fire.Terminal.Bridge). Eigenes Projekt, damit
    `graphics` allein weder SDL noch fire.Terminal.Windows braucht (Embedded-Ziele binden statt eines Fensters ein Display ein).
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>fire.Windows.Bridge</RootNamespace>
    <AssemblyName>fire.Windows.Bridge</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\fire\fire.csproj" />
    <ProjectReference Include="..\fire.Terminal\fire.Terminal.csproj" />
    <ProjectReference Include="..\fire.Terminal.Windows\fire.Terminal.Windows.csproj" />
  </ItemGroup>

</Project>
