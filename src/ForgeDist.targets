<Project>
  <!--
    forge and the VM next to spark (docs/ROADMAP_C_PORT.md, M3; docs/BUILDING.md): forge and `fire` are C programs (native/forge, native/vm) - no .NET. The solution builds
    them before spark: src/forge-c (forge-c from native/forge/forge.c with the C compiler of this machine - MSVC, gcc or clang), then src/ember (`forge-c package-dist`
    into src/ember/bin/dist/: forge, fire and its variants, native/, Source/, Prebuilt/, libforge/libfirevm - and ember, built by that forge). This file makes
    spark (and the tests) depend on src/ember and copies the folder into the output folder after a build, into the publish folder after a publish - what setup.iss
    packs. A missing C compiler fails the build of src/forge-c with a message that says what to install.

    Properties: BuildForgeDist=false (leave it all out: spark then builds forge-c from the sources of the repository when it first needs it,
    src/fire.Tooling/Forge.cs), PrebuildStandard=false and BuildEmber=false (src/ember), PublishForge=false (a publish of spark alone - forge, the VM and ember from a
    folder made with native/forge/package-dist.sh: setup.iss /DForgeDist), FireDistPrebuilt=false (Prebuilt/ not copied: the tests build the C++ of a package when it
    is used). Imported by fire.Editor and fire.Testing.
  -->
  <Import Project="FireNative.props" />

  <ItemGroup Condition="'$(BuildForgeDist)' != 'false'">
    <!-- (only the order: nothing of src/ember is an assembly; the folder does not depend on the framework, the runtime or the publish of spark) -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)ember\ember.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false"
                      GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;SelfContained;PublishSingleFile;PublishDir;PublishProtocol;_IsPublishing;PublishReadyToRun;PublishTrimmed" />
    <!-- Visual Studio's up-to-date check: a new folder makes spark copy it -->
    <UpToDateCheckInput Include="$(FireDistDir).stamp" />
  </ItemGroup>

  <Target Name="_FireDistFiles">
    <ItemGroup>
      <_FireDistFile Include="$(FireDistDir)**" Exclude="$(FireDistDir).stamp*" />
      <_FireDistFile Remove="$(FireDistDir)Prebuilt/**" Condition="'$(FireDistPrebuilt)' == 'false'" />
    </ItemGroup>
    <Error Condition="'@(_FireDistFile)' == ''" Text="The folder of forge, the VM and ember ($(FireDistDir)) is empty: build src/ember first (fire.sln does), or build without it: -p:BuildForgeDist=false." />
  </Target>

  <Target Name="ForgeDistAfterBuild" AfterTargets="Build" DependsOnTargets="_FireDistFiles" Condition="'$(DesignTimeBuild)' != 'true' And '$(BuildForgeDist)' != 'false'">
    <Copy SourceFiles="@(_FireDistFile)" DestinationFiles="@(_FireDistFile->'$(TargetDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ForgeDistAfterPublish" AfterTargets="Publish" DependsOnTargets="_FireDistFiles" Condition="'$(DesignTimeBuild)' != 'true' And '$(BuildForgeDist)' != 'false' And '$(PublishForge)' != 'false'">
    <Copy SourceFiles="@(_FireDistFile)" DestinationFiles="@(_FireDistFile->'$([System.IO.Path]::GetFullPath('$(PublishDir)'))%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
