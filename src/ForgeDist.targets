<Project>
  <!--
    forge and the VM next to spark (docs/ROADMAP_C_PORT.md, M3): forge and `fire` are C programs (native/forge, native/vm) - no .NET. After the build of spark (and of the
    tests) forge-c is compiled with the C compiler of this machine (once per change of its sources: obj/forge-c/), then `forge package-dist <output>` puts the folder
    spark finds them in next to it: forge, fire and its variants, native/ (tables, runtime, platform, abi, vm, base), Source/ (the standard packages) and Prebuilt/ (their
    libraries for this machine). ember (tools/ember, a fire program) is built by that forge into the same folder. A publish does the same into the publish folder -
    what setup.iss packs.

    Properties: FireCC (the C compiler; default cc, on Windows gcc), BuildForgeDist=false (leave it all out: spark then builds forge-c from the sources of the
    repository when it first needs it, src/fire.Tooling/Forge.cs), PrebuildStandard=false (no Prebuilt/: the VM builds the libraries of a package when it first loads it),
    BuildEmber=false (no ember). A machine without a C compiler still builds spark (the steps only warn).
    Imported by fire.Editor and fire.Testing.
  -->
  <PropertyGroup>
    <FireCC Condition="'$(FireCC)' == '' And '$(OS)' == 'Windows_NT'">gcc</FireCC>
    <FireCC Condition="'$(FireCC)' == ''">cc</FireCC>
    <_FireRepo>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_FireRepo>
    <_FireExe Condition="'$(OS)' == 'Windows_NT'">.exe</_FireExe>
    <_FireCLibs Condition="'$(OS)' == 'Windows_NT'">-static</_FireCLibs>
    <_FireCLibs Condition="'$(OS)' != 'Windows_NT'">-lm -lpthread</_FireCLibs>
    <_ForgeC>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)forge-c/forge-c$(_FireExe)</_ForgeC>
  </PropertyGroup>

  <ItemGroup>
    <_ForgeCSource Include="$(_FireRepo)/native/forge/**/*.c;$(_FireRepo)/native/forge/**/*.h;$(_FireRepo)/native/forge/**/*.inc;$(_FireRepo)/native/tables/*;$(_FireRepo)/native/base/*.h" />
  </ItemGroup>

  <!-- forge-c, compiled when one of its sources changed -->
  <Target Name="BuildForgeC" Inputs="@(_ForgeCSource)" Outputs="$(_ForgeC)" Condition="'$(DesignTimeBuild)' != 'true' And '$(BuildForgeDist)' != 'false'">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_ForgeC)'))" />
    <Exec Command="&quot;$(FireCC)&quot; -O2 &quot;$(_FireRepo)/native/forge/forge.c&quot; -o &quot;$(_ForgeC)&quot; $(_FireCLibs)" ContinueOnError="true" StandardOutputImportance="low" />
  </Target>

  <!-- `forge package-dist <folder>` and ember into the folder -->
  <Target Name="_ForgeDistInto" Condition="'$(DesignTimeBuild)' != 'true' And '$(BuildForgeDist)' != 'false' And Exists('$(_ForgeC)')">
    <PropertyGroup>
      <_DistArgs Condition="'$(PrebuildStandard)' == 'false'">--no-prebuilt</_DistArgs>
      <_DistEnv>FIRE_TABLES=$(_FireRepo)/native/tables;FIRE_NATIVE_ROOT=$(_FireRepo)/native;FIRE_PACKAGES=$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)forge-c/Packages</_DistEnv>
    </PropertyGroup>
    <Exec Command="&quot;$(_ForgeC)&quot; package-dist &quot;$(_ForgeDistFolder).&quot; $(_DistArgs)" EnvironmentVariables="$(_DistEnv)" ContinueOnError="true" StandardOutputImportance="low" />
    <Exec Condition="'$(BuildEmber)' != 'false' And Exists('$(_ForgeDistFolder)forge$(_FireExe)')" Command="&quot;$(_ForgeDistFolder)forge$(_FireExe)&quot; build &quot;$(_FireRepo)/tools/ember/ember.fireproj&quot; -o &quot;$(_ForgeDistFolder)ember$(_FireExe)&quot;" ContinueOnError="true" StandardOutputImportance="low" />
  </Target>

  <Target Name="ForgeDistAfterBuild" AfterTargets="Build" DependsOnTargets="BuildForgeC" Condition="'$(DesignTimeBuild)' != 'true' And '$(BuildForgeDist)' != 'false'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_ForgeDistInto" Properties="_ForgeDistFolder=$(TargetDir);Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier)" />
  </Target>

  <Target Name="ForgeDistAfterPublish" AfterTargets="Publish" DependsOnTargets="BuildForgeC" Condition="'$(DesignTimeBuild)' != 'true' And '$(BuildForgeDist)' != 'false' And '$(PublishForge)' != 'false'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_ForgeDistInto" Properties="_ForgeDistFolder=$([System.IO.Path]::GetFullPath('$(PublishDir)'));Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier)" />
  </Target>
</Project>
