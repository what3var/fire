<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Die Brücke zwischen der Skriptsprache (fire) und der Grafik-API
    (fire.Terminal/.Windows) - siehe docs/CONSOLE.md. Registriert
    FramebufferManager/ConsoleManager/WindowManager als native Funktionen
    (NativeRegistry.RegisterGroup) und liefert den passenden fire-
    Quelltext (GraphicsBridge.PreludeSource), der diese nativen Funktionen
    hinter drei gewöhnlichen Klassen (Framebuffer/Console/Window) versteckt.

    net8.0-windows, da WindowManager (fire.Terminal.Windows) das
    voraussetzt.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>fire.Terminal.Bridge</RootNamespace>
    <AssemblyName>fire.Terminal.Bridge</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\fire\fire.csproj" />
    <ProjectReference Include="..\fire.Terminal\fire.Terminal.csproj" />
    <ProjectReference Include="..\fire.Terminal.Windows\fire.Terminal.Windows.csproj" />
  </ItemGroup>

</Project>
