<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The bridge between the scripting language (fire) and the graphics API
    (fire.Terminal/.Windows) - see docs/CONSOLE.md. Registers
    FramebufferManager/RendererManager/WindowManager as native functions
    (NativeRegistry.RegisterGroup) and supplies the matching fire
    source (GraphicsBridge.PreludeSource) that hides these native functions
    behind three ordinary classes (Framebuffer/Console/Window).
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>fire.Terminal.Bridge</RootNamespace>
    <AssemblyName>fire.Terminal.Bridge</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\fire\fire.csproj" />
    <ProjectReference Include="..\fire.Terminal\fire.Terminal.csproj" />
  </ItemGroup>

</Project>
