<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Die Brücke zwischen fire und dem KobraMill-Gerätekommunikations-
    Framework (DeviceManager/Drivers) - registriert DeviceManager als
    native Funktionen (NativeRegistry.RegisterGroup) und liefert dazu
    passenden fire-Quelltext (DeviceBridge.PreludeSource), der Geräte
    hinter einer gewöhnlichen 'Device'-Klasse versteckt, ansprechbar per
    Handle ODER Identifier (siehe DeviceManagerFacade in PreludeSource).

    Passe den Projektpfad zu deinem fire-Kernprojekt unten an, falls deine
    Solution anders aufgebaut ist als hier angenommen (Geschwister-Ordner
    'fire' neben diesem Projekt, wie bei fire.Terminal.Bridge).
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>fire.Device.Bridge</RootNamespace>
    <AssemblyName>fire.Device.Bridge</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\fire.Device.Manager\fire.Device.Manager.csproj" />
    <ProjectReference Include="..\fire\fire.csproj" />
  </ItemGroup>

</Project>
