<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PLATFORM-INDEPENDENT core (see docs/CONSOLE.md): framebuffer,
    PixelColor, renderer, IGlyphFont, IFramebufferRenderer - deliberately
    WITHOUT any Windows/SDL/GDI-specific dependency, so that a later
    port (e.g. to C++, or a scripting-language bridge directly on
    this layer) stays as simple as possible. Concrete implementations
    (SDL renderer, GDI glyph rasterisation, the composing window)
    deliberately live in separate projects of their own:
    fire.Terminal.Sdl / fire.Terminal.Windows.

    Therefore explicitly "net8.0" (NOT "net8.0-windows") and NO references
    to SDL/System.Drawing/WPF/etc.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>fire.Terminal</RootNamespace>
    <AssemblyName>fire.Terminal</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\fire\fire.csproj" />
  </ItemGroup>

</Project>
