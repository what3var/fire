<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PLATTFORMUNABHÄNGIGER Kern (siehe docs/CONSOLE.md): Framebuffer,
    PixelColor, TerminalCanvas, IGlyphFont, IFramebufferRenderer - bewusst
    OHNE jede Windows-/SDL-/GDI-spezifische Abhängigkeit, damit eine spätere
    Portierung (z.B. nach C++, oder eine Skriptsprachen-Brücke direkt auf
    diese Schicht) so einfach wie möglich bleibt. Konkrete Implementierungen
    (SDL-Renderer, GDI-Schriftrasterung, das zusammensetzende Fenster)
    liegen bewusst in eigenen, separaten Projekten:
    fire.Terminal.Sdl / fire.Terminal.Windows.

    Deshalb explizit "net8.0" (NICHT "net8.0-windows") und KEINE Referenzen
    auf SDL/System.Drawing/WPF/etc.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>fire.Terminal</RootNamespace>
    <AssemblyName>fire.Terminal</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>
