<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ember - the command line of the package manager (docs/PACKAGES.md). The package manager itself is the library fire.Package.Manager (referenced by fire.Native and fire.Project;
    forge and spark get it from them); this is only the program, so that no library references an executable.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>fire.Ember</RootNamespace>
    <AssemblyName>ember</AssemblyName>
    <Product>ember</Product>
    <AssemblyTitle>ember</AssemblyTitle>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\fire.Package.Manager\fire.Package.Manager.csproj" />
  </ItemGroup>

</Project>
