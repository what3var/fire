#include "Main.fxml"          // the script generated from the markup is included right here
#import "ui"
// The code-behind: the data the window is bound to, a converter, and the handler of the button.
class UpperConverter : UI.Converter {
    Convert(value) {
        if (value == undefined) { return "" }        // nothing selected yet
        return value.ToUpper()
    }
}

class Person {
    string name
    bool member = false
    construct(string name) { this.name = name }
}

// The data context: what the {Binding ...} paths in Main.fxml look up.
// A fresh object handed to a call belongs to the surrounding scope and would die with it: `take` gives it to the list (List.Add takes it from there).
class Model {
    List people
    construct() {
        this.people = new List()
        this.people.Add(take new Person("Carol"))
        this.people.Add(take new Person("alice"))
        this.people.Add(take new Person("Bob"))
        this.UpdateSummary()
    }
    // a field, not a property: a binding watches fields (probe), so writing it updates the label
    string summary = ""
    UpdateSummary() { this.summary = this.people.count + " people" }
}

class PeopleWindow : MainBase {            // the inheritance is declared here, in the code-behind
    AddPerson(sender) {
        var model = this.dataContext
        model.people.Add(take new Person("new person " + model.people.count))
        model.UpdateSummary()           // the label {Binding summary} follows
    }
}

var window = new PeopleWindow()
window.SetDataContext(new Model())
window.peopleList.Select(0)       // the elements with a name are fields of the window
window.Run()
