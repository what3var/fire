<!-- The interface. The compiler turns it into a base class; main.fire (the code-behind) inherits from it. docs/UI_MARKUP.md -->
<Window Class="Main" Title="People" Width="520" Height="320">
  <Resources>
    <Converter Key="Upper" Type="UpperConverter"/>
    <!-- how one person looks in the list -->
    <DataTemplate Key="Person">
      <Label Text="{Binding name}"/>
    </DataTemplate>
    <!-- the people, sorted by name -->
    <CollectionView Key="ByName" Source="{Binding people}" SortBy="name"/>
  </Resources>

  <Panel Left="10" Top="10" Width="500" Height="300">
    <Label Left="10" Top="10" Text="People" FontSize="18"/>
    <ListBox Name="peopleList" Left="10" Top="40" Width="200" Height="200" View="ByName" ItemTemplate="Person"/>

    <Label Left="230" Top="44" Text="Name:"/>
    <!-- ElementName: the property of another element - here the selected person of the list. TwoWay: typing changes the data, a change of the data shows here -->
    <TextBox Left="290" Top="40" Width="200" Text="{Binding selectedItem.name, ElementName=peopleList, Mode=TwoWay}"/>
    <CheckBox Left="230" Top="76" Text="Member" IsChecked="{Binding selectedItem.member, ElementName=peopleList, Mode=TwoWay}"/>

    <Label Left="230" Top="116" Text="Shown as:"/>
    <!-- a converter changes the value on its way to the screen -->
    <Label Left="310" Top="116" Text="{Binding selectedItem.name, ElementName=peopleList, Converter=Upper}" Font="8x8"/>
    <Button Left="230" Top="150" Width="120" Height="26" Text="Add person" OnClick="AddPerson"/>
    <Label Left="10" Top="260" Text="{Binding summary}"/>
  </Panel>
</Window>
