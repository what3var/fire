<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="using:Dock.Avalonia.Themes.Fluent"
             xmlns:local="using:fire.Editor"
             x:Class="fire.Editor.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <!-- the docking areas in the colours of fire instead of the blue of the Fluent theme -->
        <SolidColorBrush x:Key="DockApplicationAccentBrushLow" Color="#8F0040"/>
        <SolidColorBrush x:Key="DockApplicationAccentBrushMed" Color="#E8447F"/>
        <SolidColorBrush x:Key="DockApplicationAccentBrushHigh" Color="#E8447F"/>
        <SolidColorBrush x:Key="DockApplicationAccentBrushIndicator" Color="#D6246E"/>
        <SolidColorBrush x:Key="DockThemeAccentBrush" Color="#B70052"/>
        <!-- since Dock 12 the blues of the theme are final brushes of their own (the DockApplicationAccent... keys above are resolved inside the theme and no longer reach them) -->
        <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#B70052"/>
        <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="#E8447F"/>
        <SolidColorBrush x:Key="DockTabHoverBackgroundBrush" Color="#8F0040"/>
        <SolidColorBrush x:Key="DockTabSelectedForegroundBrush" Color="#E8447F"/>
        <SolidColorBrush x:Key="DockTabCloseHoverBackgroundBrush" Color="#D6246E"/>
        <SolidColorBrush x:Key="DockChromeButtonDangerHoverBrush" Color="#D6246E"/>
        <SolidColorBrush x:Key="DockTargetIndicatorBrush" Color="#D6246E"/>
        <SolidColorBrush x:Key="DockSplitterHoverBrush" Color="#B70052"/>
        <SolidColorBrush x:Key="DockSplitterDragBrush" Color="#E8447F"/>


    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- the colours of fire: panels #242028, frame #1B181E, accent #B70052 (EditorTheme) -->
                <ColorPaletteResources x:Key="Dark" Accent="#B70052" RegionColor="#242028"
                                       ErrorText="#E5566F"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
        <dock:DockFluentTheme/>
        <!-- the tool strips (ToolStrips/), docked and floating -->
        <Style Selector="local|ToolStrip Button">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="local|ToolStrip CommandBarButton:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="local|ToolStrip Image">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
        </Style>
        <Style Selector="local|ToolStrip PathIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>
        <Style Selector="local|ToolStrip Rectangle.separator">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Fill" Value="#4A4252"/>
        </Style>
        <Style Selector="local|ToolStrip SplitButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
        <Style Selector="local|ToolStrip SplitButton">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- compact buttons of the little tool bars inside the panels (formatting bar of the Markdown editor, ...) -->
        <Style Selector="Button.tool, ToggleButton.tool">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#B70052"/>
        </Style>
    </Application.Styles>
</Application>
