<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="using:Dock.Avalonia.Themes.Fluent"
             xmlns:local="using:fire.Editor"
             x:Class="fire.Editor.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <!-- the docking areas in the colours of fire instead of the blue of the Fluent theme -->
        <SolidColorBrush x:Key="DockApplicationAccentBrushLow" Color="#8F0040"/>
        <SolidColorBrush x:Key="DockApplicationAccentBrushMed" Color="#E8447F"/>
        <SolidColorBrush x:Key="DockApplicationAccentBrushHigh" Color="#E8447F"/>
        <SolidColorBrush x:Key="DockApplicationAccentBrushIndicator" Color="#D6246E"/>
        <SolidColorBrush x:Key="DockThemeAccentBrush" Color="#B70052"/>
        <!-- since Dock 12 the blues of the theme are final brushes of their own (the DockApplicationAccent... keys above are resolved inside the theme and no longer reach them) -->
        <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#B70052"/>
        <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="#E8447F"/>
        <SolidColorBrush x:Key="DockTabHoverBackgroundBrush" Color="#8F0040"/>
        <SolidColorBrush x:Key="DockTabSelectedForegroundBrush" Color="#E8447F"/>
        <SolidColorBrush x:Key="DockTabCloseHoverBackgroundBrush" Color="#D6246E"/>
        <SolidColorBrush x:Key="DockChromeButtonDangerHoverBrush" Color="#D6246E"/>
        <SolidColorBrush x:Key="DockTargetIndicatorBrush" Color="#D6246E"/>
        <SolidColorBrush x:Key="DockSplitterHoverBrush" Color="#B70052"/>
        <SolidColorBrush x:Key="DockSplitterDragBrush" Color="#E8447F"/>
        <!-- the TableView (lists in the panels): compact rows, the colours of fire for hover and selection -->
        <SolidColorBrush x:Key="TableViewRowBackgroundPointerOver" Color="#2E2935"/>
        <SolidColorBrush x:Key="TableViewRowBackgroundSelected" Color="#59B70052"/>
        <SolidColorBrush x:Key="TableViewRowBackgroundSelectedPointerOver" Color="#73B70052"/>
        <SolidColorBrush x:Key="TableViewRowBackgroundSelectedPressed" Color="#8CB70052"/>
        <SolidColorBrush x:Key="TableViewRowBackgroundPressed" Color="#38323F"/>
        <SolidColorBrush x:Key="TableViewColumnHeaderSeparatorBackground" Color="#4A4252"/>
        <Thickness x:Key="TableViewCellPadding">6,1</Thickness>
        <Thickness x:Key="TableViewRowPadding">0</Thickness>


    </Application.Resources>

    <Application.Styles>
		<!--<Style Selector="local|ToolStrip CommandBarButton">
			<Setter Property="Padding" Value="2,2"/>
			<Setter Property="Background" Value="Blue"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="MinWidth" Value="16"/>
			<Setter Property="Width" Value="16"/>

		</Style>
		<Style Selector="CommandBarButton">
			<Setter Property="Theme" Value="{x:Null}"/>
		</Style>-->
		<FluentTheme DensityStyle="Compact">
            <FluentTheme.Palettes>
                <!-- the colours of fire: panels #242028, frame #1B181E, accent #B70052 (EditorTheme) -->
                <ColorPaletteResources x:Key="Dark" Accent="#B70052" RegionColor="#242028"
                                       ErrorText="#E5566F"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
        <dock:DockFluentTheme/>
        <!-- the TableView: no frame, a header band in the tone of the panels, rows of one line -->
        <Style Selector="TableView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TableViewColumnHeader">
            <Setter Property="Background" Value="#2B2631"/>
            <Setter Property="Foreground" Value="#C9BED0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderBrush" Value="#3C3544"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="TableViewRow">
            <Setter Property="MinHeight" Value="22"/>
        </Style>
        <Style Selector="TableViewCell">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- the tool strips (ToolStrips/), docked and floating -->
        <Style Selector="local|ToolStrip Button">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="local|ToolStrip CommandBarButton:disabled, Button.toolstrip:disabled, Image.dimmable:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <!-- Fluent paints a grey box behind a disabled button: in a tool strip it is just dimmed -->
        <Style Selector="Button.toolstrip:disabled /template/ ContentPresenter#PART_ContentPresenter, local|ToolStrip Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <!-- the compact tool button (ToolStrips/ToolStripButton.cs): small padding, a 16 x 16 icon, a small label -->
        <Style Selector="local|ToolStripButton">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="local|ToolStrip Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>
        <Style Selector="local|ToolStrip PathIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>
        <Style Selector="local|ToolStrip Rectangle.separator">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Fill" Value="#4A4252"/>
        </Style>
        <Style Selector="local|ToolStripButton Border.dropdown:pointerover">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
        <!-- compact buttons of the little tool bars inside the panels (formatting bar of the Markdown editor, ...) -->
        <Style Selector="Button.tool, ToggleButton.tool">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#B70052"/>
        </Style>
    </Application.Styles>
</Application>
