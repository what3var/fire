<UserControl x:Class="fire.Editor.ThreadsPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" Loaded="ToolBar_HideOverflow">
            <Button x:Name="PauseThreadButton" Click="PauseThread_Click" ToolTip="Pause the active thread at the next statement">
                <TextBlock Text="Pause active thread" Margin="2,0"/>
            </Button>
            <Separator/>
            <TextBlock x:Name="BreakpointsText" Text="Breakpoints: (none)" VerticalAlignment="Center" Margin="4,0"/>
        </ToolBar>

        <ListView x:Name="ThreadsList" FontFamily="Consolas" FontSize="12" BorderThickness="0"
                  SelectionMode="Single" SelectionChanged="ThreadsList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="24" DisplayMemberBinding="{Binding Marker}"/>
                    <GridViewColumn Header="Name" Width="140" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Status" Width="200" DisplayMemberBinding="{Binding Status}"/>
                    <GridViewColumn Header="Line" Width="60" DisplayMemberBinding="{Binding Line}"/>
                    <GridViewColumn Header="Call depth" Width="90" DisplayMemberBinding="{Binding Depth}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
