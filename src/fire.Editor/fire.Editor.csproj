<Project Sdk="Microsoft.NET.Sdk">

  <!--
    spark, the editor of fire - on Avalonia, so that it runs on Windows, Linux and macOS.
    Docking: Dock.Avalonia, text editor: AvaloniaEdit, look: the Fluent theme (App.axaml: dark, the accent colour of fire).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>fire.Editor</RootNamespace>
    <AssemblyName>spark</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AssemblyTitle>fire spark</AssemblyTitle>
    <!--<ApplicationIcon>Assets\Logo.ico</ApplicationIcon>-->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

	<PublishSingleFile>true</PublishSingleFile>
	<SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.7" />
    <PackageReference Include="Dock.Model.Avalonia" Version="12.1.0.7" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- Accesses Lexer/Parser/Resolver/Compiler/VM directly via project reference. -->
    <ProjectReference Include="..\fire.Compiler\fire.Compiler.csproj" />
    <ProjectReference Include="..\fire.Project\fire.Project.csproj" />
    <ProjectReference Include="..\fire.Git\fire.Git.csproj" />
    <ProjectReference Include="..\fire.Runtime\fire.Runtime.csproj" />
    <ProjectReference Include="..\fire.UI.Markup\fire.UI.Markup.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The help pages behind the "?" menu (Help folder): copied to Help\ next to the executable and opened from there (see MainWindow.OpenHelp). -->
    <None Include="Help\**\*.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- The language reference (docs/language): copied to Help\Language\, its contents page fills Help > The fire Language (see MainWindow.BuildLanguageHelpMenu). -->
    <None Include="..\..\docs\language\*.md" Link="Help\Language\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\icons\*.png" />
    <None Remove="Assets\splash.png" />
    <None Remove="fileicons.res" />
    <AvaloniaResource Include="Assets\Logo-64.png" />
    <!-- the license texts the About window shows (the ones of the repository linked in) -->
    <AvaloniaResource Include="Assets\Licenses\*.txt" />
    <AvaloniaResource Include="..\..\LICENSE" Link="Assets\Licenses\LICENSE-fire.txt" />
    <AvaloniaResource Include="..\fire.Terminal\LICENSE-pcface.md" Link="Assets\Licenses\LICENSE-pcface.txt" />
    <AvaloniaResource Include="..\fire.Terminal\TrueType\LICENSE-libschrift.md" Link="Assets\Licenses\LICENSE-libschrift.txt" />
    <AvaloniaResource Include="Assets\splash.png" />
  </ItemGroup>

  <PropertyGroup>
	  <Win32Resource>fileicons.res</Win32Resource>
  </PropertyGroup>

  <Import Project="..\StandardSources.targets" />

</Project>
