<Project Sdk="Microsoft.NET.Sdk">

  <!--
    spark, the editor of fire - on Avalonia, so that it runs on Windows, Linux and macOS.
    Docking: Dock.Avalonia, text editor: AvaloniaEdit, look: the Fluent theme (App.axaml: dark, the accent colour of fire).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>fire.Editor</RootNamespace>
    <AssemblyName>spark</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AssemblyTitle>fire spark</AssemblyTitle>
    <!--<ApplicationIcon>Assets\Logo.ico</ApplicationIcon>-->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- The live analyses compile whole programs in the background; with the workstation GC their objects (alive until the analysis ends) were copied in gen0/gen1 pauses of
         100-350 ms that froze the UI thread, too. The server GC with its dynamic adaptation (DATAS, the default of .NET 9 and later) collects a smaller gen0 in parallel: with
         RuhrpottRaser open (docs/tools/spark.md "Live errors") the GC pauses within UI stalls went from 2.8 s to 0.4 s per session on an idle machine (about even when all cores
         are busy with other work), for 10-20 % more memory. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>

	<PublishSingleFile>false</PublishSingleFile>
	<SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="all" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.7" />
    <PackageReference Include="Dock.Model.Avalonia" Version="12.1.0.7" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- No compiler in spark (docs/ROADMAP_C_PORT.md, M3): it builds, tests and serves its language services through forge (native/forge, a C program) and runs
         programs in `fire` (native/vm). fire.Tooling: the way to them, the data of their reports, the debugger's client, the models of the editors. -->
    <ProjectReference Include="..\fire.Tooling\fire.Tooling.csproj" />
    <ProjectReference Include="..\fire.Project\fire.Project.csproj" />
    <ProjectReference Include="..\fire.Git\fire.Git.csproj" />
    <ProjectReference Include="..\fire.Imaging\fire.Imaging.csproj" />   <!-- the images of the pixel editor and of the project icons (PixelCanvas, ImageDecoder/Encoder) -->
    <ProjectReference Include="..\fire.UI.Markup\fire.UI.Markup.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The help pages behind the "?" menu (Help folder): copied to Help\ next to the executable and opened from there (see MainWindow.OpenHelp). -->
    <None Include="Help\**\*.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- The language reference (docs/language): copied to Help\Language\, its contents page fills Help > The fire Language (see MainWindow.BuildLanguageHelpMenu). -->
    <None Include="..\..\docs\language\*.md" Link="Help\Language\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The whole documentation (docs, without the roadmaps): Help\Docs\, for the tools search_docs and read_doc of the MCP server (docs/tools/spark-mcp.md). -->
    <!-- The assistant (docs/ai/assistant.md): a fire program spark starts with forge when it is switched on (Tools > Assistant). -->
    <None Include="Assistant\assistant.fire" Link="Assistant\assistant.fire" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\**\*.md" Exclude="..\..\docs\ROADMAP*.md" Link="Help\Docs\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\icons\*.png" />
    <AvaloniaResource Include="Assets\treeicons\*.png" />
    <None Remove="Assets\ico fire 2.ico" />
    <None Remove="Assets\logo2_64.png" />
    <None Remove="Assets\splash.png" />
    <None Remove="fileicons.res" />
    <AvaloniaResource Include="Assets\ico fire 2.ico" />
    <AvaloniaResource Include="Assets\Logo-64.png" />
    <!-- the license texts the About window shows (the ones of the repository linked in) -->
    <AvaloniaResource Include="Assets\Licenses\*.txt" />
    <AvaloniaResource Include="..\..\LICENSE" Link="Assets\Licenses\LICENSE-fire.txt" />
    <AvaloniaResource Include="..\..\packages\graphics\native\LICENSE-pcface.md" Link="Assets\Licenses\LICENSE-pcface.txt" />
    <AvaloniaResource Include="..\..\packages\graphics\native\LICENSE-libschrift.md" Link="Assets\Licenses\LICENSE-libschrift.txt" />
    <AvaloniaResource Include="Assets\logo2_64.png" />
    <AvaloniaResource Include="Assets\splash.png" />
  </ItemGroup>

  <PropertyGroup>
	  <Win32Resource>fileicons.res</Win32Resource>
  </PropertyGroup>

  <!--
    forge, the VM, native/, Source/, Prebuilt/ and ember next to spark - after a build in its output folder, after a publish in the publish folder (what setup.iss packs):
    the folder of src/ember (`forge package-dist`, the D6 path, docs/spec/FORGE_C.md, with forge-c of src/forge-c compiled by the C compiler of this machine, and
    ember - tools/ember - built by that forge), which the solution builds before spark (docs/BUILDING.md). Nothing of .NET.
    PublishForge=false: a publish of spark alone (forge, the VM and ember come from a folder made with native/forge/package-dist.sh: setup.iss /DForgeDist).
  -->
  <Import Project="..\ForgeDist.targets" />

</Project>
