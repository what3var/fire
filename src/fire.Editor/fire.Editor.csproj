<Project Sdk="Microsoft.NET.Sdk">

  <!--
    spark, the editor of fire - on Avalonia, so that it runs on Windows, Linux and macOS.
    Docking: Dock.Avalonia, text editor: AvaloniaEdit, look: the Fluent theme (App.axaml: dark, the accent colour of fire).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>fire.Editor</RootNamespace>
    <AssemblyName>spark</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AssemblyTitle>fire spark</AssemblyTitle>
    <ApplicationIcon>Logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.2" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageReference Include="Dock.Avalonia" Version="11.3.2" />
    <PackageReference Include="Dock.Model.Avalonia" Version="11.3.2" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="11.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Greift per Projektreferenz direkt auf Lexer/Parser/Resolver/Compiler/VM zu. -->
    <ProjectReference Include="..\fire.Compiler\fire.Compiler.csproj" />
    <ProjectReference Include="..\fire.Runtime\fire.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The help pages behind the "?" menu (Help folder): copied to Help\ next to the executable and opened from there (see MainWindow.OpenHelp). -->
    <None Include="Help\**\*.md" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="icons\*.png" />
    <AvaloniaResource Include="Logo-64.png" />
  </ItemGroup>

  <Import Project="..\BridgePackages.targets" />

</Project>
