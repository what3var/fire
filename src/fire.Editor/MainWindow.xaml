<Window x:Class="fire.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:fire.Editor"
        Title="fire Editor" Height="820" Width="1300"
        FontFamily="Segoe UI">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="_Neu" Click="New_Click" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Öffnen..." Click="Open_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Speichern" Click="Save_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Speichern _unter..." Click="SaveAs_Click"/>
                <Separator/>
                <MenuItem Header="Buildeinstellungen" Click="BuildSettings_Click"/>
                <Separator/>
                <MenuItem Header="_Beenden" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Ausführen">
                <MenuItem Header="_Starten/Neu kompilieren" Click="Run_Click" InputGestureText="F5"/>
                <MenuItem Header="Standalone erstellen..." Click="Build_Click"/>
                <Separator/>
                <MenuItem Header="Einzelschritt (_Step Over)" Click="Step_Click" InputGestureText="F10"/>
                <MenuItem Header="Einzelschritt (Step _Into)" Click="StepInto_Click" InputGestureText="F11"/>
                <MenuItem Header="Aktuelle Funktion verlassen (Step _Out)" Click="StepOut_Click" InputGestureText="Shift+F11"/>
                <MenuItem Header="_Weiter (bis Haltepunkt)" Click="Continue_Click" InputGestureText="F8"/>
                <MenuItem Header="Bis _Ende durchlaufen" Click="RunToEnd_Click" InputGestureText="Ctrl+F5"/>
                <MenuItem Header="_Stopp" Click="Stop_Click" InputGestureText="Shift+F5"/>
                    <Separator/>
                    <MenuItem Header="Debug" IsCheckable="True" x:Name="mnuRunDebug" Click="mnuRunDebug_Click"/>
                    <MenuItem Header="Release" IsCheckable="True" x:Name="mnuRunRelease" Click="mnuRunRelease_Click"/>
                    <MenuItem Header="Performance" IsCheckable="True" x:Name="mnuRunPerformance" Click="mnuRunPerformance_Click"/>
                    <Separator/>
                <MenuItem Header="_Haltepunkt umschalten (aktuelle Zeile)" Click="ToggleBreakpoint_Click" InputGestureText="F9"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Bereit."/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="CaretText" Text="Zeile 1"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <local:ScriptEditorControl x:Name="EditorControl" Grid.Row="0"/>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#DDDDDD"/>

                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="Ausgabe" FontWeight="Bold" Margin="4,2"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="OutputBox" Grid.Row="0" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="13"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 Background="#1E1E1E" Foreground="#DCDCDC" BorderThickness="0"/>

                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#DDDDDD"/>

                        <DockPanel Grid.Row="2">
                            <TextBlock x:Name="ErrorPanelHeader" DockPanel.Dock="Top"
                                       Text="Fehler" FontWeight="Bold" Margin="4,2"
                                       Foreground="#B00000"/>
                            <ListBox x:Name="ErrorList" FontFamily="Consolas" FontSize="12"
                                     Foreground="#B00000"
                                     MouseDoubleClick="ErrorList_MouseDoubleClick"/>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDDDDD"/>

            <local:DebuggerPanelControl x:Name="DebuggerPanel" Grid.Column="2"/>
        </Grid>
    </DockPanel>
</Window>
