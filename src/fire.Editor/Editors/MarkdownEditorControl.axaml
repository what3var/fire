<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="fire.Editor.MarkdownEditorControl">
    <DockPanel>
        <Border x:Name="FormatBar" DockPanel.Dock="Top" BorderBrush="#3C3544" BorderThickness="0,0,0,1" Padding="4,2">
            <StackPanel x:Name="FormatPanel" Orientation="Horizontal" Spacing="2">
                <!-- Markdown formatting: acts on the text (Split, Code) -->
                <StackPanel x:Name="TextTools" Orientation="Horizontal" Spacing="2">
                    <Button Classes="tool" Click="Bold_Click" ToolTip.Tip="Bold (Ctrl+B)"><TextBlock FontWeight="Bold" Text="F"/></Button>
                    <Button Classes="tool" Click="Italic_Click" ToolTip.Tip="Italic (Ctrl+I)"><TextBlock FontStyle="Italic" Text="K"/></Button>
                    <Button Classes="tool" Click="Strike_Click" ToolTip.Tip="Strikethrough"><TextBlock TextDecorations="Strikethrough" Text="D"/></Button>
                    <Button Classes="tool" Click="InlineCode_Click" ToolTip.Tip="Code (Ctrl+E)"><PathIcon Width="16" Height="16" Data="M14.6,16.6L19.2,12L14.6,7.4L16,6L22,12L16,18L14.6,16.6M9.4,16.6L4.8,12L9.4,7.4L8,6L2,12L8,18L9.4,16.6Z"/></Button>
                    <Border Width="1" Background="#3C3544" Margin="4,2"/>
                    <Button Classes="tool" Click="Heading_Click" ToolTip.Tip="Heading: change level (Ctrl+H)"><TextBlock FontWeight="Bold" Text="H"/></Button>
                    <Button Classes="tool" Click="BulletList_Click" ToolTip.Tip="Bulleted list"><PathIcon Width="16" Height="16" Data="M7,5H21V7H7V5M7,13V11H21V13H7M4,4.5A1.5,1.5 0 0,1 5.5,6A1.5,1.5 0 0,1 4,7.5A1.5,1.5 0 0,1 2.5,6A1.5,1.5 0 0,1 4,4.5M4,10.5A1.5,1.5 0 0,1 5.5,12A1.5,1.5 0 0,1 4,13.5A1.5,1.5 0 0,1 2.5,12A1.5,1.5 0 0,1 4,10.5M7,19V17H21V19H7M4,16.5A1.5,1.5 0 0,1 5.5,18A1.5,1.5 0 0,1 4,19.5A1.5,1.5 0 0,1 2.5,18A1.5,1.5 0 0,1 4,16.5Z"/></Button>
                    <Button Classes="tool" Click="NumberedList_Click" ToolTip.Tip="Numbered list"><PathIcon Width="16" Height="16" Data="M7,13V11H21V13H7M7,19V17H21V19H7M7,7V5H21V7H7M3,8V5H2V4H4V8H3M2,17V16H5V20H2V19H4V18.5H3V17.5H4V17H2M4.25,10A0.75,0.75 0 0,1 5,10.75C5,10.95 4.92,11.14 4.79,11.27L3.12,13H5V14H2V13.08L4,11H2V10H4.25Z"/></Button>
                    <Button Classes="tool" Click="Quote_Click" ToolTip.Tip="Quote"><PathIcon Width="16" Height="16" Data="M10,7L8,11H11V17H5V11L7,7H10M18,7L16,11H19V17H13V11L15,7H18Z"/></Button>
                    <Button Classes="tool" Click="CodeBlock_Click" ToolTip.Tip="Code block"><PathIcon Width="16" Height="16" Data="M8,3A2,2 0 0,0 6,5V9A2,2 0 0,1 4,11H3V13H4A2,2 0 0,1 6,15V19A2,2 0 0,0 8,21H10V19H8V14A2,2 0 0,0 6,12A2,2 0 0,0 8,10V5H10V3M16,3A2,2 0 0,1 18,5V9A2,2 0 0,0 20,11H21V13H20A2,2 0 0,0 18,15V19A2,2 0 0,1 16,21H14V19H16V14A2,2 0 0,1 18,12A2,2 0 0,1 16,10V5H14V3H16Z"/></Button>
                    <Button Classes="tool" Click="Link_Click" ToolTip.Tip="Link (Ctrl+K)"><PathIcon Width="16" Height="16" Data="M3.9,12C3.9,10.29 5.29,8.9 7,8.9H11V7H7A5,5 0 0,0 2,12A5,5 0 0,0 7,17H11V15.1H7C5.29,15.1 3.9,13.71 3.9,12M8,13H16V11H8V13M17,7H13V8.9H17C18.71,8.9 20.1,10.29 20.1,12C20.1,13.71 18.71,15.1 17,15.1H13V17H17A5,5 0 0,0 22,12A5,5 0 0,0 17,7Z"/></Button>
                    <Button Classes="tool" Click="Table_Click" ToolTip.Tip="Insert table"><PathIcon Width="16" Height="16" Data="M5,4H19A2,2 0 0,1 21,6V18A2,2 0 0,1 19,20H5A2,2 0 0,1 3,18V6A2,2 0 0,1 5,4M5,8V12H11V8H5M13,8V12H19V8H13M5,14V18H11V14H5M13,14V18H19V14H13Z"/></Button>
                    <Border Width="1" Background="#3C3544" Margin="4,2"/>
                </StackPanel>
                <!-- the tools of a canvas (docs/tools/notes.md): filled in the code -->
                <StackPanel x:Name="CanvasTools" Orientation="Horizontal" Spacing="2"/>
                <!-- the view: Surface (default), Split, Code, View -->
                <ComboBox x:Name="LayoutBox" FontSize="12" MinWidth="86" VerticalAlignment="Center" SelectionChanged="LayoutBox_SelectionChanged" ToolTip.Tip="How the document is shown">
                    <ComboBoxItem>Surface</ComboBoxItem>
                    <ComboBoxItem>Split</ComboBoxItem>
                    <ComboBoxItem>Code</ComboBoxItem>
                    <ComboBoxItem>View</ComboBoxItem>
                </ComboBox>
                <Button x:Name="PreviewButton" Classes="tool" Click="PreviewButton_Click" ToolTip.Tip="Code: show the view - View: show the code - Surface: leave the editor of a container (Ctrl+Shift+V)"><TextBlock x:Name="PreviewButtonText" Text="Preview"/></Button>
            </StackPanel>
        </Border>

        <Grid x:Name="ContentGrid" ColumnDefinitions="*,Auto,*">
            <ae:TextEditor x:Name="Editor" Grid.Column="0"
                           FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="14"
                           WordWrap="True"
                           ShowLineNumbers="False"
                           HorizontalScrollBarVisibility="Disabled"
                           VerticalScrollBarVisibility="Auto"
                           Padding="6,4"/>

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" Background="#1B181E"/>

            <ScrollViewer x:Name="Preview" Grid.Column="2" Background="#242028"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"/>
        </Grid>
    </DockPanel>
</UserControl>
