<Window x:Class="ScriptLang.Editor.FileViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datei ansehen" Height="700" Width="900"
        FontFamily="Segoe UI">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F0F0F0" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8,5">
                <TextBlock x:Name="PathText" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="  (schreibgeschützt - Strg+Klick springt zu Definition/Include)"
                           Foreground="#666666" VerticalAlignment="Center" FontSize="11"/>
            </StackPanel>
        </Border>

        <RichTextBox x:Name="Viewer"
                     FontFamily="Consolas" FontSize="14"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     PreviewMouseLeftButtonDown="Viewer_PreviewMouseLeftButtonDown"/>
    </DockPanel>
</Window>
