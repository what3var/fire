<Window x:Class="fire.Editor.FileViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Datei ansehen" Height="700" Width="900"
        FontFamily="Segoe UI" Background="#1B181E">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1B181E" BorderBrush="#3C3544" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8,5">
                <TextBlock x:Name="PathText" FontWeight="Bold" Foreground="#F4F0F2" VerticalAlignment="Center"/>
                <TextBlock Text="  (schreibgeschützt - Strg+Klick springt zu Definition/Include)"
                           Foreground="#A094A8" VerticalAlignment="Center" FontSize="11"/>
            </StackPanel>
        </Border>

        <avalonedit:TextEditor x:Name="Viewer"
                               FontFamily="Consolas" FontSize="14"
                               IsReadOnly="True"
                               ShowLineNumbers="True"
                               VerticalScrollBarVisibility="Auto"
                               HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
