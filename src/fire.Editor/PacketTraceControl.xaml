<UserControl x:Class="fire.Editor.PacketTraceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" Loaded="ToolBar_HideOverflow">
            <ToggleButton x:Name="RecordToggle" IsChecked="True" Click="RecordToggle_Click"
                          ToolTip="Recording on/off (live traces only)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x25CF;" Foreground="#C42B1C" VerticalAlignment="Center"/>
                    <TextBlock Text="Record" Margin="5,0,2,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ToggleButton>
            <Button Click="Clear_Click" ToolTip="Remove all packets from the list">
                <TextBlock Text="Clear" Margin="2,0"/>
            </Button>
            <Separator/>
            <TextBlock Text="Show content as:" VerticalAlignment="Center" Margin="4,0"/>
            <RadioButton x:Name="HexRadio" GroupName="PacketView" IsChecked="True" Content="Hex (Bytes)" Margin="4,0"
                         VerticalAlignment="Center" Checked="ViewMode_Changed"
                         ToolTip="Every byte in hexadecimal, separated by spaces"/>
            <RadioButton x:Name="TextRadio" GroupName="PacketView" Content="Text (Unicode)" Margin="4,0"
                         VerticalAlignment="Center" Checked="ViewMode_Changed"
                         ToolTip="The bytes as UTF-8 text; control characters as \r, \n, \xNN"/>
            <Separator/>
            <CheckBox x:Name="AutoScrollBox" Content="Autoscroll" IsChecked="True" VerticalAlignment="Center" Margin="4,0"/>
            <Separator/>
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Margin="4,0" Foreground="#444444"/>
        </ToolBar>

        <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" Visibility="Collapsed" Margin="8,4" Foreground="#C42B1C" TextWrapping="Wrap"/>

        <ListView x:Name="PacketList" FontFamily="Consolas" FontSize="12" BorderThickness="0"
                  SelectionMode="Extended" SelectionChanged="PacketList_SelectionChanged"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="#EEF8EE"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                            <Setter Property="Background" Value="#E8F1FC"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="60" DisplayMemberBinding="{Binding Number}"/>
                    <GridViewColumn Header="Time" Width="100" DisplayMemberBinding="{Binding TimeText}"/>
                    <GridViewColumn Header="Direction" Width="110" DisplayMemberBinding="{Binding DirectionText}"/>
                    <GridViewColumn Header="Device" Width="140" DisplayMemberBinding="{Binding DeviceId}"/>
                    <GridViewColumn Header="Bytes" Width="55" DisplayMemberBinding="{Binding Length}"/>
                    <GridViewColumn Header="Content" Width="600" DisplayMemberBinding="{Binding Content}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
