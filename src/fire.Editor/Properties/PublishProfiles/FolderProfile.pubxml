<?xml version="1.0" encoding="utf-8"?>
<!--
  Publishes spark together with forge and ember into src/fire.Editor/bin/publish (the folder setup.iss packs):
  spark self-contained (no single file: its libraries and the native parts lie next to it), with forge, fire, ember, native/, Source/ and Prebuilt/
  (src/ForgeDist.targets), Help and Assistant.
  Visual Studio: right click fire.Editor > Publish > FolderProfile. Command line:
    dotnet publish src/fire.Editor/fire.Editor.csproj -p:PublishProfile=FolderProfile
  Another system: -r linux-x64 / -r osx-arm64 (the RuntimeIdentifier below is the default).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\publish\</PublishDir>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- forge and ember go into the same folder (fire.Editor.csproj, target PublishTools) -->
    <PublishTools>true</PublishTools>
	<DebugType>none</DebugType>
	<DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
