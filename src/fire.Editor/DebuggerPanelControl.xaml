<UserControl x:Class="fire.Editor.DebuggerPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Debugger" FontWeight="Bold" Margin="6,6,6,2"/>

        <GroupBox Grid.Row="1" Header="Threads" Margin="4" MaxHeight="140">
            <ListBox x:Name="ThreadsList" FontFamily="Consolas" FontSize="12"
                     SelectionChanged="ThreadsList_SelectionChanged"/>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="6,0,6,4">
            <Button x:Name="PauseThreadButton" Content="Aktiven Thread anhalten"
                    Click="PauseThread_Click" Padding="6,2"/>
        </StackPanel>

        <GroupBox Grid.Row="3" Header="Aktiver Scope" Margin="4">
            <TreeView x:Name="ScopeTree" FontFamily="Consolas" FontSize="12"/>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="Wert-Stack (oben = zuletzt)" Margin="4">
            <ListView x:Name="StackView" FontFamily="Consolas" FontSize="12"/>
        </GroupBox>

        <StackPanel Grid.Row="5" Margin="6" Orientation="Vertical">
            <TextBlock x:Name="CallDepthText" Text="Aufruftiefe: -"/>
            <TextBlock x:Name="CurrentLineText" Text="Aktuelle Zeile: -" Margin="0,4,0,0"/>
            <TextBlock x:Name="BreakpointsText" Text="Haltepunkte: (keine)" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
