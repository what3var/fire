<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="fire.Editor.StackPanelControl">
    <TableView x:Name="StackView" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" BorderThickness="0"
               CanUserResizeColumns="True" SelectionMode="Single">
        <TableView.Columns>
            <TableViewColumn Header="#" Width="40" Binding="{Binding Position}"/>
            <TableViewColumn Header="Type" Width="80" Binding="{Binding Type}"/>
            <TableViewColumn Header="Value (top = latest)" Width="*" Binding="{Binding Text}"/>
        </TableView.Columns>
    </TableView>
</UserControl>
