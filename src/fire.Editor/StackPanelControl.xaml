<UserControl x:Class="fire.Editor.StackPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ListView x:Name="StackView" FontFamily="Consolas" FontSize="12" BorderThickness="0">
        <ListView.View>
            <GridView>
                <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Position}"/>
                <GridViewColumn Header="Typ" Width="80" DisplayMemberBinding="{Binding Type}"/>
                <GridViewColumn Header="Wert (oben = zuletzt)" Width="360" DisplayMemberBinding="{Binding Text}"/>
            </GridView>
        </ListView.View>
    </ListView>
</UserControl>
