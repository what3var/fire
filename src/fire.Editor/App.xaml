<Application x:Class="fire.Editor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.modernwpf.com/2019" xmlns:local="clr-namespace:fire.Editor"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources AccentColor="#B70052"/>
                <ui:FluentControlsResources UseCompactResources="False" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Farben der Inhalte der Bereiche: dieselbe wie im Editor (EditorTheme.PanelColor). Der Rahmen (Hauptfenster, Docking)
                 ist dunkler (#1B181E), siehe MainWindow/FireDockTheme. -->
            <!-- Akzentfarbe #B70052 (EditorTheme.AccentColor). AccentColor oben färbt alles Abgeleitete; die Ressourcen hier sind die
                 Stellen, an denen ModernWpf im dunklen Thema eine AUFGEHELLTE Variante nimmt (Light2) - sie sollen exakt die Akzentfarbe zeigen.
                 Die Schlüssel müssen die Blätter sein, die die Vorlagen abfragen: ModernWpf verweist intern per StaticResource auf die
                 AccentFillColor-Pinsel, ein Überschreiben von denen käme dort nicht an. -->
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#B70052"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#B70052" Opacity="0.9"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#B70052" Opacity="0.8"/>
            <SolidColorBrush x:Key="AppBarToggleButtonBackgroundChecked" Color="#B70052"/>
            <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" Color="#B70052" Opacity="0.9"/>
            <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedPressed" Color="#B70052" Opacity="0.8"/>
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#B70052"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#B70052" Opacity="0.9"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#B70052" Opacity="0.8"/>
            <!-- Unterer Akzentrand der fokussierten Textfelder (wie ModernWpfs TextControlElevationBorderFocusedBrush, nur mit der Akzentfarbe) -->
            <LinearGradientBrush x:Key="TextControlBorderBrushFocused" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
                <LinearGradientBrush.RelativeTransform>
                    <ScaleTransform ScaleY="-1" CenterY="0.5"/>
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Offset="1.0" Color="#B70052"/>
                <GradientStop Offset="1.0" Color="#12FFFFFF"/>
            </LinearGradientBrush>

            <SolidColorBrush x:Key="TextControlBackground" Color="#242028"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#242028"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#242028"/>
            <SolidColorBrush x:Key="ListViewBackground" Color="#242028"/>
            <SolidColorBrush x:Key="ListBoxBackground" Color="#242028"/>

            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="Background" Value="#242028"/>
            </Style>
            <Style TargetType="ListView" BasedOn="{StaticResource DefaultListViewStyle}">
                <Setter Property="Background" Value="#242028"/>
            </Style>
            <Style TargetType="ListBox" BasedOn="{StaticResource DefaultListBoxStyle}">
                <Setter Property="Background" Value="#242028"/>
            </Style>
            <Style TargetType="TreeView" BasedOn="{StaticResource DefaultTreeViewStyle}">
                <Setter Property="Background" Value="#242028"/>
            </Style>
            <Style TargetType="DataGrid" BasedOn="{StaticResource DefaultDataGridStyle}">
                <Setter Property="Background" Value="#242028"/>
            </Style>

            <Style TargetType="{x:Type local:SplitButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:SplitButton}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PART_Button"
                                        Grid.Column="0"
                                        Content="{TemplateBinding Content}"
                                        VerticalAlignment="Stretch"
                                        BorderThickness="0,0,1,0" BorderBrush="#404040" 
                                        Background="Transparent"/>
                                    <ToggleButton x:Name="PART_ToggleButton"
                                        Grid.Column="1" Content="▼" Padding="6" FontSize="8"
                                        VerticalAlignment="Stretch" 
                                        BorderThickness="0"
                                        Background="Transparent">
                                    </ToggleButton>
                                </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
