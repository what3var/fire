<Window x:Class="fire.Editor.ToolchainProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installing the toolchain" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <StackPanel Margin="14">
        <TextBlock x:Name="txtStatus" Text="Starting..." TextWrapping="Wrap" Margin="0,0,0,10"/>
        <ProgressBar x:Name="bar" Height="16" IsIndeterminate="True"/>
    </StackPanel>
</Window>
