<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="fire.Editor.PackageManagerDialog"
        Title="Package Manager (ember)" Width="780" Height="520" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="8" RowDefinitions="Auto,*,Auto,Auto">
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Search" Padding="14,2" Margin="6,0,0,0" Click="Search_Click" IsDefault="True"/>
            <TextBox x:Name="txtSearch" ToolTip.Tip="Part of a name or of a description; empty: everything"/>
        </DockPanel>

        <TableView Grid.Row="1" x:Name="lvPackages" CanUserResizeColumns="True" SelectionMode="Single" SelectionChanged="Packages_SelectionChanged">
            <TableView.Columns>
                <TableViewColumn Header="Package" Width="150" Binding="{Binding Name}"/>
                <TableViewColumn Header="Version" Width="80" Binding="{Binding Latest}"/>
                <TableViewColumn Header="Installed" Width="80" Binding="{Binding InstalledVersion}"/>
                <TableViewColumn Header="Author" Width="110" Binding="{Binding Author}"/>
                <TableViewColumn Header="Description" Width="*" Binding="{Binding Description}"/>
            </TableView.Columns>
        </TableView>

        <TextBlock Grid.Row="2" x:Name="txtDetails" TextWrapping="Wrap" Margin="2,6" MinHeight="34"/>

        <DockPanel Grid.Row="3" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" x:Name="txtStatus" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
            <Button DockPanel.Dock="Right" Content="Close" Padding="14,2" Margin="6,0,0,0" IsCancel="True" Click="Close_Click"/>
            <Button DockPanel.Dock="Right" x:Name="btnRemove" Content="Remove" Padding="14,2" Margin="6,0,0,0" Click="Remove_Click" IsEnabled="False"/>
            <Button DockPanel.Dock="Right" x:Name="btnInstall" Content="Install" Padding="14,2" Margin="6,0,0,0" Click="Install_Click" IsEnabled="False"/>
            <Button DockPanel.Dock="Right" Content="From file..." Padding="14,2" Margin="6,0,0,0" Click="InstallFile_Click" ToolTip.Tip="Install a package file (.fpk)"/>
        </DockPanel>
    </Grid>
</Window>
