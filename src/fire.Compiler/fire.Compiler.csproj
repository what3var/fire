<Project Sdk="Microsoft.NET.Sdk">
	
<PropertyGroup>
	<OutputType>Exe</OutputType>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<RootNamespace>fire.Compiler</RootNamespace>
	<LangVersion>latest</LangVersion>
	<AssemblyName>forge</AssemblyName>
	<AssemblyTitle>forge</AssemblyTitle>

	<PublishSingleFile>true</PublishSingleFile>
	<SelfContained>true</SelfContained>
</PropertyGroup>
	
<ItemGroup>
  <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="all" />
</ItemGroup>
	
  <ItemGroup>
    <ProjectReference Include="..\fire.Device.Manager\fire.Device.Manager.csproj" />   <!-- spark's devices (PackageDriverAgent, DeviceHostServer) -->

    <ProjectReference Include="..\fire.UI.Markup\fire.UI.Markup.csproj" />
    <ProjectReference Include="..\fire.Native\fire.Native.csproj" />
    <ProjectReference Include="..\fire.Ember\fire.Ember.csproj" />   <!-- the program ember comes along into the compiler folder (it uses the package manager library, which fire.Native and fire.Project bring) -->
    <ProjectReference Include="..\fire.Project\fire.Project.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The VM in C (the program fire): its sources travel with forge, which builds it on a machine that has none next to it (CVm.cs). The runtime comes from fire.Native. -->
    <EmbeddedResource Include="..\..\native\vm\*.c;..\..\native\vm\*.h" LogicalName="cvm/vm/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\native\base\*.h" LogicalName="cvm/base/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\native\tables\*.def" LogicalName="cvm/tables/%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="..\StandardSources.targets" />
  <Import Project="..\FireVm.targets" />

</Project>
