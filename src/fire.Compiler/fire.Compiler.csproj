<Project Sdk="Microsoft.NET.Sdk">
	
<PropertyGroup>
	<OutputType>Exe</OutputType>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<RootNamespace>fire.Compiler</RootNamespace>
	<LangVersion>latest</LangVersion>
	<AssemblyName>forge</AssemblyName>
	<AssemblyTitle>forge</AssemblyTitle>
</PropertyGroup>
	
<ItemGroup>
  <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" />
</ItemGroup>
	
  <ItemGroup>
    <ProjectReference Include="..\fire.Runtime\fire.Runtime.csproj" />
    <ProjectReference Include="..\fire.UI.Bridge\fire.UI.Bridge.csproj" />
    <ProjectReference Include="..\fire.UI.Markup\fire.UI.Markup.csproj" />
    <ProjectReference Include="..\fire.Native\fire.Native.csproj" />
    <ProjectReference Include="..\fire.Ember\fire.Ember.csproj" />   <!-- the program ember comes along into the compiler folder (it uses the package manager library, which fire.Native and fire.Project bring) -->
    <ProjectReference Include="..\fire.Project\fire.Project.csproj" />
  </ItemGroup>

  <!-- The templates that a standard bridge brings with its package (PackageTemplates\<bridge>\{Code,Project}\..., docs/TEMPLATES.md): copied next to the compiler, packed by bridge-packages. -->
  <ItemGroup>
    <None Update="PackageTemplates\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- (the SDK leaves *.*proj files out of its default items) -->
    <None Include="PackageTemplates\**\*.fireproj" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\BridgePackages.targets" />

</Project>
