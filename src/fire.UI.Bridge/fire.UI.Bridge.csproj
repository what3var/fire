<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A small UI library that runs in a framebuffer (buttons, labels, check boxes,
    text fields, panels). Written entirely in fire (UiBridge.PreludeSource, `namespace UI`) and built on the
    classes of the graphics bridge (Framebuffer, Console, Window) - therefore contains no native functions and
    no DLL dependency of its own. Activated via `#import "ui"` (automatically switches on `graphics` as well).
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>fire.UI.Bridge</RootNamespace>
    <AssemblyName>fire.UI.Bridge</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- the source of the library: ui/*.fire, in the order of their names (embedded, UiBridge.PreludeSource joins them) -->
  <ItemGroup>
    <EmbeddedResource Include="ui\*.fire" LogicalName="ui/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
