namespace UI {
    // The brushes and pens of the interface (Root.theme) - individual fields can be changed after the root has been created (e.g. `root.theme.back = new SolidBrush(...)`).
    class Theme {
        Brush back
        Brush panel
        Brush face
        Brush faceHover
        Brush facePressed
        Brush faceDisabled
        Brush inputBack
        Brush accent
        Brush text
        Brush textDisabled
        // Listen, Menues, Bildlaufleisten
        Brush selection
        Brush selectionText
        Brush scrollTrack
        Brush scrollThumb
        Brush scrollThumbHover
        Brush menuBack
        Pen border
        Pen borderFocus
        // the caret of the text field
        Pen caret
        // The font of all text that does not choose another (Element.font): a name for Fonts.Get - a font added with Fonts.Add, a built-in one ("8x14", "8x8") or one installed
        // on the system; "" is the console font of the renderer. fontSize is the height of the letters in pixels (TrueType fonts; the bitmap fonts ignore it).
        string font = ""
        int fontSize = 14

        construct() {
            this.back = new SolidBrush(UI.Color.Rgb(240, 240, 240))
            this.panel = new SolidBrush(UI.Color.Rgb(250, 250, 250))
            this.face = new SolidBrush(UI.Color.Rgb(225, 225, 225))
            this.faceHover = new SolidBrush(UI.Color.Rgb(229, 241, 251))
            this.facePressed = new SolidBrush(UI.Color.Rgb(204, 228, 247))
            this.faceDisabled = new SolidBrush(UI.Color.Rgb(204, 204, 204))
            this.inputBack = new SolidBrush(UI.Color.Rgb(255, 255, 255))
            this.accent = new SolidBrush(UI.Color.Rgb(0, 120, 215))
            this.text = new SolidBrush(UI.Color.Rgb(0, 0, 0))
            this.textDisabled = new SolidBrush(UI.Color.Rgb(131, 131, 131))
            this.selection = new SolidBrush(UI.Color.Rgb(0, 120, 215))
            this.selectionText = new SolidBrush(UI.Color.Rgb(255, 255, 255))
            this.scrollTrack = new SolidBrush(UI.Color.Rgb(235, 235, 235))
            this.scrollThumb = new SolidBrush(UI.Color.Rgb(190, 190, 190))
            this.scrollThumbHover = new SolidBrush(UI.Color.Rgb(160, 160, 160))
            this.menuBack = new SolidBrush(UI.Color.Rgb(248, 248, 248))
            this.border = new Pen(UI.Color.Rgb(120, 120, 120))
            this.borderFocus = new Pen(UI.Color.Rgb(0, 120, 215))
            this.caret = new Pen(UI.Color.Rgb(0, 0, 0))
        }
    }
}
