namespace UI {
    // Eine Zeile eines Menues: Beschriftung, Aktion (Lambda ohne Parameter), Untermenue (Add), Trenner, Haken, Kuerzel als Text.
    class MenuItem {
        string header = ""
        var onClick
        List items
        bool separator = false
        // Mit checkable schaltet ein Klick den Haken um (isChecked), bevor onClick laeuft.
        bool checkable = false
        bool isChecked = false
        bool enabled = true
        // Nur ein Text rechts in der Zeile (zum Beispiel "Strg+S"), die Tastenbelegung selbst ist Sache des Programms
        string shortcut = ""

        construct(string header = "", onClick = undefined) {
            this.header = header
            this.onClick = onClick
            this.items = new List()
        }

        // Ein Trenner.
        static Separator() {
            var m = new MenuItem()
            m.separator = true
            return m
        }

        // Haengt eine Untermenue-Zeile an; sie gehoert dieser Zeile.
        Add(item) {
            item.TakeTo(this)
            this.items.Add(item)
            return item
        }

        bool HasSubmenu() { return this.items.count > 0 }

        // Fuehrt die Aktion aus (Haken umschalten, Lambda aufrufen).
        Activate() {
            if (this.checkable) { this.isChecked = !this.isChecked }
            var callback = this.onClick
            if (callback != undefined) { callback() }
        }
    }

    // Die aufgeklappte Liste eines Menues (schwebend, siehe Root.ShowMenu); ein Untermenue ist ein weiteres MenuPopup daneben.
    class MenuPopup : Element {
        List entries
        int hot = -1
        MenuPopup sub
        int subIndex = -1
        MenuPopup parentMenu

        construct(entries) : base(0, 0, -1, -1) {
            this.entries = entries
            this.grabsKeys = true
        }

        string StyleKey() { return "MenuPopup" }

        int RowHeight(root) { return root.ch + 8 }

        int HeightOf(root, item) {
            if (item.separator) { return 7 }
            return this.RowHeight(root)
        }

        MeasureCore(root, int aw, int ah) {
            var w = 0
            var h = 4
            for (var i = 0; i < this.entries.count; i = i + 1) {
                var item = this.entries[i]
                h = h + this.HeightOf(root, item)
                if (item.separator) { continue }
                var line = 28 + root.cw * item.header.Length + 12
                if (item.shortcut != "") { line = line + 24 + root.cw * item.shortcut.Length }
                if (item.HasSubmenu()) { line = line + 12 }
                w = UI.M.Max(w, line)
            }
            this.cw = UI.M.Max(w, 80)
            this.ch = h
        }

        // Der Index der Zeile bei der Bildschirmhoehe `py`, oder -1.
        int RowAt(root, int py) {
            var y = this.ay + 2
            for (var i = 0; i < this.entries.count; i = i + 1) {
                var h = this.HeightOf(root, this.entries[i])
                if (py >= y && py < y + h) { return i }
                y = y + h
            }
            return -1
        }

        int RowTop(root, int index) {
            var y = this.ay + 2
            for (var i = 0; i < index; i = i + 1) { y = y + this.HeightOf(root, this.entries[i]) }
            return y
        }

        Draw(root, int ax, int ay) {
            if (!this.NeedsDraw(root, ax, ay)) { return }
            var theme = root.theme
            var r = root.renderer
            var back = this.background
            if (back == undefined) { back = theme.menuBack }
            r.FillRect(ax, ay, this.actualWidth, this.actualHeight, back)
            var border = this.pen
            if (border == undefined) { border = theme.border }
            r.DrawRect(ax, ay, this.actualWidth, this.actualHeight, border)
            var y = ay + 2
            for (var i = 0; i < this.entries.count; i = i + 1) {
                var item = this.entries[i]
                var h = this.HeightOf(root, item)
                if (item.separator) {
                    r.DrawLine(ax + 4, y + 3, ax + this.actualWidth - 5, y + 3, theme.border)
                    y = y + h
                    continue
                }
                var text = theme.text
                if (this.foreground != undefined) { text = this.foreground }
                if (!item.enabled) { text = theme.textDisabled }
                if (i == this.hot && item.enabled) {
                    r.FillRect(ax + 2, y, this.actualWidth - 4, h, theme.selection)
                    text = theme.selectionText
                }
                if (item.isChecked) {
                    // ein Haken
                    var cx = ax + 8
                    var cy = y + h / 2
                    var tick = new Pen(text.Color, 2)
                    r.DrawLine(cx, cy, cx + 3, cy + 4, tick)
                    r.DrawLine(cx + 3, cy + 4, cx + 10, cy - 4, tick)
                }
                var ty = y + (h - root.ch) / 2
                r.DrawText(ax + 28, ty, item.header, text)
                var right = ax + this.actualWidth - 12
                if (item.HasSubmenu()) {
                    // ein Pfeil nach rechts
                    var my = y + h / 2
                    r.FillTriangle(right - 4, my - 4, right - 4, my + 4, right + 1, my, text)
                    right = right - 12
                }
                if (item.shortcut != "") { r.DrawText(right - root.cw * item.shortcut.Length, ty, item.shortcut, text) }
                y = y + h
            }
        }

        // Das Untermenue schliessen, wenn es offen ist.
        CloseSub(root) {
            if (this.sub != undefined) {
                var inner = this.sub
                this.sub = undefined
                this.subIndex = -1
                // zuerst die Untermenues des Untermenues, dann es selbst
                inner.CloseSub(root)
                root.ClosePopup(inner)
            }
        }

        OpenSub(root, int index) {
            var item = this.entries[index]
            if (this.subIndex == index && this.sub != undefined) { return }
            this.CloseSub(root)
            if (!item.HasSubmenu() || !item.enabled) { return }
            var menu = new MenuPopup(item.items)
            menu.parentMenu = this
            root.ShowPopup(menu, this.ax + this.actualWidth - 2, this.RowTop(root, index), true, this)
            this.sub = menu
            this.subIndex = index
        }

        // Waehlt die Zeile: ein Untermenue oeffnet sich, sonst laeuft die Aktion und alles schliesst sich.
        Choose(root, int index) {
            var item = this.entries[index]
            if (item.separator || !item.enabled) { return }
            if (item.HasSubmenu()) {
                this.OpenSub(root, index)
                return
            }
            root.CloseAllPopups()
            item.Activate()
        }

        Hover(root, int px, int py) {
            var index = this.RowAt(root, py)
            if (index < 0 || this.entries[index].separator) { return }
            this.hot = index
            if (this.subIndex != index) { this.OpenSub(root, index) }
        }

        // Ein Klick ausserhalb aller Menues schliesst alles; die Menues eines Untermenues schliesst der Root ohnehin der Reihe nach.
        bool PopupOutside(root, int px, int py) {
            var consumed = this.owner != undefined && this.owner.Contains(px, py)
            root.ClosePopup(this)
            return consumed
        }

        MouseDown(root, int button, int px, int py) {
            if (button != 1) { return }
            var index = this.RowAt(root, py)
            if (index >= 0) { this.Choose(root, index) }
        }

        KeyDown(root, int key, int mod) {
            // die Tasten gehen an das oberste Menue
            if (key == UI.Keys.Escape()) {
                if (this.parentMenu != undefined) {
                    this.parentMenu.CloseSub(root)
                } else {
                    root.CloseAllPopups()
                }
                return
            }
            if (key == UI.Keys.Down()) { this.Step(1) }
            else if (key == UI.Keys.Up()) { this.Step(-1) }
            else if (key == UI.Keys.Right()) {
                if (this.hot >= 0 && this.entries[this.hot].HasSubmenu()) {
                    this.OpenSub(root, this.hot)
                    if (this.sub != undefined) { this.sub.hot = this.sub.FirstRow() }
                }
            } else if (key == UI.Keys.Left()) {
                if (this.parentMenu != undefined) { this.parentMenu.CloseSub(root) }
            } else if (key == UI.Keys.Enter() || key == UI.Keys.Space()) {
                if (this.hot >= 0) { this.Choose(root, this.hot) }
            }
        }

        int FirstRow() {
            for (var i = 0; i < this.entries.count; i = i + 1) {
                if (!this.entries[i].separator && this.entries[i].enabled) { return i }
            }
            return -1
        }

        // Die naechste waehlbare Zeile in Richtung `direction` (1 oder -1), kreisend.
        Step(int direction) {
            var n = this.entries.count
            if (n == 0) { return }
            var i = this.hot
            for (var k = 0; k < n; k = k + 1) {
                i = i + direction
                if (i >= n) { i = 0 }
                if (i < 0) { i = n - 1 }
                var item = this.entries[i]
                if (!item.separator && item.enabled) {
                    this.hot = i
                    return
                }
            }
        }
    }

    // Die Menueleiste: die Titel der obersten Ebene nebeneinander; ein Klick klappt das Menue auf, bei offenem Menue wechselt der Zeiger darueber das Menue.
    class MenuBar : Element {
        List menus
        int openIndex = -1
        // der Titel unter dem Zeiger (-1: keiner)
        int hotIndex = -1
        MenuPopup open

        construct(int x = 0, int y = 0, int width = -1, int height = -1) : base(x, y, width, height) {
            this.menus = new List()
        }

        string StyleKey() { return "MenuBar" }

        // Haengt ein Menue der obersten Ebene an (ein MenuItem mit Untermenue-Zeilen); es gehoert der Leiste.
        Add(item) {
            item.TakeTo(this)
            this.menus.Add(item)
            return item
        }

        int HeaderWidth(root, item) { return root.cw * item.header.Length + 16 }

        MeasureCore(root, int aw, int ah) {
            var w = 0
            for (var i = 0; i < this.menus.count; i = i + 1) { w = w + this.HeaderWidth(root, this.menus[i]) }
            this.cw = w
            this.ch = root.ch + 8
        }

        // Der Index des Titels bei der Bildschirmposition px, oder -1.
        int IndexAt(root, int px) {
            var x = this.ax
            for (var i = 0; i < this.menus.count; i = i + 1) {
                var w = this.HeaderWidth(root, this.menus[i])
                if (px >= x && px < x + w) { return i }
                x = x + w
            }
            return -1
        }

        int HeaderLeft(root, int index) {
            var x = this.ax
            for (var i = 0; i < index; i = i + 1) { x = x + this.HeaderWidth(root, this.menus[i]) }
            return x
        }

        // Ein Menue, das sich geschlossen hat, ist nicht mehr offen.
        Poll(root) {
            base.Poll(root)
            if (this.open != undefined && !root.IsPopup(this.open)) {
                this.open = undefined
                this.openIndex = -1
            }
        }

        Draw(root, int ax, int ay) {
            if (!this.NeedsDraw(root, ax, ay)) { return }
            var theme = root.theme
            var back = this.background
            if (back == undefined) { back = theme.panel }
            root.renderer.FillRect(ax, ay, this.actualWidth, this.actualHeight, back)
            var x = ax
            for (var i = 0; i < this.menus.count; i = i + 1) {
                var item = this.menus[i]
                var w = this.HeaderWidth(root, item)
                var text = theme.text
                if (this.foreground != undefined) { text = this.foreground }
                if (i == this.openIndex) {
                    root.renderer.FillRect(x, ay, w, this.actualHeight, theme.selection)
                    text = theme.selectionText
                } else if (i == this.hotIndex) {
                    root.renderer.FillRect(x, ay, w, this.actualHeight, theme.faceHover)
                }
                if (!item.enabled) { text = theme.textDisabled }
                root.renderer.DrawText(x + 8, ay + (this.actualHeight - root.ch) / 2, item.header, text)
                x = x + w
            }
        }

        Open(root, int index) {
            if (this.open != undefined) {
                root.CloseAllPopups()
                this.open = undefined
            }
            this.openIndex = index
            var item = this.menus[index]
            if (!item.enabled || !item.HasSubmenu()) {
                this.openIndex = -1
                item.Activate()
                return
            }
            this.open = root.ShowMenu(item.items, this.HeaderLeft(root, index), this.ay + this.actualHeight, this)
        }

        MouseDown(root, int button, int px, int py) {
            if (button != 1) { return }
            var index = this.IndexAt(root, px)
            if (index >= 0) { this.Open(root, index) }
        }

        // Bei offenem Menue oeffnet der Zeiger ueber einem anderen Titel dessen Menue.
        Hover(root, int px, int py) {
            this.hotIndex = this.IndexAt(root, px)
            if (this.open == undefined) { return }
            var index = this.hotIndex
            if (index >= 0 && index != this.openIndex) { this.Open(root, index) }
        }
    }
}