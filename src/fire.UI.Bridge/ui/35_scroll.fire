namespace UI {
    // How a scroll bar disappears or appears (ScrollViewer.hmode/vmode).
    enum ScrollMode { Disabled = 0, Auto = 1, Visible = 2 }

    // The calculation behind a scroll bar in ONE direction: content size (`extent`), visible section (`viewport`), shift (`offset`).
    // Draws the bar and handles dragging the thumb; ScrollViewer and the lists use it.
    class Scroller {
        bool horizontal = false
        int offset = 0
        int extent = 0
        int viewport = 0
        // Width of the bar in pixels
        int size = 12
        bool dragging = false
        int grab = 0
        bool hover = false
        // the element that shows the bar: it is repainted when something about the bar changes
        var owner

        construct(bool horizontal = false) { this.horizontal = horizontal }

        Changed() {
            var o = this.owner
            if (o != undefined) { o.Invalidate() }
        }

        SetHover(bool value) {
            if (this.hover == value) { return }
            this.hover = value
            this.Changed()
        }

        int Max() { return UI.M.Max(0, this.extent - this.viewport) }

        bool Needed() { return this.extent > this.viewport }

        Set(int value) {
            var next = UI.M.Clamp(value, 0, this.Max())
            if (next == this.offset) { return }
            this.offset = next
            this.Changed()
        }

        By(int delta) { this.Set(this.offset + delta) }

        // Length and start of the thumb in a bar of length `track`
        int ThumbLength(int track) {
            if (this.extent <= 0) { return track }
            var length = track * this.viewport / this.extent
            return UI.M.Clamp(length, 12, track)
        }

        int ThumbStart(int track) {
            var room = track - this.ThumbLength(track)
            var max = this.Max()
            if (max == 0) { return 0 }
            return room * this.offset / max
        }

        // Draws the bar into the rectangle (x, y, length `track` in the running direction, `size` across).
        Draw(root, int x, int y, int track) {
            var theme = root.theme
            var start = this.ThumbStart(track)
            var length = this.ThumbLength(track)
            var thumb = theme.scrollThumb
            if (this.hover || this.dragging) { thumb = theme.scrollThumbHover }
            if (this.horizontal) {
                root.renderer.FillRect(x, y, track, this.size, theme.scrollTrack)
                root.renderer.FillRect(x + start + 1, y + 2, length - 2, this.size - 4, thumb)
            } else {
                root.renderer.FillRect(x, y, this.size, track, theme.scrollTrack)
                root.renderer.FillRect(x + 2, y + start + 1, this.size - 4, length - 2, thumb)
            }
        }

        // A click at the position `pos` (running direction, from the start of the bar): at the thumb dragging begins, next to it a page is scrolled.
        Press(int pos, int track) {
            var start = this.ThumbStart(track)
            var length = this.ThumbLength(track)
            if (pos >= start && pos < start + length) {
                this.dragging = true
                this.Changed()
                this.grab = pos - start
            } else if (pos < start) {
                this.By(-this.viewport)
            } else {
                this.By(this.viewport)
            }
        }

        // The pointer moves to the position `pos` while dragging.
        Drag(int pos, int track) {
            if (!this.dragging) { return }
            var room = track - this.ThumbLength(track)
            if (room <= 0) { return }
            this.Set((pos - this.grab) * this.Max() / room)
        }

        Release() {
            if (this.dragging) {
                this.dragging = false
                this.Changed()
            }
        }
    }

    // Shows ONE child (`content`) in a section and fades in scroll bars if it does not fit. Adjustable with `hmode`/`vmode`
    // (UI.ScrollMode: Disabled, Auto, Visible); Disabled means: in this direction the child gets exactly the space of the section
    // (a WrapPanel then wraps). The mouse wheel scrolls vertically (horizontally with Shift).
    class ScrollViewer : Element {
        Element content
        Scroller vbar
        Scroller hbar
        int vmode = UI.ScrollMode.Auto
        int hmode = UI.ScrollMode.Disabled
        // at the last layout: visible bars and size of the section
        bool showV = false
        bool showH = false
        int viewW = 0
        int viewH = 0

        construct(int x = 0, int y = 0, int width = -1, int height = -1) : base(x, y, width, height) {
            this.vbar = new Scroller(false)
            this.hbar = new Scroller(true)
            this.vbar.owner = this
            this.hbar.owner = this
        }

        Poll(root) {
            base.Poll(root)
            if (this.content != undefined) { this.content.Poll(root) }
        }

        string StyleKey() { return "ScrollViewer" }

        // The child belongs to the ScrollViewer from now on.
        SetContent(element) {
            if (this.content != undefined) { this.content.parent = undefined }
            this.content = element
            element.TakeTo(this)
            element.parent = this
            this.Invalidate()
        }

        MeasureCore(root, int aw, int ah) {
            var c = this.content
            if (c == undefined) {
                this.cw = 0
                this.ch = 0
                return
            }
            var bar = this.vbar.size
            // First measure without bars: with Disabled with the full space, otherwise unbounded.
            var mw = -1
            var mh = -1
            if (this.hmode == UI.ScrollMode.Disabled) { mw = aw }
            if (this.vmode == UI.ScrollMode.Disabled) { mh = ah }
            this.showV = this.vmode == UI.ScrollMode.Visible
            this.showH = this.hmode == UI.ScrollMode.Visible
            if (this.showV && mw >= 0) { mw = UI.M.Max(0, mw - bar) }
            if (this.showH && mh >= 0) { mh = UI.M.Max(0, mh - bar) }
            c.Measure(root, mw, mh)
            // if the child needs more space than is available, bars are added (and take away space)
            if (!this.showV && this.vmode == UI.ScrollMode.Auto && ah >= 0 && c.dh > ah - (this.ShownBar(this.showH)) ) { this.showV = true }
            if (!this.showH && this.hmode == UI.ScrollMode.Auto && aw >= 0 && c.dw > aw - (this.ShownBar(this.showV))) { this.showH = true }
            if (this.showV && !this.showH && this.hmode == UI.ScrollMode.Auto && aw >= 0 && c.dw > aw - bar) { this.showH = true }
            if (this.showV || this.showH) {
                if (this.hmode == UI.ScrollMode.Disabled && mw >= 0) { mw = UI.M.Max(0, aw - this.ShownBar(this.showV)) }
                if (this.vmode == UI.ScrollMode.Disabled && mh >= 0) { mh = UI.M.Max(0, ah - this.ShownBar(this.showH)) }
                c.Measure(root, mw, mh)
                // with the bar the other may have become necessary
                if (!this.showH && this.hmode == UI.ScrollMode.Auto && aw >= 0 && c.dw > aw - this.ShownBar(this.showV)) { this.showH = true }
                if (!this.showV && this.vmode == UI.ScrollMode.Auto && ah >= 0 && c.dh > ah - this.ShownBar(this.showH)) { this.showV = true }
            }
            var w = c.dw + this.ShownBar(this.showV)
            var h = c.dh + this.ShownBar(this.showH)
            if (aw >= 0) { w = UI.M.Min(w, aw) }
            if (ah >= 0) { h = UI.M.Min(h, ah) }
            this.cw = w
            this.ch = h
        }

        // The width that a bar takes away (0 if it is not shown).
        int ShownBar(bool shown) {
            if (shown) { return this.vbar.size }
            return 0
        }

        ArrangeCore(root, int w, int h) {
            var c = this.content
            if (c == undefined) { return }
            this.viewW = UI.M.Max(0, w - this.ShownBar(this.showV))
            this.viewH = UI.M.Max(0, h - this.ShownBar(this.showH))
            this.vbar.extent = c.dh
            this.vbar.viewport = this.viewH
            this.hbar.extent = c.dw
            this.hbar.viewport = this.viewW
            this.vbar.Set(this.vbar.offset)
            this.hbar.Set(this.hbar.offset)
            // the child gets at least the section, so that it can stretch there
            c.Arrange(root, -this.hbar.offset, -this.vbar.offset, UI.M.Max(c.dw, this.viewW), UI.M.Max(c.dh, this.viewH))
        }

        Draw(root, int ax, int ay) {
            if (!this.NeedsDraw(root, ax, ay)) { return }
            if (this.DrawTemplate(root, ax, ay)) { return }
            var c = this.content
            if (this.background != undefined) { root.renderer.FillRect(ax, ay, this.actualWidth, this.actualHeight, this.background) }
            if (c != undefined && c.visible) {
                root.PushClip(ax, ay, this.viewW, this.viewH)
                c.Draw(root, ax + c.rx, ay + c.ry)
                root.PopClip()
            }
            if (this.showV) { this.vbar.Draw(root, ax + this.viewW, ay, this.viewH) }
            if (this.showH) { this.hbar.Draw(root, ax, ay + this.viewH, this.viewW) }
            if (this.showV && this.showH) { root.renderer.FillRect(ax + this.viewW, ay + this.viewH, this.vbar.size, this.hbar.size, root.theme.scrollTrack) }
        }

        // In the section the child, on the bars the ScrollViewer itself.
        HitTest(int px, int py) {
            if (!this.visible) { return undefined }
            if (!this.Contains(px, py)) { return undefined }
            var c = this.content
            if (c != undefined && px < this.ax + this.viewW && py < this.ay + this.viewH) {
                var hit = c.HitTest(px, py)
                if (hit != undefined) { return hit }
            }
            return this
        }

        Collect(list) {
            if (!this.visible || !this.enabled) { return }
            if (this.content != undefined) { this.content.Collect(list) }
        }

        FindName(string name) {
            if (this.name == name) { return this }
            if (this.content != undefined) { return this.content.FindName(name) }
            return undefined
        }

        bool MouseWheel(root, int dx, int dy) {
            var step = this.TextHeight(root) * 3
            if (dx != 0 && this.showH) {
                this.hbar.By(-dx * step)
                return true
            }
            if (dy != 0 && this.showV) {
                this.vbar.By(-dy * step)
                return true
            }
            if (dy != 0 && this.showH) {
                this.hbar.By(-dy * step)
                return true
            }
            return false
        }

        bool CanPan() { return this.showV || this.showH }

        bool Dragging() { return this.vbar.dragging || this.hbar.dragging }

        bool PanBy(root, int dx, int dy) {
            if (!this.showV && !this.showH) { return false }
            if (this.showH) { this.hbar.By(-dx) }
            if (this.showV) { this.vbar.By(-dy) }
            return true
        }

        MouseDown(root, int button, int px, int py) {
            if (button != 1) { return }
            if (this.showV && px >= this.ax + this.viewW && py < this.ay + this.viewH) { this.vbar.Press(py - this.ay, this.viewH) }
            else if (this.showH && py >= this.ay + this.viewH && px < this.ax + this.viewW) { this.hbar.Press(px - this.ax, this.viewW) }
        }

        MouseMove(root, int px, int py) {
            if (this.vbar.dragging) { this.vbar.Drag(py - this.ay, this.viewH) }
            if (this.hbar.dragging) { this.hbar.Drag(px - this.ax, this.viewW) }
        }

        MouseUp(root, int button, int px, int py) {
            this.vbar.Release()
            this.hbar.Release()
        }

        // Moves the section so that the rectangle (x, y, w, h) of the content (in content coordinates) is visible.
        ScrollIntoView(int x, int y, int w, int h) {
            if (y < this.vbar.offset) { this.vbar.Set(y) }
            else if (y + h > this.vbar.offset + this.viewH) { this.vbar.Set(y + h - this.viewH) }
            if (x < this.hbar.offset) { this.hbar.Set(x) }
            else if (x + w > this.hbar.offset + this.viewW) { this.hbar.Set(x + w - this.viewW) }
        }
    }
}
