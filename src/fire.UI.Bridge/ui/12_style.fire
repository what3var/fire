namespace UI {
    // Collections of values and appearance: setters, triggers, style, templates (ControlTemplate/DataTemplate), bindings between elements and the
    // ResourceDictionary. Properties are the fields of the elements; they are set via their names (Reflect.Get/Set), which is why
    // `ui` needs the library `reflection`. Nothing here paints by itself - the elements (see Element.Prepare) fetch styles, triggers, templates and bindings.

    // Gives a property a value. `target`: name of a part of the element's template (empty: the element itself).
    class Setter {
        string property
        var value
        string target = ""

        construct(string property, value, string target = "") {
            this.property = property
            this.value = value
            this.target = target
            UI.M.Own(this, value)
        }

        // The element the setter acts on (undefined if the part does not exist).
        Find(owner) {
            if (this.target == "") { return owner }
            return owner.FindPart(this.target)
        }

        Apply(owner) {
            var element = this.Find(owner)
            if (element == undefined) { return }
            if (Reflect.Has(element, this.property)) { Reflect.Set(element, this.property, this.value) }
        }
    }

    // A condition of a trigger: the property has the value. `source`: name of a part of the template (empty: the element itself).
    class Condition {
        string property
        var value
        string source = ""

        construct(string property, value, string source = "") {
            this.property = property
            this.value = value
            this.source = source
        }

        bool Holds(owner) {
            var element = owner
            if (this.source != "") { element = owner.FindPart(this.source) }
            if (element == undefined) { return false }
            if (!Reflect.Has(element, this.property)) { return false }
            return Reflect.Get(element, this.property) == this.value
        }
    }

    // As long as all conditions hold, the setters set their values; afterwards the old ones return.
    // `new Trigger("hover", true)` - further conditions with And(...), the values with Set(...).
    class Trigger {
        List conditions
        List setters

        construct(string property, value, string source = "") {
            this.conditions = new List()
            this.setters = new List()
            this.And(property, value, source)
        }

        And(string property, value, string source = "") {
            var condition = new Condition(property, value, source)
            condition.TakeTo(this)
            this.conditions.Add(condition)
        }

        Set(string property, value, string target = "") {
            var setter = new Setter(property, value, target)
            setter.TakeTo(this)
            this.setters.Add(setter)
        }

        bool Holds(owner) {
            for (var i = 0; i < this.conditions.count; i = i + 1) {
                if (!this.conditions[i].Holds(owner)) { return false }
            }
            return true
        }
    }

    // A value that is reset when a trigger ends.
    class Saved {
        Element element
        string property
        var value
    }

    // The state of a trigger on ONE element (style and template are shared by many elements).
    class TriggerState {
        Trigger trigger
        bool active = false
        List saved

        construct(trigger) {
            this.trigger = trigger
            this.saved = new List()
        }

        Update(owner) {
            var holds = this.trigger.Holds(owner)
            if (holds && !this.active) { this.Activate(owner) }
            else if (!holds && this.active) { this.Deactivate() }
        }

        Activate(owner) {
            this.active = true
            for (var i = 0; i < this.trigger.setters.count; i = i + 1) {
                var setter = this.trigger.setters[i]
                var element = setter.Find(owner)
                if (element == undefined) { continue }
                if (!Reflect.Has(element, setter.property)) { continue }
                var s = new Saved()
                s.element = element
                s.property = setter.property
                s.value = Reflect.Get(element, setter.property)
                s.TakeTo(this)
                this.saved.Add(s)
                Reflect.Set(element, setter.property, setter.value)
            }
        }

        Deactivate() {
            var i = this.saved.count - 1
            while (i >= 0) {
                var s = this.saved[i]
                Reflect.Set(s.element, s.property, s.value)
                i = i - 1
            }
            for (var j = 0; j < this.saved.count; j = j + 1) { delete this.saved[j] }
            this.saved.Clear()
            this.active = false
        }
    }

    // A collection of setters and triggers for a kind of element. `target` is the style key (see Element.StyleKey, e.g. "Button");
    // in a ResourceDictionary with AddStyle it applies to all elements of this kind below it ("implicit style"), otherwise you assign it
    // with `element.style = ...`. `basedOn`: a style this one builds on.
    // A style applies at the first layout of the element and overrides there what the constructor or code set beforehand.
    class Style {
        string target
        Style basedOn
        List setters
        List triggers

        construct(string target = "") {
            this.target = target
            this.setters = new List()
            this.triggers = new List()
        }

        Set(string property, value) {
            var setter = new Setter(property, value)
            setter.TakeTo(this)
            this.setters.Add(setter)
        }

        AddTrigger(trigger) {
            trigger.TakeTo(this)
            this.triggers.Add(trigger)
        }

        // Apply the setters and register the triggers with the element (first those of the base style).
        Apply(owner) {
            if (this.basedOn != undefined) { this.basedOn.Apply(owner) }
            for (var i = 0; i < this.setters.count; i = i + 1) { this.setters[i].Apply(owner) }
            for (var j = 0; j < this.triggers.count; j = j + 1) { owner.AddTrigger(this.triggers[j]) }
        }
    }

    // Binds the property of a part of the template to a property of the element that owns the template.
    class TemplateBinding {
        string part
        string partProperty
        string ownerProperty

        construct(string part, string partProperty, string ownerProperty) {
            this.part = part
            this.partProperty = partProperty
            this.ownerProperty = ownerProperty
        }
    }

    // The appearance of a control: `factory` is a lambda with one parameter (the element) that builds the tree of the parts and returns its
    // root. Parts with names (`element.name = "..."`) can be addressed: Bind(...) binds one of their properties to one of the element,
    // AddTrigger(...) changes it under a condition (setters with `target` = name of the part).
    // Without a template the control draws itself.
    class ControlTemplate {
        var factory
        List bindings
        List triggers

        construct(factory) {
            this.factory = factory
            this.bindings = new List()
            this.triggers = new List()
        }

        Bind(string part, string partProperty, string ownerProperty) {
            var binding = new TemplateBinding(part, partProperty, ownerProperty)
            binding.TakeTo(this)
            this.bindings.Add(binding)
        }

        AddTrigger(trigger) {
            trigger.TakeTo(this)
            this.triggers.Add(trigger)
        }
    }

    // Builds the element that shows a data item (a row of a list, a tree): `factory` is a lambda with one parameter (the data item).
    class DataTemplate {
        var factory

        construct(factory) { this.factory = factory }

        Build(item) {
            var make = this.factory
            return make(item)
        }
    }

    // Connects a property of an element with that of another object. It is reconciled on every layout (without events): if the source changes,
    // the target follows; with `twoWay` the source follows the target too; with `once` it is transferred only one time. `sourceProperty` is a path ("name", "address.city");
    // empty is the source itself (e.g. the data item of a DataTemplate row, read-only). A text property shows every value as text. `converter`: a UI.Converter (undefined: values unchanged).
    class Binding {
        Element target
        string targetProperty
        var source
        string sourceProperty
        bool twoWay = false
        var converter
        bool once = false
        // state at the last reconciliation
        bool synced = false
        var lastSource
        var lastTarget

        construct(Element target, string targetProperty, source, string sourceProperty, bool twoWay = false, converter = undefined, bool once = false) {
            this.target = target
            this.targetProperty = targetProperty
            this.source = source
            this.sourceProperty = sourceProperty
            this.twoWay = twoWay
            this.converter = converter
            this.once = once
        }

        Sync() {
            if (this.once && this.synced) { return }
            if (!UI.M.PathHas(this.source, this.sourceProperty) || !Reflect.Has(this.target, this.targetProperty)) { return }
            var s = UI.M.PathGet(this.source, this.sourceProperty)
            var t = Reflect.Get(this.target, this.targetProperty)
            if (this.twoWay && this.sourceProperty != "" && this.synced && t != this.lastTarget) {
                // the target has changed: back into the source
                var back = t
                if (this.converter != undefined) { back = this.converter.ConvertBack(t) }
                if (back != s) { UI.M.PathSet(this.source, this.sourceProperty, back) }
                this.lastSource = UI.M.PathGet(this.source, this.sourceProperty)
                this.lastTarget = t
                return
            }
            if (!this.synced || s != this.lastSource) {
                var forward = s
                if (this.converter != undefined) { forward = this.converter.Convert(s) }
                // a text property shows any other value as its text
                if (t is of string && forward != undefined && !(forward is of string)) { forward = UI.M.Text(forward) }
                if (forward != t) { Reflect.Set(this.target, this.targetProperty, forward) }
                this.lastSource = s
                this.lastTarget = Reflect.Get(this.target, this.targetProperty)
                this.synced = true
            }
        }
    }

    // Named values (brushes, pens, numbers, styles, ...) and implicit styles. Every element and the root has one (`resources`, initially undefined
    // on the element); the search goes upwards from the element (Element.FindResource, Element.FindStyle).
    class ResourceDictionary {
        List keys
        List values
        List styles

        construct() {
            this.keys = new List()
            this.values = new List()
            this.styles = new List()
        }

        int IndexOf(string key) {
            for (var i = 0; i < this.keys.count; i = i + 1) {
                if (this.keys[i] == key) { return i }
            }
            return -1
        }

        bool Has(string key) { return this.IndexOf(key) >= 0 }

        // The value for the key, otherwise undefined.
        Get(string key) {
            var i = this.IndexOf(key)
            if (i < 0) { return undefined }
            return this.values[i]
        }

        // Stores the value (an existing key is overwritten); the dictionary owns it.
        Set(string key, value) {
            UI.M.Own(this, value)
            var i = this.IndexOf(key)
            if (i >= 0) {
                this.values[i] = value
                return
            }
            this.keys.Add(key)
            this.values.Add(value)
        }

        // An implicit style: applies to all elements with the style key `style.target` below it.
        AddStyle(style) {
            style.TakeTo(this)
            for (var i = 0; i < this.styles.count; i = i + 1) {
                if (this.styles[i].target == style.target) {
                    this.styles[i] = style
                    return
                }
            }
            this.styles.Add(style)
        }

        FindStyle(string key) {
            for (var i = 0; i < this.styles.count; i = i + 1) {
                if (this.styles[i].target == key) { return this.styles[i] }
            }
            return undefined
        }

        // Takes over the entries and styles of another dictionary (it must live as long as this one).
        Merge(other) {
            for (var i = 0; i < other.keys.count; i = i + 1) {
                var key = other.keys[i]
                var at = this.IndexOf(key)
                if (at >= 0) { this.values[at] = other.values[i] }
                else {
                    this.keys.Add(key)
                    this.values.Add(other.values[i])
                }
            }
            for (var j = 0; j < other.styles.count; j = j + 1) {
                var style = other.styles[j]
                var found = false
                for (var k = 0; k < this.styles.count; k = k + 1) {
                    if (this.styles[k].target == style.target) {
                        this.styles[k] = style
                        found = true
                    }
                }
                if (!found) { this.styles.Add(style) }
            }
        }
    }
}
