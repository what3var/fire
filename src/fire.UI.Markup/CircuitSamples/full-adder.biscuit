{
  "biscuit": 1,
  "timeStep": "10us",
  "elements": [
    {"type": "Text", "from": [0, -8], "to": [4, -8], "text": "Full adder: click the inputs - S = A xor B xor Cin, C = the carry"},
    {"type": "LogicInput", "name": "A", "from": [8, 0], "to": [4, 0], "high": "true"},
    {"type": "LogicInput", "name": "B", "from": [8, 4], "to": [4, 4]},
    {"type": "LogicInput", "name": "Cin", "from": [8, 8], "to": [4, 8], "high": "true"},
    {"type": "Wire", "from": [8, 0], "to": [16, 0]},
    {"type": "Wire", "from": [8, 4], "to": [16, 4]},
    {"type": "Wire", "from": [8, 8], "to": [16, 8]},
    {"type": "FullAdder", "name": "U1", "from": [16, 0], "to": [28, 0]},
    {"type": "Wire", "from": [28, 0], "to": [36, 0]},
    {"type": "Wire", "from": [28, 8], "to": [36, 8]},
    {"type": "LogicOutput", "name": "C", "from": [36, 0], "to": [40, 0]},
    {"type": "LogicOutput", "name": "S", "from": [36, 8], "to": [40, 8]}
  ]
}
