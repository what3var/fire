<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SelfContained>true</SelfContained>   <!-- the executables it references are self-contained -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The logic of the editor that has no user interface (the types of the language services, Markdown), linked in directly for the tests. -->
    <Compile Include="..\fire.Editor\Language\LanguageTypes.cs" Link="Editor\LanguageTypes.cs" />
    <Compile Include="..\fire.Editor\Markdown\MarkdownParser.cs" Link="Editor\MarkdownParser.cs" />
    <Compile Include="..\fire.Editor\Notes\OverviewParser.cs" Link="Editor\OverviewParser.cs" />
    <Compile Include="..\fire.Editor\Markdown\LanguageHelp.cs" Link="Editor\LanguageHelp.cs" />
    <Compile Include="..\fire.Editor\Language\DocComments.cs" Link="Editor\DocComments.cs" />
    <Compile Include="..\fire.Editor\Language\LiveDiagnostics.cs" Link="Editor\LiveDiagnostics.cs" />
    <Compile Include="..\fire.Editor\Language\BackgroundCheck.cs" Link="Editor\BackgroundCheck.cs" />
    <Compile Include="..\fire.Editor\Language\DeclarationShape.cs" Link="Editor\DeclarationShape.cs" />
    <Compile Include="..\fire.Editor\Language\FileTexts.cs" Link="Editor\FileTexts.cs" />
    <Compile Include="..\fire.Editor\Language\SyntaxHighlighter.cs" Link="Editor\SyntaxHighlighter.cs" />
    <Compile Include="..\fire.Editor\Language\CppHighlighter.cs" Link="Editor\CppHighlighter.cs" />
    <Compile Include="..\fire.Editor\Language\ColorizeAttributes.cs" Link="Editor\ColorizeAttributes.cs" />
    <!-- the client of `forge serve` (docs/spec/FORGE_SERVE.md): the language services over the protocol (ServeTests, CompletionTests) -->
    <Compile Include="..\fire.Editor\Language\ServeClient.cs" Link="Editor\ServeClient.cs" />
    <!-- the debug session of spark (no user interface): tested headless against the debug targets (DebuggerTests) -->
    <Compile Include="..\fire.Editor\Debugging\DebugSession.cs" Link="Editor\DebugSession.cs" />
    <Compile Include="..\fire.Editor\Debugging\DebugThreadContext.cs" Link="Editor\DebugThreadContext.cs" />
    <!-- the log of a build as spark keeps it (into the build log panel, mirrored by the build window) -->
    <Compile Include="..\fire.Editor\Debugging\BuildLogFeed.cs" Link="Editor\BuildLogFeed.cs" />
    <!-- spark builds through forge: the runner of `forge build` with its report and the overlays of the editor's text (ForgeReportTests) -->
    <Compile Include="..\fire.Editor\Build\ForgeProcess.cs" Link="Editor\ForgeProcess.cs" />
    <!-- spark's setup wizard without its windows: the catalog of ai.models, the pages and the plan, the progress of a run, the download of a model (SetupWizardTests) -->
    <Compile Include="..\fire.Editor\Setup\*.cs" LinkBase="Editor\Setup" />
    <!-- the native build of the assistant that spark starts (SetupWizardTests: "Assistent nativ") -->
    <Compile Include="..\fire.Editor\Assistant\AssistantNative.cs" Link="Editor\AssistantNative.cs" />
    <!-- files that change under the editor (a git pull, a switch of the branch, other programs): what to load again (GitSyncTests) -->
    <Compile Include="..\fire.Editor\Git\WorkingTreeSync.cs" Link="Editor\WorkingTreeSync.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\fire.Tooling\fire.Tooling.csproj" />
    <ProjectReference Include="..\fire.Imaging\fire.Imaging.csproj" />   <!-- the image codecs of spark (ImageTests) -->
    <ProjectReference Include="..\fire.Project\fire.Project.csproj" />
    <ProjectReference Include="..\fire.Git\fire.Git.csproj" />
  </ItemGroup>

  <!-- forge, the VM, native/ and Source/ (the standard libraries) next to the program (src/ember: `forge package-dist`, copied by src/ForgeDist.targets): the tests install
       the packages into a store of their own; their C++ is built when it is used (Prebuilt/ is not copied) -->
  <PropertyGroup><FireDistPrebuilt>false</FireDistPrebuilt></PropertyGroup>
  <Import Project="..\ForgeDist.targets" />
</Project>
