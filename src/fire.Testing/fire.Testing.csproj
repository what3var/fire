<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SelfContained>true</SelfContained>   <!-- the executables it references are self-contained -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The logic of the editor that has no user interface (completion, navigation, Markdown), linked in directly for the tests. -->
    <Compile Include="..\fire.Editor\Language\ScriptSymbolIndex.cs" Link="Editor\ScriptSymbolIndex.cs" />
    <Compile Include="..\fire.Editor\Language\ScriptSymbolIndex.Types.cs" Link="Editor\ScriptSymbolIndex.Types.cs" />
    <Compile Include="..\fire.Editor\Language\CompletionEngine.cs" Link="Editor\CompletionEngine.cs" />
    <Compile Include="..\fire.Editor\Language\NavigationEngine.cs" Link="Editor\NavigationEngine.cs" />
    <Compile Include="..\fire.Editor\Language\BuiltinMembers.cs" Link="Editor\BuiltinMembers.cs" />
    <Compile Include="..\fire.Editor\Markdown\MarkdownParser.cs" Link="Editor\MarkdownParser.cs" />
    <Compile Include="..\fire.Editor\Markdown\LanguageHelp.cs" Link="Editor\LanguageHelp.cs" />
    <Compile Include="..\fire.Editor\Language\DocComments.cs" Link="Editor\DocComments.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\fire.Compiler\fire.Compiler.csproj" />
    <ProjectReference Include="..\fire.Runtime\fire.Runtime.csproj" />
    <ProjectReference Include="..\fire.Project\fire.Project.csproj" />
    <ProjectReference Include="..\fire.Git\fire.Git.csproj" />
  </ItemGroup>

  <!-- the standard libraries (packages/) next to the program as Source: the tests pack and install them into a store of their own; their C++ is built when it is used -->
  <PropertyGroup><PrebuildStandard>false</PrebuildStandard><StandardSourcesPublish>false</StandardSourcesPublish></PropertyGroup>
  <Import Project="..\StandardSources.targets" />
</Project>
