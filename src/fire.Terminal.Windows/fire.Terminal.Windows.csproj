<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows-specific composition: GdiGlyphFont (GDI+ glyph rasterisation)
    and ConsoleWindow (puts framebuffer + renderer + the SDL
    renderer together into a finished window, with concrete Windows
    defaults). References both the platform-independent core and
    the SDL rendering project - exactly here, not in fire.Terminal
    itself, the two come together.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>fire.Terminal.Windows</RootNamespace>
    <AssemblyName>fire.Terminal.Windows</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\fire.Terminal\fire.Terminal.csproj" />
    <ProjectReference Include="..\fire.Terminal.Sdl\fire.Terminal.Sdl.csproj" />
  </ItemGroup>

</Project>
