<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows-spezifische Komposition: GdiGlyphFont (GDI+-Schriftrasterung)
    und ConsoleWindow (setzt Framebuffer + TerminalCanvas + den SDL-
    Renderer zu einem fertigen Fenster zusammen, mit konkreten Windows-
    Defaults). Referenziert sowohl den plattformunabhängigen Kern als auch
    das SDL-Rendering-Projekt - genau hier, nicht in fire.Terminal
    selbst, laufen beide zusammen.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>fire.Terminal.Windows</RootNamespace>
    <AssemblyName>fire.Terminal.Windows</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\fire.Terminal\fire.Terminal.csproj" />
    <ProjectReference Include="..\fire.Terminal.Sdl\fire.Terminal.Sdl.csproj" />
  </ItemGroup>

</Project>
