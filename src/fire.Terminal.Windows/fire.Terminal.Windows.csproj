<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The windows of the C# implementation of graphics and windows: ConsoleWindow
    (framebuffer + renderer) and WindowManager. The renderer is the host's (the
    tests, an editor that shows the pictures itself); the windows of the desktop
    are the C library's (docs/UI_PLATFORM.md) - no SDL here any more.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>fire.Terminal.Windows</RootNamespace>
    <AssemblyName>fire.Terminal.Windows</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\fire.Terminal\fire.Terminal.csproj" />
  </ItemGroup>

</Project>
