<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>fire.Native</RootNamespace>
    <AssemblyName>fire.Native</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\fire\fire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The C++ runtime that the generated code includes; written next to the generated file (see NativeRuntimeFiles). -->
    <EmbeddedResource Include="..\..\native\runtime\fire_rt.hpp" LogicalName="fire_rt.hpp" />
    <!-- The bridges (native/bridges/): the natives behind the #import libraries, included by the generated file when the program imports them. -->
    <EmbeddedResource Include="..\..\native\bridges\**\*.hpp" LogicalName="bridges/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The platform packages (native/platform/<name>/): everything that depends on the operating system or the board. -->
    <EmbeddedResource Include="..\..\native\platform\**\*.hpp" LogicalName="platform/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- A FreeRTOS simulator on top of pthreads (to try a FreeRTOS build on a PC, and for the tests). -->
    <EmbeddedResource Include="..\..\native\sim\**\*.h" LogicalName="sim/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
