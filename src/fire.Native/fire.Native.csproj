<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>fire.Native</RootNamespace>
    <AssemblyName>fire.Native</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\fire\fire.csproj" />
    <ProjectReference Include="..\fire.Package.Manager\fire.Package.Manager.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The runtime (C) that the generated code includes; written next to the generated file (see NativeRuntimeFiles). -->
    <EmbeddedResource Include="..\..\native\runtime\fire_rt.h" LogicalName="fire_rt.h" />
    <!-- What the natives in C++ include (fire_natives.cpp): fire_rt.h as C++ and the C++ platform layer. -->
    <EmbeddedResource Include="..\..\native\runtime\fire_rt_cpp.hpp" LogicalName="fire_rt_cpp.hpp" />
    <!-- JSON (`#import "json"`): the engine in C, written next to the program (it includes it when it uses JSON). -->
    <EmbeddedResource Include="..\..\native\runtime\fire_json.h" LogicalName="fire_json.h" />
    <EmbeddedResource Include="..\..\native\runtime\fire_debug.h" LogicalName="fire_debug.h" />
    <EmbeddedResource Include="..\..\native\runtime\cc\*.h" LogicalName="cc/%(Filename)%(Extension)" />
    <!-- The C ABI between the virtual machine and the natives of packages, and its C++ wrapper (native/abi/). -->
    <EmbeddedResource Include="..\..\native\abi\*" LogicalName="abi/%(Filename)%(Extension)" />
    <!-- The platform packages (native/platform/<name>/): everything that depends on the operating system or the board. -->
    <EmbeddedResource Include="..\..\native\platform\**\*.hpp" LogicalName="platform/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\native\platform\**\*.h" LogicalName="platform/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\native\platform\**\*.asm" LogicalName="platform/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- A FreeRTOS simulator on top of pthreads (to try a FreeRTOS build on a PC, and for the tests). -->
    <EmbeddedResource Include="..\..\native\sim\**\*.h" LogicalName="sim/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
