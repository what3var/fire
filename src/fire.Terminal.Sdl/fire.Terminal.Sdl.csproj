<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDL3-based IFramebufferRenderer implementation - a project of its own,
    references ONLY fire.Terminal (the platform-independent core),
    no GDI/WPF dependency. "net8.0" instead of "net8.0-windows", since the
    SDL3-CS package itself is cross-platform (Windows/Linux/macOS/...) -
    only the additional native runtime package (SDL3-CS.Windows) is chosen
    Windows-specific here, matching the rest of this solution.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>fire.Terminal.Sdl</RootNamespace>
    <AssemblyName>fire.Terminal.Sdl</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\fire.Terminal\fire.Terminal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Managed bindings (see SdlFramebufferRenderer.cs) + native
         Windows runtime package - versions current at the time of this change,
         update in the Package Manager if needed. -->
    <PackageReference Include="SDL3-CS" Version="3.4.18" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.18" />
  </ItemGroup>

</Project>
